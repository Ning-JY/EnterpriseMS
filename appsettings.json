{
  "ConnectionStrings": {
    "Default": "Server=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Uid=${DB_USER};Pwd=${DB_PASSWORD};CharSet=utf8mb4;AllowPublicKeyRetrieval=true;"
  },
  "Redis": {
    "Connection": "${REDIS_HOST}:${REDIS_PORT},password=${REDIS_PASSWORD},abortConnect=false"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Hangfire": {
    "ContractWarningDays": 30,
    "CertWarningDays": 60
  },
  "App": {
    "Name": "企业管理系统",
    "UploadPath": "wwwroot/uploads/"
  },
  "AllowedHosts": "*",
  "Cookie": {
    "SecurePolicy": "SameAsRequest",
    "_comment": "可选值: SameAsRequest(推荐,自动适配HTTP和HTTPS) | Always(纯HTTPS) | None(纯HTTP)"
  }
}
