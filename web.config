<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 部署上传限制配置。
  应用本身允许 500MB（见 Common/UploadLimits.cs），IIS 默认 maxAllowedContentLength 仅约 28.6MB，
  不配这里大文件上传会被 IIS 直接 413 拦截，根本进不了应用。
  dotnet publish 会保留本文件并补上 aspNetCore 处理程序配置。
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- 500MB，与应用内 UploadLimits.MaxUploadBytes 对齐 -->
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
