# 静态资源：放开 wwwroot 以便纳入版本库（css/js/lib/templates 等应用资源）
# 运行时用户上传目录 uploads/ 仅忽略其内容，保留目录结构（.gitkeep 纳入版本库）
wwwroot/uploads/*
!wwwroot/uploads/.gitkeep

# 数据库迁移文件
Migrations/

# 环境变量（含敏感信息，不可提交）
.env
.env.*
!.env.example

# IIS 配置（含环境变量密码，部署时本地填写）
web.config

# IDE 配置
.vscode/
