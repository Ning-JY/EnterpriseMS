{
  "ConnectionStrings": {
    "Default": "Server=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Uid=${DB_USER};Pwd=${DB_PASSWORD};CharSet=utf8mb4;AllowPublicKeyRetrieval=true;"
  },
  "Redis": {
    "Connection": "${REDIS_HOST}:${REDIS_PORT},password=${REDIS_PASSWORD},abortConnect=false"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "AI": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o"
  }
}
