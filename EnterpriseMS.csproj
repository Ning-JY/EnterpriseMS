<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EnterpriseMS</RootNamespace>
    <AssemblyName>EnterpriseMS</AssemblyName>
    <UserSecretsId>enterprisems-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>    
    <!-- EF Core + MySQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <!-- AutoMapper 12.0.1（MIT，最后一个免费版）。
         NU1903(GHSA-rvv3-g6hj-g44x / CVE-2026-32933)：深度递归 DoS，需构造 25,000+ 层嵌套对象；
         本系统仅在身份认证后映射内部浅层 DTO，实际不可利用。
         官方修复版为 15.1.1 / 16.1.1，但 AutoMapper 自 15.0 起转为商业许可(RPL)，不向后移植至免费版。
         故抑制该审计告警以免误伤构建；如需彻底修复须评估商业许可（谨慎决策）。 -->
    <PackageReference Include="AutoMapper" Version="12.0.1" NoWarn="NU1903" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.0" />
    <!-- FluentValidation -->
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.0" />
    <!-- BCrypt -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <!-- Redis -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.0" />
    <!-- Serilog -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Hangfire -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />
    <PackageReference Include="Hangfire.Redis.StackExchange" Version="1.9.3" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.0" />
    <!-- SnowflakeId -->
    <PackageReference Include="Yitter.IdGenerator" Version="1.0.14" />
    <!-- MiniExcel -->
    <PackageReference Include="MiniExcel" Version="1.36.0" />
    <!-- MiniWord：Word 模板引擎，支持 {{字段}} 文本、表格行循环、图片插入 -->
    <PackageReference Include="MiniWord" Version="0.9.2" />
    <!-- Health Checks -->
    <PackageReference Include="AspNetCore.HealthChecks.MySql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <!-- AI & 文档解析 -->
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.35.0" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.OpenAI" Version="1.35.0" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
  </ItemGroup>
</Project>
