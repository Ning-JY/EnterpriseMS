@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Domain.Entities.Hr
@using EnterpriseMS.Services.DTOs.System
@model Employee
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = Model.RealName + " - 员工详情";
    var userId     = User.GetUserId();
    bool canEdit   = await PermSvc.HasPermAsync(userId, "hr:employee:edit");
    bool canFormal = await PermSvc.HasPermAsync(userId, "hr:employee:formal");
    bool canLeave  = await PermSvc.HasPermAsync(userId, "hr:employee:leave");
    string[] statusText  = new[]{"试用期","在职","已离职"};
    string[] statusBadge = new[]{"badge-warning","badge-success","badge-secondary"};
    var depts = ViewBag.Depts as List<DeptTreeDto> ?? new();

    // 岗位（PostId 关联 SysPost，零迁移复用）
    var postName = Model.Post?.PostName;

    // 工龄
    string workAge = "-";
    if (Model.EntryDate.HasValue)
    {
        var s = Model.EntryDate.Value;
        var e = Model.LeaveDate ?? DateTime.Today;
        int y = e.Year - s.Year;
        if (e < s.AddYears(y)) y--;
        workAge = y + " 年";
    }

    // 档案完整度（按字段填充率计算）
    var fillFields = new List<string?>
    {
        Model.IdCard, Model.Phone, Model.Email,
        Model.Dept?.DeptName, postName,
        Model.EntryDate?.ToString("yyyy-MM-dd"),
        Model.Education, Model.Nationality, Model.BirthDate?.ToString("yyyy-MM-dd"),
        Model.PoliticalStatus, Model.NativePlace, Model.Address,
        Model.HighestDegree, Model.GraduateSchool, Model.Major,
        Model.WorkStartDate?.ToString("yyyy-MM-dd"),
        Model.TechnicalTitle, Model.TechnicalLevel,
        Model.EmergencyContact, Model.EmergencyPhone,
        Model.BankAccount, Model.BankName, Model.SocialInsuranceNo,
        Model.ProfilePhoto, Model.Remark
    };
    int fillCnt = fillFields.Count(f => !string.IsNullOrWhiteSpace(f));
    int fillTot = fillFields.Count;
    int fillPct = fillTot == 0 ? 0 : (int)Math.Round(fillCnt * 100.0 / fillTot);

    bool hasPhoto = !string.IsNullOrEmpty(Model.ProfilePhoto);
    var firstContract = Model.Contracts.OrderByDescending(x => x.StartDate).FirstOrDefault();
}

@functions {
    private static Microsoft.AspNetCore.Html.HtmlString Fld(string label, string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        return new Microsoft.AspNetCore.Html.HtmlString(
            $"<tr><td class='text-muted w-40'>{label}</td><td>{System.Net.WebUtility.HtmlEncode(val)}</td></tr>");
    }
    private static Microsoft.AspNetCore.Html.HtmlString Fld(string label, DateTime? val)
    {
        if (!val.HasValue) return Microsoft.AspNetCore.Html.HtmlString.Empty;
        return Fld(label, val.Value.ToString("yyyy-MM-dd"));
    }
}

<style>
    .employee-detail .profile-header {
        display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;
        border-radius: 14px;
    }
    .profile-avatar-wrap { position: relative; width: 96px; height: 96px; flex: 0 0 auto; }
    .profile-fallback { font-size: 96px; line-height: 96px; color: #cbd5e1; }
    .profile-avatar-img {
        position: absolute; inset: 0; width: 96px; height: 96px;
        border-radius: 50%; object-fit: cover; border: 3px solid #fff;
        box-shadow: 0 2px 10px rgba(15,23,42,.12);
    }
    .profile-main { flex: 1 1 auto; min-width: 220px; }
    .profile-main h3 { margin: 0 0 .35rem; font-weight: 600; }
    .profile-meta { display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; color: #64748b; font-size: .875rem; }
    .profile-meta span { white-space: nowrap; }
    .profile-meta i { width: 16px; text-align: center; color: #0d6b64; }
    .profile-actions { flex: 0 0 auto; display: flex; gap: .5rem; }
    .info-card .card-body { padding: .75rem 1rem; }
    .info-card table td { border: none; padding: .3rem .25rem; font-size: .85rem; vertical-align: top; }
    .info-card table td.w-40 { width: 38%; color: #94a3b8; white-space: nowrap; }
    .completeness-wrap { text-align: center; padding: .5rem 0; }
    .circular-chart { display: block; margin: 0 auto; max-width: 150px; max-height: 150px; }
    .circle-bg { fill: none; stroke: #eef2f7; stroke-width: 3.8; }
    .circle { fill: none; stroke: #0d6b64; stroke-width: 3.8; stroke-linecap: round;
              transition: stroke-dasharray .6s ease; }
    .percentage { fill: #0f172a; font-family: inherit; font-size: 9px; text-anchor: middle; font-weight: 700; }
    .contract-mini td { font-size: .8rem; padding: .3rem .4rem; }
    .nav-tabs .nav-link { cursor: pointer; }
</style>

<section class="content employee-detail"><div class="container-fluid">

    <!-- 面包屑 + 返回 -->
    <div class="d-flex align-items-center mb-2">
        <a href="/hr/employee" class="btn btn-sm btn-default mr-2"><i class="fas fa-arrow-left"></i> 返回</a>
        <ol class="breadcrumb float-sm-right" style="background:transparent;margin:0;padding:0;">
            <li class="breadcrumb-item"><a href="/">首页</a></li>
            <li class="breadcrumb-item"><a href="/hr/employee">员工信息</a></li>
            <li class="breadcrumb-item active">员工详情</li>
        </ol>
    </div>

    <!-- 顶部 Profile Header -->
    <div class="card card-outline profile-header mb-3">
        <div class="card-body">
            <div class="profile-avatar-wrap">
                <i class="fas fa-user-circle profile-fallback"></i>
                @if (hasPhoto)
                {
                    <img src="@Model.ProfilePhoto" class="profile-avatar-img" alt="头像"
                         onerror="this.style.display='none'">
                }
            </div>
            <div class="profile-main">
                <h3>
                    @Model.RealName
                    <span class="badge @statusBadge[Model.Status] ml-1">@statusText[Model.Status]</span>
                </h3>
                <div class="profile-meta">
                    <span><i class="fas fa-id-badge"></i> 工号：@Model.EmpNo</span>
                    <span><i class="fas fa-building"></i> 部门：@(Model.Dept?.DeptName ?? "暂无部门")</span>
                    <span><i class="fas fa-briefcase"></i> 岗位：@(postName ?? "未设置")</span>
                    <span><i class="fas fa-phone"></i> @(Model.Phone ?? "-")</span>
                    <span><i class="fas fa-calendar-check"></i> 入职：@(Model.EntryDate?.ToString("yyyy-MM-dd") ?? "-")</span>
                </div>
            </div>
            <div class="profile-actions">
                @if (canEdit && Model.Status != 2)
                {
                    <a href="/hr/employee/edit/@Model.Id" class="btn btn-warning">
                        <i class="fas fa-edit mr-1"></i> 编辑档案
                    </a>
                }
                @if (canFormal && Model.Status == 0)
                {
                    <button class="btn btn-success" onclick="doFormal()">
                        <i class="fas fa-user-check mr-1"></i> 办理转正
                    </button>
                }
                @if (canLeave && Model.Status != 2)
                {
                    <button class="btn btn-secondary" onclick="doLeave()">
                        <i class="fas fa-sign-out-alt mr-1"></i> 办理离职
                    </button>
                }
                <button class="btn btn-outline-primary" onclick="ems.msg('导出 PDF 功能开发中', {icon:7})">
                    <i class="fas fa-file-pdf mr-1"></i> 导出 PDF
                </button>
            </div>
        </div>
    </div>

    <!-- 四张信息卡 -->
    <div class="row">
        <!-- 基本信息 -->
        <div class="col-lg-3 col-md-6">
            <div class="card card-primary card-outline info-card h-100">
                <div class="card-header"><h3 class="card-title"><i class="fas fa-user mr-1"></i>基本信息</h3></div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        @Fld("性别", Model.Gender == 1 ? "男" : "女")
                        @Fld("出生日期", Model.BirthDate)
                        @Fld("民族", Model.Nationality)
                        @Fld("政治面貌", Model.PoliticalStatus)
                        @Fld("籍贯", Model.NativePlace)
                        @Fld("最高学位", Model.HighestDegree)
                        @Fld("毕业院校", Model.GraduateSchool)
                        @Fld("专业", Model.Major)
                        @Fld("技术职称", Model.TechnicalTitle)
                        @Fld("技术等级", Model.TechnicalLevel)
                        @Fld("身份证号", Model.IdCard)
                        @Fld("紧急联系人", (Model.EmergencyContact ?? "") + (Model.EmergencyPhone != null ? " / " + Model.EmergencyPhone : ""))
                        @Fld("社保号", Model.SocialInsuranceNo)
                        @Fld("住址", Model.Address)
                        @Fld("邮箱", Model.Email)
                        @Fld("手机", Model.Phone)
                    </table>
                </div>
            </div>
        </div>

        <!-- 任职信息 -->
        <div class="col-lg-3 col-md-6">
            <div class="card card-info card-outline info-card h-100">
                <div class="card-header"><h3 class="card-title"><i class="fas fa-id-card mr-1"></i>任职信息</h3></div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-0">
                        @Fld("工号", Model.EmpNo)
                        @Fld("部门", Model.Dept?.DeptName)
                        @Fld("岗位", postName)
                        @Fld("员工状态", statusText[Model.Status])
                        @Fld("入职日期", Model.EntryDate)
                        @Fld("工龄", workAge)
                        @Fld("转正日期", Model.FormalDate)
                        @if (Model.Status == 2) { @Fld("离职日期", Model.LeaveDate) }
                        @Fld("合同类型", firstContract?.ContractType)
                        @Fld("社保号", Model.SocialInsuranceNo)
                    </table>
                </div>
            </div>
        </div>

        <!-- 合同信息 -->
        <div class="col-lg-3 col-md-6">
            <div class="card card-success card-outline info-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title"><i class="fas fa-file-contract mr-1"></i>合同信息</h3>
                    <div>
                        @if (canEdit)
                        {
                            <button class="btn btn-xs btn-success" onclick="openAddContractModal()" title="新增合同"><i class="fas fa-plus"></i></button>
                        }
                        <a href="/hr/contract" class="btn btn-xs btn-outline-success">全部</a>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-sm table-borderless mb-2">
                        @Fld("合同类型", firstContract?.ContractType)
                        @if (firstContract != null)
                        {
                            @Fld("合同期限", firstContract.StartDate.ToString("yyyy-MM-dd") + " ~ " + firstContract.EndDate.ToString("yyyy-MM-dd"))
                        }
                        @Fld("紧急联系人", (Model.EmergencyContact ?? "") + (Model.EmergencyPhone != null ? " / " + Model.EmergencyPhone : ""))
                        @Fld("银行卡号", Model.BankAccount)
                        @Fld("开户行", Model.BankName)
                        @Fld("工作电话", Model.Phone)
                        @Fld("邮箱", Model.Email)
                    </table>
                    @if (Model.Contracts.Any())
                    {
                        <div style="max-height:200px; overflow:auto;">
                            <table class="table table-sm table-bordered mb-0 contract-mini">
                                <thead class="thead-light"><tr><th>编号</th><th>类型</th><th>期限</th><th>状态</th><th>附件</th></tr></thead>
                                <tbody>
                                @foreach (var cont in Model.Contracts.OrderByDescending(x => x.StartDate))
                                {
                                    var warn = cont.Status == 0 && cont.EndDate <= DateTime.Today.AddDays(30);
                                    <tr class="@(warn ? "table-warning" : "")">
                                        <td><code class="small">@cont.ContractNo</code></td>
                                        <td>@cont.ContractType</td>
                                        <td class="small @(warn ? "text-danger font-weight-bold" : "")">
                                            @cont.StartDate.ToString("yyyy-MM-dd") ~ @cont.EndDate.ToString("yyyy-MM-dd")
                                            @if (warn) { <span class="badge badge-warning ml-1">即将到期</span> }
                                        </td>
                                        <td>@(cont.Status == 0 ? "生效" : "已终止")</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(cont.FileName))
                                            {
                                                <a href="/hr/contract/download/@cont.Id" class="btn btn-xs btn-info" title="下载"><i class="fas fa-download"></i></a>
                                                @if (canEdit)
                                                {
                                                    <label class="btn btn-xs btn-warning mb-0" title="重新上传">
                                                        <i class="fas fa-sync-alt"></i>
                                                        <input type="file" style="display:none" onchange="uploadContractFile(@cont.Id, this)">
                                                    </label>
                                                    <button class="btn btn-xs btn-outline-danger" onclick="deleteAttachment('contract',@cont.Id)" title="删除附件"><i class="fas fa-times"></i></button>
                                                }
                                            }
                                            else if (canEdit)
                                            {
                                                <label class="btn btn-xs btn-outline-secondary mb-0">
                                                    <i class="fas fa-upload"></i>
                                                    <input type="file" style="display:none" onchange="uploadContractFile(@cont.Id, this)">
                                                </label>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-2 small">暂无合同记录</div>
                    }
                </div>
            </div>
        </div>

        <!-- 档案完整度 -->
        <div class="col-lg-3 col-md-6">
            <div class="card card-warning card-outline info-card h-100">
                <div class="card-header"><h3 class="card-title"><i class="fas fa-chart-pie mr-1"></i>档案完整度</h3></div>
                <div class="card-body completeness-wrap">
                    <svg viewBox="0 0 36 36" class="circular-chart">
                        <path class="circle-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        <path class="circle" stroke-dasharray="@fillPct, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                        <text x="18" y="20.5" class="percentage">@fillPct%</text>
                    </svg>
                    <p class="mt-2 mb-0 small text-muted">已完善 @fillCnt / @fillTot 项信息</p>
                    @if (fillPct < 100)
                    {
                        <p class="mb-0 small text-warning"><i class="fas fa-lightbulb mr-1"></i>建议补充缺失项以提升档案完整度</p>
                    }
                    else
                    {
                        <p class="mb-0 small text-success"><i class="fas fa-check-circle mr-1"></i>档案信息已完善</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- 底部标签页 -->
    <div class="card card-outline">
        <div class="card-header p-0 pt-2 pl-2">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tabEdu">教育经历</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabWork">工作经历</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabCert">证书资质</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabAtt">考勤汇总</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tabFile">档案附件</a></li>
            </ul>
        </div>
        <div class="card-body">
            <div class="tab-content">
                <!-- 教育经历 -->
                <div class="tab-pane active" id="tabEdu">
                    <div class="mb-2 text-right">
                        @if (canEdit) { <button class="btn btn-sm btn-warning" onclick="openAddEduModal()"><i class="fas fa-plus mr-1"></i>新增教育经历</button> }
                    </div>
                    @if (Model.EducationList.Any())
                    {
                        <table class="table table-sm">
                            <thead class="thead-light"><tr><th>学校</th><th>专业</th><th>学历</th><th>起止</th><th class="text-right">操作</th></tr></thead>
                            <tbody>
                            @foreach (var edu in Model.EducationList.OrderByDescending(x => x.StartDate))
                            {
                                <tr>
                                    <td>@edu.SchoolName</td>
                                    <td>@edu.Major</td>
                                    <td>@edu.Degree</td>
                                    <td class="small">@(edu.StartDate?.ToString("yyyy-MM-dd") ?? "-") ~ @(edu.EndDate?.ToString("yyyy-MM-dd") ?? "至今")</td>
                                    <td class="text-right">
                                        @if (canEdit)
                                        {
                                            <button class="btn btn-xs btn-outline-primary" data-id="@edu.Id" data-school="@edu.SchoolName" data-major="@edu.Major" data-degree="@edu.Degree" data-start="@(edu.StartDate?.ToString("yyyy-MM-dd"))" data-end="@(edu.EndDate?.ToString("yyyy-MM-dd"))" data-full="@(edu.IsFullTime ? "1" : "0")" data-remark="@edu.Remark" onclick="openEditEduModal(this)">编辑</button>
                                            <button class="btn btn-xs btn-outline-danger" onclick="deleteEdu(@edu.Id)">删除</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else { <div class="text-center text-muted py-3">暂无教育经历</div> }
                </div>

                <!-- 工作经历 -->
                <div class="tab-pane" id="tabWork">
                    <div class="mb-2 text-right">
                        @if (canEdit) { <button class="btn btn-sm btn-secondary" onclick="openAddWorkModal()"><i class="fas fa-plus mr-1"></i>新增工作经历</button> }
                    </div>
                    @if (Model.WorkExperiences.Any())
                    {
                        <table class="table table-sm">
                            <thead class="thead-light"><tr><th>公司</th><th>职位</th><th>起止</th><th class="text-right">操作</th></tr></thead>
                            <tbody>
                            @foreach (var w in Model.WorkExperiences.OrderByDescending(x => x.StartDate))
                            {
                                <tr>
                                    <td>@w.CompanyName</td>
                                    <td>@w.Position</td>
                                    <td class="small">@(w.StartDate?.ToString("yyyy-MM-dd") ?? "-") ~ @(w.EndDate?.ToString("yyyy-MM-dd") ?? "至今")</td>
                                    <td class="text-right">
                                        @if (canEdit)
                                        {
                                            <button class="btn btn-xs btn-outline-primary" data-id="@w.Id" data-company="@w.CompanyName" data-position="@w.Position" data-start="@(w.StartDate?.ToString("yyyy-MM-dd"))" data-end="@(w.EndDate?.ToString("yyyy-MM-dd"))" data-remark="@w.Remark" onclick="openEditWorkModal(this)">编辑</button>
                                            <button class="btn btn-xs btn-outline-danger" onclick="deleteWork(@w.Id)">删除</button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else { <div class="text-center text-muted py-3">暂无工作经历</div> }
                </div>

                <!-- 证书资质 -->
                <div class="tab-pane" id="tabCert">
                    <div class="mb-2 text-right">
                        @if (canEdit) { <button class="btn btn-sm btn-info" onclick="openAddCertModal()"><i class="fas fa-plus mr-1"></i>新增证书</button> }
                        <a href="/hr/cert" class="btn btn-sm btn-outline-info">查看全部</a>
                    </div>
                    @if (Model.Certificates.Any())
                    {
                        <table class="table table-sm">
                            <thead class="thead-light"><tr><th>证书名称</th><th>类型</th><th>证书编号</th><th>有效期至</th><th>状态</th><th>附件</th></tr></thead>
                            <tbody>
                            @foreach (var cert in Model.Certificates)
                            {
                                var warn = cert.Status == 0 && cert.ExpireDate.HasValue && cert.ExpireDate <= DateTime.Today.AddDays(60);
                                <tr class="@(warn ? "table-warning" : "")">
                                    <td>@cert.CertName</td>
                                    <td><span class="badge badge-light">@cert.CertType</span></td>
                                    <td><code class="small">@(cert.CertNo ?? "-")</code></td>
                                    <td class="small @(warn ? "text-danger font-weight-bold" : "")">
                                        @(cert.ExpireDate?.ToString("yyyy-MM-dd") ?? "长期")
                                        @if (warn) { <span class="badge badge-warning ml-1">即将到期</span> }
                                    </td>
                                    <td>@(cert.Status == 0 ? "有效" : "已过期")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(cert.FileName))
                                        {
                                            <a href="/hr/cert/download/@cert.Id" class="btn btn-xs btn-info" title="下载"><i class="fas fa-download"></i></a>
                                            @if (canEdit)
                                            {
                                                <label class="btn btn-xs btn-warning mb-0" title="重新上传">
                                                    <i class="fas fa-sync-alt"></i>
                                                    <input type="file" style="display:none" onchange="uploadCertFile(@cert.Id, this)">
                                                </label>
                                                <button class="btn btn-xs btn-outline-danger" onclick="deleteAttachment('cert',@cert.Id)" title="删除附件"><i class="fas fa-times"></i></button>
                                            }
                                        }
                                        else if (canEdit)
                                        {
                                            <label class="btn btn-xs btn-outline-secondary mb-0">
                                                <i class="fas fa-upload"></i>
                                                <input type="file" style="display:none" onchange="uploadCertFile(@cert.Id, this)">
                                            </label>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else { <div class="text-center text-muted py-3">暂无证书记录</div> }
                </div>

                <!-- 考勤汇总（开发中） -->
                <div class="tab-pane" id="tabAtt">
                    <div class="text-center text-muted py-5">
                        <i class="fas fa-tools fa-2x mb-3"></i>
                        <p class="mb-0">考勤汇总功能正在开发中</p>
                        <small>将支持出勤天数、迟到早退、请假记录等统计</small>
                    </div>
                </div>

                <!-- 档案附件（合同附件） -->
                <div class="tab-pane" id="tabFile">
                    @{
                        var attachList = Model.Contracts.Where(c => !string.IsNullOrEmpty(c.FileName)).ToList();
                    }
                    @if (attachList.Any())
                    {
                        <table class="table table-sm">
                            <thead class="thead-light"><tr><th>所属合同</th><th>附件名称</th><th>类型</th><th>操作</th></tr></thead>
                            <tbody>
                            @foreach (var cont in attachList)
                            {
                                <tr>
                                    <td><code class="small">@cont.ContractNo</code> <span class="small text-muted">@cont.ContractType</span></td>
                                    <td class="small">@cont.FileName</td>
                                    <td>合同附件</td>
                                    <td>
                                        <a href="/hr/contract/download/@cont.Id" class="btn btn-xs btn-info" title="下载"><i class="fas fa-download"></i> 下载</a>
                                        @if (canEdit)
                                        {
                                            <button class="btn btn-xs btn-outline-danger" onclick="deleteAttachment('contract',@cont.Id)" title="删除附件"><i class="fas fa-times"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                    else { <div class="text-center text-muted py-3">暂无档案附件（合同附件）</div> }
                </div>
            </div>
        </div>
    </div>

</div></section>

