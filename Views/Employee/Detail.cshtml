    /* ===== 合同弹窗 ===== */
    function openContractForm(d) {
        d = d || {};
        var typeOpts = (contractTypes || []).map(function (t) {
            return '<option value="' + esc(t.DictValue) + '"' + (t.DictValue == d.ContractType ? ' selected' : '') + '>' + esc(t.DictLabel) + '</option>';
        }).join('');
        var html = '<form class="layui-form ems-archive-form" id="contractForm" style="padding:15px;">'
            + '<input type="hidden" name="Id" value="' + (d.Id || 0) + '">'
            + '<input type="hidden" name="EmployeeId" value="' + EMP_ID + '">'
            + fItem('合同编号', '<input class="layui-input" name="ContractNo" value="' + esc(d.ContractNo) + '" lay-verify="required">')
            + fItem('合同类型', '<select name="ContractType"><option value="">请选择</option>' + typeOpts + '</select>')
            + fRow2(fItem('开始日期', '<input type="date" class="layui-input" name="StartDate" value="' + esc(d.StartDate) + '">'),
                    fItem('结束日期', '<input type="date" class="layui-input" name="EndDate" value="' + esc(d.EndDate) + '">'))
            + fItem('签订日期', '<input type="date" class="layui-input" name="SignDate" value="' + esc(d.SignDate) + '">')
            + fItem('状态', '<select name="Status"><option value="0"' + (d.Status == 0 ? ' selected' : '') + '>履行中</option><option value="1"' + (d.Status == 1 ? ' selected' : '') + '>已终止</option><option value="2"' + (d.Status == 2 ? ' selected' : '') + '>已到期</option></select>')
            + fItem('附件', '<input type="file" name="file" class="layui-input">')
            + fItem('备注', '<textarea class="layui-textarea" name="Remark">' + esc(d.Remark) + '</textarea>')
            + '</form>';
        var idx = layer.open({ type: 1, title: d.Id ? '编辑合同' : '新增合同', skin: 'ems-layer', area: ['620px', 'auto'],
            btn: ['保存', '取消'], content: html, success: function () { form.render(); },
            yes: function () { postForm('#contractForm', '/hr/employee/archive/contract/save', 'contractTable', idx); } });
    }

    /* ===== 证书弹窗 ===== */
    function openCertForm(d) {
        d = d || {};
        var typeOpts = (certTypes || []).map(function (t) {
            return '<option value="' + esc(t.DictValue) + '"' + (t.DictValue == d.CertType ? ' selected' : '') + '>' + esc(t.DictLabel) + '</option>';
        }).join('');
        var html = '<form class="layui-form ems-archive-form" id="certForm" style="padding:15px;">'
            + '<input type="hidden" name="Id" value="' + (d.Id || 0) + '">'
            + '<input type="hidden" name="EmployeeId" value="' + EMP_ID + '">'
            + fItem('证书名称', '<input class="layui-input" name="CertName" value="' + esc(d.CertName) + '" lay-verify="required">')
            + fItem('证书类型', '<select name="CertType"><option value="">请选择</option>' + typeOpts + '</select>')
            + fRow2(fItem('编号', '<input class="layui-input" name="CertNo" value="' + esc(d.CertNo) + '">'),
                    fItem('颁发机构', '<input class="layui-input" name="IssueOrg" value="' + esc(d.IssueOrg) + '">'))
            + fRow2(fItem('颁发日期', '<input type="date" class="layui-input" name="IssueDate" value="' + esc(d.IssueDate) + '">'),
                    fItem('有效期至', '<input type="date" class="layui-input" name="ExpireDate" value="' + esc(d.ExpireDate) + '">'))
            + fItem('状态', '<select name="Status"><option value="0"' + (d.Status == 0 ? ' selected' : '') + '>有效</option><option value="1"' + (d.Status == 1 ? ' selected' : '') + '>已过期</option></select>')
            + fItem('附件', '<input type="file" name="file" class="layui-input">')
            + '</form>';
        var idx = layer.open({ type: 1, title: d.Id ? '编辑证书' : '新增证书', skin: 'ems-layer', area: ['620px', 'auto'],
            btn: ['保存', '取消'], content: html, success: function () { form.render(); },
            yes: function () { postForm('#certForm', '/hr/employee/archive/cert/save', 'certTable', idx); } });
    }

    /* ===== 教育弹窗 ===== */
    function openEduForm(d) {
        d = d || {};
        var html = '<form class="layui-form ems-archive-form" id="eduForm" style="padding:15px;">'
            + '<input type="hidden" name="Id" value="' + (d.Id || 0) + '">'
            + '<input type="hidden" name="EmployeeId" value="' + EMP_ID + '">'
            + fItem('学校', '<input class="layui-input" name="SchoolName" value="' + esc(d.SchoolName) + '" lay-verify="required">')
            + fRow2(fItem('专业', '<input class="layui-input" name="Major" value="' + esc(d.Major) + '">'),
                    fItem('学位', '<input class="layui-input" name="Degree" value="' + esc(d.Degree) + '">'))
            + fRow2(fItem('开始', '<input type="date" class="layui-input" name="StartDate" value="' + esc(d.StartDate) + '">'),
                    fItem('结束', '<input type="date" class="layui-input" name="EndDate" value="' + esc(d.EndDate) + '">'))
            + fItem('全日制', '<input type="checkbox" name="IsFullTime" value="true" title="是" ' + (d.IsFullTime === '是' || d.IsFullTime === true ? 'checked' : '') + '>')
            + fItem('备注', '<textarea class="layui-textarea" name="Remark">' + esc(d.Remark) + '</textarea>')
            + '</form>';
        var idx = layer.open({ type: 1, title: d.Id ? '编辑教育经历' : '新增教育经历', skin: 'ems-layer', area: ['620px', 'auto'],
            btn: ['保存', '取消'], content: html, success: function () { form.render(); },
            yes: function () { postForm('#eduForm', '/hr/employee/archive/edu/save', 'eduTable', idx); } });
    }

    /* ===== 工作弹窗 ===== */
    function openWorkForm(d) {
        d = d || {};
        var html = '<form class="layui-form ems-archive-form" id="workForm" style="padding:15px;">'
            + '<input type="hidden" name="Id" value="' + (d.Id || 0) + '">'
            + '<input type="hidden" name="EmployeeId" value="' + EMP_ID + '">'
            + fItem('公司', '<input class="layui-input" name="CompanyName" value="' + esc(d.CompanyName) + '" lay-verify="required">')
            + fItem('职位', '<input class="layui-input" name="Position" value="' + esc(d.Position) + '">')
            + fRow2(fItem('开始', '<input type="date" class="layui-input" name="StartDate" value="' + esc(d.StartDate) + '">'),
                    fItem('结束', '<input type="date" class="layui-input" name="EndDate" value="' + esc(d.EndDate) + '">'))
            + fItem('备注', '<textarea class="layui-textarea" name="Remark">' + esc(d.Remark) + '</textarea>')
            + '</form>';
        var idx = layer.open({ type: 1, title: d.Id ? '编辑工作经历' : '新增工作经历', skin: 'ems-layer', area: ['620px', 'auto'],
            btn: ['保存', '取消'], content: html, success: function () { form.render(); },
            yes: function () { postForm('#workForm', '/hr/employee/archive/work/save', 'workTable', idx); } });
    }

    /* ===== 附件上传弹窗 ===== */
    function openAttachForm() {
        var html = '<form class="layui-form ems-archive-form" id="attachForm" style="padding:15px;">'
            + '<div class="layui-form-item"><label class="layui-form-label">选择文件</label><div class="layui-input-block"><input type="file" name="file" class="layui-input" lay-verify="required"></div></div>'
            + '<div class="layui-form-item layui-form-text"><label class="layui-form-label">备注</label><div class="layui-input-block"><textarea class="layui-textarea" name="Remark"></textarea></div></div>'
            + '</form>';
        var idx = layer.open({ type: 1, title: '上传附件', skin: 'ems-layer', area: ['520px', 'auto'],
            btn: ['上传', '取消'], content: html, success: function () { form.render(); },
            yes: function () {
                var fd = new FormData(document.getElementById('attachForm'));
                fd.append('EmployeeId', EMP_ID);
                postFormData('/hr/employee/archive/attach/upload', fd, function () { ems.reloadTable('attachTable', null, false); }, idx);
            } });
    }

    /* ===== 通用辅助 ===== */
    function fItem(label, control) {
        return '<div class="layui-form-item"><label class="layui-form-label">' + label + '</label><div class="layui-input-block">' + control + '</div></div>';
    }
    function fRow2(a, b) {
        return '<div class="layui-row layui-col-space10"><div class="layui-col-md6">' + a + '</div><div class="layui-col-md6">' + b + '</div></div>';
    }
    function fRadio(label, name, opts) {
        var s = opts.map(function (o) { return '<input type="radio" name="' + name + '" value="' + o[0] + '" title="' + o[1] + '"' + (o[2] ? ' checked' : '') + '>'; }).join('');
        return '<div class="layui-form-item"><label class="layui-form-label">' + label + '</label><div class="layui-input-block">' + s + '</div></div>';
    }
    function esc(s) { return ems.escapeHtml(s == null ? '' : s); }
    function contractStatus(d) {
        var m = { 0: ['履行中', 'green'], 1: ['已终止', 'gray'], 2: ['已到期', 'orange'] };
        var h = m[d.Status] || ['未知', 'gray'];
        return '<span class="layui-badge layui-bg-' + h[1] + '">' + h[0] + '</span>';
    }
    function certStatus(d) {
        var m = { 0: ['有效', 'green'], 1: ['已过期', 'orange'] };
        var h = m[d.Status] || ['未知', 'gray'];
        return '<span class="layui-badge layui-bg-' + h[1] + '">' + h[0] + '</span>';
    }
    function fmtSize(d) {
        var n = d.FileSize || 0;
        if (n < 1024) return n + ' B';
        if (n < 1024 * 1024) return (n / 1024).toFixed(1) + ' KB';
        return (n / 1024 / 1024).toFixed(1) + ' MB';
    }
    function flattenDepts(tree, prefix) {
        var out = [];
        (Array.isArray(tree) ? tree : []).forEach(function (n) {
            out.push({ id: n.Id, name: (prefix ? prefix + ' / ' : '') + n.DeptName });
            if (n.Children && n.Children.length) out = out.concat(flattenDepts(n.Children, (prefix ? prefix + ' / ' : '') + n.DeptName));
        });
        return out;
    }
    function token() {
        return $('input[name="__RequestVerificationToken"]').first().val() || '';
    }
    // 表单（含文件）提交
    function postForm(formSel, url, tableId, layerIdx) {
        var fd = new FormData($(formSel)[0]);
        postFormData(url, fd, function () { ems.reloadTable(tableId, null, false); }, layerIdx);
    }
    function postFormData(url, fd, done, layerIdx) {
        $.ajax({
            url: url, type: 'POST', data: fd, processData: false, contentType: false,
            headers: { 'RequestVerificationToken': token() },
            success: function (res) {
                if (res && (res.success === true || res.code === 200)) {
                    if (layerIdx) layer.close(layerIdx);
                    ems.success(res.message || '操作成功', function () { if (done) done(res); });
                } else { ems.error((res && res.message) || '操作失败'); }
            },
            error: function () { ems.error('网络请求失败'); }
        });
    }
});
</script>
