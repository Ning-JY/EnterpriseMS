@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Domain.Entities.Hr
@using System.Text.Json
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@model Employee
@{
    ViewData["Title"] = Model.RealName + " - 员工详情";
    var userId  = User.GetUserId();
    bool canEdit   = await PermSvc.HasPermAsync(userId, "hr:employee:edit");
    var statusText = new Dictionary<int, string> { { 0, "试用期" }, { 1, "在职" }, { 2, "离职" } };
    var statusTag  = new Dictionary<int, string> { { 0, "orange" }, { 1, "green" }, { 2, "gray" } };
    var initial = string.IsNullOrEmpty(Model.RealName) ? "?" : Model.RealName.Substring(0, 1);

    // 档案完整度（按字段填充率）
    var fillFields = new List<string?>
    {
        Model.IdCard, Model.Phone, Model.Email, Model.Dept?.DeptName, Model.Post?.PostName,
        Model.EntryDate?.ToString("yyyy-MM-dd"), Model.Education, Model.Nationality,
        Model.BirthDate?.ToString("yyyy-MM-dd"), Model.PoliticalStatus, Model.NativePlace,
        Model.Address, Model.HighestDegree, Model.GraduateSchool, Model.Major,
        Model.WorkStartDate?.ToString("yyyy-MM-dd"), Model.TechnicalTitle, Model.TechnicalLevel,
        Model.EmergencyContact, Model.EmergencyPhone, Model.BankAccount, Model.BankName,
        Model.SocialInsuranceNo, Model.ProfilePhoto, Model.Remark
    };
    int fillCnt = fillFields.Count(f => !string.IsNullOrWhiteSpace(f));
    int fillPct = fillFields.Count == 0 ? 0 : (int)Math.Round(fillCnt * 100.0 / fillFields.Count);

    // 序列化下拉数据源供前端弹窗使用
    var contractTypes = ViewBag.ContractTypes as List<EnterpriseMS.Services.DTOs.System.DictDataDto> ?? new();
    var certTypes     = ViewBag.CertTypes as List<EnterpriseMS.Services.DTOs.System.DictDataDto> ?? new();
    var deptTree      = ViewBag.Depts as object ?? new object();
    var postList      = ViewBag.Posts as List<SysPost> ?? new();
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-user"></i> 员工详情
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">HR管理</a>
        <a href="javascript:ems.openTab('/hr/employee')">员工信息</a>
        <a><cite>@Model.RealName</cite></a>
    </div>
</div>

<!-- 详情头部 -->
<div class="ems-detail-header">
    <div class="ems-detail-avatar @(canEdit ? "ems-avatar-edit" : "")" id="avatarBox" title="@(canEdit ? "点击上传头像" : "")">
        @if (!string.IsNullOrEmpty(Model.ProfilePhoto))
        {
            <img src="/hr/employee/avatar/@Model.Id" class="ems-avatar-img" alt="@Model.RealName">
        }
        else
        {
            <span class="ems-avatar-initial">@initial</span>
        }
    </div>
    <input type="file" id="avatarFile" accept="image/*" style="display:none">
    <div class="ems-detail-info">
        <h2>@Model.RealName <span class="layui-badge-rim">@Model.EmpNo</span></h2>
        <div class="ems-detail-meta">
            <span>@(Model.Dept?.DeptName ?? "未分配部门")</span>
            <span>@(Model.Gender == 1 ? "男" : "女")</span>
            <span class="ems-tag ems-tag-@statusTag.GetValueOrDefault(Model.Status, "gray")">@statusText.GetValueOrDefault(Model.Status, "未知")</span>
            <span>入职：@(Model.EntryDate?.ToString("yyyy-MM-dd") ?? "-")</span>
            @if (Model.FormalDate.HasValue) { <span>转正：@Model.FormalDate.Value.ToString("yyyy-MM-dd")</span> }
        </div>
    </div>
    <div class="ems-ring" style="--p:@fillPct"><span class="ems-ring-text">@fillPct%</span></div>
    <div class="ems-ring-label">档案<br>完整度</div>
    <div class="ems-detail-actions">
        @if (canEdit) { <a class="layui-btn layui-btn-normal layui-btn-sm" href="javascript:ems.openTab('/hr/employee/edit/@Model.Id', '编辑员工档案')"><i class="layui-icon layui-icon-edit"></i> 编辑档案</a> }
        <a class="layui-btn layui-btn-primary layui-btn-sm" href="javascript:ems.openTab('/hr/employee', '员工信息')"><i class="layui-icon layui-icon-return"></i> 返回</a>
    </div>
</div>

<!-- 三卡片并排：基本信息 / 任职信息 / 学历信息 -->
<div class="ems-card-row">
    <div class="ems-info-card">
        <div class="ems-info-card-title">
            基本信息
            @if (canEdit) { <a class="ems-card-edit" data-card="basic" title="编辑基本信息"><i class="layui-icon layui-icon-edit"></i>编辑</a> }
        </div>
        <div class="ems-info-list">
            <div class="ems-info-item"><span class="label">姓名</span><span class="val"><strong>@Model.RealName</strong></span></div>
            <div class="ems-info-item"><span class="label">工号</span><span class="val">@Model.EmpNo</span></div>
            <div class="ems-info-item"><span class="label">性别</span><span class="val">@(Model.Gender == 1 ? "男" : "女")</span></div>
            <div class="ems-info-item"><span class="label">身份证</span><span class="val">@(Model.IdCard ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">手机号</span><span class="val">@(Model.Phone ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">邮箱</span><span class="val">@(Model.Email ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">民族</span><span class="val">@(Model.Nationality ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">出生日期</span><span class="val">@(Model.BirthDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">籍贯</span><span class="val">@(Model.NativePlace ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">政治面貌</span><span class="val">@(Model.PoliticalStatus ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">住址</span><span class="val">@(Model.Address ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">紧急联系</span><span class="val">@(Model.EmergencyContact ?? "-") @(Model.EmergencyPhone ?? "")</span></div>
        </div>
    </div>
    <div class="ems-info-card">
        <div class="ems-info-card-title">
            任职信息
            @if (canEdit) { <a class="ems-card-edit" data-card="job" title="编辑任职信息"><i class="layui-icon layui-icon-edit"></i>编辑</a> }
        </div>
        <div class="ems-info-list">
            <div class="ems-info-item"><span class="label">部门</span><span class="val">@(Model.Dept?.DeptName ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">岗位</span><span class="val">@(Model.Post?.PostName ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">入职日期</span><span class="val">@(Model.EntryDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">试用期截止</span><span class="val">@(Model.ProbationEndDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">转正日期</span><span class="val">@(Model.FormalDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">参加工作</span><span class="val">@(Model.WorkStartDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">社保号</span><span class="val">@(Model.SocialInsuranceNo ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">银行账号</span><span class="val">@(Model.BankAccount ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">开户行</span><span class="val">@(Model.BankName ?? "-")</span></div>
        </div>
    </div>
    <div class="ems-info-card">
        <div class="ems-info-card-title">
            学历信息
            @if (canEdit) { <a class="ems-card-edit" data-card="education" title="编辑学历信息"><i class="layui-icon layui-icon-edit"></i>编辑</a> }
        </div>
        <div class="ems-info-list">
            <div class="ems-info-item"><span class="label">学历</span><span class="val">@(Model.Education ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">学位</span><span class="val">@(Model.HighestDegree ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">毕业院校</span><span class="val">@(Model.GraduateSchool ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">专业</span><span class="val">@(Model.Major ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">技术职称</span><span class="val">@(Model.TechnicalTitle ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">技术等级</span><span class="val">@(Model.TechnicalLevel ?? "-")</span></div>
        </div>
    </div>
</div>

<!-- Tabs：合同 / 证书 / 教育 / 工作 / 附件 -->
<div class="ems-detail-tabs">
    <div class="layui-tab layui-tab-brief">
        <ul class="layui-tab-title">
            <li class="layui-this">合同信息</li>
            <li>证书资质</li>
            <li>教育经历</li>
            <li>工作经历</li>
            <li>附件管理</li>
        </ul>
        <div class="layui-tab-content">
            <!-- 合同信息 -->
            <div class="layui-tab-item layui-show">
                <div class="flex-between">
                    <strong>合同信息</strong>
                    @if (canEdit) { <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnAddContract"><i class="layui-icon layui-icon-add-1"></i>新增合同</button> }
                </div>
                <table id="contractTable" lay-filter="contractTable"></table>
            </div>
            <!-- 证书资质 -->
            <div class="layui-tab-item">
                <div class="flex-between">
                    <strong>证书资质</strong>
                    @if (canEdit) { <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnAddCert"><i class="layui-icon layui-icon-add-1"></i>新增证书</button> }
                </div>
                <table id="certTable" lay-filter="certTable"></table>
            </div>
            <!-- 教育经历 -->
            <div class="layui-tab-item">
                <div class="flex-between">
                    <strong>教育经历</strong>
                    @if (canEdit) { <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnAddEdu"><i class="layui-icon layui-icon-add-1"></i>新增经历</button> }
                </div>
                <table id="eduTable" lay-filter="eduTable"></table>
            </div>
            <!-- 工作经历 -->
            <div class="layui-tab-item">
                <div class="flex-between">
                    <strong>工作经历</strong>
                    @if (canEdit) { <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnAddWork"><i class="layui-icon layui-icon-add-1"></i>新增经历</button> }
                </div>
                <table id="workTable" lay-filter="workTable"></table>
            </div>
            <!-- 附件管理 -->
            <div class="layui-tab-item">
                <div class="flex-between">
                    <strong>附件管理</strong>
                    @if (canEdit) { <button class="layui-btn layui-btn-sm layui-btn-normal" id="btnAddAttach"><i class="layui-icon layui-icon-upload"></i>上传附件</button> }
                </div>
                <table id="attachTable" lay-filter="attachTable"></table>
            </div>
        </div>
    </div>
</div>

<!-- 行内工具条模板 -->
<script type="text/html" id="contractBar">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    {{# if(d.HasFile){ }}<a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="preview">预览</a><a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="download">下载</a>{{# } }}
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="certBar">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    {{# if(d.HasFile){ }}<a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="preview">预览</a><a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="download">下载</a>{{# } }}
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="eduBar">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="workBar">
    <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>
<script type="text/html" id="attachBar">
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="preview">预览</a>
    <a class="layui-btn layui-btn-xs layui-btn-normal" lay-event="download">下载</a>
    <a class="layui-btn layui-btn-xs layui-btn-danger" lay-event="del">删除</a>
</script>

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery, form = layui.form, element = layui.element;
    if (element) element.render();
    var EMP_ID = @Model.Id;
    var canEdit = @canEdit.ToString().ToLower();
    // 下拉数据源
    var contractTypes = @Html.Raw(JsonSerializer.Serialize(contractTypes));
    var certTypes     = @Html.Raw(JsonSerializer.Serialize(certTypes));
    var deptTree      = @Html.Raw(JsonSerializer.Serialize(deptTree));
    var postList      = @Html.Raw(JsonSerializer.Serialize(postList));

    /* ===== 头像上传 ===== */
    $('#avatarBox').on('click', function () {
        if (!canEdit) return;
        $('#avatarFile').trigger('click');
    });
    $('#avatarFile').on('change', function () {
        var f = this.files[0];
        if (!f) return;
        var fd = new FormData();
        fd.append('id', EMP_ID);
        fd.append('file', f);
        postFormData('/hr/employee/avatar-upload', fd, function () {
            $('#avatarBox').html('<img src="/hr/employee/avatar/' + EMP_ID + '?t=' + Date.now() + '" class="ems-avatar-img">');
        });
        this.value = '';
    });

    /* ===== 卡片内编辑 ===== */
    var cardIdx = {};
    $('.ems-card-edit').on('click', function () {
        var card = $(this).data('card');
        openCardEdit(card);
    });

    function openCardEdit(card) {
        ems.get('/hr/employee/full/' + EMP_ID, function (d) {
            var title = { basic: '编辑基本信息', job: '编辑任职信息', education: '编辑学历信息' }[card];
            var html = card === 'basic' ? basicForm(d)
                     : card === 'job'   ? jobForm(d)
                     : educationForm(d);
            cardIdx[card] = layer.open({
                type: 1, title: title, skin: 'ems-layer', area: ['640px', 'auto'],
                btn: ['保存', '取消'], content: html,
                success: function () { form.render(); },
                yes: function () { submitCard(card); }
            });
        });
    }

    function basicForm(d) {
        return '<form class="layui-form ems-card-form" style="padding:15px;">'
            + fItem('姓名', '<input class="layui-input" id="basic_RealName" value="' + esc(d.RealName) + '">')
            + fRadio('性别', 'basic_Gender', [['1', '男', d.Gender == 1], ['2', '女', d.Gender == 2]])
            + fItem('手机号', '<input class="layui-input" id="basic_Phone" value="' + esc(d.Phone) + '">')
            + fItem('邮箱', '<input class="layui-input" id="basic_Email" value="' + esc(d.Email) + '">')
            + fItem('身份证号', '<input class="layui-input" maxlength="18" id="basic_IdCard" value="' + esc(d.IdCard) + '">')
            + fItem('民族', '<input class="layui-input" id="basic_Nationality" value="' + esc(d.Nationality) + '">')
            + fItem('出生日期', '<input type="date" class="layui-input" id="basic_BirthDate" value="' + esc(d.BirthDate) + '">')
            + fItem('籍贯', '<input class="layui-input" id="basic_NativePlace" value="' + esc(d.NativePlace) + '">')
            + fItem('政治面貌', '<input class="layui-input" id="basic_PoliticalStatus" value="' + esc(d.PoliticalStatus) + '">')
            + fItem('住址', '<input class="layui-input" id="basic_Address" value="' + esc(d.Address) + '">')
            + fItem('紧急联系人', '<input class="layui-input" id="basic_EmergencyContact" value="' + esc(d.EmergencyContact) + '">')
            + fItem('紧急电话', '<input class="layui-input" id="basic_EmergencyPhone" value="' + esc(d.EmergencyPhone) + '">')
            + '</form>';
    }

    function jobForm(d) {
        var deptOpts = '<option value="">请选择部门</option>' + flattenDepts(deptTree, '').map(function (o) {
            return '<option value="' + o.id + '"' + (o.id == d.DeptId ? ' selected' : '') + '>' + esc(o.name) + '</option>';
        }).join('');
        var postOpts = '<option value="">请选择岗位</option>' + (postList || []).map(function (p) {
            return '<option value="' + p.Id + '"' + (p.Id == d.PostId ? ' selected' : '') + '>' + esc(p.PostName) + '</option>';
        }).join('');
        return '<form class="layui-form ems-card-form" style="padding:15px;">'
            + fItem('部门', '<select id="job_DeptId">' + deptOpts + '</select>')
            + fItem('岗位', '<select id="job_PostId">' + postOpts + '</select>')
            + fItem('入职日期', '<input type="date" class="layui-input" id="job_EntryDate" value="' + esc(d.EntryDate) + '">')
            + fItem('试用期截止', '<input type="date" class="layui-input" id="job_ProbationEndDate" value="' + esc(d.ProbationEndDate) + '">')
            + fItem('转正日期', '<input type="date" class="layui-input" id="job_FormalDate" value="' + esc(d.FormalDate) + '">')
            + fItem('参加工作', '<input type="date" class="layui-input" id="job_WorkStartDate" value="' + esc(d.WorkStartDate) + '">')
            + fItem('社保号', '<input class="layui-input" id="job_SocialInsuranceNo" value="' + esc(d.SocialInsuranceNo) + '">')
            + fItem('银行账号', '<input class="layui-input" id="job_BankAccount" value="' + esc(d.BankAccount) + '">')
            + fItem('开户行', '<input class="layui-input" id="job_BankName" value="' + esc(d.BankName) + '">')
            + '</form>';
    }

    function educationForm(d) {
        return '<form class="layui-form ems-card-form" style="padding:15px;">'
            + fItem('学历', '<input class="layui-input" id="edu_Education" value="' + esc(d.Education) + '">')
            + fItem('学位', '<input class="layui-input" id="edu_HighestDegree" value="' + esc(d.HighestDegree) + '">')
            + fItem('毕业院校', '<input class="layui-input" id="edu_GraduateSchool" value="' + esc(d.GraduateSchool) + '">')
            + fItem('专业', '<input class="layui-input" id="edu_Major" value="' + esc(d.Major) + '">')
            + fItem('技术职称', '<input class="layui-input" id="edu_TechnicalTitle" value="' + esc(d.TechnicalTitle) + '">')
            + fItem('技术等级', '<input class="layui-input" id="edu_TechnicalLevel" value="' + esc(d.TechnicalLevel) + '">')
            + '</form>';
    }

    function submitCard(card) {
        var data = { Id: EMP_ID }, url;
        if (card === 'basic') {
            data.RealName = $('#basic_RealName').val();
            data.Gender = parseInt($('input[name=basic_Gender]:checked').val() || '1');
            data.Phone = $('#basic_Phone').val() || null;
            data.Email = $('#basic_Email').val() || null;
            data.IdCard = $('#basic_IdCard').val() || null;
            data.Nationality = $('#basic_Nationality').val() || null;
            data.BirthDate = $('#basic_BirthDate').val() || null;
            data.NativePlace = $('#basic_NativePlace').val() || null;
            data.PoliticalStatus = $('#basic_PoliticalStatus').val() || null;
            data.Address = $('#basic_Address').val() || null;
            data.EmergencyContact = $('#basic_EmergencyContact').val() || null;
            data.EmergencyPhone = $('#basic_EmergencyPhone').val() || null;
            url = '/hr/employee/update-basic';
        } else if (card === 'job') {
            data.DeptId = parseInt($('#job_DeptId').val()) || null;
            data.PostId = parseInt($('#job_PostId').val()) || null;
            data.EntryDate = $('#job_EntryDate').val() || null;
            data.ProbationEndDate = $('#job_ProbationEndDate').val() || null;
            data.FormalDate = $('#job_FormalDate').val() || null;
            data.WorkStartDate = $('#job_WorkStartDate').val() || null;
            data.SocialInsuranceNo = $('#job_SocialInsuranceNo').val() || null;
            data.BankAccount = $('#job_BankAccount').val() || null;
            data.BankName = $('#job_BankName').val() || null;
            url = '/hr/employee/update-job';
        } else {
            data.Education = $('#edu_Education').val() || null;
            data.HighestDegree = $('#edu_HighestDegree').val() || null;
            data.GraduateSchool = $('#edu_GraduateSchool').val() || null;
            data.Major = $('#edu_Major').val() || null;
            data.TechnicalTitle = $('#edu_TechnicalTitle').val() || null;
            data.TechnicalLevel = $('#edu_TechnicalLevel').val() || null;
            url = '/hr/employee/update-education';
        }
        ems.post({
            url: url, data: data,
            done: function () { layer.close(cardIdx[card]); ems.openTab('/hr/employee/detail/' + EMP_ID, '@Model.RealName 详情'); }
        });
    }

    /* ===== 5 个 Tab 表格 ===== */
    ems.initTable({
        elem: '#contractTable', id: 'contractTable', page: false,
        url: '/hr/employee/archive/contract/list/' + EMP_ID,
        cols: [[
            { field: 'ContractNo', title: '合同编号', minWidth: 120 },
            { field: 'ContractType', title: '类型', minWidth: 90 },
            { title: '起止日期', templet: function (d) { return d.StartDate + ' ~ ' + d.EndDate; }, minWidth: 180 },
            { field: 'Status', title: '状态', templet: contractStatus, width: 90 },
            { field: 'FileName', title: '附件', templet: function (d) { return d.FileName || '-'; }, minWidth: 120 },
            { title: '操作', templet: '#contractBar', width: 150, fixed: 'right' }
        ]],
        tool: {
            edit: function (d) { openContractForm(d); },
            preview: function (d) { ems.preview(d.DownloadUrl + '?inline=1', d.FileName); },
            download: function (d) { ems.download(d.DownloadUrl); },
            del: function (d) { ems.del({ url: '/hr/employee/archive/contract/delete/' + d.Id, name: d.ContractNo, table: 'contractTable' }); }
        }
    });

    ems.initTable({
