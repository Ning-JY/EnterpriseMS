@section Scripts {
<script>
var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
var empId = @Model.Id;

// custom-file-input 显示文件名
document.addEventListener('change', function(e) {
    if (e.target.classList.contains('custom-file-input')) {
        var label = e.target.nextElementSibling;
        if (label) label.textContent = e.target.files[0]?.name ?? '选择文件';
    }
});

function openEditModal() {
    $('#editEmpModal').modal('show');
}

function saveEdit() {
    var data = {
        Id:       empId,
        RealName: $('#editRealName').val(),
        Gender:   parseInt($('#editGender').val()),
        Phone:    $('#editPhone').val(),
        Email:    $('#editEmail').val(),
        IdCard:   $('#editIdCard').val(),
        DeptId:   parseInt($('#editDeptId').val()) || null,
        EntryDate: $('#editEntryDate').val() || null,
        Remark:   $('#editRemark').val(),
        // 回传扩展字段，避免快捷编辑时清空人事档案数据
        BirthDate:       '@(Model.BirthDate?.ToString("yyyy-MM-dd") ?? "")' || null,
        NativePlace:     '@(Model.NativePlace ?? "")' || null,
        Education:       '@(Model.Education ?? "")' || null,
        Major:           '@(Model.Major ?? "")' || null,
        GraduateSchool:  '@(Model.GraduateSchool ?? "")' || null,
        EmergencyContact:'@(Model.EmergencyContact ?? "")' || null,
        EmergencyPhone:  '@(Model.EmergencyPhone ?? "")' || null,
        Address:         '@(Model.Address ?? "")' || null,
        BankAccount:     '@(Model.BankAccount ?? "")' || null,
        BankName:        '@(Model.BankName ?? "")' || null,
        Nationality:     '@(Model.Nationality ?? "")' || null,
        PoliticalStatus: '@(Model.PoliticalStatus ?? "")' || null,
        HighestDegree:   '@(Model.HighestDegree ?? "")' || null,
        WorkStartDate:   '@(Model.WorkStartDate?.ToString("yyyy-MM-dd") ?? "")' || null,
        TechnicalTitle:  '@(Model.TechnicalTitle ?? "")' || null,
        TechnicalLevel:  '@(Model.TechnicalLevel ?? "")' || null,
        SocialInsuranceNo:'@(Model.SocialInsuranceNo ?? "")' || null,
        ProfilePhoto:    '@(Model.ProfilePhoto ?? "")' || null,
    };
    if (!data.RealName) { ems.msg('请填写姓名', {icon:2}); return; }
    ajaxPost('/hr/employee/update', data, function(r) {
        ems.msg(r.message, {icon:1, time:1500}, function() { location.reload(); });
    });
}

function doFormal() {
    var today = new Date().toISOString().split('T')[0];
    ems.open({
        type: 1, title: '办理转正', area: ['350px', '180px'],
        content: '<div class="form-group" style="padding:15px"><label>转正日期</label><input type="date" id="formalDate" class="form-control" value="' + today + '"></div>',
        btn: ['确认转正', '取消'],
        yes: function(idx) {
            var val = $('#formalDate').val();
            if (!val) { ems.msg('请选择日期', {icon:2}); return; }
            $.post('/hr/employee/formal', { id: empId, formalDate: val, __RequestVerificationToken: antiForgery },
                function(r) {
                    ems.close(idx);
                    ems.msg(r.message, { icon: r.success ? 1 : 2, time: 1500 },
                        function() { if (r.success) location.reload(); });
                });
        }
    });
}

function doLeave() {
    var today = new Date().toISOString().split('T')[0];
    ems.open({
        type: 1, title: '办理离职', area: ['350px', '180px'],
        content: '<div class="form-group" style="padding:15px"><label>离职日期</label><input type="date" id="leaveDate" class="form-control" value="' + today + '"></div>',
        btn: ['确认离职', '取消'],
        yes: function(idx) {
            var val = $('#leaveDate').val();
            if (!val) { ems.msg('请选择日期', {icon:2}); return; }
            $.post('/hr/employee/leave', { id: empId, leaveDate: val, __RequestVerificationToken: antiForgery },
                function(r) {
                    ems.close(idx);
                    ems.msg(r.message, { icon: r.success ? 1 : 2, time: 1500 },
                        function() { if (r.success) location.reload(); });
                });
        }
    });
}

function uploadContractFile(contractId, input) {
    if (!input.files[0]) return;
    var formData = new FormData();
    formData.append('file', input.files[0]);
    var load = ems.loading(1);
    $.ajax({
        url: '/hr/contract/upload/' + contractId, type: 'POST',
        data: formData, processData: false, contentType: false,
        headers: { 'RequestVerificationToken': antiForgery },
        success: function(r) {
            ems.close(load);
            ems.msg(r.message, { icon: r.success ? 1 : 2, time: 1500 },
                function() { if (r.success) location.reload(); });
        }
    });
}

function uploadCertFile(certId, input) {
    if (!input.files[0]) return;
    var formData = new FormData();
    formData.append('file', input.files[0]);
    var load = ems.loading(1);
    $.ajax({
        url: '/hr/cert/upload/' + certId, type: 'POST',
        data: formData, processData: false, contentType: false,
        headers: { 'RequestVerificationToken': antiForgery },
        success: function(r) {
            ems.close(load);
            ems.msg(r.message, { icon: r.success ? 1 : 2, time: 1500 },
                function() { if (r.success) location.reload(); });
        }
    });
}

// 统一删除附件（合同/证书）
function deleteAttachment(type, id) {
    var url = type === "contract"
        ? "/hr/contract/file/delete/" + id
        : "/hr/cert/file/delete/" + id;
    ems.confirm("确认删除附件？记录本身将保留。",
        {icon:3, btn:["确认删除","取消"]}, function(i) {
        ems.close(i);
        $.post(url, {__RequestVerificationToken: antiForgery},
            function(r) { handleResult(r, ()=>location.reload()); });
    });
}

// ── 新增合同 ────────────────────────────────────────────────
function openAddContractModal() {
    $('#ctNo,#ctRemark').val('');
    var today = new Date().toISOString().split('T')[0];
    $('#ctStart').val(today);
    var next = new Date(); next.setFullYear(next.getFullYear()+1);
    $('#ctEnd').val(next.toISOString().split('T')[0]);
    $('#ctSign').val(today);
    document.getElementById('ctFile').value = '';
    document.querySelector('label[for="ctFile"]').textContent = '选择文件（可选）';
    $('#addContractModal').modal('show');
}

function saveEmpContract() {
    var no = $('#ctNo').val(), start = $('#ctStart').val(), end = $('#ctEnd').val();
    if (!no || !start || !end) { ems.msg('请填写合同编号和起止日期', {icon:2}); return; }
    var fd = new FormData();
    fd.append('EmployeeId', empId);
    fd.append('ContractNo', no);
    fd.append('ContractType', $('#ctType').val());
    fd.append('StartDate', start);
    fd.append('EndDate', end);
    if ($('#ctSign').val()) fd.append('SignDate', $('#ctSign').val());
    fd.append('Remark', $('#ctRemark').val());
    var file = document.getElementById('ctFile').files[0];
    if (file) fd.append('file', file);

    $('#ctSaveBtn').prop('disabled', true);
    var load = ems.loading(1);
    $.ajax({ url: '/hr/contract/create-with-file', type: 'POST',
        data: fd, processData: false, contentType: false,
        headers: { 'RequestVerificationToken': antiForgery },
        success: function(r) {
            ems.close(load); $('#ctSaveBtn').prop('disabled', false);
            if (r.success) { $('#addContractModal').modal('hide'); location.reload(); }
            else ems.msg(r.message, {icon:2});
        }
    });
}

// ── 新增证书 ────────────────────────────────────────────────
function openAddCertModal() {
    ['#certName2,#certNo2,#certOrg2,#certIssue2,#certExpire2'].forEach(function(s){
        $(s).val('');
    });
    $('#certName2,#certNo2,#certOrg2').val('');
    $('#certIssue2,#certExpire2').val('');
    document.getElementById('certFile2').value = '';
    document.querySelector('label[for="certFile2"]').textContent = '选择文件（可选）';
    $('#addCertModal').modal('show');
}

function saveEmpCert() {
    var name = $('#certName2').val();
    if (!name) { ems.msg('请填写证书名称', {icon:2}); return; }
    var fd = new FormData();
    fd.append('EmployeeId', empId);
    fd.append('CertName', name);
    fd.append('CertType', $('#certType2').val());
    if ($('#certNo2').val())     fd.append('CertNo',    $('#certNo2').val());
    if ($('#certOrg2').val())    fd.append('IssueOrg',  $('#certOrg2').val());
    if ($('#certIssue2').val())  fd.append('IssueDate', $('#certIssue2').val());
    if ($('#certExpire2').val()) fd.append('ExpireDate', $('#certExpire2').val());
    var file = document.getElementById('certFile2').files[0];
    if (file) fd.append('file', file);

    $('#certSaveBtn2').prop('disabled', true);
    var load = ems.loading(1);
    $.ajax({ url: '/hr/cert/create-with-file', type: 'POST',
        data: fd, processData: false, contentType: false,
        headers: { 'RequestVerificationToken': antiForgery },
        success: function(r) {
            ems.close(load); $('#certSaveBtn2').prop('disabled', false);
            if (r.success) { $('#addCertModal').modal('hide'); location.reload(); }
            else ems.msg(r.message, {icon:2});
        }
    });
}

// ── 教育经历 ────────────────────────────────────────────────
function openAddEduModal() {
    $('#eduId').val('');
    $('#eduSchool,#eduMajor,#eduDegree,#eduRemark').val('');
    $('#eduFull').val('1');
    var today = new Date().toISOString().split('T')[0];
    $('#eduStart').val(today);
    $('#eduEnd').val('');
    $('#eduModalTitle').text('新增教育经历');
    $('#eduModal').modal('show');
}

function openEditEduModal(btn) {
    $('#eduId').val($(btn).data('id'));
    $('#eduSchool').val($(btn).data('school') || '');
    $('#eduMajor').val($(btn).data('major') || '');
    $('#eduDegree').val($(btn).data('degree') || '');
    $('#eduFull').val($(btn).data('full') === '1' ? '1' : '0');
    $('#eduStart').val($(btn).data('start') || '');
    $('#eduEnd').val($(btn).data('end') || '');
    $('#eduRemark').val($(btn).data('remark') || '');
    $('#eduModalTitle').text('编辑教育经历');
    $('#eduModal').modal('show');
}

function saveEdu() {
    var school = $('#eduSchool').val(), major = $('#eduMajor').val(), degree = $('#eduDegree').val();
    if (!school || !major || !degree) { ems.msg('请填写学校、专业和学历', {icon:2}); return; }
    var id = $('#eduId').val();
    var dto = {
        SchoolName: school, Major: major, Degree: degree,
        StartDate: $('#eduStart').val() || null,
        EndDate:   $('#eduEnd').val() || null,
        IsFullTime: $('#eduFull').val() === '1',
        Remark:    $('#eduRemark').val(),
    };
    $('#eduSaveBtn').prop('disabled', true);
    var done = function(r) {
        $('#eduSaveBtn').prop('disabled', false);
        if (r && r.success) { $('#eduModal').modal('hide'); location.reload(); }
        else ems.msg((r && r.message) || '保存失败', {icon:2});
    };
    var fail = function(r) { $('#eduSaveBtn').prop('disabled', false); ems.msg((r && r.message) || '保存失败', {icon:2}); };
    if (id) { dto.Id = parseInt(id); ajaxPost('/hr/education/update', dto, done, fail); }
    else    { ajaxPost('/hr/education/create?employeeId=' + empId, dto, done, fail); }
}

function deleteEdu(id) {
    ems.confirm('确认删除该教育经历？', {icon:3, btn:['确认删除','取消']}, function(i) {
        ems.close(i);
        $.post('/hr/education/delete/' + id, {__RequestVerificationToken: antiForgery}, function(r) {
            if (r && r.success) location.reload();
            else ems.msg((r && r.message) || '删除失败', {icon:2});
        });
    });
}

// ── 工作经历 ────────────────────────────────────────────────
function openAddWorkModal() {
    $('#workId').val('');
    $('#workCompany,#workPosition,#workRemark').val('');
    var today = new Date().toISOString().split('T')[0];
    $('#workStart').val(today);
    $('#workEnd').val('');
    $('#workModalTitle').text('新增工作经历');
    $('#workModal').modal('show');
}

function openEditWorkModal(btn) {
    $('#workId').val($(btn).data('id'));
    $('#workCompany').val($(btn).data('company') || '');
    $('#workPosition').val($(btn).data('position') || '');
    $('#workStart').val($(btn).data('start') || '');
    $('#workEnd').val($(btn).data('end') || '');
    $('#workRemark').val($(btn).data('remark') || '');
    $('#workModalTitle').text('编辑工作经历');
    $('#workModal').modal('show');
}

function saveWork() {
    var company = $('#workCompany').val(), position = $('#workPosition').val();
    if (!company || !position) { ems.msg('请填写公司和职位', {icon:2}); return; }
    var id = $('#workId').val();
    var dto = {
        CompanyName: company, Position: position,
        StartDate: $('#workStart').val() || null,
        EndDate:   $('#workEnd').val() || null,
        Remark:    $('#workRemark').val(),
    };
    $('#workSaveBtn').prop('disabled', true);
    var done = function(r) {
        $('#workSaveBtn').prop('disabled', false);
        if (r && r.success) { $('#workModal').modal('hide'); location.reload(); }
        else ems.msg((r && r.message) || '保存失败', {icon:2});
    };
    var fail = function(r) { $('#workSaveBtn').prop('disabled', false); ems.msg((r && r.message) || '保存失败', {icon:2}); };
    if (id) { dto.Id = parseInt(id); ajaxPost('/hr/workexp/update', dto, done, fail); }
    else    { ajaxPost('/hr/workexp/create?employeeId=' + empId, dto, done, fail); }
}

function deleteWork(id) {
    ems.confirm('确认删除该工作经历？', {icon:3, btn:['确认删除','取消']}, function(i) {
        ems.close(i);
        $.post('/hr/workexp/delete/' + id, {__RequestVerificationToken: antiForgery}, function(r) {
            if (r && r.success) location.reload();
            else ems.msg((r && r.message) || '删除失败', {icon:2});
        });
    });
}
</script>
}
