@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Domain.Entities.Hr
@using EnterpriseMS.Services.DTOs.System
@model Employee
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = (Model.Id == 0 ? "新增员工" : "编辑员工 - " + Model.RealName);
    bool isEdit = Model.Id > 0;
    var statusMap = ViewBag.EmployeeStatusMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var posts = ViewBag.Posts as List<SysPost> ?? new();
    var isDialog = Context.Request.Query["_dialog"] == "1";
}

<div class="ems-page @(isDialog ? "ems-dialog" : "")">
@if (!isDialog)
{
<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-form"></i> @(isEdit ? "编辑员工" : "新增员工")
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">HR管理</a>
        <a href="javascript:ems.openTab('/hr/employee')">员工信息</a>
        <a><cite>@(isEdit ? Model.RealName : "新增")</cite></a>
    </div>
</div>
}

<form class="layui-form" lay-filter="empForm" id="empForm">
    <input type="hidden" id="EmpId" value="@Model.Id">
    @if (isEdit)
    {
        <div class="layui-card ems-card">
            <div class="layui-card-header">基础信息</div>
            <div class="layui-card-body">
                <div class="layui-form-item">
                    <label class="layui-form-label">工号</label>
                    <div class="layui-input-block">
                        <input type="text" class="layui-input" value="@Model.EmpNo" disabled>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="layui-card ems-card">
        <div class="layui-card-header">基础信息</div>
        <div class="layui-card-body">
            <div class="layui-row layui-col-space10">
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">姓名 <span class="layui-font-red">*</span></label>
                        <div class="layui-input-block">
                            <input type="text" id="RealName" class="layui-input" value="@Model.RealName" placeholder="请输入姓名">
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">性别</label>
                        <div class="layui-input-block">
                            <input type="radio" name="Gender" value="1" title="男" @(Model.Gender == 1 ? "checked" : "")>
                            <input type="radio" name="Gender" value="2" title="女" @(Model.Gender == 2 ? "checked" : "")>
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">手机号</label>
                        <div class="layui-input-block">
                            <input type="text" id="Phone" class="layui-input" value="@Model.Phone" placeholder="手机号">
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">邮箱</label>
                        <div class="layui-input-block">
                            <input type="text" id="Email" class="layui-input" value="@Model.Email" placeholder="邮箱">
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">身份证号</label>
                        <div class="layui-input-block">
                            <input type="text" id="IdCard" class="layui-input" maxlength="18" value="@Model.IdCard" placeholder="身份证号">
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">联系地址</label>
                        <div class="layui-input-block">
                            <input type="text" id="Address" class="layui-input" value="@Model.Address" placeholder="联系地址">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="layui-card ems-card">
        <div class="layui-card-header">任职信息</div>
        <div class="layui-card-body">
            <div class="layui-row layui-col-space10">
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">所属部门</label>
                        <div class="layui-input-block">
                            @await Component.InvokeAsync("DeptSelect", new {
                                id = "DeptId", name = "DeptId", selectedId = (Model.DeptId ?? 0),
                                emptyText = "请选择部门", cssClass = ""
                            })
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">岗位</label>
                        <div class="layui-input-block">
                            <select id="PostId">
                                <option value="">请选择岗位</option>
                                @foreach (var p in posts)
                                {
                                    <option value="@p.Id" selected="@(Model.PostId == p.Id)">@p.PostName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">入职日期</label>
                        <div class="layui-input-block">
                            <input type="date" id="EntryDate" class="layui-input" value="@(Model.EntryDate?.ToString("yyyy-MM-dd"))">
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">试用期截止</label>
                        <div class="layui-input-block">
                            <input type="date" id="ProbationEndDate" class="layui-input" value="@(Model.ProbationEndDate?.ToString("yyyy-MM-dd"))">
                        </div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">状态</label>
                        <div class="layui-input-block">
                            <select id="Status">
                                @foreach (var kv in statusMap)
                                {
                                    <option value="@kv.Key" selected="@(Model.Status == kv.Key)">@kv.Value</option>
                                }
                                @if (!statusMap.Any())
                                {
                                    <option value="1" selected="@(Model.Status==1)">在职</option>
                                    <option value="0" selected="@(Model.Status==0)">试用期</option>
                                    <option value="2" selected="@(Model.Status==2)">离职</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="layui-card ems-card">
        <div class="layui-card-header">其他信息</div>
        <div class="layui-card-body">
            <div class="layui-form-item layui-form-text">
                <label class="layui-form-label">补充说明</label>
                <div class="layui-input-block"><textarea id="Remark" class="layui-textarea" rows="2">@Model.Remark</textarea></div>
            </div>
        </div>
    </div>

    @if (isEdit)
    {
    <div class="layui-card ems-card">
        <div class="layui-card-header">学历与档案</div>
        <div class="layui-card-body">
            <div class="layui-row layui-col-space10">
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">学历</label>
                        <div class="layui-input-block"><input type="text" id="Education" class="layui-input" value="@Model.Education"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">学位</label>
                        <div class="layui-input-block"><input type="text" id="HighestDegree" class="layui-input" value="@Model.HighestDegree"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">毕业院校</label>
                        <div class="layui-input-block"><input type="text" id="GraduateSchool" class="layui-input" value="@Model.GraduateSchool"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">专业</label>
                        <div class="layui-input-block"><input type="text" id="Major" class="layui-input" value="@Model.Major"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">出生日期</label>
                        <div class="layui-input-block"><input type="date" id="BirthDate" class="layui-input" value="@(Model.BirthDate?.ToString("yyyy-MM-dd"))"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">籍贯</label>
                        <div class="layui-input-block"><input type="text" id="NativePlace" class="layui-input" value="@Model.NativePlace"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">政治面貌</label>
                        <div class="layui-input-block"><input type="text" id="PoliticalStatus" class="layui-input" value="@Model.PoliticalStatus"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">民族</label>
                        <div class="layui-input-block"><input type="text" id="Nationality" class="layui-input" value="@Model.Nationality"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">紧急联系人</label>
                        <div class="layui-input-block"><input type="text" id="EmergencyContact" class="layui-input" value="@Model.EmergencyContact"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">紧急电话</label>
                        <div class="layui-input-block"><input type="text" id="EmergencyPhone" class="layui-input" value="@Model.EmergencyPhone"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">开户行</label>
                        <div class="layui-input-block"><input type="text" id="BankName" class="layui-input" value="@Model.BankName"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">银行账号</label>
                        <div class="layui-input-block"><input type="text" id="BankAccount" class="layui-input" value="@Model.BankAccount"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">技术职称</label>
                        <div class="layui-input-block"><input type="text" id="TechnicalTitle" class="layui-input" value="@Model.TechnicalTitle"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">技术等级</label>
                        <div class="layui-input-block"><input type="text" id="TechnicalLevel" class="layui-input" value="@Model.TechnicalLevel"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">社保号</label>
                        <div class="layui-input-block"><input type="text" id="SocialInsuranceNo" class="layui-input" value="@Model.SocialInsuranceNo"></div>
                    </div>
                </div>
                <div class="layui-col-md6">
                    <div class="layui-form-item">
                        <label class="layui-form-label">参加工作</label>
                        <div class="layui-input-block"><input type="date" id="WorkStartDate" class="layui-input" value="@(Model.WorkStartDate?.ToString("yyyy-MM-dd"))"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    }

    <div class="ems-form-foot">
        <button type="button" class="layui-btn layui-btn-normal" id="btnSave">保存</button>
        <button type="button" class="layui-btn layui-btn-primary" onclick="ems.closeSelf('empTable')">取消</button>
    </div>
</form>
</div>

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery;
    layui.form.render();

    $('#btnSave').on('click', function () {
        var id = parseInt($('#EmpId').val()) || 0;
        var data = {
            RealName: $('#RealName').val(),
            Gender: parseInt($('input[name=Gender]:checked').val() || '1'),
            Phone: $('#Phone').val() || null,
            Email: $('#Email').val() || null,
            IdCard: $('#IdCard').val() || null,
            DeptId: parseInt($('#DeptId').val()) || null,
            PostId: parseInt($('#PostId').val()) || null,
            EntryDate: $('#EntryDate').val() || null,
            ProbationEndDate: $('#ProbationEndDate').val() || null,
            Status: parseInt($('#Status').val()),
            Education: $('#Education').val() || null,
            HighestDegree: $('#HighestDegree').val() || null,
            GraduateSchool: $('#GraduateSchool').val() || null,
            Major: $('#Major').val() || null,
            BirthDate: $('#BirthDate').val() || null,
            NativePlace: $('#NativePlace').val() || null,
            PoliticalStatus: $('#PoliticalStatus').val() || null,
            Address: $('#Address').val() || null,
            EmergencyContact: $('#EmergencyContact').val() || null,
            EmergencyPhone: $('#EmergencyPhone').val() || null,
            BankName: $('#BankName').val() || null,
            BankAccount: $('#BankAccount').val() || null,
            TechnicalTitle: $('#TechnicalTitle').val() || null,
            TechnicalLevel: $('#TechnicalLevel').val() || null,
            SocialInsuranceNo: $('#SocialInsuranceNo').val() || null,
            WorkStartDate: $('#WorkStartDate').val() || null,
            Remark: $('#Remark').val() || null
        };
        if (id) data.Id = id;
        if (!data.RealName) { ems.error('请填写姓名'); return; }

        var url = id ? '/hr/employee/update' : '/hr/employee/create';
        var load = ems.loading(1);
        $.ajax({
            url: url, type: 'POST', contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (r) {
                ems.close(load);
                if (r.success) ems.msg(r.message, { icon: 1, time: 1200 }, function () { ems.closeSelf('empTable'); });
                else ems.error(r.message);
            },
            error: function () { ems.close(load); ems.error('请求失败'); }
        });
    });
});
</script>
}
