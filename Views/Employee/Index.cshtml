@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "员工信息";
    var userId  = User.GetUserId();
    bool canAdd    = await PermSvc.HasPermAsync(userId, "hr:employee:add");
    bool canEdit   = await PermSvc.HasPermAsync(userId, "hr:employee:edit");
    bool canFormal = await PermSvc.HasPermAsync(userId, "hr:employee:formal");
    bool canLeave  = await PermSvc.HasPermAsync(userId, "hr:employee:leave");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-user"></i> 员工信息
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">HR管理</a>
        <a><cite>员工信息</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="empSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="姓名 / 工号 / 手机"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                @await Component.InvokeAsync("DeptSelect", new {
                    id = "DeptId", name = "DeptId", selectedId = 0L,
                    emptyText = "全部部门", cssClass = ""
                })
            </div>
            <div class="layui-inline">
                <select name="Status">
                    <option value="">全部状态</option>
                    <option value="0">试用期</option>
                    <option value="1">在职</option>
                    <option value="2">离职</option>
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="empSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新增员工
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>员工列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="empTable" lay-filter="empTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="empBar">
    <a class="ems-icon-btn primary" title="详情" lay-event="detail"><i class="layui-icon layui-icon-about"></i></a>
    @if (canFormal)
    {
        <text>
        {{# if (d.Status === 0) { }}
        <a class="ems-icon-btn success" title="转正" lay-event="formal"><i class="layui-icon layui-icon-user"></i></a>
        {{# } }}
        </text>
    }
    @if (canLeave)
    {
        <text>
        {{# if (d.Status !== 2) { }}
        <a class="ems-icon-btn warn" title="离职" lay-event="leave"><i class="layui-icon layui-icon-logout"></i></a>
        {{# } }}
        </text>
    }
</script>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'EmpNo',    title: '工号', width: 110 },
        { field: 'RealName', title: '姓名', templet: function (d) {
            return '<a class="layui-link" lay-event="detail">' + (d.RealName || '') + '</a>'
                 + ' <span class="layui-badge-rim">' + (d.Gender === 1 ? '男' : '女') + '</span>';
        } },
        { field: 'DeptName', title: '部门', templet: ems.tpl.text('DeptName') },
        { field: 'Phone',    title: '手机', templet: ems.tpl.text('Phone') },
        { field: 'Status',   title: '状态', align: 'center', width: 90,
          templet: ems.tpl.badge('Status', { 0: ['试用期', 'orange'], 1: ['在职', 'green'], 2: ['离职', 'gray'] }) },
        { field: 'EntryDate', title: '入职日期', width: 120,
          templet: function (d) { return d.EntryDate ? ems.fmtDate(d.EntryDate) : '-'; } },
        { title: '操作', width: 150, align: 'center', toolbar: '#empBar' }
    ];

    ems.initTable({
        elem: '#empTable',
        id:   'empTable',
        url:  '/hr/employee/list',
        cols: [colsConfig],

        tool: {
            detail: function (d) { ems.openTab('/hr/employee/detail/' + d.Id, '员工详情 - ' + d.RealName); },
            formal: function (d) {
                var today = ems.today();
                layer.open({
                    type: 1, skin: 'ems-layer ems-layer-prompt2', title: '办理转正 - ' + d.RealName, area: ['360px', ''],
                    content: '<div class="ems-prompt-box">'
                           +   '<div class="ems-form-line" style="justify-content:center;gap:12px;padding:4px 0 10px">'
                           +     '<label class="layui-form-label" style="width:auto;padding:0">转正日期</label>'
                           +     '<div class="layui-input-inline" style="margin:0;width:170px"><input type="date" id="formalDate" class="layui-input" value="' + today + '"></div>'
                           +   '</div>'
                           + '</div>',
                    btn: ['确认转正', '取消'],
                    yes: function (idx) {
                        var val = $('#formalDate').val();
                        if (!val) { ems.error('请选择转正日期'); return; }
                        ems.post({
                            url: '/hr/employee/formal',
                            data: { id: d.Id, formalDate: val },
                            done: function () {
                                layer.close(idx);
                                ems.reloadTable('empTable');
                            }
                        });
                    }
                });
            },
            leave: function (d) {
                var today = ems.today();
                layer.open({
                    type: 1, skin: 'ems-layer ems-layer-prompt2', title: '办理离职 - ' + d.RealName, area: ['380px', ''],
                    content: '<div class="ems-prompt-box" style="text-align:left">'
                           +   '<div class="ems-form-line" style="justify-content:flex-start;align-items:flex-start;gap:10px;padding:0 0 12px">'
                           +     '<label class="layui-form-label" style="width:72px;text-align:right;padding:9px 0 0">离职日期</label>'
                           +     '<div class="layui-input-inline" style="margin:0;width:180px"><input type="date" id="leaveDate" class="layui-input" value="' + today + '"></div>'
                           +   '</div>'
                           +   '<div class="ems-form-line" style="justify-content:flex-start;align-items:flex-start;gap:10px;padding:0">'
                           +     '<label class="layui-form-label" style="width:72px;text-align:right;padding:9px 0 0">离职原因</label>'
                           +     '<div class="layui-input-inline" style="margin:0;flex:1;width:auto">'
                           +       '<textarea id="leaveReason" class="layui-textarea" rows="2" style="width:100%" placeholder="离职原因（选填）"></textarea>'
                           +     '</div>'
                           +   '</div>'
                           + '</div>',
                    btn: ['确认离职', '取消'],
                    yes: function (idx) {
                        var date = $('#leaveDate').val();
                        if (!date) { ems.error('请选择离职日期'); return; }
                        ems.post({
                            url: '/hr/employee/leave',
                            data: { id: d.Id, leaveDate: date, reason: $('#leaveReason').val() },
                            done: function () {
                                layer.close(idx);
                                ems.reloadTable('empTable');
                            }
                        });
                    }
                });
            }
        }
    });

    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新增员工', url: '/hr/employee/create', area: ['820px', '92%'] });
    });

    $('#btnFilter').on('click', function () { ems.colFilter('empTable', colsConfig); });
    $('#btnExport').on('click', function () { ems.exportMenu('empTable', '员工列表'); });

    ems.bindSearch('empSearch', 'empTable');
});
</script>
}
