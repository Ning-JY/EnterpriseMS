@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Domain.Entities.Hr
@using EnterpriseMS.Services.DTOs.System
@using System.Collections.Generic
@model List<Employee>
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "员工信息";
    var userId = User.GetUserId();
    bool canAdd    = await PermSvc.HasPermAsync(userId, "hr:employee:add");
    bool canEdit   = await PermSvc.HasPermAsync(userId, "hr:employee:edit");
    bool canFormal = await PermSvc.HasPermAsync(userId, "hr:employee:formal");
    bool canLeave  = await PermSvc.HasPermAsync(userId, "hr:employee:leave");
    var empStatusMap = ViewBag.EmployeeStatusMap as Dictionary<int, string> ?? new Dictionary<int, string>();
    var empStatusOpts = ViewBag.EmployeeStatusOptions as List<DictDataDto> ?? new List<DictDataDto>();
    var statusBadge = new Dictionary<int, string> { { 0, "badge-warning" }, { 1, "badge-success" }, { 2, "badge-secondary" } };
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-id-card mr-2"></i>员工信息</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item">员工档案</li>
                    <li class="breadcrumb-item active">员工信息</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content"><div class="container-fluid">

    <!-- 搜索 -->
    <div class="card card-default">
        <div class="card-body">
            <form id="searchForm" method="get" action="/hr/employee">
                <div class="row">
                    <div class="col-md-3">
                        <input name="keyword" class="form-control form-control-sm"
                               placeholder="姓名 / 工号 / 手机" value="@ViewBag.Keyword">
                    </div>
                    <div class="col-md-3">
                        <select name="deptId" class="form-control form-control-sm">
                            <option value="">全部部门</option>
                            @foreach (var d in ViewBag.Depts as List<EnterpriseMS.Services.DTOs.System.DeptTreeDto> ?? new())
                            {
                                <option value="@d.Id" selected="@(ViewBag.DeptId?.ToString()==d.Id.ToString() ? "selected" : null)">@d.DeptName</option>
                                @foreach (var c in d.Children)
                                {
                                    <option value="@c.Id" selected="@(ViewBag.DeptId?.ToString()==c.Id.ToString() ? "selected" : null)">&nbsp;&nbsp;└ @c.DeptName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-control form-control-sm">
                            <option value="">全部状态</option>
                            @foreach (var o in empStatusOpts)
                            {
                                <option value="@o.DictValue" selected="@(ViewBag.Status?.ToString()==o.DictValue ? "selected" : null)">@o.DictLabel</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary btn-sm mr-1">
                            <i class="fas fa-search"></i> 搜索
                        </button>
                        <a href="/hr/employee" class="btn btn-default btn-sm">
                            <i class="fas fa-redo"></i> 重置
                        </a>
                    </div>
                    <div class="col-md-2 text-right">
                        @if (canAdd)
                        {
                            <button type="button" class="btn btn-success btn-sm" onclick="openAddModal()">
                                <i class="fas fa-plus"></i> 新增员工
                            </button>
                        }
                    </div>
                </div>
                <input type="hidden" name="page" id="pageInput" value="1">
            </form>
        </div>
    </div>

    <!-- 列表 -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">共 @ViewBag.Total 名员工</h3>
        </div>
        <div class="card-body table-responsive p-0">
        <table class="table table-hover table-sm">
            <thead class="thead-light">
                <tr>
                    <th>工号</th><th>姓名</th><th>部门</th><th>手机</th>
                    <th>状态</th><th>入职日期</th><th>登录账号</th><th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
                {
                    <tr>
                        <td><code class="small">@e.EmpNo</code></td>
                        <td>
                            <a href="/hr/employee/detail/@e.Id" class="font-weight-bold text-dark">
                                @e.RealName
                            </a>
                            <small class="text-muted ml-1">@(e.Gender == 1 ? "男" : "女")</small>
                        </td>
                        <td>@(e.Dept?.DeptName ?? "-")</td>
                        <td>@(e.Phone ?? "-")</td>
                        <td>
                            <span class="badge @(statusBadge.TryGetValue(e.Status, out var sb) ? sb : "badge-secondary")">@(empStatusMap.TryGetValue(e.Status, out var st) ? st : e.Status.ToString())</span>
                        </td>
                        <td class="small text-muted">@(e.EntryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>
                            @if (ViewBag.BoundEmpIds is List<long> boundIds && boundIds.Contains(e.Id))
                            {
                                <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i>已绑定</span>
                            }
                            else
                            {
                                <span class="text-muted small">未绑定</span>
                            }
                        </td>
                        <td>
                            <a href="/hr/employee/detail/@e.Id" class="btn btn-xs btn-info" title="详情">
                                <i class="fas fa-eye"></i>
                            </a>
                            @if (canEdit)
                            {
                                <button class="btn btn-xs btn-warning" onclick="openEditModal(@e.Id)" title="编辑">
                                    <i class="fas fa-edit"></i>
                                </button>
                            }
                            @if (canFormal && e.Status == 0)
                            {
                                <button class="btn btn-xs btn-success" onclick="doFormal(@e.Id, '@JavaScriptEncoder.Default.Encode(e.RealName)')" title="转正">
                                    <i class="fas fa-user-check"></i>
                                </button>
                            }
                            @if (canLeave && e.Status != 2)
                            {
                                <button class="btn btn-xs btn-secondary" onclick="doLeave(@e.Id, '@JavaScriptEncoder.Default.Encode(e.RealName)')" title="离职">
                                    <i class="fas fa-sign-out-alt"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">暂无数据</td></tr>
                }
            </tbody>
        </table>
    </div>
    @{
        var paged = new EnterpriseMS.Common.PagedResult<Employee>
        {
            Items = Model, Total = ViewBag.Total,
            Page = ViewBag.Page, PageSize = ViewBag.Size
        };
    }
    <partial name="_Pagination" model="paged" />
</div>
</div></section>

<!-- 新增/编辑弹窗 -->
<div class="modal fade" id="empModal" tabindex="-1" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="empModalTitle">新增员工</h5>
            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="empId">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>姓名 <span class="text-danger">*</span></label>
                        <input type="text" id="empRealName" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>性别</label>
                        <select id="empGender" class="form-control">
                            <option value="1">男</option>
                            <option value="2">女</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>手机号</label>
                        <input type="text" id="empPhone" class="form-control">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>邮箱</label>
                        <input type="email" id="empEmail" class="form-control">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>所属部门</label>
                        <select id="empDeptId" class="form-control">
                            <option value="">请选择</option>
                            @foreach (var d in ViewBag.Depts as List<EnterpriseMS.Services.DTOs.System.DeptTreeDto> ?? new())
                            {
                                <option value="@d.Id">@d.DeptName</option>
                                @foreach (var c in d.Children)
                                {
                                    <option value="@c.Id">&nbsp;&nbsp;└ @c.DeptName</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>入职日期</label>
                        <input type="date" id="empEntryDate" class="form-control">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>身份证号</label>
                        <input type="text" id="empIdCard" class="form-control" maxlength="18">
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>试用期截止日</label>
                        <input type="date" id="empProbationEnd" class="form-control">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label>备注</label>
                <textarea id="empRemark" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
            <button type="button" class="btn btn-primary" onclick="saveEmp()">保存</button>
        </div>
    </div></div>
</div>

@section Scripts {
<script>
function openAddModal() {
    $('#empModalTitle').text('新增员工');
    $('#empId').val('');
    $('#empRealName,#empPhone,#empEmail,#empIdCard,#empRemark').val('');
    $('#empGender').val(1); $('#empDeptId').val('');
    $('#empEntryDate').val(new Date().toISOString().split('T')[0]);
    $('#empModal').modal('show');
}

function openEditModal(id) {
    $.get('/hr/employee/json/' + id, function(r) {
        if (!r.success) { layer.msg(r.message || '加载失败', {icon:2}); return; }
        var e = r.data;
        $('#empModalTitle').text('编辑员工');
        $('#empId').val(e.Id);
        $('#empRealName').val(e.RealName);
        $('#empGender').val(e.Gender);
        $('#empPhone').val(e.Phone || '');
        $('#empEmail').val(e.Email || '');
        $('#empIdCard').val(e.IdCard || '');
        $('#empDeptId').val(e.DeptId || '');
        $('#empEntryDate').val(e.EntryDate || '');
        $('#empProbationEnd').val(e.ProbationEndDate || '');
        $('#empRemark').val(e.Remark || '');
        $('#empModal').modal('show');
    }).fail(function() {
        layer.msg('加载员工信息失败', {icon:2});
    });
}

function saveEmp() {
    var id = $('#empId').val();
    var data = {
        Id: id || undefined, RealName: $('#empRealName').val(),
        Gender: parseInt($('#empGender').val()),
        Phone: $('#empPhone').val(), Email: $('#empEmail').val(),
        IdCard: $('#empIdCard').val(),
        DeptId: parseInt($('#empDeptId').val()) || null,
        EntryDate: $('#empEntryDate').val() || null,
        ProbationEndDate: $('#empProbationEnd').val() || null,
        Remark: $('#empRemark').val()
    };
    if (!data.RealName) { layer.msg('请填写姓名', {icon:2}); return; }
    var url = id ? '/hr/employee/update' : '/hr/employee/create';
    var load = layer.load(1);
    // CSRF Token 由 site.js 的全局 $.ajaxSetup 自动注入，无需在此手动拼接
    $.ajax({ url: url, type:'POST', contentType:'application/json',
        data: JSON.stringify(data),
        success: function(r) {
            layer.close(load);
            if (r.success) { $('#empModal').modal('hide'); layer.msg(r.message, {icon:1, time:1500}, function(){ location.reload(); }); }
            else layer.msg(r.message, {icon:2});
        }
    });
}

function doFormal(id, name) {
    var today = new Date().toISOString().split('T')[0];
    layer.open({
        type: 1, title: name + ' - 办理转正', area: ['350px', '180px'],
        content: '<div class="form-group" style="padding:15px"><label>转正日期</label><input type="date" id="formalDate" class="form-control" value="' + today + '"></div>',
        btn: ['确认转正', '取消'],
        yes: function(idx) {
            var val = $('#formalDate').val();
            if (!val) { layer.msg('请选择日期', {icon:2}); return; }
            $.post('/hr/employee/formal', {id: id, formalDate: val}, function(r) {
                layer.close(idx);
                layer.msg(r.message, {icon: r.success?1:2, time:1500}, function() { if(r.success) location.reload(); });
            });
        }
    });
}

function doLeave(id, name) {
    var today = new Date().toISOString().split('T')[0];
    layer.open({
        type: 1, title: name + ' - 办理离职', area: ['350px', '180px'],
        content: '<div class="form-group" style="padding:15px"><label>离职日期</label><input type="date" id="leaveDate" class="form-control" value="' + today + '"></div>',
        btn: ['确认离职', '取消'],
        yes: function(idx) {
            var val = $('#leaveDate').val();
            if (!val) { layer.msg('请选择日期', {icon:2}); return; }
            $.post('/hr/employee/leave', {id: id, leaveDate: val}, function(r) {
                layer.close(idx);
                layer.msg(r.message, {icon: r.success?1:2, time:1500}, function() { if(r.success) location.reload(); });
            });
        }
    });
}
</script>
}
