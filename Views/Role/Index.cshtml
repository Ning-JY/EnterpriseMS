@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "角色管理";
    var userId  = User.GetUserId();
    bool canAdd  = await PermSvc.HasPermAsync(userId, "sys:role:add");
    bool canEdit = await PermSvc.HasPermAsync(userId, "sys:role:edit");
    bool canDel  = await PermSvc.HasPermAsync(userId, "sys:role:delete");
    bool canPerm = await PermSvc.HasPermAsync(userId, "sys:role:perm");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-user"></i> 角色管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>角色管理</cite></a>
    </div>
</div>

<!-- 搜索卡片：无头部、无字段名，仅控件；新增在右侧 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="roleSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="角色名称 / 编码"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="roleSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新增
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片：筛选/导出在卡片头部 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>角色列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="roleTable" lay-filter="roleTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="roleBar">
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        </text>
    }
    @if (canPerm)
    {
        <text>
        <a class="ems-icon-btn switch" title="分配权限" lay-event="perm"><i class="layui-icon layui-icon-auz"></i></a>
        </text>
    }
    @if (canDel)
    {
        <text>
        {{# if (d.RoleCode !== 'superadmin') { }}
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
        {{# } }}
        </text>
    }
</script>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'RoleName', title: '角色名称' },
        { field: 'RoleCode', title: '角色编码' },
        { field: 'DataScope', title: '数据范围', templet: function (d) {
            var m = { 1: '全部数据', 2: '本部门', 3: '本部门及子部门', 4: '仅本人' };
            return m[d.DataScope] || '未知';
        } },
        { field: 'Sort',     title: '排序', align: 'center' },
        { field: 'Status',   title: '状态', align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['禁用', 'red'] }) },
        { field: 'CreatedAt', title: '创建时间', templet: ems.tpl.dateTime('CreatedAt') },
        { title: '操作', width: 170, align: 'center', toolbar: '#roleBar' }
    ];

    ems.initTable({
        elem: '#roleTable',
        id:   'roleTable',
        url:  '/system/role/list',
        cols: [colsConfig],

        tool: {
            edit: function (d) {
                ems.openEdit({ title: '编辑角色 - ' + d.RoleName, url: '/system/role/form?id=' + d.Id, table: 'roleTable' });
            },
            perm: function (d) {
                ems.open({ title: '分配权限 - ' + d.RoleName, url: '/system/role/perm?id=' + d.Id });
            },
            del: function (d) {
                ems.del({ url: '/system/role/delete/' + d.Id, name: d.RoleName, table: 'roleTable' });
            }
        }
    });

    // 角色新增/编辑走 ems.openAdd / ems.openEdit，统一为「固定顶」模式（pinTop：固定宽 + 顶部钉死 + 高度随内容）

    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新增角色', url: '/system/role/form', table: 'roleTable' });
    });

    $('#btnFilter').on('click', function () {
        ems.colFilter('roleTable', colsConfig);
    });

    $('#btnExport').on('click', function () {
        ems.exportMenu('roleTable', '角色列表');
    });

    ems.bindSearch('roleSearch', 'roleTable');
});
</script>
}
