@using EnterpriseMS.Services.DTOs.System
@model RoleListDto
@{
    var isEdit = Model != null;
    var isDialog = Context.Request.Query["_dialog"] == "1";
    ViewData["Title"] = isEdit ? "编辑角色" : "新增角色";
}

<div class="ems-page @(isDialog ? "ems-dialog" : "")">
@if (!isDialog)
{
<div class="ems-page-head">
    <div class="ems-page-title">@(isEdit ? "编辑角色" : "新增角色")</div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>@(isEdit ? "编辑" : "新增")</cite></a>
    </div>
</div>
}

<form class="layui-form" lay-filter="roleForm">
<div class="layui-card ems-card">
    <div class="layui-card-body">
        <input type="hidden" name="Id" value="@(Model?.Id)">

        <div class="layui-form-item">
            <label class="layui-form-label">角色名称</label>
            <div class="layui-input-block">
                <input type="text" name="RoleName" value="@Model?.RoleName" maxlength="50"
                       lay-verify="required" placeholder="请输入角色名称" autocomplete="off" class="layui-input">
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">角色编码</label>
            <div class="layui-input-block">
                <input type="text" name="RoleCode" value="@Model?.RoleCode" maxlength="50"
                       lay-verify="required" placeholder="如：role_admin" autocomplete="off"
                       class="layui-input" disabled="@isEdit">
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">数据范围</label>
            <div class="layui-input-block">
                <select name="DataScope" lay-filter="DataScope">
                    <option value="1" selected="@(Model == null || Model.DataScope == 1)">全部数据</option>
                    <option value="2" selected="@(Model != null && Model.DataScope == 2)">本部门</option>
                    <option value="3" selected="@(Model != null && Model.DataScope == 3)">本部门及子部门</option>
                    <option value="4" selected="@(Model != null && Model.DataScope == 4)">仅本人</option>
                </select>
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">排序</label>
            <div class="layui-input-block">
                <input type="number" name="Sort" value="@(Model?.Sort ?? 0)" class="layui-input">
            </div>
        </div>

        <div class="layui-form-item">
            <label class="layui-form-label">状态</label>
            <div class="layui-input-block">
                <input type="radio" name="Status" value="1" title="正常" @((Model == null || Model.Status == 1) ? "checked" : null)>
                <input type="radio" name="Status" value="0" title="禁用" @(Model != null && Model.Status == 0 ? "checked" : null)>
            </div>
        </div>

        <div class="layui-form-item layui-form-text">
            <label class="layui-form-label">备注</label>
            <div class="layui-input-block">
                <textarea name="Remark" placeholder="请输入备注" class="layui-textarea">@Model?.Remark</textarea>
            </div>
        </div>
    </div>
</div>
<div class="ems-form-foot">
    <button class="layui-btn" lay-submit lay-filter="roleForm">
        <i class="layui-icon layui-icon-ok"></i> 保存
    </button>
    <button type="button" class="layui-btn layui-btn-primary" id="btnCancel">
        <i class="layui-icon layui-icon-close"></i> 取消
    </button>
</div>
</form>
</div>

@section Scripts {
<script>
ems.ready(function () {
    var isEdit = @(isEdit ? "true" : "false");

    // 保存
    ems.bindSubmit('roleForm', function (field) {
        field.DataScope = Number(field.DataScope) || 1;
        field.Sort = Number(field.Sort) || 0;
        field.Status = (field.Status === "0" || field.Status === 0) ? 0 : 1;
        if (isEdit) {
            field.Id = Number(field.Id);
        } else {
            delete field.Id;
        }
        return {
            url: isEdit ? '/system/role/update' : '/system/role/create',
            data: field,
            table: 'roleTable'
        };
    });

    $('#btnCancel').on('click', function () { ems.closeSelf(); });
});
</script>
}
