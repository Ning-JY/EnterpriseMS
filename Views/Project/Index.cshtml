@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Services.DTOs.System
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "项目台账";
    var userId  = User.GetUserId();
    bool canAdd = await PermSvc.HasPermAsync(userId, "proj:project:add");
    bool canEdit = await PermSvc.HasPermAsync(userId, "proj:project:edit");
    bool canReport = await PermSvc.HasPermAsync(userId, "proj:project:list");
    var bizTypes = ViewBag.BizTypes as List<DictDataDto> ?? new();
    string[] statusText = {"前期商务","预计启动","标书制作中","投标/磋商中","已中标·签合同中","已签回合同","执行中","成果提交","已完成","已终止"};
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-console"></i> 项目台账
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">项目管理</a>
        <a><cite>项目台账</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="projSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="项目名称 / 业主 / 编号"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                @await Component.InvokeAsync("DeptSelect", new {
                    id = "DeptId", name = "DeptId", selectedId = 0L,
                    emptyText = "全部部门", cssClass = ""
                })
            </div>
            <div class="layui-inline">
                <select name="ProgressStatus">
                    <option value="">全部状态</option>
                    @for (int i = 0; i <= 9; i++)
                    {
                        <option value="@i">@statusText[i]</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                <select name="BizType">
                    <option value="">全部业务类型</option>
                    @foreach (var bt in bizTypes)
                    {
                        <option value="@bt.DictValue">@bt.DictLabel</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="projSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新建项目
                    </button>
                }
                @if (await PermSvc.HasPermAsync(userId, "proj:project:import"))
                {
                    <button type="button" class="layui-btn" id="btnImport">
                        <i class="layui-icon layui-icon-upload-circle"></i> 批量导入
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>项目列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="projTable" lay-filter="projTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="projBar">
    <a class="ems-icon-btn primary" title="详情" lay-event="detail"><i class="layui-icon layui-icon-about"></i></a>
    @if (canEdit)
    {
        <text>
        {{# if (d.ProgressStatus !== 9) { }}
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        {{# } }}
        </text>
    }
    @if (canReport)
    {
        <text>
        <a class="ems-icon-btn success" title="生成报告" lay-event="report"><i class="layui-icon layui-icon-file"></i></a>
        </text>
    }
    <a class="ems-icon-btn warn" title="用章申请" lay-event="seal"><i class="layui-icon layui-icon-auz"></i></a>
</script>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'ProjNo',    title: '编号', width: 140,
          templet: function (d) { return '<span class="layui-font-12">' + ems.escapeHtml(d.ProjNo) + '</span>'; } },
        { field: 'ProjName',  title: '项目名称', minWidth: 220,
          templet: function (d) {
              var html = '<a class="layui-link" lay-event="detail">' + ems.escapeHtml(d.ProjName) + '</a>';
              if (d.BizType) html += ' <span class="layui-badge-rim">' + ems.escapeHtml(d.BizType) + '</span>';
              return html;
          } },
        { field: 'DeptName',  title: '承接部门', width: 130, templet: ems.tpl.text('DeptName') },
        { field: 'OwnerName', title: '项目业主', width: 140,
          templet: function (d) {
              var html = ems.escapeHtml(d.OwnerName || '-');
              if (d.OwnerPhone) html += '<br><span class="layui-font-12 layui-font-gray">' + ems.escapeHtml(d.OwnerPhone) + '</span>';
              return html;
          } },
        { field: 'ContractAmount', title: '合同金额(万)', width: 150,
          templet: function (d) {
              var html = '<span class="layui-font-teal ">¥' + (d.ContractAmount || 0).toFixed(2) + '</span>';
              if (d.IsJointVenture && d.OurRatio) html += '<br><span class="layui-font-12 layui-font-gray">我方 ' + (d.OurRatio * 100).toFixed(1) + '%</span>';
              return html;
          } },
        { field: 'ProgressStatus', title: '进度状态', width: 110, align: 'center',
          templet: ems.tpl.badge('ProgressStatus', {
              0: ['前期商务', 'gray'], 1: ['预计启动', 'blue'], 2: ['标书制作中', 'orange'],
              3: ['投标/磋商中', 'orange'], 4: ['已中标·签合同', 'teal'], 5: ['已签回合同', 'teal'],
              6: ['执行中', 'green'], 7: ['成果提交', 'green'], 8: ['已完成', 'green'], 9: ['已终止', 'red']
          }) },
        { field: 'ProjectLeaderName', title: '项目负责人', width: 110, templet: ems.tpl.text('ProjectLeaderName') },
        { field: 'Milestone', title: '里程碑', width: 130,
          templet: function (d) {
              var total = d.MilestoneTotal || 0, done = d.MilestoneDone || 0;
              var pct = total > 0 ? Math.round(done * 100 / total) : 0;
              return '<span class="layui-font-12">' + done + '/' + total + '</span>'
                   + '<div class="layui-progress layui-progress-small" style="margin-top:4px"><div class="layui-progress-bar layui-bg-green" style="width:' + pct + '%"></div></div>';
          } },
        { title: '操作', width: 160, align: 'center', toolbar: '#projBar' }
    ];

    ems.initTable({
        elem: '#projTable',
        id:   'projTable',
        url:  '/project/list',
        cols: [colsConfig],

        tool: {
            detail: function (d) { ems.openTab('/project/' + d.Id, '项目详情 - ' + d.ProjName); },
            edit:   function (d) { ems.openEdit({ title: '编辑项目 - ' + d.ProjName, url: '/project/edit/' + d.Id, area: ['860px', '92%'] }); },
            report: function (d) { ems.openTab('/project/' + d.Id + '?report=1', '项目报告 - ' + d.ProjName); },
            seal:   function () { ems.msg('用章申请功能开发中', { icon: 0 }); }
        }
    });

    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新建项目', url: '/project/create', area: ['740px', '90%'] });
    });

    $('#btnImport').on('click', function () {
        ems.openTab('/project/import', '项目批量导入');
    });

    $('#btnFilter').on('click', function () { ems.colFilter('projTable', colsConfig); });
    $('#btnExport').on('click', function () { ems.exportMenu('projTable', '项目台账'); });

    ems.bindSearch('projSearch', 'projTable');
});
</script>
}
