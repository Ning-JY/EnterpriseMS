@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Services.DTOs.Project
@using EnterpriseMS.Services.DTOs.Hr
@using EnterpriseMS.Services.DTOs.System
@model ProjectDetailDto
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = Model.ProjName;
    var userId     = User.GetUserId();
    bool canEdit   = await PermSvc.HasPermAsync(userId, "proj:project:edit");
    bool canStatus = await PermSvc.HasPermAsync(userId, "proj:project:status");
    bool canMember = await PermSvc.HasPermAsync(userId, "proj:member:add");
    bool canMSAdd  = await PermSvc.HasPermAsync(userId, "proj:milestone:add");
    bool canAccept = await PermSvc.HasPermAsync(userId, "proj:acceptance:add");
    var members    = ViewBag.AllMembers as List<EmployeeSimpleDto> ?? new();
    string[] statusText = {"前期商务","预计启动","标书制作中","投标/磋商中","已中标·签合同中","已签回合同","执行中","成果提交","已完成","已终止"};
    string[] statusTag  = {"gray","blue","orange","orange","teal","teal","green","green","green","red"};
    var dicts = ViewBag.DictMilestoneType as List<DictDataDto> ?? new();
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title"><i class="layui-icon layui-icon-console"></i> 项目详情</div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:ems.openTab('/project')">项目台账</a>
        <a><cite>@Model.ProjName</cite></a>
    </div>
</div>
<input type="hidden" id="hfProjName" value="@Model.ProjName" />

<!-- 详情头部 -->
<!-- 防伪造令牌：供详情页内联 AJAX（新增合同 / 上传文件等）使用 -->
<div style="display:none">@Html.AntiForgeryToken()</div>

<div class="ems-detail-header">
    <a href="javascript:;" title="返回项目台账" onclick="ems.openTab('/project','项目台账')"
       style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:8px;background:#eef3f2;color:#0d6b64;font-size:20px;cursor:pointer;flex:0 0 auto;">
        <i class="layui-icon layui-icon-left"></i>
    </a>
    <div class="ems-detail-avatar"><i class="layui-icon layui-icon-console"></i></div>
    <div class="ems-detail-info" style="display:flex;align-items:center;">
        <div>
            <h2>@Model.ProjName <span class="ems-tag ems-tag-@statusTag[Model.ProgressStatus]">@statusText[Model.ProgressStatus]</span></h2>
            <div class="ems-detail-meta">
                <span>编号：@Model.ProjNo</span>
                @if (Model.StatusUpdatedAt.HasValue) { <span>状态更新：@Model.StatusUpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span> }
            </div>
        </div>
    </div>
    <div class="ems-detail-actions">
        <a class="layui-btn layui-btn-sm layui-btn-normal" onclick="openReportModal()"><i class="layui-icon layui-icon-file"></i> 生成报告</a>
        <a class="layui-btn layui-btn-sm" onclick="ems.msg('生成合同功能开发中',{icon:0})"><i class="layui-icon layui-icon-template"></i> 生成合同</a>
        <a class="layui-btn layui-btn-sm layui-btn-primary" onclick="ems.msg('用章申请功能开发中',{icon:0})"><i class="layui-icon layui-icon-auz"></i> 用章申请</a>
        @if (canStatus && Model.ProgressStatus < 9) {
            <a class="layui-btn layui-btn-sm layui-btn-primary" onclick="openModal('statusModal','变更项目状态')"><i class="layui-icon layui-icon-next"></i> 变更状态</a>
        }
    </div>
</div>

<!-- 四张统计卡片 -->
<div class="ems-stat-cards four-cols">
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-rmb"></i> 合同金额</div>
        <div class="value layui-font-teal">¥@Model.ContractAmount.ToString("N2")<span class="layui-font-12">万</span></div>
        @if (Model.IsJointVenture && Model.OurRatio.HasValue) { <div class="label">联合体 · 我方 @Model.OurRatio.Value.ToString("N1")%</div> }
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-dollar"></i> 已收款</div>
        <div class="value layui-font-green">¥@Model.TotalReceived.ToString("N2")<span class="layui-font-12">万</span></div>
        @{ var recvRate = Model.ActualAmount > 0 ? Model.TotalReceived / Model.ActualAmount * 100 : 0; }
        <div class="label">收款率 @recvRate.ToString("N1")%</div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-flag"></i> 里程碑</div>
        <div class="value">@Model.MilestoneDone <span class="layui-font-12">/ @Model.MilestoneTotal</span></div>
        <div class="label">已完成 / 共计</div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-user"></i> 服务团队</div>
        <div class="value layui-font-purple">@Model.Members.Count(m => m.Status == 0)<span class="layui-font-12">人</span></div>
        @{ var totalR = Model.Members.Where(m => m.Status == 0).Sum(m => m.Ratio); }
        <div class="label @(Math.Abs(totalR - 100) < 0.1m ? "layui-font-green" : "layui-font-orange")">占比合计 @totalR.ToString("N1")%</div>
    </div>
</div>

<!-- 基本信息 + 服务团队 -->
<div class="ems-card-row">
    <div class="ems-info-card ems-col-main">
        <div class="ems-info-card-title">
            基本信息
            @if (canEdit)
            {
                <a class="ems-icon-btn edit" style="float:right" title="编辑" onclick="ems.openEdit({ title: '编辑项目 - ' + @System.Text.Json.JsonSerializer.Serialize(Model.ProjName), url: '/project/edit/@Model.Id' })"><i class="layui-icon layui-icon-edit"></i></a>
            }
        </div>
        <div class="ems-info-grid">
            <div class="ems-info-item"><span class="label">业务类型</span><span class="val">@Model.BizType</span></div>
            <div class="ems-info-item"><span class="label">采购方式</span><span class="val">@(Model.ProcurementType ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">项目业主</span><span class="val"><strong>@Model.OwnerName</strong></span></div>
            <div class="ems-info-item"><span class="label">业主联系人</span><span class="val">
                @if (!string.IsNullOrEmpty(Model.OwnerContact) && !string.IsNullOrEmpty(Model.OwnerPhone))
                { @($"{Model.OwnerContact}（{Model.OwnerPhone}）") }
                else if (!string.IsNullOrEmpty(Model.OwnerContact))
                { @Model.OwnerContact }
                else if (!string.IsNullOrEmpty(Model.OwnerPhone))
                { @Model.OwnerPhone }
                else
                { @("-") }
            </span></div>
            <div class="ems-info-item"><span class="label">承接部门</span><span class="val">@(Model.DeptName ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">项目负责人</span><span class="val">@(Model.ProjectLeaderName ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">签约日期</span><span class="val">@(Model.SignDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">计划完成</span><span class="val">@(Model.PlanEndDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">实际开始</span><span class="val">@(Model.ActualStartDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">实际完成</span><span class="val">@(Model.ActualEndDate?.ToString("yyyy-MM-dd") ?? "-")</span></div>
            <div class="ems-info-item"><span class="label">协作单位</span><span class="val">@(Model.CooperationUnit ?? "-")</span></div>
            <div class="ems-info-item" style="grid-column: 1 / -1;"><span class="label">项目概况</span><span class="val">@(Model.ProjectOverview ?? "-")</span></div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Remark)) {
            <div class="ems-alert teal" style="margin-top:12px"><i class="layui-icon layui-icon-about"></i> @Model.Remark</div>
        }
    </div>

    <div class="ems-info-card ems-col-side">
        <div class="ems-info-card-title">
            服务团队与产值
            @{ var totalR2 = Model.Members.Where(m => m.Status == 0).Sum(m => m.Ratio); }
            <span class="layui-font-12 @(Math.Abs(totalR2 - 100) < 0.1m ?"layui-font-green" : "layui-font-orange")">已分配 @totalR2.ToString("N1")%</span>
        </div>
        <table class="layui-table ems-detail-tbl-sm" lay-skin="line">
            <thead><tr><th>姓名</th><th>角色</th><th>占比</th><th>合同产值</th><th>已实现</th><th>操作</th></tr></thead>
            <tbody>
                @foreach (var m in Model.Members.OrderByDescending(x => x.Status == 0))
                {
                    <tr class="@(m.Status == 1 ? "layui-bg-gray" : "")">
                        <td><strong>@m.EmployeeName</strong><br><span class="layui-font-12">@(m.DeptName ?? "")</span></td>
                        <td><span class="layui-font-12">@m.Role</span></td>
                        <td><strong class="@(m.Status == 0 ? "layui-font-teal" : "layui-font-gray")">@m.Ratio.ToString("N1")%</strong></td>
                        <td class="layui-font-teal layui-font-12">@m.ContractValue.ToString("N2")</td>
                        <td class="layui-font-green layui-font-12">@m.ReceivedValue.ToString("N2")</td>
                        <td>
                            @if (canMember && m.Status == 0)
                            {
                                <a class="ems-icon-btn edit" data-act="member-edit" data-id="@m.Id" data-role="@m.Role" data-duty="@(m.DutyDesc ?? "")" data-ratio="@m.Ratio" title="编辑"><i class="layui-icon layui-icon-edit"></i></a>
                                <a class="ems-icon-btn warn" data-act="member-remove" data-id="@m.Id" data-name="@m.EmployeeName" title="移除"><i class="layui-icon layui-icon-delete"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Members.Any()) { <tr><td colspan="6" class="ems-empty">暂无成员</td></tr> }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="3"><strong>合计</strong></td>
                    <td class="layui-font-teal"><strong>¥@Model.ActualAmount.ToString("N2")万</strong></td>
                    <td class="layui-font-green"><strong>¥@Model.TotalReceived.ToString("N2")万</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        @if (canMember) {
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" style="margin-top:8px" data-act="member-add"><i class="layui-icon layui-icon-add-1"></i> 添加成员</button>
        }
    </div>
</div>

<!-- Tabs -->
<div class="ems-detail-tabs">
    <div class="layui-tab layui-tab-brief">
        <ul class="layui-tab-title">
            <li class="layui-this">合同与回款</li>
            <li>工作节点</li>
            <li>项目文件</li>
            <li>操作日志</li>
        </ul>
        <div class="layui-tab-content">

            <!-- 合同与回款 -->
            <div class="layui-tab-item layui-show">
                <div class="flex-between"><strong>合同与回款</strong>
                    @if (canEdit) { <button class="layui-btn layui-btn-sm layui-btn-normal" onclick="openModal('addContractModal','新增合同',['760px'])"><i class="layui-icon layui-icon-add-1"></i> 新增合同</button> }
                </div>
                @if (Model.Contracts.Any())
                {
                    foreach (var ct in Model.Contracts)
                    {
                        var ctInvoices = Model.Invoices.Where(i => i.ContractId == ct.Id).ToList();
                        <div class="ems-contract-group">
                            <div class="ems-contract-row">
                                <span class="ems-contract-name">@ct.ContractNo</span>
                                <span class="ems-tag ems-tag-blue">@ct.ContractType</span>
                                <span class="layui-font-teal"><strong>¥@ct.Amount.ToString("N2")万</strong></span>
                                @if (ct.Status == 1) { <span class="ems-tag ems-tag-green">生效</span> } else { <span class="ems-tag ems-tag-gray">无效</span> }
                                @if (ct.SignDate.HasValue) { <span class="layui-font-12">签约：@ct.SignDate.Value.ToString("yyyy-MM-dd")</span> }
                                <span class="layui-font-12">@ct.PartyA</span>
                                <span style="margin-left:auto">
                                    @if (canEdit) {
                                        <a class="ems-icon-btn success" onclick="openAddReceipt(@ct.Id)" title="新增回款"><i class="layui-icon layui-icon-add-1"></i></a>
                                        <a class="ems-icon-btn warn" data-id="@ct.Id" data-no="@ct.ContractNo" onclick="delContract(this)" title="删除合同"><i class="layui-icon layui-icon-delete"></i></a>
                                    }
                                </span>
                            </div>
                            <div class="ems-contract-row" style="margin-top:6px">
                                @if (!string.IsNullOrEmpty(ct.FileName)) {
                                    <a class="layui-font-12" href="/project/contracts/download/@ct.Id"><i class="layui-icon layui-icon-file"></i> @ct.FileName</a>
                                    <a class="ems-icon-btn" title="预览" onclick="ems.preview('/project/contracts/download/@ct.Id?inline=1')"><i class="layui-icon layui-icon-search"></i></a>
                                    @if (canEdit) {
                                        <label class="ems-icon-btn" title="重新上传"><i class="layui-icon layui-icon-upload"></i><input type="file" class="layui-hide" onchange="uploadContractFile(@ct.Id,this)"></label>
                                        <a class="ems-icon-btn warn" data-id="@ct.Id" onclick="delContractFile(this)" title="删除附件"><i class="layui-icon layui-icon-close"></i></a>
                                    }
                                } else if (canEdit) {
                                    <label class="ems-icon-btn" title="上传合同"><i class="layui-icon layui-icon-upload"></i><input type="file" class="layui-hide" onchange="uploadContractFile(@ct.Id,this)"></label>
                                }
                            </div>
                            @if (ctInvoices.Any())
                            {
                                <div class="ems-invoice-rows">
                                    <table class="layui-table" lay-skin="line">
                                        <thead><tr><th>回款批次</th><th>发票号</th><th>类型</th><th>金额(万)</th><th>税率</th><th>开票日期</th><th>付款方</th><th>状态</th><th>发票附件</th><th>付款申请</th><th>操作</th></tr></thead>
                                        <tbody>
                                            @foreach (var inv in ctInvoices.OrderByDescending(i => i.CreatedAt))
                                            {
                                                <tr class="@(inv.IsReceived ? "layui-bg-green" : "")">
                                                    <td><strong>@inv.ReceiptName</strong></td>
                                                    <td><span class="layui-font-12">@(inv.InvoiceNo ?? "-")</span></td>
                                                    <td><span class="layui-font-12">@inv.InvoiceType</span></td>
                                                    <td class="layui-font-teal"><strong>¥@inv.Amount.ToString("N2")</strong></td>
                                                    <td class="layui-font-12">@(inv.TaxRate.HasValue ? inv.TaxRate.Value.ToString("N1") + "%" : "-")</td>
                                                    <td class="layui-font-12">@(inv.InvoiceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                                    <td class="layui-font-12">@(inv.Payer ?? "-")</td>
                                                    <td>
                                                        @if (inv.IsReceived) { <span class="ems-tag ems-tag-green">已收款 @(inv.ReceivedDate?.ToString("yyyy-MM-dd"))</span> }
                                                        else if (canEdit) { <a class="layui-btn layui-btn-xs layui-btn-normal" onclick="confirmReceived(@inv.Id)">确认收款</a> }
                                                        else { <span class="ems-tag ems-tag-orange">待收款</span> }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(inv.InvoiceFileName)) {
                                                            <a class="layui-font-12" href="/project/invoices/file/@inv.Id/invoice"><i class="layui-icon layui-icon-file"></i> @inv.InvoiceFileName</a>
                                                            <a class="ems-icon-btn" title="预览" onclick="ems.preview('/project/invoices/file/@inv.Id/invoice?inline=1')"><i class="layui-icon layui-icon-search"></i></a>
                                                        } else if (canEdit) {
                                                            <label class="ems-icon-btn" title="上传发票"><i class="layui-icon layui-icon-upload"></i><input type="file" class="layui-hide" onchange="uploadInvoiceFile(@inv.Id,'invoice',this)"></label>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(inv.PaymentFileName)) {
                                                            <a class="layui-font-12" href="/project/invoices/file/@inv.Id/payment"><i class="layui-icon layui-icon-file"></i> @inv.PaymentFileName</a>
                                                            <a class="ems-icon-btn" title="预览" onclick="ems.preview('/project/invoices/file/@inv.Id/payment?inline=1')"><i class="layui-icon layui-icon-search"></i></a>
                                                        } else if (canEdit) {
                                                            <label class="ems-icon-btn" title="上传付款申请"><i class="layui-icon layui-icon-upload"></i><input type="file" class="layui-hide" onchange="uploadInvoiceFile(@inv.Id,'payment',this)"></label>
                                                        }
                                                    </td>
                                                    <td>@if (canEdit) { <a class="ems-icon-btn warn" data-id="@inv.Id" onclick="delReceipt(this)"><i class="layui-icon layui-icon-delete"></i></a> }</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    }
                }
                else { <div class="ems-empty">暂无合同记录</div> }

                @{
                    var unlinked = Model.Invoices.Where(i => !i.ContractId.HasValue).ToList();
                }
                @if (unlinked.Any())
                {
                    <div class="ems-alert gray" style="margin-top:10px">
                        <strong>未关联合同的回款（@unlinked.Count 笔）</strong>
                        <table class="layui-table" lay-skin="line" style="margin-top:8px">
                            <thead><tr><th>回款批次</th><th>发票号</th><th>类型</th><th>金额(万)</th><th>税率</th><th>开票日期</th><th>付款方</th><th>状态</th><th>操作</th></tr></thead>
                            <tbody>
                                @foreach (var inv in unlinked.OrderByDescending(i => i.CreatedAt))
                                {
                                    <tr class="@(inv.IsReceived ? "layui-bg-green" : "")">
                                        <td><strong>@inv.ReceiptName</strong></td>
                                        <td><span class="layui-font-12">@(inv.InvoiceNo ?? "-")</span></td>
                                        <td><span class="layui-font-12">@inv.InvoiceType</span></td>
                                        <td class="layui-font-teal"><strong>¥@inv.Amount.ToString("N2")</strong></td>
                                        <td class="layui-font-12">@(inv.TaxRate.HasValue ? inv.TaxRate.Value.ToString("N1") + "%" : "-")</td>
                                        <td class="layui-font-12">@(inv.InvoiceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td class="layui-font-12">@(inv.Payer ?? "-")</td>
                                        <td>
                                            @if (inv.IsReceived) { <span class="ems-tag ems-tag-green">已收款 @(inv.ReceivedDate?.ToString("yyyy-MM-dd"))</span> }
                                            else if (canEdit) { <a class="layui-btn layui-btn-xs layui-btn-normal" onclick="confirmReceived(@inv.Id)">确认收款</a> }
                                            else { <span class="ems-tag ems-tag-orange">待收款</span> }
                                        </td>
                                        <td>@if (canEdit) { <a class="ems-icon-btn warn" data-id="@inv.Id" onclick="delReceipt(this)"><i class="layui-icon layui-icon-delete"></i></a> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- 工作节点 -->
            <div class="layui-tab-item">
                <div class="flex-between"><strong>工作节点</strong>
                    @if (canMSAdd) { <button class="layui-btn layui-btn-sm layui-btn-normal" onclick="openModal('addMsModal','新增工作节点',['520px'])"><i class="layui-icon layui-icon-add-1"></i> 新增节点</button> }
                </div>
                @if (Model.Milestones.Any())
                {
                    <div class="ems-timeline">
                        @foreach (var ms in Model.Milestones.OrderBy(m => m.Sort))
                        {
                            string dotCls = ms.Status == 2 ? "done" : (ms.IsOverdue ? "pending" : (ms.Status == 1 ? "active" : "pending"));
                            <div class="ems-timeline-item">
                                <span class="dot @dotCls"></span>
                                <div class="content">
                                    <div class="title">@ms.MilestoneName
                                        @if (ms.IsOverdue && ms.Status != 2) { <span class="ems-tag ems-tag-red">已逾期</span> }
                                        @if (!string.IsNullOrEmpty(ms.MilestoneType)) { <span class="ems-tag ems-tag-blue">@ms.MilestoneType</span> }
                                        @if (canMSAdd) {
                                            <span style="margin-left:auto">
                                                <a class="ems-icon-btn edit" data-id="@ms.Id" data-name="@ms.MilestoneName" data-type="@(ms.MilestoneType ?? "")" data-plan="@ms.PlanDate.ToString("yyyy-MM-dd")" data-sort="@ms.Sort" data-remark="@(ms.Remark ?? "")" onclick="openEditMs(this)" title="编辑"><i class="layui-icon layui-icon-edit"></i></a>
                                                @if (ms.Status != 2) { <a class="ems-icon-btn success" data-id="@ms.Id" onclick="completeMs(this)" title="完成"><i class="layui-icon layui-icon-ok"></i></a> }
                                            </span>
                                        }
                                    </div>
                                    <div class="desc">
                                        计划：@ms.PlanDate.ToString("yyyy-MM-dd")
                                        @if (ms.ActualDate.HasValue) { <span class="layui-font-green"> 实际：@ms.ActualDate.Value.ToString("yyyy-MM-dd")</span> }
                                        @if (!string.IsNullOrEmpty(ms.OwnerName)) { <span> 负责人：@ms.OwnerName</span> }
                                        @if (ms.AcceptAmount.HasValue) { <span class="layui-font-orange"> 应收：¥@ms.AcceptAmount.Value.ToString("N2")万</span> }
                                        @if (!string.IsNullOrEmpty(ms.Remark)) { <div>@ms.Remark</div> }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else { <div class="ems-empty">暂无工作节点</div> }
            </div>

            <!-- 项目文件 -->
            <div class="layui-tab-item">
                @if (canEdit)
                {
                    <div class="ems-alert gray" style="margin-bottom:10px">
                        <div class="layui-form" style="margin-top:6px">
                            <div class="layui-form-item">
                                <div class="layui-inline"><label class="layui-form-label" style="width:auto">文件类别</label>
                                    <div class="layui-input-inline">
                                        <select id="uploadCategory" class="layui-input">
                                            <option value="资料收集">资料收集</option>
                                            <option value="过程文件">过程文件</option>
                                            <option value="成果文件">成果文件</option>
                                            <option value="其他">其他</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="layui-inline"><label class="layui-form-label" style="width:auto">版本号</label>
                                    <div class="layui-input-inline"><input type="text" id="uploadVersion" class="layui-input" placeholder="如 V04.10"></div>
                                </div>
                                <div class="layui-inline"><label class="layui-form-label" style="width:auto">说明</label>
                                    <div class="layui-input-inline"><input type="text" id="uploadDesc" class="layui-input" placeholder="默认使用文件名"></div>
                                </div>
                                <div class="layui-inline">
                                    <label class="layui-btn layui-btn-sm layui-btn-primary"><i class="layui-icon layui-icon-folder"></i> 选择文件
                                        <input type="file" id="fileInput" class="layui-hide" onchange="onFileSelected(this)">
                                    </label>
                                </div>
                            </div>
                            <div id="uploadPreview" style="display:none">
                                <div class="ems-alert info">
                                    <div class="flex-between">
                                        <div><i class="layui-icon layui-icon-file"></i> <strong id="previewFileName"></strong> <span class="layui-font-12" id="previewFileSize"></span></div>
                                        <a class="ems-icon-btn" onclick="clearFileSelection()"><i class="layui-icon layui-icon-close"></i></a>
                                    </div>
                                    <div class="layui-font-12" style="margin-top:4px">类别：<span id="previewCategory"></span> ｜ 版本：<span id="previewVersion"></span> ｜ 说明：<span id="previewDesc"></span></div>
                                </div>
                                <button class="layui-btn layui-btn-sm layui-btn-normal" id="uploadConfirmBtn" onclick="confirmUpload()"><i class="layui-icon layui-icon-upload"></i> 确认上传</button>
                            </div>
                        </div>
                    </div>
                }
                @foreach (var grp in Model.Files.GroupBy(f => f.FileCategory).OrderBy(g => g.Key))
                {
                    <h6 class="layui-font-12" style="margin:14px 0 6px">@grp.Key（@grp.Count() 个）</h6>
                    <table class="layui-table" lay-skin="line">
                        <thead><tr><th>文件名</th><th>版本</th><th>大小</th><th>说明</th><th>上传人</th><th>上传时间</th><th>操作</th></tr></thead>
                        <tbody>
                            @foreach (var f in grp.OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>
                                    <td><i class="layui-icon layui-icon-file @GetFileIcon(f.FileExt)"></i> <a href="/project/files/download/@f.Id">@f.FileName</a></td>
                                    <td class="layui-font-12">@(f.Version ?? "-")</td>
                                    <td class="layui-font-12">@f.FileSizeText</td>
                                    <td class="layui-font-12">@(f.Description ?? "-")</td>
                                    <td class="layui-font-12">@f.UploadBy</td>
                                    <td class="layui-font-12">@f.CreatedAt.ToString("MM-dd HH:mm")</td>
                                    <td>
                                        <a class="ems-icon-btn" title="预览" onclick="ems.preview('/project/files/download/@f.Id?inline=1')"><i class="layui-icon layui-icon-search"></i></a>
                                        <a class="ems-icon-btn" href="/project/files/download/@f.Id" title="下载"><i class="layui-icon layui-icon-download"></i></a>
                                        @if (canEdit) { <a class="ems-icon-btn warn" data-id="@f.Id" onclick="deleteFile(this)" title="删除"><i class="layui-icon layui-icon-delete"></i></a> }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (!Model.Files.Any()) { <div class="ems-empty">暂无文件</div> }
            </div>

            <!-- 操作日志 -->
            <div class="layui-tab-item">
                <div class="ems-timeline">
                    @foreach (var log in Model.Logs.OrderByDescending(l => l.OperAt))
                    {
                        <div class="ems-timeline-item">
                            <span class="dot pending"></span>
                            <div class="content">
                                <div class="desc"><span class="layui-font-12"><i class="layui-icon layui-icon-time"></i> @log.OperAt.ToString("yyyy-MM-dd HH:mm") @log.OperBy</span></div>
                                <div class="title">@log.Title</div>
                                @if (!string.IsNullOrEmpty(log.Content)) { <div class="desc">@log.Content</div> }
                            </div>
                        </div>
                    }
                    @if (!Model.Logs.Any()) { <div class="ems-empty">暂无操作日志</div> }
                </div>
            </div>

        </div>
    </div>
</div>

