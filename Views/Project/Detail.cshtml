@section Scripts {
<script>
    var projId = @Model.Id;
    var projName = document.getElementById('hfProjName').value;
    var _layerIdx = {};

function getAntiForgery() {
    var el = document.querySelector('input[name="__RequestVerificationToken"]');
    return el ? el.value : '';
}
var antiForgery = getAntiForgery();

window.openModal = function (id, title, area) {
    _layerIdx[id] = layer.open({
        type: 1, skin: 'ems-layer', title: title, area: area || ['480px'],
        content: $('#' + id), shadeClose: false,
        success: function () { if (layui.form) layui.form.render('select'); }
    });
};
    window.closeModal = function (id) { if (_layerIdx[id]) { layer.close(_layerIdx[id]); _layerIdx[id] = null; } };
    window.reloadPage = function () { location.reload(); };

    // ── 状态变更 ──
    window.saveStatus = function () {
        $.ajax({
            url: '/project/status', type: 'POST',
            data: { Id: projId, NewStatus: parseInt($('#newStatus').val()), StatusDate: $('#statusDate').val(), Remark: $('#statusRemark').val(), __RequestVerificationToken: antiForgery },
            success: function (r) {
                if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); }
                else ems.msg(r.message, { icon: 2 });
            }
        });
    };

    // ── 成员管理 ──
    window.saveMember = function () {
        var ratio = parseFloat($('#addRatio').val());
        if (!$('#addEmpId').val()) { ems.msg('请选择员工', { icon: 2 }); return; }
        if (!ratio) { ems.msg('请填写占比', { icon: 2 }); return; }
        $.ajax({
            url: '/project/' + projId + '/members', type: 'POST',
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': antiForgery },
            data: JSON.stringify({
                EmployeeId: parseInt($('#addEmpId').val()),
                Role: $('#addRole').val(),
                DutyDesc: $('#addDuty').val(),
                Ratio: ratio,
                JoinDate: $('#addJoinDate').val()
            }),
            success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); },
            error: function () { ems.msg('请求失败，请重试', { icon: 2 }); }
        });
    };
    window.openEditMember = function (el) {
        var $el = $(el);
        $('#editMemberId').val($el.data('id'));
        $('#editMemberRole').val($el.data('role'));
        $('#editMemberDuty').val($el.data('duty'));
        $('#editMemberRatio').val($el.data('ratio'));
        openModal('editMemberModal', '编辑成员信息', ['460px']);
    };
    window.doEditMember = function () {
        var ratio = parseFloat($('#editMemberRatio').val());
        if (!ratio) { ems.msg('请填写占比', { icon: 2 }); return; }
        $.ajax({
            url: '/project/members/update', type: 'POST',
            contentType: 'application/json',
            headers: { 'RequestVerificationToken': antiForgery },
            data: JSON.stringify({
                Id: parseInt($('#editMemberId').val()),
                Role: $('#editMemberRole').val(),
                DutyDesc: $('#editMemberDuty').val(),
                Ratio: ratio
            }),
            success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); },
            error: function () { ems.msg('请求失败，请重试', { icon: 2 }); }
        });
    };
    window.removeMember = function (el) {
        var id = $(el).data('id'), name = $(el).data('name');
        ems.confirm('确认移除成员 <b>' + ems.escapeHtml(name) + '</b>？移除后可重新添加。', { icon: 3, btn: ['确认移除', '取消'] }, function (i) {
            ems.close(i);
            $.ajax({ url: '/project/' + projId + '/members/' + id + '/remove', type: 'POST', data: { __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };

    // ── 里程碑 ──
    window.openEditMs = function (el) {
        var $el = $(el);
        $('#editMsId').val($el.data('id'));
        $('#msName').val($el.data('name'));
        $('#msType').val($el.data('type') || '');
        $('#msPlanDate').val($el.data('plan'));
        $('#msSort').val($el.data('sort'));
        $('#msRemark').val($el.data('remark'));
        openModal('addMsModal', '编辑工作节点', ['520px']);
    };
    window.saveMs = function () {
        if (!$('#msName').val()) { ems.msg('请填写节点名称', { icon: 2 }); return; }
        if (!$('#msPlanDate').val()) { ems.msg('请选择计划日期', { icon: 2 }); return; }
        var id = $('#editMsId').val();
        var url = id ? '/project/milestones/update' : '/project/' + projId + '/milestones';
        var data = { MilestoneName: $('#msName').val(), MilestoneType: $('#msType').val(), PlanDate: $('#msPlanDate').val(), Sort: parseInt($('#msSort').val()) || 1, AcceptAmount: parseFloat($('#msAmount').val()) || null, Remark: $('#msRemark').val(), __RequestVerificationToken: antiForgery };
        if (id) data.Id = parseInt(id);
        $.ajax({ url: url, type: id ? 'PUT' : 'POST', data: data, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
    };
    window.completeMs = function (el) {
        var id = $(el).data('id');
        ems.confirm('确认标记该节点为已完成？', { icon: 3 }, function (i) {
            ems.close(i);
            $.ajax({ url: '/project/milestones/' + id + '/complete', type: 'POST', data: { __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };

    // ── 验收 ──
    window.saveAccept = function () {
        if (!$('#accBatch').val()) { ems.msg('请填写批次名称', { icon: 2 }); return; }
        var amount = parseFloat($('#accAmount').val());
        if (!amount) { ems.msg('请填写验收金额', { icon: 2 }); return; }
        $.ajax({
            url: '/project/acceptances', type: 'POST',
            data: { ProjectId: projId, AcceptBatch: $('#accBatch').val(), AcceptDate: $('#accDate').val(), AcceptAmount: amount, InvoiceNo: $.trim($('#accInvoice').val()), Remark: $('#accRemark').val(), __RequestVerificationToken: antiForgery },
            success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); }
        });
    };
    window.openAddReceipt = function (contractId) { $('#rcpContract').val(contractId || ''); openModal('addReceiptModal', '新增回款记录', ['760px']); };

    // ── 回款记录 ──
    window.saveReceipt = function () {
        if (!$('#rcpName').val()) { ems.msg('请填写批次名称', { icon: 2 }); return; }
        var amount = parseFloat($('#rcpAmount').val());
        if (!amount) { ems.msg('请填写金额', { icon: 2 }); return; }
        var fd = new FormData();
        fd.append('__RequestVerificationToken', antiForgery);
        fd.append('ProjectId', projId);
        var contractId = $('#rcpContract').val();
        if (contractId) fd.append('ContractId', contractId);
        fd.append('ReceiptName', $('#rcpName').val());
        fd.append('Amount', amount);
        fd.append('InvoiceType', $('#rcpType').val());
        var taxRate = $('#rcpTaxRate').val();
        if (taxRate) fd.append('TaxRate', taxRate);
        var invNo = $('#rcpInvNo').val();
        if (invNo) fd.append('InvoiceNo', invNo);
        var invDate = $('#rcpDate').val();
        if (invDate) fd.append('InvoiceDate', invDate);
        var payer = $('#rcpPayer').val();
        if (payer) fd.append('Payer', payer);
        var remark = $('#rcpRemark').val();
        if (remark) fd.append('Remark', remark);
        var invFile = document.getElementById('rcpInvoiceFile');
        if (invFile.files[0]) fd.append('invoiceFile', invFile.files[0]);
        var payFile = document.getElementById('rcpPaymentFile');
        if (payFile.files[0]) fd.append('paymentFile', payFile.files[0]);
        var load = ems.loading();
        $.ajax({
            url: '/project/' + projId + '/invoices', type: 'POST',
            data: fd, processData: false, contentType: false,
            success: function (r) { ems.close(load); if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); },
            error: function () { ems.close(load); ems.msg('请求失败，请重试', { icon: 2 }); }
        });
    };

    // ── 合同 ──
    window.saveContract = function () {
        if (!$('#ctNo').val() || !$('#ctAmount').val()) { ems.msg('请填写合同编号和金额', { icon: 2 }); return; }
        var fd = new FormData();
        fd.append('__RequestVerificationToken', antiForgery);
        fd.append('ProjectId', projId);
        fd.append('ContractNo', $('#ctNo').val());
        fd.append('ContractType', $('#ctType').val());
        fd.append('PartyA', $('#ctPartyA').val());
        fd.append('PartyB', $('#ctPartyB').val());
        fd.append('Amount', $('#ctAmount').val());
        if ($('#ctSignDate').val()) fd.append('SignDate', $('#ctSignDate').val());
        if ($('#ctStartDate').val()) fd.append('StartDate', $('#ctStartDate').val());
        if ($('#ctEndDate').val()) fd.append('EndDate', $('#ctEndDate').val());
        if ($('#ctRemark').val()) fd.append('Remark', $('#ctRemark').val());
        var fileInput = document.getElementById('ctFile');
        if (fileInput.files[0]) fd.append('file', fileInput.files[0]);
        var load = ems.loading();
        $.ajax({ url: '/project/' + projId + '/contracts', type: 'POST', data: fd, processData: false, contentType: false, success: function (r) { ems.close(load); if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); }, error: function () { ems.close(load); ems.msg('请求失败', { icon: 2 }); } });
    };
    window.delContract = function (el) {
        var id = $(el).data('id'), no = $(el).data('no');
        ems.confirm('确认删除合同 ' + ems.escapeHtml(no || '') + '？', { icon: 3 }, function (i) {
            ems.close(i);
            $.ajax({ url: '/project/' + projId + '/contracts/delete/' + id, type: 'POST', data: { __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };
    window.delContractFile = function (el) {
        var id = $(el).data('id');
        ems.confirm('确认删除该合同附件？合同记录将保留。', { icon: 3, btn: ['确认删除', '取消'] }, function (i) {
            ems.close(i);
            $.ajax({ url: '/project/contracts/file/delete/' + id, type: 'POST', data: { __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };
    window.uploadContractFile = function (contractId, input) {
        if (!input.files[0]) return;
        var fd = new FormData(); fd.append('file', input.files[0]);
        var load = ems.loading();
        $.ajax({ url: '/project/contracts/upload/' + contractId, type: 'POST', data: fd, processData: false, contentType: false, headers: { 'RequestVerificationToken': antiForgery }, success: function (r) { ems.close(load); if (r.success) { ems.msg('上传成功', { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
    };

    // ── 发票 / 回款 ──
    window.confirmReceived = function (invoiceId) {
        var today = new Date().toISOString().split('T')[0];
        ems.prompt({ title: '请输入收款日期', formType: 2, value: today }, function (val, i) {
            ems.close(i);
            if (!val) return;
            $.ajax({ url: '/project/invoices/received/' + invoiceId, type: 'POST', data: { receivedDate: val, __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };
    window.delReceipt = function (el) {
        var id = $(el).data('id');
        ems.confirm('确认删除该回款记录？', { icon: 3, btn: ['确认', '取消'] }, function (i) {
            ems.close(i);
            $.ajax({ url: '/project/invoices/delete/' + id, type: 'POST', data: { __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };
    window.uploadInvoiceFile = function (invId, fileType, input) {
        if (!input.files[0]) return;
        var fd = new FormData(); fd.append('file', input.files[0]);
        var load = ems.loading();
        $.ajax({ url: '/project/invoices/file/' + invId + '/' + fileType, type: 'POST', data: fd, processData: false, contentType: false, headers: { 'RequestVerificationToken': antiForgery }, success: function (r) { ems.close(load); if (r.success) { ems.msg('上传成功', { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
    };

    // ── 文件上传 ──
    window.onFileSelected = function (input) {
        if (!input.files[0]) return;
        var file = input.files[0];
        var now = new Date();
        var defaultVersion = 'V' + String(now.getMonth() + 1).padStart(2, '0') + '.' + String(now.getDate()).padStart(2, '0');
        if (!$('#uploadVersion').val()) $('#uploadVersion').val(defaultVersion);
        if (!$('#uploadDesc').val()) $('#uploadDesc').val(file.name.replace(/\.[^/.]+$/, ''));
        var sizeText = file.size < 1048576 ? (file.size / 1024).toFixed(1) + ' KB' : (file.size / 1048576).toFixed(1) + ' MB';
        $('#previewFileName').text(file.name);
        $('#previewFileSize').text('(' + sizeText + ')');
        $('#previewCategory').text($('#uploadCategory').val());
        $('#previewVersion').text($('#uploadVersion').val() || '未填写');
        $('#previewDesc').text($('#uploadDesc').val() || '未填写');
        $('#uploadPreview').show();
    };
    window.clearFileSelection = function () {
        $('#fileInput').val(''); $('#uploadVersion').val(''); $('#uploadDesc').val(''); $('#uploadPreview').hide();
    };
    window.confirmUpload = function () {
        var input = document.getElementById('fileInput');
        if (!input.files[0]) { ems.msg('请先选择文件', { icon: 2 }); return; }
        var fd = new FormData();
        fd.append('file', input.files[0]);
        fd.append('category', $('#uploadCategory').val());
        fd.append('description', $('#uploadDesc').val());
        var load = ems.loading();
        $.ajax({
            url: '/project/' + projId + '/files', type: 'POST', data: fd, processData: false, contentType: false,
            headers: { 'RequestVerificationToken': antiForgery },
            success: function (r) {
                ems.close(load);
                if (r.success) { ems.msg('上传成功', { icon: 1, time: 1200 }, reloadPage); }
                else ems.msg(r.message || '上传失败', { icon: 2 });
            },
            error: function () { ems.close(load); ems.msg('网络请求失败，请重试', { icon: 2 }); }
        });
    };
    window.deleteFile = function (el) {
        var id = $(el).data('id');
        ems.confirm('确认删除该文件？', { icon: 3 }, function (i) {
            ems.close(i);
            $.ajax({ url: '/project/files/delete/' + id, type: 'POST', data: { __RequestVerificationToken: antiForgery }, success: function (r) { if (r.success) { ems.msg(r.message, { icon: 1, time: 1200 }, reloadPage); } else ems.msg(r.message, { icon: 2 }); } });
        });
    };

    // ── 成果报告 ──
    window.openReportModal = function () {
        openModal('reportGenModal', '生成成果报告', ['760px']);
        loadReportTemplates();
    };
    function loadReportTemplates() {
        fetch('/templatereport/templates', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                var $sel = $('#reportTemplate');
                if (res.code === 200 && res.data && res.data.length) {
                    var opts = '<option value="">请选择报告模板...</option>';
                    res.data.forEach(function (t) { opts += '<option value="' + ems.escapeHtml(t.id) + '">' + ems.escapeHtml(t.name) + (t.description ? '(' + ems.escapeHtml(t.description) + ')' : '') + '</option>'; });
                    $sel.html(opts);
                } else { $sel.html('<option value="">暂无模板，请先到「模板管理」添加</option>'); }
            })
            .catch(function () { $('#reportTemplate').html('<option value="">模板加载失败</option>'); });
    }
    window.loadReportPreview = function () {
        var tid = $('#reportTemplate').val();
        if (!tid) { $('#autoFields').html('<span class="layui-font-12">请先选择模板</span>'); $('#manualFields').html(''); return; }
        var load = ems.loading();
        fetch('/project/' + projId + '/report/preview-fields?templateId=' + encodeURIComponent(tid), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                ems.close(load);
                if (res.code !== 200 || !res.data) { ems.msg(res.message || '加载失败', { icon: 2 }); return; }
                var d = res.data, ah = '';
                (d.autoFields || []).forEach(function (f) { ah += '<div style="margin-bottom:4px"><span class="layui-font-12">' + ems.escapeHtml(f.label) + '：</span>' + ems.escapeHtml(f.value || '(空)') + '</div>'; });
                $('#autoFields').html(ah || '<span class="layui-font-12">无</span>');
                var mh = '';
                (d.manualFields || []).forEach(function (f) {
                    var req = f.required ? ' <span class="layui-font-red">*</span>' : '';
                    var val = f.defaultValue || '';
                    var ctrl = f.type === 'textarea'
                        ? '<textarea class="layui-input" data-name="' + ems.escapeHtml(f.name) + '" data-required="' + (f.required ? '1' : '0') + '" rows="3">' + ems.escapeHtml(val) + '</textarea>'
                        : '<input type="' + (f.type === 'date' ? 'date' : 'text') + '" class="layui-input" data-name="' + ems.escapeHtml(f.name) + '" data-required="' + (f.required ? '1' : '0') + '" value="' + ems.escapeHtml(val) + '">';
                    mh += '<div class="layui-form-item" style="margin-bottom:8px"><label class="layui-form-label" style="width:auto">' + ems.escapeHtml(f.label) + req + '</label><div class="layui-input-block">' + ctrl + '</div></div>';
                });
                $('#manualFields').html(mh);
            })
            .catch(function () { ems.close(load); ems.msg('加载失败', { icon: 2 }); });
    };
    window.confirmReportGenerate = function () {
        var tid = $('#reportTemplate').val();
        if (!tid) { ems.msg('请先选择模板', { icon: 2 }); return; }
        var fields = {}, missing = [];
        $('#manualFields [data-name]').each(function () {
            var n = $(this).data('name'), v = $(this).val();
            fields[n] = v;
            if ($(this).attr('data-required') === '1' && !v) missing.push(n);
        });
        if (missing.length) { ems.msg('请填写必填项：' + missing.join('、'), { icon: 2 }); return; }
        var btn = $('#btnConfirmGen');
        btn.prop('disabled', true).text('生成中...');
        var load = ems.loading();
        fetch('/project/' + projId + '/report/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery, 'X-Requested-With': 'XMLHttpRequest' },
            body: JSON.stringify({ templateId: tid, fields: fields })
        })
            .then(function (r) { if (!r.ok) return r.text().then(function (t) { throw new Error(t || '生成失败'); }); return r.blob(); })
            .then(function (blob) {
                var tname = $('#reportTemplate option:selected').text() || '成果报告';
                var fname = projName + '_' + tname + '.docx';
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a'); a.href = url; a.download = fname;
                document.body.appendChild(a); a.click(); document.body.removeChild(a);
                setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
                ems.msg('报告已生成，开始下载', { icon: 1, time: 1500 });
                closeModal('reportGenModal');
            })
            .catch(function (err) { ems.msg(err.message || '生成失败', { icon: 2 }); })
            .finally(function () { ems.close(load); btn.prop('disabled', false).text('生成并下载'); });
    };

ems.ready(function () {
    if (layui.element) layui.element.render();

    // ── 服务团队与产值：改用事件委托，避免内联 onclick 依赖全局函数 ──
    $(document).on('click', '[data-act="member-add"]', function () {
        openModal('addMemberModal', '添加项目成员', ['460px']);
    });
    $(document).on('click', '[data-act="member-edit"]', function () {
        openEditMember(this);
    });
    $(document).on('click', '[data-act="member-remove"]', function () {
        removeMember(this);
    });

    // 从列表「生成报告」入口直达报告弹窗
    if (new URLSearchParams(location.search).get('report') === '1') {
        setTimeout(openReportModal, 300);
    }
});
</script>
}

@functions {
    string GetFileIcon(string? ext) => ext?.ToLower() switch {
        "pdf"  => "layui-font-red",
        "doc" or "docx" => "layui-font-blue",
        "xls" or "xlsx" => "layui-font-green",
        "jpg" or "jpeg" or "png" => "layui-font-orange",
        "zip" or "rar" => "layui-font-gray",
        _ => ""
    };
}
