@using EnterpriseMS.Services.DTOs.Project
@using EnterpriseMS.Services.DTOs.System
@using EnterpriseMS.Services.DTOs.Hr
@model ProjectDetailDto
@{
    ViewData["Title"] = "新建项目";
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-add-1"></i> 新建项目
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">项目管理</a>
        <a href="javascript:ems.openTab('/project')">项目台账</a>
        <a><cite>新建</cite></a>
    </div>
</div>

<partial name="_ProjectForm" model="new ProjectDetailDto()" />

<div class="ems-form-foot">
    <button type="button" class="layui-btn layui-btn-normal" id="btnSave">保存</button>
    <button type="button" class="layui-btn" id="btnSaveContinue">保存并继续新建</button>
    <button type="button" class="layui-btn layui-btn-primary" onclick="ems.closeSelf('projTable')">取消</button>
</div>

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery;

    function doSave(continueNew) {
        var data = window.collectProjectForm();
        data.ProgressStatus = 0;
        if (!window.validateProjectForm(data)) return;

        var load = ems.loading();
        $.ajax({
            url: '/project/create', type: 'POST', contentType: 'application/json',
            data: JSON.stringify(data),
            success: function (r) {
                ems.close(load);
                if (r.success) {
                    ems.msg(r.message, { icon: 1, time: 1200 }, function () {
                        if (continueNew) {
                            // 清空表单（保留新生成的编号逻辑：编号清空由后端自动生成）
                            document.getElementById('projForm').reset();
                            document.getElementById('jointBlock').style.display = 'none';
                            layui.form.render();
                        } else {
                            ems.closeSelf('projTable');
                        }
                    });
                } else ems.error(r.message);
            },
            error: function (xhr, textStatus) { ems.close(load); ems.error(ems._httpErrorMsg(xhr, '保存失败', textStatus)); }
        });
    }

    $('#btnSave').on('click', function () { doSave(false); });
    $('#btnSaveContinue').on('click', function () { doSave(true); });
});
</script>
}
