@using EnterpriseMS.Services.DTOs.System
@{
    Layout = null;
    var depts   = ViewBag.Depts   as List<DeptTreeDto> ?? new List<DeptTreeDto>();
    var members = ViewBag.Members as List<EnterpriseMS.Services.DTOs.Hr.EmployeeSimpleDto>
                  ?? new List<EnterpriseMS.Services.DTOs.Hr.EmployeeSimpleDto>();
    var projNoPrefixes = ViewBag.ProjNoPrefixes as List<EnterpriseMS.Services.DTOs.System.DictDataDto>
                  ?? new List<EnterpriseMS.Services.DTOs.System.DictDataDto>();
    var projNoPrefix = ViewBag.ProjNoPrefix as string ?? (projNoPrefixes.FirstOrDefault()?.DictValue ?? "");
    var generatedNo  = ViewBag.GeneratedNo  as string ?? "";
}
<form id="createProjForm">
@Html.AntiForgeryToken()

<!-- 步骤条 -->
<div class="card mb-3">
  <div class="card-body py-2">
    <div class="d-flex align-items-center">
      <span id="st1" class="badge badge-primary p-2 mr-2">1 基本信息</span>
      <div class="flex-fill border-top mx-2"></div>
      <span id="st2" class="badge badge-secondary p-2 mr-2">2 其他信息</span>
    </div>
  </div>
</div>

<!-- STEP 1: 基本信息 -->
<div id="step-1">
  <div class="card card-primary card-outline">
    <div class="card-header"><h3 class="card-title">基本信息</h3></div>
    <div class="card-body">
      <!-- 第一行：编号 + 名称 -->
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>项目编号 <small class="text-muted">前缀-序号</small></label>
            <div class="input-group">
              <select id="projNoPrefix" class="form-control" style="max-width:130px" onchange="onPrefixChange()">
                @foreach (var p in projNoPrefixes)
                {
                  <option value="@p.DictValue" selected="@(p.IsDefault==1)">@p.DictLabel</option>
                }
              </select>
              <input type="text" id="projNoSuffix" class="form-control" value="@generatedNo" placeholder="自动生成">
            </div>
            <small class="text-muted" id="projNoCheck"></small>
          </div>
        </div>
        <div class="col-md-8">
          <div class="form-group">
            <label>项目名称 <span class="text-danger">*</span></label>
            <input type="text" id="projName" class="form-control"
                   placeholder="请输入完整项目名称" maxlength="200">
          </div>
        </div>
      </div>
      <!-- 第二行：工程类别 + 项目负责人 -->
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>工程类别 <span class="text-danger">*</span></label>
            <select id="projectCategory" class="form-control">
              <option value="">请选择</option>
              <option>建筑</option><option>安装</option><option>水利</option>
              <option>交通</option><option>市政</option><option>环保</option>
              <option>电力</option><option>通信</option><option>其他</option>
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>项目负责人 <span class="text-danger">*</span></label>
            <select id="projectLeaderId" class="form-control" onchange="syncLeaderRow()">
              <option value="">请选择</option>
              @foreach (var m in members)
              { <option value="@m.Id">@m.Display</option> }
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>承接部门 <span class="text-danger">*</span></label>
            <select id="deptId" class="form-control">
              <option value="">请选择</option>
              @foreach (var d in depts)
              {
                <option value="@d.Id">@d.DeptName</option>
                @foreach (var c in d.Children)
                { <option value="@c.Id">&nbsp;&nbsp;@c.DeptName</option> }
              }
            </select>
          </div>
        </div>
      </div>
      <!-- 第三行：业务类型 + 采购方式 -->
      <div class="row">
        <div class="col-md-6">
          <div class="form-group">
            <label>业务类型 <span class="text-danger">*</span></label>
            <select id="bizType" class="form-control">
              <option value="">请选择</option>
              <optgroup label="工程咨询">
                <option>可行性研究报告</option><option>节能评估报告</option>
                <option>稳评报告</option><option>项目后评价</option>
                <option>概算编制</option><option>预算编制</option><option>结算编制</option>
                <option>概算评审</option><option>预算评审</option><option>结算评审</option>
              </optgroup>
              <optgroup label="规划设计">
                <option>控制性详细规划</option><option>专项规划</option>
                <option>城市更新规划</option><option>概念方案设计</option><option>施工图设计</option>
              </optgroup>
              <optgroup label="其他咨询">
                <option>战略咨询</option><option>专家评审服务</option><option>框架协议服务</option>
              </optgroup>
            </select>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-group">
            <label>采购方式</label>
            <select id="procurementType" class="form-control">
              <option value="">请选择</option>
              <option>竞争性磋商</option><option>询价</option><option>公开招标</option>
              <option>邀请招标</option><option>公开招选</option>
              <option>框架协议采购</option><option>单一来源</option>
            </select>
          </div>
        </div>
      </div>
      <!-- 第四行：业主信息 -->
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>项目业主 <span class="text-danger">*</span></label>
            <input type="text" id="ownerName" class="form-control" placeholder="委托单位全称" maxlength="100">
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>业主联系人</label>
            <input type="text" id="ownerContact" class="form-control" placeholder="姓名">
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>联系人手机</label>
            <input type="text" id="ownerPhone" class="form-control" placeholder="手机号码">
          </div>
        </div>
      </div>
      <!-- 进度状态（从原 step2 移入 step1） -->
      <div class="form-group">
        <label>进度状态 <span class="text-danger">*</span></label>
        <select id="progressStatus" class="form-control">
          <option value="0">前期商务</option><option value="1">预计启动</option>
          <option value="2">标书制作中</option><option value="3">投标/磋商中</option>
          <option value="4">已中标·签订合同中</option>
          <option value="5" selected>已签回合同</option><option value="6">执行中</option>
        </select>
      </div>
      <!-- 预估造价金额（从原金额信息卡移入 step1） -->
      <div class="form-group">
        <label>预估造价金额（万元）</label>
        <div class="input-group" style="max-width:320px">
          <div class="input-group-prepend"><span class="input-group-text">¥</span></div>
          <input type="number" id="limitPrice" class="form-control" placeholder="选填" step="0.01" min="0">
        </div>
      </div>
      <!-- 项目概况 -->
      <div class="form-group">
        <label>项目概况</label>
        <textarea id="projectOverview" class="form-control" rows="3"
                  placeholder="项目背景、规模、主要内容等"></textarea>
      </div>
      <div class="form-group mb-0">
        <label>备注</label>
        <textarea id="remark" class="form-control" rows="2"
                  placeholder="如：开标截止时间、合同金额区间说明等"></textarea>
      </div>
    </div>
  </div>
  <div class="text-right mb-3">
    <button type="button" class="btn btn-primary" onclick="goStep(2)">
      下一步：其他信息 <i class="fas fa-arrow-right"></i>
    </button>
  </div>
</div>

<!-- STEP 2: 其他信息 -->
<div id="step-2" style="display:none">
  <!-- ① 合同信息（第一个卡片，含“是否联合体项目”） -->
  <div class="card card-warning card-outline">
    <div class="card-header"><h3 class="card-title">合同信息</h3></div>
    <div class="card-body">
      <div class="row mb-3">
        <div class="col-md-4">
          <div class="form-group">
            <label>合同金额（万元）<span class="text-danger">*</span></label>
            <div class="input-group">
              <div class="input-group-prepend"><span class="input-group-text">¥</span></div>
              <input type="number" id="contractAmount" class="form-control" placeholder="0.00" step="0.01" min="0">
              <div class="input-group-append"><span class="input-group-text">万</span></div>
            </div>
          </div>
        </div>
      </div>
      <!-- 是否联合体项目：从原“项目属性”卡移入合同信息内 -->
      <div class="form-check mb-2">
        <input type="checkbox" class="form-check-input" id="isJointVenture" onchange="toggleJoint(this.checked)">
        <label class="form-check-label" for="isJointVenture">是否联合体项目</label>
      </div>
      <div id="jointArea" class="row" style="display:none">
        <div class="col-md-4">
          <div class="form-group">
            <label>我方合同占比 <span class="text-danger">*</span></label>
            <div class="input-group">
              <input type="number" id="ourRatio" class="form-control" min="1" max="99" step="0.5" oninput="onJointChange('ratio')">
              <div class="input-group-append"><span class="input-group-text">%</span></div>
            </div>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>我方实际合同额</label>
            <input type="number" id="actualAmt" class="form-control" readonly step="0.01" min="0" oninput="onJointChange('amount')">
          </div>
        </div>
      </div>
      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="contractSigned" onchange="toggleContractInfo(this.checked)">
        <label class="form-check-label" for="contractSigned">已签订合同</label>
      </div>
      <div id="contractInfoArea" style="display:none">
        <div class="row">
          <div class="col-md-4">
            <div class="form-group">
              <label>签订日期</label>
              <input type="date" id="contractSignedDate" class="form-control">
            </div>
          </div>
          <div class="col-md-4">
            <div class="form-group">
              <label>合同扫描件</label>
              <div class="custom-file">
                <input type="file" class="custom-file-input" id="contractScanFile" accept=".pdf,.jpg,.jpeg,.png">
                <label class="custom-file-label" for="contractScanFile">选择文件</label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- ② 参与人员 & 产值占比（第二个卡片） -->
  <div class="card card-success card-outline">
    <div class="card-header">
      <h3 class="card-title">参与人员 & 产值占比</h3>
      <div class="card-tools">
        <button type="button" class="btn btn-sm btn-success" onclick="addMRow()">
          <i class="fas fa-plus"></i> 添加
        </button>
      </div>
    </div>
    <div class="card-body p-0">
      <table class="table table-sm">
        <thead class="thead-light">
          <tr><th>姓名</th><th>角色</th><th>职责描述</th><th width="130">占比</th><th width="36"></th></tr>
        </thead>
        <tbody id="mBody"></tbody>
      </table>
    </div>
    <div class="card-footer">
      占比合计：<strong id="rTotal" class="text-success">0%</strong>
      <span id="rWarn" class="text-warning ml-3" style="display:none">⚠ 占比不足100%（仅提醒）</span>
      <span id="rOver" class="text-danger ml-3" style="display:none">⚠ 占比超过100%</span>
    </div>
  </div>
  <!-- ③ 投标信息（第三个卡片：项目来源 + 三日期） -->
  <div class="card card-info card-outline">
    <div class="card-header"><h3 class="card-title">投标信息</h3></div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <div class="form-group">
            <label>项目来源</label>
            <select id="projectSource" class="form-control">
              <option value="">请选择</option>
              <option>自主承揽</option><option>合作承揽</option>
              <option>投标获取</option><option>客户指定</option><option>其他</option>
            </select>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>开标日期</label>
            <input type="date" id="bidDeadline" class="form-control">
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-group">
            <label>签约日期</label>
            <input type="date" id="signDate" class="form-control">
          </div>
        </div>
      </div>
      <div class="row">
        <div class="col-md-4">
          <div class="form-group mb-0">
            <label>计划完成日期</label>
            <input type="date" id="planEndDate" class="form-control">
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- 工作节点 -->
  <div class="card card-info card-outline">
    <div class="card-header">
      <h3 class="card-title">工作节点</h3>
      <div class="card-tools">
        <button type="button" class="btn btn-sm btn-info" onclick="addMsRow()">
          <i class="fas fa-plus"></i> 新增节点
        </button>
      </div>
    </div>
    <div class="card-body p-0">
      <table class="table table-sm">
        <thead class="thead-light">
          <tr><th>节点名称</th><th width="100">类型</th><th width="140">计划日期</th><th width="120">关联金额（万）</th><th width="36"></th></tr>
        </thead>
        <tbody id="msBody"></tbody>
      </table>
    </div>
  </div>
  <!-- 保存前检查 -->
  <div class="callout callout-info" id="checkList">
    <h5>保存前检查</h5>
    <span id="ck1" class="mr-3">☐ 工程类别</span>
    <span id="ck2" class="mr-3">☐ 项目名称</span>
    <span id="ck3" class="mr-3">☐ 项目业主</span>
    <span id="ck4" class="mr-3">☐ 合同金额</span>
    <span id="ck5">☐ 项目负责人</span>
  </div>
  <div class="d-flex justify-content-between mb-3">
    <button type="button" class="btn btn-default" onclick="goStep(1)">
      <i class="fas fa-arrow-left"></i> 上一步
    </button>
    <button type="button" class="btn btn-success" onclick="submitProj()">
      <i class="fas fa-check"></i> 提交保存
    </button>
  </div>
</div>

</form>

<script>
var af = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
var projNoPrefix = '@projNoPrefix';
var allMembers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    members.Select(m => new { id = m.Id, name = m.RealName })));
var colors = ['#28a745','#007bff','#6f42c1','#fd7e14','#dc3545'];
var mIdx = 0, msIdx = 0;

function goStep(n) {
    $('[id^="step-"]').hide(); $('#step-'+n).show();
    ['st1','st2'].forEach(function(id,i){
        $('#'+id).removeClass('badge-primary badge-secondary')
                 .addClass(i+1===n?'badge-primary':'badge-secondary');
    });
    if (n===2) { syncLeaderRow(); updateChecklist(); }
    window.scrollTo(0,0);
}

function toggleJoint(on) { $('#jointArea').toggle(on); }
function toggleContractInfo(on) { $('#contractInfoArea').toggle(on); }
function onPrefixChange() { projNoPrefix = $('#projNoPrefix').val(); }

function onJointChange(src) {
    var amt = parseFloat($('#contractAmount').val())||0;
    var isJ = $('#isJointVenture').is(':checked');
    if (src === 'ratio') {
        var r = parseFloat($('#ourRatio').val())||100;
        if (isJ && amt > 0) $('#actualAmt').val((amt*r/100).toFixed(2));
    } else {
        var actual = parseFloat($('#actualAmt').val())||0;
        if (isJ && actual > 0 && amt > 0) {
            $('#ourRatio').val((actual/amt*100).toFixed(1));
        }
    }
}

var roles = ['项目负责人','技术负责人','商务负责人','参与人员','其他'];
function mRoleOpts(selected) {
    return roles.map(function(r){ return '<option'+(r===selected?' selected':'')+'>'+r+'</option>'; }).join('');
}
function addMRow(empId, role, duty, ratio, isLeader) {
    var i = mIdx++;
    empId = empId || ''; role = role || '参与人员'; duty = duty || '';
    ratio = (ratio==null?0:ratio);
    var mopts = allMembers.map(function(m){
        return '<option value="'+m.id+'"'+(String(m.id)===String(empId)?' selected':'')+'>'+m.name+'</option>';
    }).join('');
    $('#mBody').append('<tr id="mr'+i+'"'+(isLeader?' data-leader="1"':'')+'>' +
        '<td><select class="form-control form-control-sm mEmp"><option value="">请选择</option>'+mopts+'</select></td>' +
        '<td><select class="form-control form-control-sm mRole">'+mRoleOpts(role)+'</select></td>' +
        '<td><input type="text" class="form-control form-control-sm mDuty" value="'+duty+'" placeholder="职责描述"></td>' +
        '<td><div class="input-group input-group-sm">' +
        '<input type="number" class="form-control mRatio" value="'+ratio+'" min="0" max="100" step="0.5" oninput="updateRatios()">' +
        '<div class="input-group-append"><span class="input-group-text">%</span></div></div></td>' +
        '<td><button type="button" class="btn btn-xs btn-danger" onclick="$(\'#mr'+i+'\').remove();updateRatios()"><i class="fas fa-times"></i></button></td>' +
        '</tr>');
    updateRatios();
}

// 选择项目负责人后自动添加一行（角色=项目负责人，占比默认0）；负责人变更时同步
function syncLeaderRow() {
    var leaderId = $('#projectLeaderId').val();
    var $row = $('#mBody tr[data-leader="1"]');
    if (!leaderId) { $row.remove(); return; }
    if ($row.length) {
        $row.find('.mEmp').val(leaderId);
    } else {
        addMRow(leaderId, '项目负责人', '项目负责人', 0, true);
    }
}

function updateRatios() {
    var total=0;
    $('.mRatio').each(function(){ total+=parseFloat($(this).val())||0; });
    var over = total > 100;
    var under = total < 100 && total > 0;
    $('#rTotal').text(total.toFixed(1)+'%')
        .toggleClass('text-success', !over && !under)
        .toggleClass('text-danger', over);
    $('#rWarn').toggle(under);
    $('#rOver').toggle(over);
}

function addMsRow(name,type,date) {
    var i=msIdx++;
    var types=['调研','方案','评审','报批','交付','回款'];
    var opts=types.map(function(t){ return '<option'+(t===type?' selected':'')+'>'+t+'</option>'; }).join('');
    $('#msBody').append('<tr id="msr'+i+'">' +
        '<td><input type="text" class="form-control form-control-sm msName" value="'+(name||'')+'" placeholder="节点名称"></td>' +
        '<td><select class="form-control form-control-sm msType">'+opts+'</select></td>' +
        '<td><input type="date" class="form-control form-control-sm msDate" value="'+(date||'')+'"></td>' +
        '<td><div class="input-group input-group-sm"><div class="input-group-prepend"><span class="input-group-text">¥</span></div>' +
        '<input type="number" class="form-control msAmt" placeholder="可选" step="0.01" min="0"></div></td>' +
        '<td><button type="button" class="btn btn-xs btn-danger" onclick="$(\'#msr'+i+'\').remove()"><i class="fas fa-times"></i></button></td>' +
        '</tr>');
}

function prefillMs() {
    var biz=$('#bizType').val();
    var presets={
        '控制性详细规划':[['现状调研','调研'],['方案初稿','方案'],['专家评审','评审'],['上报','报批'],['批复归档','交付']],
        '可行性研究报告':[['资料收集','调研'],['初稿提交','方案'],['评审修改','评审'],['成果交付','交付']],
        '施工图设计':    [['方案设计','方案'],['初步设计','方案'],['出图','交付'],['审查通过','交付']],
        '结算编制':      [['资料收集','调研'],['编制报告','方案'],['内审','评审'],['交付','交付']],
    };
    var nodes=presets[biz]||[['成果提交','交付']];
    nodes.forEach(function(n){ addMsRow(n[0],n[1]); });
}

function updateChecklist() {
    var checks={
        'ck1':!!$('#projectCategory').val(), 'ck2':!!$('#projName').val().trim(),
        'ck3':!!$('#ownerName').val().trim(), 'ck4':parseFloat($('#contractAmount').val())>0,
        'ck5':!!$('#projectLeaderId').val(),
    };
    var labels={'ck1':'工程类别','ck2':'项目名称','ck3':'项目业主','ck4':'合同金额','ck5':'项目负责人'};
    $.each(checks,function(id,ok){
        $('#'+id).text((ok?'✓ ':'☐ ')+labels[id])
                 .toggleClass('text-success',ok).toggleClass('text-muted',!ok);
    });
}

function collectData() {
    var ms_list=[]; $('#msBody tr').each(function(){
        var n=$(this).find('.msName').val(), d=$(this).find('.msDate').val();
        if(n&&d) ms_list.push({MilestoneName:n, MilestoneType:$(this).find('.msType').val(),
            PlanDate:d, AcceptAmount:parseFloat($(this).find('.msAmt').val())||null, Sort:ms_list.length+1});
    });
    var mb_list=[]; $('#mBody tr').each(function(){
        var eid=$(this).find('.mEmp').val(), r=parseFloat($(this).find('.mRatio').val())||0;
        if(eid) mb_list.push({EmployeeId:parseInt(eid), Role:$(this).find('.mRole').val()||'参与人员',
            DutyDesc:$(this).find('.mDuty').val(), Ratio:r,
            JoinDate:new Date().toISOString().split('T')[0]});
    });
    return {
        ProjNo: (($('#projNoPrefix').val())||'') + '-' + ($('#projNoSuffix').val()||''),
        ProjName:$('#projName').val().trim(),
        DeptId:parseInt($('#deptId').val())||null, BizType:$('#bizType').val(),
        ProjectCategory:$('#projectCategory').val(),
        ProjectLeaderId:parseInt($('#projectLeaderId').val())||null,
        OwnerName:$('#ownerName').val().trim(), OwnerContact:$('#ownerContact').val(),
        OwnerPhone:$('#ownerPhone').val(), ProcurementType:$('#procurementType').val(),
        LimitPrice:parseFloat($('#limitPrice').val())||null,
        ContractAmount:parseFloat($('#contractAmount').val())||0,
        IsJointVenture:$('#isJointVenture').is(':checked'),
        OurRatio:parseFloat($('#ourRatio').val())||null,
        TechLeaderId:null, BizLeaderId:null,
        BidDeadline:$('#bidDeadline').val()||null,
        SignDate:$('#signDate').val()||null, PlanEndDate:$('#planEndDate').val()||null,
        ProgressStatus:parseInt($('#progressStatus').val()),
        ProjectSource:$('#projectSource').val()||null,
        ProjectOverview:$('#projectOverview').val(), Remark:$('#remark').val(),
        ContractSigned:$('#contractSigned').is(':checked'),
        ContractSignedDate:$('#contractSignedDate').val()||null,
        Members:mb_list, Milestones:ms_list,
    };
}

function submitProj() {
    var d=collectData();
    if(!d.ProjectCategory){layer.msg('请选择工程类别',{icon:2});goStep(1);return;}
    if(!d.ProjName){layer.msg('请填写项目名称',{icon:2});goStep(1);return;}
    if(!d.OwnerName){layer.msg('请填写项目业主',{icon:2});goStep(1);return;}
    if(!d.ProjectLeaderId){layer.msg('请选择项目负责人',{icon:2});goStep(1);return;}
    if(d.ContractAmount<=0){layer.msg('请填写合同金额',{icon:2});goStep(2);return;}
    if(d.IsJointVenture&&!d.OurRatio){layer.msg('联合体须填写我方占比',{icon:2});goStep(2);return;}
    var load=layer.load(1);
    $.ajax({url:'/project/create',type:'POST',contentType:'application/json',
        headers:{'RequestVerificationToken':af}, data:JSON.stringify(d),
        success:function(r){
            layer.close(load);
            if(r.success){layer.msg('创建成功！',{icon:1,time:1500},function(){window.location='/project/'+r.data.id;});}
            else{layer.msg(r.message,{icon:2});}
        },
        error:function(){layer.close(load);layer.msg('请求失败',{icon:2});}
    });
}
</script>
