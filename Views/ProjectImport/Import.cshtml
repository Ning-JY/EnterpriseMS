@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "批量导入项目";
    var depts = ViewBag.Depts as List<EnterpriseMS.Domain.Entities.System.SysDept> ?? new();
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <a href="javascript:ems.openTab('/project','项目管理')" class="layui-font-teal"><i class="layui-icon layui-icon-return"></i></a>
        <i class="layui-icon layui-icon-upload"></i> 批量导入项目
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:ems.openTab('/project','项目管理')">项目管理</a>
        <a><cite>批量导入</cite></a>
    </div>
</div>

<div class="layui-row layui-col-space14">

    <!-- 左侧：操作区 -->
    <div class="layui-col-md7">

        <!-- Step 1 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span class="layui-badge layui-bg-blue">1</span> 下载导入模板
            </div>
            <div class="layui-card-body">
                <p class="layui-font-gray" style="margin-top:0">
                    请先下载标准模板，按照模板格式填写项目数据后再上传。
                    带 <span class="layui-font-red">*</span> 的列为必填项。
                </p>
                <a class="layui-btn layui-btn-normal" href="/project/import/template">
                    <i class="layui-icon layui-icon-download"></i>下载导入模板（Excel）
                </a>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span class="layui-badge layui-bg-blue">2</span> 上传 Excel 文件
            </div>
            <div class="layui-card-body">
                <!-- 拖拽上传区 -->
                <div id="dropZone"
                     class="layui-upload-drag"
                     style="cursor:pointer"
                     onclick="document.getElementById('fileInput').click()"
                     ondragover="event.preventDefault();this.style.background='#e8f4fd'"
                     ondragleave="this.style.background=''"
                     ondrop="handleDrop(event)">
                    <i class="layui-icon layui-icon-upload" style="font-size:50px;color:#bfbfbf"></i>
                    <p class="layui-font-gray" style="margin:6px 0 2px">点击或拖拽文件到此处</p>
                    <p class="layui-font-gray" style="margin:0">支持 .xlsx / .xls，最大 10MB</p>
                    <input type="file" id="fileInput" accept=".xlsx,.xls"
                           class="layui-hide" onchange="onFileSelected(this)">
                </div>

                <!-- 已选文件信息 -->
                <div id="fileInfo" class="ems-alert info layui-hide">
                    <i class="layui-icon layui-icon-file"></i>
                    <span id="fileName"></span>
                    <span class="layui-badge layui-bg-gray" id="fileSize" style="margin-left:8px"></span>
                    <button type="button" class="layui-btn layui-btn-xs layui-btn-primary" style="float:right" onclick="clearFile()">
                        <i class="layui-icon layui-icon-close"></i>
                    </button>
                </div>

                <button class="layui-btn layui-btn-normal layui-btn-fluid" id="importBtn"
                        onclick="doImport()" disabled>
                    <i class="layui-icon layui-icon-upload"></i>开始导入
                </button>

                <!-- 进度条 -->
                <div class="ems-progress layui-hide" id="progressBar" style="margin-top:14px">
                    <span style="width:100%"></span>
                </div>
            </div>
        </div>

        <!-- 导入结果（导入后显示） -->
        <div id="resultCard" class="layui-card ems-card layui-hide">
            <div class="layui-card-header" id="resultHeader">导入结果</div>
            <div class="layui-card-body" id="resultBody"></div>
        </div>
    </div>

    <!-- 右侧：说明和结果 -->
    <div class="layui-col-md5">
        <!-- 字段说明 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-about"></i> 字段说明</div>
            <div class="layui-card-body" style="padding:0">
                <table class="layui-table" lay-size="sm" lay-skin="line" style="margin:0">
                    <thead><tr><th>字段名</th><th style="text-align:center">必填</th><th>说明</th></tr></thead>
                    <tbody>
                        <tr><td>项目编号*</td><td class="layui-font-red" style="text-align:center">✓</td><td>唯一，重复则跳过</td></tr>
                        <tr><td>项目名称*</td><td class="layui-font-red" style="text-align:center">✓</td><td></td></tr>
                        <tr><td>业务类型*</td><td class="layui-font-red" style="text-align:center">✓</td><td>见右侧参考值</td></tr>
                        <tr><td>承接部门</td><td class="layui-font-gray" style="text-align:center">-</td><td>填部门全称</td></tr>
                        <tr><td>项目业主*</td><td class="layui-font-red" style="text-align:center">✓</td><td></td></tr>
                        <tr><td>业主联系人</td><td class="layui-font-gray" style="text-align:center">-</td><td></td></tr>
                        <tr><td>业主联系电话</td><td class="layui-font-gray" style="text-align:center">-</td><td></td></tr>
                        <tr><td>采购方式</td><td class="layui-font-gray" style="text-align:center">-</td><td>见右侧参考值</td></tr>
                        <tr><td>预估造价金额(万元)</td><td class="layui-font-gray" style="text-align:center">-</td><td>数字，可留空</td></tr>
                        <tr><td>合同金额(万元)*</td><td class="layui-font-red" style="text-align:center">✓</td><td>数字</td></tr>
                        <tr><td>是否联合体</td><td class="layui-font-gray" style="text-align:center">-</td><td>填"是"或"否"</td></tr>
                        <tr><td>我方比例(%)</td><td class="layui-font-gray" style="text-align:center">-</td><td>联合体时填数字</td></tr>
                        <tr><td>签约日期</td><td class="layui-font-gray" style="text-align:center">-</td><td>格式：2024-03-01</td></tr>
                        <tr><td>计划完成日期</td><td class="layui-font-gray" style="text-align:center">-</td><td>格式：2024-09-30</td></tr>
                        <tr><td>进展状态</td><td class="layui-font-gray" style="text-align:center">-</td><td>见右侧参考值</td></tr>
                        <tr><td>建设规模</td><td class="layui-font-gray" style="text-align:center">-</td><td>文字描述</td></tr>
                        <tr><td>备注</td><td class="layui-font-gray" style="text-align:center">-</td><td></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 参考值 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-list"></i> 字段参考值</div>
            <div class="layui-card-body">
                <p class="layui-font-gray" style="margin:0 0 4px"><b>承接部门（当前可用）：</b></p>
                <p class="layui-font-gray" style="margin:0 0 10px">@string.Join("、", depts.Select(d => d.DeptName))</p>
                <p class="layui-font-gray" style="margin:0 0 4px"><b>进展状态：</b></p>
                <p class="layui-font-gray" style="margin:0 0 10px">
                    前期商务、预计启动、标书制作中、投标/磋商中、<br>
                    已中标·签合同中、已签回合同、执行中、成果提交、已完成、已终止
                </p>
                <p class="layui-font-gray" style="margin:0 0 4px"><b>采购方式：</b></p>
                <p class="layui-font-gray" style="margin:0">
                    竞争性磋商、询价、公开招标、邀请招标、公开招选、框架协议采购、单一来源
                </p>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script>
var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
var selectedFile = null;

function onFileSelected(input) {
    if (input.files[0]) setFile(input.files[0]);
}

function handleDrop(e) {
    e.preventDefault();
    document.getElementById('dropZone').style.background = '';
    var f = e.dataTransfer.files[0];
    if (f && (f.name.endsWith('.xlsx') || f.name.endsWith('.xls'))) {
        setFile(f);
    } else {
        ems.msg('请上传 .xlsx 或 .xls 文件', { icon: 2 });
    }
}

function setFile(f) {
    selectedFile = f;
    document.getElementById('fileName').textContent = f.name;
    document.getElementById('fileSize').textContent =
        f.size < 1048576 ? (f.size / 1024).toFixed(1) + 'KB' : (f.size / 1048576).toFixed(1) + 'MB';
    document.getElementById('fileInfo').classList.remove('layui-hide');
    document.getElementById('importBtn').disabled = false;
}

function clearFile() {
    selectedFile = null;
    document.getElementById('fileInput').value = '';
    document.getElementById('fileInfo').classList.add('layui-hide');
    document.getElementById('importBtn').disabled = true;
}

function doImport() {
    if (!selectedFile) { ems.msg('请先选择文件', { icon: 2 }); return; }

    var fd = new FormData();
    fd.append('file', selectedFile);

    document.getElementById('importBtn').disabled = true;
    document.getElementById('progressBar').classList.remove('layui-hide');
    document.getElementById('resultCard').classList.add('layui-hide');

    $.ajax({
        url: '/project/import/execute',
        type: 'POST',
        data: fd,
        processData: false,
        contentType: false,
        headers: { 'RequestVerificationToken': antiForgery },
        success: function (r) {
            document.getElementById('progressBar').classList.add('layui-hide');
            document.getElementById('importBtn').disabled = false;
            showResult(r);
        },
        error: function (xhr) {
            document.getElementById('progressBar').classList.add('layui-hide');
            document.getElementById('importBtn').disabled = false;
            ems.msg('请求失败：' + (xhr.responseText || '未知错误'), { icon: 2 });
        }
    });
}

function showResult(r) {
    var card   = document.getElementById('resultCard');
    var header = document.getElementById('resultHeader');
    var body   = document.getElementById('resultBody');
    card.classList.remove('layui-hide');

    if (!r.success) {
        header.textContent = '导入结果';
        body.innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
        return;
    }

    var d = r.data;
    var hasError = d.ErrorCount > 0;
    header.textContent = hasError ? '导入结果（部分失败）' : '导入结果';

    var html = '<div class="layui-row layui-col-space10" style="text-align:center;margin-bottom:12px">'
        + '<div class="layui-col-xs4"><div class="layui-font-green  layui-font-30">' + d.SuccessCount + '</div><div class="layui-font-gray">成功导入</div></div>'
        + '<div class="layui-col-xs4"><div class="layui-font-orange  layui-font-30">' + d.SkipCount + '</div><div class="layui-font-gray">跳过（已存在）</div></div>'
        + '<div class="layui-col-xs4"><div class="layui-font-red  layui-font-30">' + d.ErrorCount + '</div><div class="layui-font-gray">错误</div></div>'
        + '</div>';

    if (d.SuccessList && d.SuccessList.length > 0) {
        html += '<div style="margin-bottom:8px"><span class="layui-badge layui-bg-green">成功</span> ' + d.SuccessList.join('、') + '</div>';
    }
    if (d.SkipList && d.SkipList.length > 0) {
        html += '<div style="margin-bottom:8px"><span class="layui-badge layui-bg-orange">跳过</span><br>' + d.SkipList.join('<br>') + '</div>';
    }
    if (d.ErrorList && d.ErrorList.length > 0) {
        html += '<div style="margin-bottom:8px"><span class="layui-badge layui-bg-red">错误</span><ul class="layui-font-red" style="margin:4px 0 0;padding-left:18px">';
        d.ErrorList.forEach(function (e) { html += '<li>' + e + '</li>'; });
        html += '</ul></div>';
    }

    if (d.SuccessCount > 0) {
        html += '<div style="text-align:center;margin-top:12px"><a class="layui-btn layui-btn-sm layui-btn-normal" href="javascript:ems.openTab(\'/project\',\'项目管理\')">'
            + '<i class="layui-icon layui-icon-right"></i> 查看项目列表</a></div>';
    }

    body.innerHTML = html;
}
</script>
}
