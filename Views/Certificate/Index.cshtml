@using EnterpriseMS.Common.Extensions
@using EnterpriseMS.Services.DTOs.Hr
@using EnterpriseMS.Services.DTOs.System
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "证书管理";
    var userId  = User.GetUserId();
    bool canAdd    = await PermSvc.HasPermAsync(userId, "hr:cert:add");
    bool canEdit   = await PermSvc.HasPermAsync(userId, "hr:cert:edit");
    var employees  = ViewBag.Employees as List<EmployeeSimpleDto> ?? new();
    var certTypes  = ViewBag.CertTypes as List<DictDataDto>       ?? new();
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-rate"></i> 证书管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">HR管理</a>
        <a><cite>证书管理</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="certSearch">
            <div class="layui-inline">
                <input type="text" name="keyword" placeholder="员工 / 证书名称 / 编号"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <select name="status">
                    <option value="">全部状态</option>
                    <option value="0">有效</option>
                    <option value="1">已过期</option>
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="certSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新增证书
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>证书列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="certTable" lay-filter="certTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="certBar">
    {{# if (d.FileName) { }}
    <a class="ems-icon-btn primary" title="下载" lay-event="download"><i class="layui-icon layui-icon-download-circle"></i></a>
    <a class="ems-icon-btn" title="重新上传" lay-event="upload"><i class="layui-icon layui-icon-upload"></i></a>
    <a class="ems-icon-btn warn" title="删除附件" lay-event="delfile"><i class="layui-icon layui-icon-delete"></i></a>
    {{# } else { }}
    <a class="ems-icon-btn" title="上传附件" lay-event="upload"><i class="layui-icon layui-icon-upload"></i></a>
    {{# } }}
    @if (canEdit)
    {
        <text><a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-close"></i></a></text>
    }
</script>

<!-- 新增证书弹窗 -->
<div class="ems-modal-box" id="certModal">
    <div class="layui-form-item">
        <label class="layui-form-label">员工 <span class="layui-font-red">*</span></label>
        <div class="layui-input-block">
            <select id="certEmpId" class="layui-input">
                <option value="">-- 请选择员工 --</option>
                @foreach (var e in employees)
                {
                    <option value="@e.Id">@e.Display</option>
                }
            </select>
        </div>
    </div>
    <div class="layui-form-item">
        <div class="layui-inline" style="width:48%">
            <label class="layui-form-label" style="width:auto">证书名称 <span class="layui-font-red">*</span></label>
            <div class="layui-input-inline" style="width:62%"><input type="text" id="certName" class="layui-input" placeholder="如：注册城乡规划师"></div>
        </div>
        <div class="layui-inline" style="width:48%">
            <label class="layui-form-label" style="width:auto">证书类型</label>
            <div class="layui-input-inline" style="width:62%">
                <select id="certType" class="layui-input">
                    @foreach (var t in certTypes)
                    {
                        <option value="@t.DictValue">@t.DictLabel</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="layui-form-item">
        <div class="layui-inline" style="width:48%">
            <label class="layui-form-label" style="width:auto">证书编号</label>
            <div class="layui-input-inline" style="width:62%"><input type="text" id="certNo" class="layui-input" placeholder="证书编号"></div>
        </div>
        <div class="layui-inline" style="width:48%">
            <label class="layui-form-label" style="width:auto">发证机构</label>
            <div class="layui-input-inline" style="width:62%"><input type="text" id="certOrg" class="layui-input" placeholder="如：住房和城乡建设部"></div>
        </div>
    </div>
    <div class="layui-form-item">
        <div class="layui-inline" style="width:48%">
            <label class="layui-form-label" style="width:auto">发证日期</label>
            <div class="layui-input-inline" style="width:62%"><input type="date" id="certIssue" class="layui-input"></div>
        </div>
        <div class="layui-inline" style="width:48%">
            <label class="layui-form-label" style="width:auto">有效期至</label>
            <div class="layui-input-inline" style="width:62%"><input type="date" id="certExpire" class="layui-input">
                <small class="layui-font-12">留空为长期有效</small>
            </div>
        </div>
    </div>
    <div class="layui-form-item">
        <label class="layui-form-label">证书扫描件</label>
        <div class="layui-input-block"><input type="file" id="certFile" accept=".pdf,.jpg,.jpeg,.png" class="layui-input"></div>
    </div>
    <div class="ems-modal-foot">
        <button class="layui-btn layui-btn-sm" onclick="closeCertModal()">取消</button>
        <button class="layui-btn layui-btn-sm layui-btn-normal" id="certSaveBtn" onclick="saveCert()">保存</button>
    </div>
</div>

<input type="file" id="certFileInput" style="display:none" accept=".pdf,.jpg,.jpeg,.png">

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery;
    layui.form.render();
    var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
    var curUploadId = 0;

    var colsConfig = [
        { field: 'Employee', title: '员工', width: 110,
          templet: function (d) { return '<strong>' + ems.escapeHtml(d.Employee?.RealName || '-') + '</strong>'; } },
        { field: 'CertName', title: '证书名称', minWidth: 160, templet: ems.tpl.text('CertName') },
        { field: 'CertType', title: '类型', width: 120,
          templet: function (d) { return '<span class="layui-badge-rim">' + ems.escapeHtml(d.CertType || '-') + '</span>'; } },
        { field: 'CertNo',   title: '编号', width: 130, templet: function (d) { return d.CertNo ? '<span class="layui-font-12">' + ems.escapeHtml(d.CertNo) + '</span>' : '-'; } },
        { field: 'IssueOrg', title: '发证机构', width: 150, templet: ems.tpl.text('IssueOrg') },
        { field: 'ExpireDate', title: '有效期至', width: 140,
          templet: function (d) {
              if (!d.ExpireDate) return '长期有效';
              var exp = new Date(d.ExpireDate);
              var warn = new Date(); warn.setDate(warn.getDate() + 60);
              var expiring = d.Status === 0 && exp <= warn;
              var cls = expiring ? 'layui-font-red ' : '';
              var html = '<span class="' + cls + '">' + exp.toISOString().slice(0, 10) + '</span>';
              if (expiring) html += ' <span class="layui-badge layui-bg-orange">即将到期</span>';
              return html;
          } },
        { field: 'Status', title: '状态', width: 90, align: 'center',
          templet: ems.tpl.badge('Status', { 0: ['有效', 'green'], 1: ['已过期', 'red'] }) },
        { title: '操作', width: 150, align: 'center', toolbar: '#certBar' }
    ];

    ems.initTable({
        elem: '#certTable', id: 'certTable', url: '/hr/cert/list', cols: [colsConfig],
        tool: {
            download: function (d) { window.location.href = '/hr/cert/download/' + d.Id; },
            upload:   function (d) { curUploadId = d.Id; $('#certFileInput').click(); },
            delfile:  function (d) {
                ems.confirm('确认删除该证书附件？证书记录将保留。', { icon: 3, btn: ['确认删除', '取消'] }, function (i) {
                    ems.close(i);
                    $.post('/hr/cert/file/delete/' + d.Id, { __RequestVerificationToken: antiForgery }, function (r) { if (r.success) ems.msg(r.message, { icon: 1, time: 1200 }, reloadCert); else ems.msg(r.message, { icon: 2 }); });
                });
            },
            del:      function (d) {
                ems.confirm('确认删除证书 <b>' + ems.escapeHtml(d.CertName) + '</b>？', { icon: 3, btn: ['确认删除', '取消'] }, function (i) {
                    ems.close(i);
                    $.post('/hr/cert/delete/' + d.Id, { __RequestVerificationToken: antiForgery }, function (r) { if (r.success) ems.msg(r.message, { icon: 1, time: 1200 }, reloadCert); else ems.msg(r.message, { icon: 2 }); });
                });
            }
        }
    });

    function reloadCert() { layui.table.reload('certTable'); }

    $('#certFileInput').on('change', function () { uploadCert(curUploadId, this); });

    $('#btnAdd').on('click', function () {
        ['certEmpId', 'certName', 'certNo', 'certOrg', 'certIssue', 'certExpire'].forEach(function (id) { $('#' + id).val(''); });
        $('#certFile').val('');
        layui.form.render('select');
        layer.open({ type: 1, title: '新增证书', area: ['640px'], content: $('#certModal'), shadeClose: false,
            success: function () { layui.form.render('select'); } });
    });

    window.closeCertModal = function () { layer.closeAll(); };

    window.saveCert = function () {
        var empId = parseInt($('#certEmpId').val()), name = $('#certName').val();
        if (!empId || !name) { ems.msg('请填写员工和证书名称', { icon: 2 }); return; }
        var fd = new FormData();
        fd.append('EmployeeId', empId);
        fd.append('CertName', name);
        fd.append('CertType', $('#certType').val());
        if ($('#certNo').val())     fd.append('CertNo', $('#certNo').val());
        if ($('#certOrg').val())    fd.append('IssueOrg', $('#certOrg').val());
        if ($('#certIssue').val())  fd.append('IssueDate', $('#certIssue').val());
        if ($('#certExpire').val()) fd.append('ExpireDate', $('#certExpire').val());
        var file = document.getElementById('certFile').files[0];
        if (file) fd.append('file', file);
        $('#certSaveBtn').prop('disabled', true);
        var load = ems.loading(1);
        $.ajax({ url: '/hr/cert/create-with-file', type: 'POST', data: fd, processData: false, contentType: false,
            success: function (r) {
                ems.close(load); $('#certSaveBtn').prop('disabled', false);
                if (r.success) { layer.closeAll(); ems.msg(r.message, { icon: 1, time: 1200 }, reloadCert); }
                else ems.msg(r.message, { icon: 2 });
            },
            error: function () { ems.close(load); $('#certSaveBtn').prop('disabled', false); ems.msg('请求失败', { icon: 2 }); }
        });
    };

    window.uploadCert = function (id, input) {
        if (!input.files[0]) return;
        var fd = new FormData(); fd.append('file', input.files[0]);
        var load = ems.loading(1);
        $.ajax({ url: '/hr/cert/upload/' + id, type: 'POST', data: fd, processData: false, contentType: false,
            headers: { 'RequestVerificationToken': antiForgery },
            success: function (r) { ems.close(load); input.value = ''; if (r.success) ems.msg('上传成功', { icon: 1, time: 1200 }, reloadCert); else ems.msg(r.message, { icon: 2 }); },
            error: function () { ems.close(load); input.value = ''; ems.msg('上传失败', { icon: 2 }); }
        });
    };

    $('#btnFilter').on('click', function () { ems.colFilter('certTable', colsConfig); });
    $('#btnExport').on('click', function () { ems.exportMenu('certTable', '证书列表'); });

    ems.bindSearch('certSearch', 'certTable');
});
</script>
}
