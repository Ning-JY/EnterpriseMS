@{
    ViewData["Title"] = "Debug 工具";
    var stats   = ViewBag.Stats   as Dictionary<string, int>   ?? new();
    var pending = ViewBag.Pending as List<string>               ?? new();
    var applied = ViewBag.Applied as List<string>               ?? new();
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-bug"></i> Debug 工具
        <span class="layui-badge layui-bg-orange" style="margin-left:8px;font-size:12px">仅超管可见</span>
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>Debug 工具</cite></a>
    </div>
</div>

<div class="ems-alert warn">
    <i class="layui-icon layui-icon-tips"></i>
    <b>注意：</b>此页面仅用于开发测试阶段。种子数据写入为<b>幂等操作</b>，
    已存在的记录（按主键判断）会自动跳过，不会覆盖业务数据。
</div>

<div class="layui-row layui-col-space14">

    <!-- 左列：操作区 -->
    <div class="layui-col-md7">

        <!-- 快捷操作：仅写入菜单/权限 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-light"></i> 快速补充菜单和字典</div>
            <div class="layui-card-body">
                <p class="layui-font-gray" style="margin-top:0">
                    仅写入菜单、角色菜单、字典类型、字典数据。
                    适合版本升级后<strong>补充新菜单权限</strong>而不重建数据库时使用。
                </p>
                <button class="layui-btn layui-btn-warm" id="seedMenuBtn" onclick="seedMenu()">
                    <i class="layui-icon layui-icon-list"></i> 写入菜单 / 字典种子数据
                </button>
                <div id="seedMenuResult" style="margin-top:12px"></div>
            </div>
        </div>

        <!-- 写入全量种子数据 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-form"></i> 写入全量种子数据</div>
            <div class="layui-card-body">
                <p class="layui-font-gray" style="margin-top:0">
                    写入所有表的种子数据（部门、用户、员工、项目等），已存在的记录自动跳过。
                    适合首次部署或新增了种子数据后补充。
                </p>
                <input type="text" id="seedConfirm" class="layui-input" placeholder="输入 CONFIRM 确认操作">
                <button class="layui-btn layui-btn-danger" style="margin-top:10px" onclick="seedAll()">
                    <i class="layui-icon layui-icon-play"></i> 执行
                </button>
                <div id="seedResult" style="margin-top:12px"></div>
            </div>
        </div>

        <!-- 清空权限缓存 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-clear"></i> 清空权限缓存</div>
            <div class="layui-card-body">
                <p class="layui-font-gray" style="margin-top:0">
                    清空所有在线用户的权限缓存，用户下次操作时会重新从数据库加载权限。
                    适合修改了角色权限后<strong>无需重启服务</strong>立即生效。
                </p>
                <button class="layui-btn layui-btn-normal" onclick="clearCache()">
                    <i class="layui-icon layui-icon-clear"></i> 清空所有用户权限缓存
                </button>
                <div id="cacheResult" style="margin-top:12px"></div>
            </div>
        </div>

        <!-- 执行数据库迁移 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-template-1"></i> 执行数据库迁移</div>
            <div class="layui-card-body">
                @if (!pending.Any())
                {
                    <p class="layui-font-green" style="margin:0 0 8px">
                        <i class="layui-icon layui-icon-ok-circle"></i>
                        数据库已是最新版本（已执行 @applied.Count 个迁移）
                    </p>
                }
                else
                {
                    <p class="layui-font-orange" style="margin:0 0 8px">
                        <i class="layui-icon layui-icon-help"></i>
                        有 <strong>@pending.Count</strong> 个待执行迁移：@string.Join("、", pending)
                    </p>
                }
                <input type="text" id="migrateConfirm" class="layui-input" placeholder="输入 CONFIRM 确认迁移">
                <button class="layui-btn" style="margin-top:10px" onclick="runMigrate()">
                    <i class="layui-icon layui-icon-template-1"></i> 执行迁移
                </button>
                <div id="migrateResult" style="margin-top:12px"></div>
            </div>
        </div>

        <!-- AI 模型配置 -->
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <i class="layui-icon layui-icon-util"></i> AI 模型配置
                <span id="aiStatus" class="layui-badge layui-bg-orange" style="float:right">未加载</span>
            </div>
            <div class="layui-card-body">
                <form class="layui-form" lay-filter="aiForm" onsubmit="return false">
                    <p class="layui-font-gray" style="margin-top:0">
                        配置 AI 服务的 API Key 和模型。保存后<strong>立即生效</strong>，无需重启。
                        支持 OpenAI / DeepSeek / 通义千问等兼容 OpenAI 协议的服务。
                    </p>
                    <div class="layui-form-item" style="margin-bottom:14px">
                        <label class="layui-form-label" style="width:auto;text-align:left;padding-left:0">API Key <span class="layui-font-red">*</span></label>
                        <div class="layui-input-block">
                            <div style="display:flex;gap:6px">
                                <input type="password" id="aiApiKey" class="layui-input" placeholder="sk-...">
                                <button type="button" class="layui-btn layui-btn-primary" style="flex:0 0 auto" onclick="togglePassword('aiApiKey')">
                                    <i class="layui-icon layui-icon-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="layui-form-item" style="margin-bottom:14px">
                        <label class="layui-form-label" style="width:auto;text-align:left;padding-left:0">API Base URL</label>
                        <div class="layui-input-inline" style="width:100%">
                            <input type="text" id="aiBaseUrl" class="layui-input" value="https://api.openai.com/v1">
                        </div>
                    </div>
                    <div class="layui-form-item" style="margin-bottom:14px">
                        <label class="layui-form-label" style="width:auto;text-align:left;padding-left:0">模型</label>
                        <div class="layui-input-inline" style="width:100%">
                            <select id="aiModel" class="layui-input">
                                <option value="gpt-4o">GPT-4o</option>
                                <option value="gpt-4o-mini">GPT-4o Mini</option>
                                <option value="gpt-4-turbo">GPT-4 Turbo</option>
                                <option value="gpt-3.5-turbo">GPT-3.5 Turbo</option>
                                <option value="deepseek-chat">DeepSeek Chat</option>
                                <option value="deepseek-reasoner">DeepSeek Reasoner</option>
                                <option value="qwen-plus">通义千问 Plus</option>
                                <option value="qwen-turbo">通义千问 Turbo</option>
                            </select>
                        </div>
                    </div>
                    <div class="layui-form-item" style="margin-bottom:14px">
                        <label class="layui-form-label" style="width:auto;text-align:left;padding-left:0">自定义模型名称</label>
                        <div class="layui-input-inline" style="width:100%">
                            <input type="text" id="aiCustomModel" class="layui-input" placeholder="如不使用预设，可直接输入模型名称">
                        </div>
                    </div>
                    <button type="button" class="layui-btn layui-btn-normal" onclick="saveAiConfig()" id="aiSaveBtn">
                        <i class="layui-icon layui-icon-edit"></i> 保存配置
                    </button>
                    <button type="button" class="layui-btn layui-btn-primary" onclick="testAiConfig()" id="aiTestBtn">
                        <i class="layui-icon layui-icon-link"></i> 测试连接
                    </button>
                    <div id="aiResult" style="margin-top:12px"></div>
                </form>
            </div>
        </div>

    </div>

    <!-- 右列：数据库状态 -->
    <div class="layui-col-md5">
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <i class="layui-icon layui-icon-table"></i> 当前数据量
                <button type="button" class="layui-btn layui-btn-xs layui-btn-normal" style="float:right;margin-top:8px" onclick="location.reload()">
                    <i class="layui-icon layui-icon-refresh"></i> 刷新
                </button>
            </div>
            <div class="layui-card-body" style="padding:0">
                <table class="layui-table" lay-size="sm" lay-skin="line" style="margin:0">
                    <thead><tr><th>数据表</th><th style="text-align:right">记录数</th><th>状态</th></tr></thead>
                    <tbody>
                        @foreach (var kv in stats)
                        {
                            <tr>
                                <td>@kv.Key</td>
                                <td style="text-align:right">
                                    <strong class="@(kv.Value == 0 ? "layui-font-red" : "layui-font-green")">@kv.Value</strong>
                                </td>
                                <td>
                                    @if (kv.Value == 0)
                                    {
                                        <span class="ems-tag ems-tag-red">空</span>
                                    }
                                    else
                                    {
                                        <span class="ems-tag ems-tag-green">正常</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Migration 历史 -->
        @if (applied.Any())
        {
            <div class="layui-card ems-card">
                <div class="layui-card-header">
                    <i class="layui-icon layui-icon-time"></i> 已执行迁移
                    <span class="layui-badge layui-bg-gray" style="float:right;margin-top:8px">@applied.Count</span>
                </div>
                <div class="layui-card-body">
                    <ul style="margin:0;padding-left:18px;font-size:12px">
                        @foreach (var m in applied.AsEnumerable().Reverse())
                        {
                            <li style="margin-bottom:4px"><i class="layui-icon layui-icon-ok layui-font-green"></i> @m</li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>

</div>

@section Scripts {
<script>
var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

// 快速写入菜单/字典
function seedMenu() {
    if (!confirm('确认写入菜单和字典种子数据？已存在的记录会自动跳过。')) return;
    var btn = document.getElementById('seedMenuBtn');
    btn.disabled = true;
    var load = ems.loading(1, { shade: [0.3, '#000'] });
    $.post('/system/debug/seed-menu', { __RequestVerificationToken: antiForgery },
        function (r) {
            ems.close(load);
            btn.disabled = false;
            var el = document.getElementById('seedMenuResult');
            if (r.success) {
                var html = '<div class="ems-alert teal"><i class="layui-icon layui-icon-ok"></i> ' + r.message + '<ul style="margin:6px 0 0;padding-left:18px">';
                if (Array.isArray(r.data)) r.data.forEach(function (d) { html += '<li>' + d + '</li>'; });
                el.innerHTML = html + '</ul></div>';
            } else {
                el.innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
            }
        }
    );
}

// 全量种子数据
function seedAll() {
    var confirm_val = document.getElementById('seedConfirm').value;
    if (confirm_val !== 'CONFIRM') {
        ems.msg('请输入 CONFIRM 确认操作', { icon: 2 }); return;
    }
    var load = ems.loading(1, { shade: [0.3, '#000'] });
    $.post('/system/debug/seed',
        { confirm: confirm_val, __RequestVerificationToken: antiForgery },
        function (r) {
            ems.close(load);
            var el = document.getElementById('seedResult');
            if (r.success) {
                var html = '<div class="ems-alert teal"><i class="layui-icon layui-icon-ok"></i> <strong>' + r.message + '</strong>';
                var d = r.data;
                if (d.Details && d.Details.length) {
                    html += '<ul style="margin:6px 0 0;padding-left:18px">';
                    d.Details.forEach(function (line) { html += '<li>' + line + '</li>'; });
                    html += '</ul>';
                }
                if (d.Errors && d.Errors.length) {
                    html += '<ul style="margin:6px 0 0;padding-left:18px" class="layui-font-red">';
                    d.Errors.forEach(function (e) { html += '<li>' + e + '</li>'; });
                    html += '</ul>';
                }
                el.innerHTML = html + '</div>';
                document.getElementById('seedConfirm').value = '';
                // 3秒后刷新数据量
                setTimeout(function () { location.reload(); }, 3000);
            } else {
                el.innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
            }
        }
    );
}

// 清空权限缓存
function clearCache() {
    var load = ems.loading(1);
    $.post('/system/debug/clear-cache',
        { __RequestVerificationToken: antiForgery },
        function (r) {
            ems.close(load);
            var el = document.getElementById('cacheResult');
            el.innerHTML = r.success
                ? '<div class="ems-alert teal"><i class="layui-icon layui-icon-ok"></i> ' + r.message + '</div>'
                : '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
        }
    );
}

// 执行迁移
function runMigrate() {
    var confirm_val = document.getElementById('migrateConfirm').value;
    if (confirm_val !== 'CONFIRM') {
        ems.msg('请输入 CONFIRM 确认迁移', { icon: 2 }); return;
    }
    var load = ems.loading(1, { shade: [0.3, '#000'] });
    $.post('/system/debug/migrate',
        { confirm: confirm_val, __RequestVerificationToken: antiForgery },
        function (r) {
            ems.close(load);
            var el = document.getElementById('migrateResult');
            if (r.success) {
                var html = '<div class="ems-alert teal"><i class="layui-icon layui-icon-ok"></i> <strong>' + r.message + '</strong>';
                if (Array.isArray(r.data) && r.data.length) {
                    html += '<ul style="margin:6px 0 0;padding-left:18px">';
                    r.data.forEach(function (m) { html += '<li>' + m + '</li>'; });
                    html += '</ul>';
                }
                el.innerHTML = html + '</div>';
                document.getElementById('migrateConfirm').value = '';
                setTimeout(function () { location.reload(); }, 2000);
            } else {
                el.innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
            }
        }
    );
}

// ── AI 配置 ───────────────────────────────────────────────
function togglePassword(id) {
    var el = document.getElementById(id);
    el.type = el.type === 'password' ? 'text' : 'password';
}

function loadAiConfig() {
    $.get('/system/debug/ai-config', function (r) {
        if (r.success && r.data) {
            var d = r.data;
            document.getElementById('aiApiKey').value = d.apiKey || '';
            document.getElementById('aiBaseUrl').value = d.baseUrl || 'https://api.openai.com/v1';
            document.getElementById('aiCustomModel').value = '';
            // 匹配预设模型
            var sel = document.getElementById('aiModel');
            var matched = false;
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === d.model) { sel.selectedIndex = i; matched = true; break; }
            }
            if (!matched && d.model) document.getElementById('aiCustomModel').value = d.model;
            updateAiStatus(d.apiKey);
        }
    });
}

function updateAiStatus(apiKey) {
    var el = document.getElementById('aiStatus');
    if (apiKey) {
        el.className = 'layui-badge layui-bg-green';
        el.textContent = '已配置';
    } else {
        el.className = 'layui-badge layui-bg-orange';
        el.textContent = 'Demo模式';
    }
}

function getSelectedModel() {
    var custom = document.getElementById('aiCustomModel').value.trim();
    if (custom) return custom;
    return document.getElementById('aiModel').value;
}

function saveAiConfig() {
    var data = {
        apiKey: document.getElementById('aiApiKey').value.trim(),
        baseUrl: document.getElementById('aiBaseUrl').value.trim(),
        model: getSelectedModel()
    };
    var btn = document.getElementById('aiSaveBtn');
    btn.disabled = true;
    $.ajax({
        url: '/system/debug/ai-config',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        headers: { 'RequestVerificationToken': antiForgery },
        success: function (r) {
            btn.disabled = false;
            var el = document.getElementById('aiResult');
            if (r.success) {
                el.innerHTML = '<div class="ems-alert teal"><i class="layui-icon layui-icon-ok"></i> ' + r.message + '</div>';
                updateAiStatus(data.apiKey);
            } else {
                el.innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
            }
        },
        error: function () {
            btn.disabled = false;
            document.getElementById('aiResult').innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> 请求失败</div>';
        }
    });
}

function testAiConfig() {
    var data = {
        apiKey: document.getElementById('aiApiKey').value.trim(),
        baseUrl: document.getElementById('aiBaseUrl').value.trim(),
        model: getSelectedModel()
    };
    if (!data.apiKey) {
        ems.msg('请先输入 API Key', { icon: 2 }); return;
    }
    var btn = document.getElementById('aiTestBtn');
    btn.disabled = true;
    var load = ems.loading(1, { shade: [0.3, '#000'] });
    $.ajax({
        url: '/system/debug/ai-test',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(data),
        headers: { 'RequestVerificationToken': antiForgery },
        success: function (r) {
            ems.close(load);
            btn.disabled = false;
            var el = document.getElementById('aiResult');
            if (r.success) {
                el.innerHTML = '<div class="ems-alert teal"><i class="layui-icon layui-icon-ok"></i> <strong>连接成功！</strong> AI回复：' + r.message + '</div>';
            } else {
                el.innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> ' + r.message + '</div>';
            }
        },
        error: function () {
            ems.close(load);
            btn.disabled = false;
            document.getElementById('aiResult').innerHTML = '<div class="ems-alert warn"><i class="layui-icon layui-icon-close-fill"></i> 请求失败</div>';
        }
    });
}

// 页面加载时读取AI配置
ems.ready(function () {
    layui.form.render('select');
    loadAiConfig();
});
</script>
}
