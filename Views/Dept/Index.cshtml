@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "部门管理";
    var userId  = User.GetUserId();
    bool canAdd  = await PermSvc.HasPermAsync(userId, "sys:dept:add");
    bool canEdit = await PermSvc.HasPermAsync(userId, "sys:dept:edit");
    bool canDel  = await PermSvc.HasPermAsync(userId, "sys:dept:delete");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-console"></i> 部门管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>部门管理</cite></a>
    </div>
</div>

<!-- 搜索卡片：无头部、无字段名，仅控件；新增在右侧 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="deptSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="部门名称 / 负责人"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="deptSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新增顶级部门
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片：筛选/导出在卡片头部 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>部门列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="deptTable" lay-filter="deptTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="deptBar">
    @if (canAdd)
    {
        <text>
        <a class="ems-icon-btn add" title="新增子部门" lay-event="add"><i class="layui-icon layui-icon-add-circle"></i></a>
        </text>
    }
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        </text>
    }
    @if (canDel)
    {
        <text>
        {{# if (!d.HasChildren) { }}
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
        {{# } }}
        </text>
    }
</script>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'DeptName',  title: '部门名称' },
        { field: 'ParentName', title: '上级部门' },
        { field: 'Leader',    title: '负责人', templet: function (d) { return d.Leader || '-'; } },
        { field: 'Phone',     title: '联系电话', templet: function (d) { return d.Phone || '-'; } },
        { field: 'Sort',      title: '排序', align: 'center' },
        { field: 'Status',    title: '状态', align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['停用', 'red'] }) },
        { title: '操作', width: 170, align: 'center', toolbar: '#deptBar' }
    ];

    ems.initTable({
        elem: '#deptTable',
        id:   'deptTable',
        url:  '/system/dept/list',
        cols: [colsConfig],

        tool: {
            add: function (d) {
                ems.openAdd({ title: '新增子部门 - ' + d.DeptName, url: '/system/dept/form?parentId=' + d.Id });
            },
            edit: function (d) {
                ems.openEdit({ title: '编辑部门 - ' + d.DeptName, url: '/system/dept/form?id=' + d.Id });
            },
            del: function (d) {
                ems.del({ url: '/system/dept/delete/' + d.Id, name: d.DeptName, table: 'deptTable' });
            }
        }
    });

    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新增顶级部门', url: '/system/dept/form' });
    });

    $('#btnFilter').on('click', function () {
        ems.colFilter('deptTable', colsConfig);
    });

    $('#btnExport').on('click', function () {
        ems.exportMenu('deptTable', '部门列表');
    });

    ems.bindSearch('deptSearch', 'deptTable');
});
</script>
}
