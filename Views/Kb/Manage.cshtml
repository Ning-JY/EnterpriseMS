@using EnterpriseMS.Domain.Entities.Info
@{
    ViewData["Title"] = "知识库管理";
    var categories = ViewBag.Categories as List<KbCategory> ?? new();
    bool canUpload = ViewBag.CanUpload ?? false;
    bool canDelete = ViewBag.CanDelete ?? false;
    bool canManage = ViewBag.CanManage ?? false;
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-set"></i> 知识库管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="/kb">知识库</a>
        <a><cite>文件管理</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="kbAdminSearch">
            <div class="layui-inline">
                <input type="text" name="keyword" placeholder="搜索文件名" autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <select name="categoryId">
                    <option value="">全部分类</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="kbAdminSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canUpload)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnUpload">
                        <i class="layui-icon layui-icon-upload"></i> 上传文件
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>文件列表</span>
        <span class="layui-badge layui-bg-gray" data-list-count style="margin-left:8px">0</span>
    </div>
    <div class="layui-card-body">
        <table id="kbAdminTable" lay-filter="kbAdminTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="kbAdminBar">
    <a class="ems-icon-btn primary" title="下载" lay-event="download"><i class="layui-icon layui-icon-download-circle"></i></a>
    @if (canManage)
    {
        <a class="ems-icon-btn warning" title="置顶 / 取消置顶" lay-event="pin"><i class="layui-icon layui-icon-praise"></i></a>
    }
    @if (canDelete)
    {
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-close"></i></a>
    }
</script>

<!-- 上传弹窗 -->
<div class="ems-modal-box" id="uploadModal">
    <div class="layui-form-item">
        <label class="layui-form-label">选择文件 <span class="layui-font-red">*</span></label>
        <div class="layui-input-block">
            <input type="file" id="uploadFile" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.png,.jpg,.jpeg,.zip,.rar" class="layui-input">
            <div class="layui-font-12 layui-font-gray" id="uploadFileTip" style="margin-top:4px">支持 PDF、Word、Excel、PPT、图片、压缩包，最大 50MB</div>
        </div>
    </div>
    <div class="layui-form-item">
        <div class="layui-inline">
            <label class="layui-form-label">显示名称</label>
            <div class="layui-input-inline" style="width:200px">
                <input type="text" id="displayName" class="layui-input" placeholder="留空则使用文件名">
            </div>
        </div>
        <div class="layui-inline">
            <label class="layui-form-label">所属分类 <span class="layui-font-red">*</span></label>
            <div class="layui-input-inline" style="width:160px">
                <select id="uploadCategory">
                    <option value="">请选择分类</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="layui-form-item">
        <div class="layui-inline">
            <label class="layui-form-label">版本号</label>
            <div class="layui-input-inline" style="width:200px">
                <input type="text" id="uploadVersion" class="layui-input" placeholder="如：v1.0、2024版">
            </div>
        </div>
        <div class="layui-inline">
            <label class="layui-form-label">说明</label>
            <div class="layui-input-inline" style="width:160px">
                <input type="text" id="uploadDesc" class="layui-input" placeholder="简短描述">
            </div>
        </div>
    </div>
    <div class="layui-form-item">
        <input type="checkbox" id="isPinned" lay-skin="primary" title="置顶显示">
    </div>
    <div class="ems-modal-foot">
        <button class="layui-btn layui-btn-sm" onclick="layer.closeAll()">取消</button>
        <button class="layui-btn layui-btn-sm layui-btn-normal" id="uploadBtn">开始上传</button>
    </div>
</div>

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery;
    layui.form.render();
    var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

    function extChip(ext) {
        ext = (ext || '').toLowerCase();
        var color = 'gray';
        if (ext === 'pdf') color = 'red';
        else if (ext === 'doc' || ext === 'docx') color = 'blue';
        else if (ext === 'xls' || ext === 'xlsx') color = 'green';
        else if (ext === 'ppt' || ext === 'pptx') color = 'orange';
        else if (ext === 'jpg' || ext === 'jpeg' || ext === 'png' || ext === 'gif' || ext === 'bmp') color = 'cyan';
        else if (ext === 'zip' || ext === 'rar' || ext === '7z') color = 'gray';
        return '<span class="layui-badge layui-bg-' + color + '">' + (ext || '?').toUpperCase() + '</span>';
    }

    function adminFileCell(d) {
        var html = '';
        if (d.IsPinned) html += '<span class="layui-badge layui-bg-red">置顶</span> ';
        if (d.Status == 0) html += '<span class="layui-badge layui-bg-gray">已禁用</span> ';
        html += extChip(d.FileExt) + ' <strong>' + ems.escapeHtml(d.FileName) + '</strong>';
        if (d.OriginalName) html += '<div class="layui-font-12 layui-font-gray">' + ems.escapeHtml(d.OriginalName) + '</div>';
        if (d.Description) html += '<div class="layui-font-12 layui-font-gray ems-ellipsis">' + ems.escapeHtml(d.Description) + '</div>';
        return html;
    }

    function reloadKb() { layui.table.reload('kbAdminTable'); }

    var colsConfig = [
        { field: 'FileName', title: '文件名称', minWidth: 260, templet: adminFileCell },
        { field: 'CategoryName', title: '分类', width: 110, templet: ems.tpl.text('CategoryName') },
        { field: 'Version', title: '版本', width: 90, templet: ems.tpl.text('Version') },
        { field: 'FileSizeText', title: '大小', width: 100,
          templet: function (d) { return '<span class="layui-font-12 layui-font-gray">' + ems.escapeHtml(d.FileSizeText) + '</span>'; } },
        { field: 'CreatedBy', title: '上传人', width: 100, templet: ems.tpl.text('CreatedBy') },
        { field: 'CreatedAt', title: '上传时间', width: 120, templet: ems.tpl.date('CreatedAt') },
        { field: 'DownloadCount', title: '下载', width: 90, align: 'center',
          templet: function (d) { return '<span class="layui-badge layui-bg-blue">' + (d.DownloadCount || 0) + '</span>'; } },
        { title: '操作', width: 130, align: 'center', toolbar: '#kbAdminBar' }
    ];

    ems.initTable({
        elem: '#kbAdminTable', id: 'kbAdminTable', url: '/kb/admin-list', cols: [colsConfig],
        tool: {
            download: function (d) { window.location.href = '/kb/download/' + d.Id; },
            pin:     function (d) {
                ems.post({ url: '/kb/pin/' + d.Id, done: function () { reloadKb(); } });
            },
            del:     function (d) {
                ems.del({ url: '/kb/delete/' + d.Id, name: d.FileName, table: 'kbAdminTable' });
            }
        }
    });

    ems.bindSearch('kbAdminSearch', 'kbAdminTable');

    @if (canUpload)
    {
        <text>
        $('#btnUpload').on('click', function () {
            $('#uploadFile').val(''); $('#uploadFileTip').text('支持 PDF、Word、Excel、PPT、图片、压缩包，最大 50MB');
            $('#displayName').val(''); $('#uploadCategory').val('');
            $('#uploadVersion').val(''); $('#uploadDesc').val('');
            $('#isPinned').prop('checked', false); layui.form.render();
            layer.open({ type: 1, skin: 'ems-layer', title: '上传文件', area: ['560px'], content: $('#uploadModal'), shadeClose: false,
                success: function () { layui.form.render(); } });
        });

        $('#uploadFile').on('change', function () {
            $('#uploadFileTip').text(this.files[0] ? this.files[0].name : '支持 PDF、Word、Excel、PPT、图片、压缩包，最大 50MB');
        });

        $('#uploadBtn').on('click', function () {
            var file = document.getElementById('uploadFile').files[0];
            var catId = $('#uploadCategory').val();
            if (!file) { ems.msg('请选择文件', { icon: 2 }); return; }
            if (!catId) { ems.msg('请选择分类', { icon: 2 }); return; }

            var fd = new FormData();
            fd.append('__RequestVerificationToken', antiForgery);
            fd.append('file', file);
            fd.append('categoryId', catId);
            fd.append('displayName', $('#displayName').val());
            fd.append('description', $('#uploadDesc').val());
            fd.append('version', $('#uploadVersion').val());
            fd.append('isPinned', $('#isPinned').is(':checked'));

            var load = ems.loading(1);
            $.ajax({
                url: '/kb/upload', type: 'POST', data: fd,
                processData: false, contentType: false,
                success: function (r) {
                    ems.close(load);
                    if (r.success) { layer.closeAll(); ems.msg(r.message, { icon: 1, time: 1200 }, reloadKb); }
                    else ems.msg(r.message, { icon: 2 });
                },
                error: function () { ems.close(load); ems.msg('上传失败，请重试', { icon: 2 }); }
            });
        });
        </text>
    }
});
</script>
}
