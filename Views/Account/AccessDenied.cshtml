@{
    Layout = null;
    ViewData["Title"] = "无权限";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>无权限 - 企业管理系统</title>
    <!-- 独立页（不参与主框架 iframe）：自包含样式，不依赖 layui / ems.css，避免引用不存在的资源 -->
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f0f2f5;
            color: #1f2d3d;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Microsoft YaHei", sans-serif;
        }
        .box { text-align: center; padding: 24px; }
        .code { font-size: 88px; font-weight: 800; color: #e09000; line-height: 1; margin: 0; }
        .box h3 { font-size: 20px; margin: 14px 0 6px; }
        .box p { color: #8a94a6; margin: 0 0 24px; }
        .btn {
            display: inline-block;
            padding: 0 22px;
            height: 38px;
            line-height: 38px;
            border-radius: 8px;
            background: #0d6b64;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            margin: 0 6px;
        }
        .btn.ghost { background: #f0f0f0; color: #555; }
        .btn:hover { opacity: .92; }
    </style>
</head>
<body>
    <div class="box">
        <p class="code">403</p>
        <h3>您没有权限访问此页面</h3>
        <p>您的账号没有执行此操作的权限，请联系管理员。</p>
        <a class="btn" href="/">返回首页</a>
        <a class="btn ghost" href="javascript:history.back()">返回上页</a>
    </div>
</body>
</html>
