@using EnterpriseMS.Common
@model PagedResultBase

@{
    // PagedResultBase 是强类型，不使用 dynamic
    if (Model == null || Model.Total == 0) { return; }

    var total = Model.Total;
    var curPage = Model.Page;
    var pageSize = Model.PageSize;
    var totalPages = Model.TotalPages;

    bool hasPrev = curPage > 1;
    bool hasNext = curPage < totalPages;
}

<div class="card-footer clearfix">
    <small class="text-muted">
        共 <strong>@total</strong> 条，
        第 <strong>@curPage</strong> / <strong>@totalPages</strong> 页
        &nbsp;(每页 @pageSize 条)
    </small>
    <ul class="pagination pagination-sm m-0 float-right">
        <li class="page-item @(hasPrev ? "" : "disabled")">
            <a class="page-link" href="javascript:goPage(@(curPage - 1))" @(hasPrev ? "" : "tabindex=\"-1\"")>«</a>
        </li>
        @for (int i = Math.Max(1, curPage - 2); i <= Math.Min(totalPages, curPage + 2); i++)
        {
            <li class="page-item @(i == curPage ? "active" : "")">
                <a class="page-link" href="javascript:goPage(@i)">@i</a>
            </li>
        }
        <li class="page-item @(hasNext ? "" : "disabled")">
            <a class="page-link" href="javascript:goPage(@(curPage + 1))" @(hasNext ? "" : "tabindex=\"-1\"")>»</a>
        </li>
    </ul>
</div>

<script>
// 防止多次定义 goPage（多个分页组件共存时只定义一次）
if (typeof goPage === 'undefined') {
    /**
     * 跳转到指定页
     * @@param {number} p - 目标页码
     */
    function goPage(p) {
        if (p < 1) return;
        var form = document.getElementById('searchForm');
        if (!form) {
            // 尝试查找最近的表单
            form = document.querySelector('form');
            if (!form) {
                console.warn('[Pagination] 找不到 id=searchForm 的表单，将使用 URL 参数');
                var url = new URL(window.location.href);
                url.searchParams.set('page', p);
                window.location.href = url.toString();
                return;
            }
        }
        var input = form.querySelector('input[name="page"]');
        if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'page';
            form.appendChild(input);
        }
        input.value = p;
        form.submit();
    }
}
</script>
