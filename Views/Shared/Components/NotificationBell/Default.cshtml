@model EnterpriseMS.Services.DTOs.System.NotificationSummary
@{
    // 通知等级 -> layui 图标 / 文字颜色
    string IconFor(string level) => level switch
    {
        "danger"  => "layui-icon-close-fill layui-font-red",
        "warning" => "layui-icon-about layui-font-orange",
        "success" => "layui-icon-ok-circle layui-font-green",
        _         => "layui-icon-tips layui-font-blue"
    };
    string BadgeText(int n) => n > 99 ? "99+" : n.ToString();
}
<li class="layui-nav-item">
    <a href="javascript:;" title="通知">
        <i class="layui-icon layui-icon-notice"></i>
        @if (Model.UnreadCount > 0)
        {
            <span class="layui-badge">@BadgeText(Model.UnreadCount)</span>
        }
    </a>
    <dl class="layui-nav-child" style="width:320px">
        <dd class="layui-nav-item-none">
            <a href="javascript:;">@Model.UnreadCount 条未读通知</a>
        </dd>

        @if (Model.Items.Count == 0)
        {
            <dd><a href="javascript:;">暂无通知</a></dd>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <dd>
                    <a href="javascript:;"
                       data-notif-id="@item.Id"
                       data-notif-link="@item.Link"
                       data-url="@(item.Link ?? "/notification")"
                       data-title="通知详情">
                        <i class="layui-icon @IconFor(item.Level)"></i>
                        @item.Title
                        <span class="layui-badge layui-bg-gray">@item.CreatedAt.ToString("MM-dd")</span>
                    </a>
                </dd>
            }
        }

        <hr>
        <dd><a href="javascript:;" data-url="/notification" data-title="通知中心">查看全部通知</a></dd>
    </dl>
</li>
