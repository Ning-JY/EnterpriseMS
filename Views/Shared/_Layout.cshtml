@*
    内页布局（iframe 内容页）
    ------------------------------------------------------------------
    整站采用 layuiAdmin 风格：Home/Index.cshtml 是外层主框架（菜单 + 单页 iframe），
    所有业务页面都跑在 iframe 里，统一使用本布局。
    _ViewStart 已把 Layout 默认指到这里，业务视图无需再声明。

    约定：
      · 只引 layui 原生资源，不引 Bootstrap / AdminLTE / FontAwesome
      · 自定义样式统一收敛到 css/ems.css（全站唯一样式入口）
      · 公共交互全部走 js/ems.js，页面里只写业务差异部分（尽量不带 style / 脚本）
*@
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "企业管理系统")</title>
    <link rel="stylesheet" href="~/lib/layui/css/layui.css">
    <link rel="stylesheet" href="~/css/ems.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ems-page @(Context.Request.Query["_dialog"] == "1" ? "ems-dialog" : "")">
@Html.AntiForgeryToken()

@RenderBody()

<script src="~/lib/layui/layui.js"></script>
<script src="~/js/ems.js" asp-append-version="true"></script>
<script>
// 直接在地址栏访问内页时（不在主框架 iframe 内），跳回主框架并自动打开对应标签，
// 避免出现一张没有菜单的裸页面。弹层表单页带 _dialog=1，不参与跳转。
(function () {
    var isDialog = location.search.indexOf('_dialog=1') > -1;
    if (!isDialog && window.top === window.self) {
        location.replace('/?redirect=' + encodeURIComponent(location.pathname + location.search));
    }
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
