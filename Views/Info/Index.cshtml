@using EnterpriseMS.Domain.Entities.Info
@model List<InfoArticle>
@{
    ViewData["Title"] = "通知公告";
    var cats = ViewBag.Categories as List<InfoCategory> ?? new();
    var curCatId = ViewBag.CategoryId as long?;
    var total = (int)(ViewBag.Total ?? 0);
    var page = (int)(ViewBag.Page ?? 1);
}

<section class="content"><div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-bullhorn mr-2 text-primary"></i>通知公告</h3>
        </div>
        <div class="card-body">
            <!-- 分类筛选 -->
            <div class="mb-3">
                <a href="/pub" class="badge @(curCatId == null ? "badge-primary" : "badge-light") p-2 mr-1">全部</a>
                @foreach (var c in cats)
                {
                    <a href="/pub?categoryId=@c.Id"
                       class="badge @(curCatId == c.Id ? "badge-primary" : "badge-light") p-2 mr-1">@c.CategoryName</a>
                }
            </div>

                @if (Model.Any())
                {
                    foreach (var a in Model)
                    {
                        <div class="card card-outline card-outline-primary shadow-sm mb-3">
                            <div class="card-body">
                                <h5 class="mb-1">
                                    <a href="/pub/Detail/@a.Id" class="text-dark">@a.Title</a>
                                    @if (a.IsTop == 1) { <span class="badge badge-danger ml-1">置顶</span> }
                                    @if (a.Status == 0) { <span class="badge badge-secondary ml-1">草稿</span> }
                                </h5>
                                <div class="text-muted small mb-2">
                                    <span class="badge badge-info mr-1">@(a.Category?.CategoryName ?? "未分类")</span>
                                    <i class="far fa-clock mr-1"></i>@(a.PublishTime?.ToString("yyyy-MM-dd") ?? a.CreatedAt.ToString("yyyy-MM-dd"))
                                    <span class="ml-2"><i class="far fa-eye mr-1"></i>@a.ViewCount</span>
                                </div>
                                <p class="text-muted mb-2">
                                    @(string.IsNullOrEmpty(a.Content)
                                        ? "（暂无内容）"
                                        : (a.Content.Length > 120 ? a.Content.Substring(0, 120) + "…" : a.Content))
                                </p>
                                <a href="/pub/Detail/@a.Id" class="btn btn-sm btn-outline-primary">阅读全文</a>
                            </div>
                        </div>
                    }

                    {
                        var paged = new EnterpriseMS.Common.PagedResult<InfoArticle>
                        {
                            Items = Model, Total = total, Page = page, PageSize = 12,
                        };
                        <partial name="_Pagination" model="paged" />
                    }
                }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="fas fa-inbox fa-3x mb-3"></i>
                    <p>暂无公开公告</p>
                </div>
            }
        </div>
    </div>
</div></section>
