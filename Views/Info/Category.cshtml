@using EnterpriseMS.Domain.Entities.Info
@using System.Text.Encodings.Web
@model List<InfoCategory>
@{
    ViewData["Title"] = "公告分类管理";
}
@section Styles {
    <style>.cat-desc { max-width: 360px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }</style>
}

<div class="content-header"><div class="container-fluid">
    <div class="row mb-2">
        <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-tags mr-2"></i>分类管理</h1></div>
        <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
                <li class="breadcrumb-item"><a href="/">首页</a></li>
                <li class="breadcrumb-item"><a href="/info/manage">资讯公告</a></li>
                <li class="breadcrumb-item active">分类管理</li>
            </ol>
        </div>
    </div>
</div></div>

<section class="content"><div class="container-fluid">

    <!-- 操作区 -->
    <div class="card card-default search-card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-10"></div>
                <div class="col-md-2 text-right">
                    <button type="button" class="btn btn-success btn-sm" onclick="openCategoryModal(0)">
                        <i class="fas fa-plus"></i> 新建分类
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 列表 -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">共 @Model.Count 个</h3>
        </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-sm table-hover">
            <thead class="thead-light">
                <tr><th>名称</th><th>排序</th><th>公开</th><th>状态</th><th class="text-center">操作</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr class="@(c.Status == 0 ? "table-secondary" : "")">
                        <td><strong>@c.CategoryName</strong></td>
                        <td>@c.Sort</td>
                        <td>@(c.IsPublic == 1 ? "是" : "否")</td>
                        <td>
                            @if (c.Status == 1)
                            {
                                <span class="badge badge-success">启用</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">禁用</span>
                            }
                        </td>
                        <td class="text-center">
                            <button class="btn btn-xs btn-primary mr-1" onclick="openCategoryModal(@c.Id)" title="编辑">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn btn-xs btn-danger"
                                    onclick="deleteCategory(@c.Id, '@EncodeHelper.SafeEncode(c.CategoryName)')" title="删除">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">暂无分类</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div></section>

<!-- 分类编辑弹窗 -->
<div class="modal fade" id="catModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title"><i class="fas fa-tags mr-2"></i>分类编辑</h5>
            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
        </div>
        <form id="catForm">
            @Html.AntiForgeryToken()
            <input type="hidden" id="catId" name="id" value="0">
            <div class="modal-body">
                <div class="form-group">
                    <label>分类名称 <span class="text-danger">*</span></label>
                    <input type="text" id="catName" name="categoryName" class="form-control" placeholder="如：公司通知、行业动态" maxlength="50">
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>排序</label>
                            <input type="number" id="catSort" name="sort" class="form-control" value="0">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>状态</label>
                            <select id="catStatus" name="status" class="form-control">
                                <option value="1">启用</option>
                                <option value="0">禁用</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="catPublic" name="isPublic" value="true">
                    <label class="custom-control-label" for="catPublic">公开展示（/pub 筛选项可见）</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">
                    <i class="fas fa-save mr-1"></i> 保存
                </button>
            </div>
        </form>
    </div></div>
</div>

@section Scripts {
<script>
var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

function openCategoryModal(id) {
    var form = document.getElementById('catForm');
    form.reset();
    $('#catId').val(id || 0);
    $('#catSort').val(0);
    $('#catStatus').val(1);
    $('#catPublic').prop('checked', false);
    if (id && id > 0) {
        $.get('/Info/api/category/' + id, function (r) {
            if (r && r.success) {
                var d = r.data;
                $('#catName').val(d.categoryName);
                $('#catSort').val(d.sort);
                $('#catStatus').val(d.status);
                $('#catPublic').prop('checked', d.isPublic == 1);
            } else {
                ems.msg((r && r.message) || '加载失败', { icon: 2 });
            }
        });
    }
    $('#catModal').modal('show');
}

function saveCategory() {
    if (!$('#catName').val().trim()) { ems.msg('请填写分类名称', { icon: 2 }); return; }
    var fd = new FormData(document.getElementById('catForm'));
    $.ajax({
        url: '/Info/api/category/save', type: 'POST', data: fd,
        processData: false, contentType: false,
        success: function (r) { handleResult(r, function () { $('#catModal').modal('hide'); location.reload(); }); },
        error: function () { ems.msg('保存失败，请重试', { icon: 2 }); }
    });
}

function deleteCategory(id, name) {
    ems.confirm('确认删除分类 <b>' + name + '</b>？', { icon: 3, btn: ['确认删除', '取消'] },
        function (i) {
            ems.close(i);
            var fd = new FormData();
            fd.append('__RequestVerificationToken', antiForgery);
            $.ajax({
                url: '/Info/api/category/delete/' + id, type: 'POST', data: fd,
                processData: false, contentType: false,
                success: function (r) { handleResult(r, function () { $('#catModal').modal('hide'); location.reload(); }); },
                error: function () { ems.msg('删除失败', { icon: 2 }); }
            });
        });
}
</script>
}
