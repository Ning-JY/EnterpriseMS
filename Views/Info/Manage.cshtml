@using EnterpriseMS.Domain.Entities.Info
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "公告管理";
    var userId  = User.GetUserId();
    bool canEdit = await PermSvc.HasPermAsync(userId, "info:article:edit");
    var categories = ViewBag.Categories as List<InfoCategory> ?? new();
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-notice"></i> 公告管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">资讯公告</a>
        <a><cite>公告管理</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="infoSearch">
            <div class="layui-inline">
                <input type="text" name="keyword" placeholder="搜索标题" autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <select name="categoryId">
                    <option value="">全部分类</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.CategoryName</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="infoSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canEdit)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新建公告
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>公告列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="infoTable" lay-filter="infoTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="infoBar">
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn primary" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-close"></i></a>
        </text>
    }
</script>

<!-- 公告编辑弹窗 -->
<div class="ems-modal-box" id="articleModal">
    <div class="layui-form-item">
        <div class="layui-inline" style="width:64%">
            <label class="layui-form-label" style="width:auto">标题 <span class="layui-font-red">*</span></label>
            <div class="layui-input-inline" style="width:75%"><input type="text" id="articleTitle" class="layui-input" maxlength="200" placeholder="公告标题"></div>
        </div>
        <div class="layui-inline" style="width:32%">
            <label class="layui-form-label" style="width:auto">分类 <span class="layui-font-red">*</span></label>
            <div class="layui-input-inline" style="width:60%">
                <select id="articleCategory" class="layui-input">
                    <option value="">请选择分类</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.CategoryName</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="layui-form-item layui-form-text">
        <label class="layui-form-label">内容</label>
        <div class="layui-input-block"><textarea id="articleContent" class="layui-textarea" rows="6" placeholder="公告正文（纯文本）"></textarea></div>
    </div>
    <div class="layui-form-item">
        <div class="layui-inline">
            <label class="layui-form-label" style="width:auto">状态</label>
            <div class="layui-input-inline" style="width:120px">
                <select id="articleStatus">
                    <option value="1">已发布</option>
                    <option value="0">草稿</option>
                </select>
            </div>
        </div>
        <div class="layui-inline">
            <input type="checkbox" id="articleTop" lay-skin="primary" title="置顶">
        </div>
        <div class="layui-inline">
            <input type="checkbox" id="articlePublic" lay-skin="primary" title="公开展示（/pub 可见）">
        </div>
    </div>
    <div class="ems-modal-foot">
        <button class="layui-btn layui-btn-sm" onclick="layer.closeAll()">取消</button>
        <button class="layui-btn layui-btn-sm layui-btn-normal" id="saveBtn" onclick="saveArticle()">保存</button>
    </div>
</div>

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery;
    layui.form.render();
    var antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
    var editId = 0;

    var colsConfig = [
        { field: 'Title', title: '标题', minWidth: 240,
          templet: function (d) {
              var html = '';
              if (d.IsTop == 1) html += '<span class="layui-badge layui-bg-red">顶</span> ';
              html += '<strong>' + ems.escapeHtml(d.Title || '') + '</strong>';
              if (d.Content) html += '<div class="layui-font-12 layui-font-gray ems-ellipsis">' + ems.escapeHtml(d.Content) + '</div>';
              return html;
          } },
        { field: 'CategoryName', title: '分类', width: 120, templet: ems.tpl.text('CategoryName') },
        { field: 'Status', title: '状态', width: 90, align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['已发布', 'green'], 0: ['草稿', 'gray'] }) },
        { field: 'IsTop', title: '置顶', width: 80, align: 'center',
          templet: function (d) { return d.IsTop == 1 ? '<span class="layui-font-orange ">是</span>' : '否'; } },
        { field: 'IsPublic', title: '公开', width: 80, align: 'center',
          templet: function (d) { return d.IsPublic == 1 ? '<span class="layui-font-green">是</span>' : '否'; } },
        { field: 'PublishTime', title: '发布时间', width: 120,
          templet: function (d) { return d.PublishTime ? ems.fmtDate(d.PublishTime) : '-'; } },
        { field: 'ViewCount', title: '阅读', width: 80, align: 'center',
          templet: function (d) { return '<span class="layui-badge layui-bg-blue">' + (d.ViewCount || 0) + '</span>'; } },
        { title: '操作', width: 120, align: 'center', toolbar: '#infoBar' }
    ];

    ems.initTable({
        elem: '#infoTable', id: 'infoTable', url: '/Info/ManageList', cols: [colsConfig],
        tool: {
            edit: function (d) { openArticleModal(d.Id); },
            del:  function (d) {
                ems.confirm('确认删除公告 <b>' + ems.escapeHtml(d.Title) + '</b>？', { icon: 3, btn: ['确认删除', '取消'] }, function (i) {
                    ems.close(i);
                    var fd = new FormData(); fd.append('__RequestVerificationToken', antiForgery);
                    $.ajax({ url: '/Info/Delete/' + d.Id, type: 'POST', data: fd, processData: false, contentType: false,
                        success: function (r) { if (r.success) ems.msg(r.message, { icon: 1, time: 1200 }, reloadInfo); else ems.msg(r.message, { icon: 2 }); },
                        error: function () { ems.msg('删除失败', { icon: 2 }); }
                    });
                });
            }
        }
    });

    function reloadInfo() { layui.table.reload('infoTable'); }

    $('#btnAdd').on('click', function () {
        $('#articleTitle').val(''); $('#articleContent').val('');
        $('#articleCategory').val(''); $('#articleStatus').val(1);
        $('#articleTop').prop('checked', false); $('#articlePublic').prop('checked', false);
        layui.form.render();
        layer.open({ type: 1, title: '新建公告', area: ['720px'], content: $('#articleModal'), shadeClose: false,
            success: function () { layui.form.render(); } });
    });

    window.openArticleModal = function (id) {
        editId = id || 0;
        $('#articleTitle').val(''); $('#articleContent').val('');
        $('#articleCategory').val(''); $('#articleStatus').val(1);
        $('#articleTop').prop('checked', false); $('#articlePublic').prop('checked', false);
        layui.form.render();
        if (id && id > 0) {
            $.get('/Info/Article/' + id, function (r) {
                if (r && r.success) {
                    var d = r.data;
                    $('#articleCategory').val(d.categoryId);
                    $('#articleTitle').val(d.title);
                    $('#articleContent').val(d.content);
                    $('#articleTop').prop('checked', d.isTop == 1);
                    $('#articlePublic').prop('checked', d.isPublic == 1);
                    $('#articleStatus').val(d.status);
                    layui.form.render();
                } else { ems.msg((r && r.message) || '加载失败', { icon: 2 }); }
            });
        }
        layer.open({ type: 1, title: id > 0 ? '编辑公告' : '新建公告', area: ['720px'], content: $('#articleModal'), shadeClose: false,
            success: function () { layui.form.render(); } });
    };

    window.saveArticle = function () {
        var title = $('#articleTitle').val().trim();
        var catId = parseInt($('#articleCategory').val());
        if (!title) { ems.msg('请填写标题', { icon: 2 }); return; }
        if (!catId) { ems.msg('请选择分类', { icon: 2 }); return; }
        var fd = new FormData();
        fd.append('__RequestVerificationToken', antiForgery);
        fd.append('id', editId);
        fd.append('categoryId', catId);
        fd.append('title', title);
        fd.append('content', $('#articleContent').val());
        fd.append('isTop', $('#articleTop').is(':checked'));
        fd.append('isPublic', $('#articlePublic').is(':checked'));
        fd.append('status', parseInt($('#articleStatus').val()));
        $('#saveBtn').prop('disabled', true);
        var load = ems.loading(1);
        $.ajax({ url: '/Info/Save', type: 'POST', data: fd, processData: false, contentType: false,
            success: function (r) {
                ems.close(load); $('#saveBtn').prop('disabled', false);
                if (r.success) { layer.closeAll(); ems.msg(r.message, { icon: 1, time: 1200 }, reloadInfo); }
                else ems.msg(r.message, { icon: 2 });
            },
            error: function () { ems.close(load); $('#saveBtn').prop('disabled', false); ems.msg('保存失败，请重试', { icon: 2 }); }
        });
    };

    window.reloadTable = reloadInfo;

    $('#btnFilter').on('click', function () { ems.colFilter('infoTable', colsConfig); });
    $('#btnExport').on('click', function () { ems.exportMenu('infoTable', '公告列表'); });

    ems.bindSearch('infoSearch', 'infoTable');
});
</script>
}
