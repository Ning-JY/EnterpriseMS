@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "菜单管理";
    var userId  = User.GetUserId();
    bool canAdd  = await PermSvc.HasPermAsync(userId, "sys:menu:add");
    bool canEdit = await PermSvc.HasPermAsync(userId, "sys:menu:edit");
    bool canDel  = await PermSvc.HasPermAsync(userId, "sys:menu:delete");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-list"></i> 菜单管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>菜单管理</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="menuSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="菜单名称 / 权限标识"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="menuSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新增顶级菜单
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>菜单列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="menuTable" lay-filter="menuTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="menuBar">
    @if (canAdd)
    {
        <text>
        {{# if (d.MenuType !== 'F') { }}
        <a class="ems-icon-btn add" title="新增子菜单" lay-event="add"><i class="layui-icon layui-icon-add-circle"></i></a>
        {{# } }}
        </text>
    }
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        </text>
    }
    @if (canDel)
    {
        <text>
        {{# if (!d.HasChildren) { }}
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
        {{# } }}
        </text>
    }
</script>

@section Scripts {
<script>
ems.ready(function () {

    // 树形折叠状态：id -> true 表示已折叠
    var collapsed = {};
    var lastRows = [];
    var byId = {};

    function buildIndex() {
        byId = {};
        lastRows.forEach(function (n) { byId[n.Id] = n; });
    }

    // 仅根据折叠状态隐藏/显示行（缩进与图标已由 templet 渲染）
    function applyCollapse() {
        var $view = $('.layui-table-view').filter(function () {
            return $(this).find('table[lay-id="menuTable"]').length > 0;
        });
        var $body = $view.find('.layui-table-body tbody');
        $body.find('tr').each(function (i) {
            var n = lastRows[i];
            if (!n) return;
            var hidden = false, p = n.ParentId || 0;
            while (p && p !== 0) {
                if (collapsed[p]) { hidden = true; break; }
                p = byId[p] ? byId[p].ParentId : 0;
            }
            $(this).toggle(!hidden);
        });
    }

    // 展开 / 折叠
    $(document).on('click', '.ems-tree-arrow', function () {
        var id = $(this).data('id');
        if (collapsed[id]) delete collapsed[id]; else collapsed[id] = true;
        applyCollapse();
    });

    var colsConfig = [
        { field: 'MenuName',   title: '菜单名称', templet: function (d) {
            var depth = d.Depth || 0;
            var indent = 8 + depth * 20;
            var arrow = d.HasChildren
                ? '<i class="layui-icon layui-icon-triangle-d ems-tree-arrow" data-id="' + d.Id + '" style="cursor:pointer;margin-right:6px"></i>'
                : '<span style="display:inline-block;width:14px;margin-right:6px"></span>';
            var icon = d.Icon ? '<i class="layui-icon ' + ems.escapeHtml(d.Icon) + ' ems-menu-icon"></i> ' : '';
            return '<span class="ems-tree-cell" style="padding-left:' + indent + 'px">' + arrow + icon +
                   '<span class="ems-tree-name">' + ems.escapeHtml(d.MenuName) + '</span></span>';
        } },
        { field: 'MenuTypeText', title: '类型', width: 90, align: 'center',
          templet: function (d) {
              var m = { '目录': 'layui-bg-blue', '菜单': 'layui-bg-green', '按钮': 'layui-bg-gray' };
              return '<span class="layui-badge ' + (m[d.MenuTypeText] || 'layui-bg-gray') + '">' + d.MenuTypeText + '</span>';
          } },
        { field: 'Path', title: '路由 / 权限', templet: function (d) {
              var s = '';
              if (d.Path)  s += '<code>' + d.Path + '</code>';
              if (d.Perms) s += ' <span class="layui-badge layui-bg-gray">' + d.Perms + '</span>';
              return s || '-';
          } },
        { field: 'Sort',    title: '排序', width: 80, align: 'center' },
        { field: 'Status',  title: '状态', width: 90, align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['停用', 'red'] }) },
        { title: '操作', width: 170, align: 'center', toolbar: '#menuBar' }
    ];

    ems.initTable({
        elem: '#menuTable',
        id:   'menuTable',
        url:  '/system/menu/list',
        page: false,
        cols: [colsConfig],

        done: function (res) { lastRows = (res && res.data) || []; buildIndex(); applyCollapse(); },

        tool: {
            add: function (d) {
                ems.openAdd({ title: '新增子菜单 - ' + d.MenuName, url: '/system/menu/form?parentId=' + d.Id });
            },
            edit: function (d) {
                ems.openEdit({ title: '编辑菜单 - ' + d.MenuName, url: '/system/menu/form?id=' + d.Id });
            },
            del: function (d) {
                ems.del({ url: '/system/menu/delete/' + d.Id, name: d.MenuName, table: 'menuTable' });
            }
        }
    });

    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新增顶级菜单', url: '/system/menu/form' });
    });

    $('#btnFilter').on('click', function () {
        ems.colFilter('menuTable', colsConfig);
    });

    $('#btnExport').on('click', function () {
        ems.exportMenu('menuTable', '菜单列表');
    });

    ems.bindSearch('menuSearch', 'menuTable');
});
</script>
}
