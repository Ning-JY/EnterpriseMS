@using EnterpriseMS.Domain.Entities.System
@{
    ViewData["Title"] = "系统参数设置";
    var configs = ViewBag.Configs as List<SysConfig> ?? new();
    var systemName = configs.FirstOrDefault(c => c.ConfigKey == "system_name")?.ConfigValue ?? "企业管理系统";
    var systemSubtitle = configs.FirstOrDefault(c => c.ConfigKey == "system_subtitle")?.ConfigValue ?? "";
    var projectNoPrefix = configs.FirstOrDefault(c => c.ConfigKey == "project_no_prefix")?.ConfigValue ?? "";
    var companyName = configs.FirstOrDefault(c => c.ConfigKey == "company_name")?.ConfigValue ?? "";
    var primaryColor = configs.FirstOrDefault(c => c.ConfigKey == "primary_color")?.ConfigValue ?? "#007bff";
    var sidebarStyle = configs.FirstOrDefault(c => c.ConfigKey == "sidebar_style")?.ConfigValue ?? "dark";
    var fontSize = configs.FirstOrDefault(c => c.ConfigKey == "font_size")?.ConfigValue ?? "default";
    var pageSize = configs.FirstOrDefault(c => c.ConfigKey == "page_size")?.ConfigValue ?? "20";
    var sidebarCollapsed = configs.FirstOrDefault(c => c.ConfigKey == "sidebar_collapsed")?.ConfigValue ?? "false";
    var navbarFixed = configs.FirstOrDefault(c => c.ConfigKey == "navbar_fixed")?.ConfigValue ?? "true";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0"><i class="fas fa-sliders-h mr-2"></i>系统参数设置</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item"><a href="/system">系统管理</a></li>
                    <li class="breadcrumb-item active">系统参数设置</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content"><div class="container-fluid">
<div class="card card-primary card-outline">
    <div class="card-header p-0">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#tab-system">基础设置</a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-display">显示设置</a></li>
            <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#tab-navigation">导航栏设置</a></li>
        </ul>
    </div>
    <div class="card-body">
        <form id="configForm">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-system">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>系统名称</label>
                                <input type="text" class="form-control config-input" data-key="system_name" data-type="text" data-group="system" value="@systemName">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>系统副标题</label>
                                <input type="text" class="form-control config-input" data-key="system_subtitle" data-type="text" data-group="system" value="@systemSubtitle">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>项目编号前缀</label>
                                <input type="text" class="form-control config-input" data-key="project_no_prefix" data-type="text" data-group="system" value="@projectNoPrefix" placeholder="如 EMC-">
                                <small class="text-muted">新建项目时自动生成的编号前缀，留空则不加前缀</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>公司名称</label>
                                <input type="text" class="form-control config-input" data-key="company_name" data-type="text" data-group="system" value="@companyName">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-display">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>主色调</label>
                                <input type="color" class="form-control config-input p-1" data-key="primary_color" data-type="color" data-group="display" value="@primaryColor" style="height:38px">
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>侧边栏样式</label>
                                <select class="form-control config-input" data-key="sidebar_style" data-type="text" data-group="display">
                                    <option value="dark" selected="@(sidebarStyle == "dark")">深色</option>
                                    <option value="light" selected="@(sidebarStyle == "light")">浅色</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>字体大小</label>
                                <select class="form-control config-input" data-key="font_size" data-type="text" data-group="display">
                                    <option value="small" selected="@(fontSize == "small")">小</option>
                                    <option value="default" selected="@(fontSize == "default")">默认</option>
                                    <option value="large" selected="@(fontSize == "large")">大</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>表格每页条数</label>
                                <select class="form-control config-input" data-key="page_size" data-type="text" data-group="display">
                                    <option value="10" selected="@(pageSize == "10")">10</option>
                                    <option value="20" selected="@(pageSize == "20")">20</option>
                                    <option value="50" selected="@(pageSize == "50")">50</option>
                                    <option value="100" selected="@(pageSize == "100")">100</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-navigation">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>侧边栏默认状态</label>
                                <select class="form-control config-input" data-key="sidebar_collapsed" data-type="text" data-group="navigation">
                                    <option value="false" selected="@(sidebarCollapsed == "false")">展开</option>
                                    <option value="true" selected="@(sidebarCollapsed == "true")">折叠</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>固定导航栏</label>
                                <select class="form-control config-input" data-key="navbar_fixed" data-type="text" data-group="navigation">
                                    <option value="true" selected="@(navbarFixed == "true")">是</option>
                                    <option value="false" selected="@(navbarFixed == "false")">否</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary" onclick="saveConfigs()">
                    <i class="fas fa-save mr-1"></i> 保存设置
                </button>
                <button type="button" class="btn btn-default ml-2" onclick="location.reload()">
                    <i class="fas fa-undo mr-1"></i> 重置
                </button>
            </div>
        </form>
    </div>
</div>
</div></section>

@section Scripts {
<script>
var af = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
function saveConfigs() {
    var configs = [];
    $('.config-input').each(function() {
        configs.push({
            ConfigKey: $(this).data('key'),
            ConfigValue: $(this).val(),
            ConfigType: $(this).data('type'),
            GroupName: $(this).data('group'),
            Sort: 0
        });
    });
    ajaxPost('/system/config/save', configs, function(r) {
        layer.msg(r.message, {icon: r.success ? 1 : 2, time: 1500});
    });
}
</script>
}
