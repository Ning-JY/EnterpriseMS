@{
    ViewData["Title"] = "操作日志";
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-log"></i> 操作日志
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>操作日志</cite></a>
    </div>
</div>

<!-- 搜索卡片：仅关键字 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="logSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="操作标题 / 操作人"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="logSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片：筛选/导出在卡片头部 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>操作日志</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="logTable" lay-filter="logTable"></table>
    </div>
</div>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'Title',       title: '操作标题' },
        { field: 'BusinessType', title: '业务类型', align: 'center', templet: function (d) {
            var m = { 'INSERT': '新增', 'UPDATE': '修改', 'DELETE': '删除' };
            return m[d.BusinessType] || d.BusinessType || '-';
        } },
        { field: 'Method',  title: '方法' },
        { field: 'OperName', title: '操作人' },
        { field: 'OperIp',  title: 'IP' },
        { field: 'OperTime', title: '操作时间', templet: ems.tpl.dateTime('OperTime') },
        { field: 'Status',  title: '状态', align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['异常', 'red'] }) }
    ];

    ems.initTable({
        elem: '#logTable',
        id:   'logTable',
        url:  '/system/log/list',
        cols: [colsConfig]
    });

    $('#btnFilter').on('click', function () {
        ems.colFilter('logTable', colsConfig);
    });

    $('#btnExport').on('click', function () {
        ems.exportMenu('logTable', '操作日志');
    });

    ems.bindSearch('logSearch', 'logTable');
});
</script>
}
