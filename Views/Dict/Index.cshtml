@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "字典管理";
    var userId  = User.GetUserId();
    bool canAdd  = await PermSvc.HasPermAsync(userId, "sys:dict:add");
    bool canEdit = await PermSvc.HasPermAsync(userId, "sys:dict:edit");
    bool canDel  = await PermSvc.HasPermAsync(userId, "sys:dict:delete");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-template"></i> 字典管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>字典管理</cite></a>
    </div>
</div>

<!-- 主从布局：左 = 字典类型，右 = 业务类型（字典项） -->
<div class="layui-row layui-col-space12 ems-dict-layout">
    <div class="layui-col-md5">
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span>字典类型</span>
                <span class="ems-count-tip">共 <b data-list-count>0</b> 项</span>
                <div class="ems-card-tools">
                    <div class="layui-inline ems-dict-kw">
                        <input type="text" id="typeKeyword" class="layui-input layui-input-sm"
                               placeholder="类型名称 / 编码" autocomplete="off">
                    </div>
                    <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="btnTypeSearch">
                        <i class="layui-icon layui-icon-search"></i> 搜索
                    </button>
                    @if (canAdd)
                    {
                        <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnAdd">
                            <i class="layui-icon layui-icon-add-1"></i> 新增
                        </button>
                    }
                </div>
            </div>
            <div class="layui-card-body">
                <table id="dictTable" lay-filter="dictTable"></table>
            </div>
        </div>
    </div>

    <div class="layui-col-md7">
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span>业务类型</span>
                <span class="ems-dict-current" id="curTypeTip">请先在左侧选择一个字典类型</span>
                <div class="ems-card-tools">
                    <div class="layui-inline ems-dict-kw">
                        <input type="text" id="dataKeyword" class="layui-input layui-input-sm"
                               placeholder="标签 / 键值" autocomplete="off">
                    </div>
                    <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="btnDataSearch">
                        <i class="layui-icon layui-icon-search"></i> 搜索
                    </button>
                    @if (canAdd)
                    {
                        <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnDataAdd" disabled>
                            <i class="layui-icon layui-icon-add-1"></i> 新增业务类型
                        </button>
                    }
                </div>
            </div>
            <div class="layui-card-body">
                <table id="dictDataTable" lay-filter="dictDataTable"></table>
            </div>
        </div>
    </div>
</div>

<!-- 字典类型行操作列 -->
<script type="text/html" id="dictBar">
    <a class="ems-icon-btn" title="查看业务类型" lay-event="view"><i class="layui-icon layui-icon-list"></i></a>
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        </text>
    }
    @if (canDel)
    {
        <text>
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
        </text>
    }
</script>

<!-- 业务类型（字典项）行操作列 -->
<script type="text/html" id="dictDataBar">
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        </text>
    }
    @if (canDel)
    {
        <text>
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
        </text>
    }
</script>

@section Scripts {
<script>
ems.ready(function () {

    var curType = '';       // 当前选中的字典类型编码
    var curTypeName = '';   // 当前选中的字典类型名称
    var canAdd  = @(canAdd ? "true" : "false");
    var allData = [];       // 当前字典类型的全部业务项（本 layui 版本对 url 返回数组不做客户端分页，改用本地 data 分页）

    /* 拉取当前类型的业务项并以本地 data 模式交给 layui 客户端分页 */
    function loadData() {
        if (!curType) { allData = []; layui.table.reloadData('dictDataTable', { data: [] }); return; }
        ems.get('/system/dict/data/list', { dictType: curType, keyword: $('#dataKeyword').val() || '' }, function (list) {
            allData = list || [];
            layui.table.reloadData('dictDataTable', { data: allData, page: { curr: 1 } });
        });
    }

    /* ── 右：业务类型（字典项）—— 先渲染，便于左表 done 回调直接联动 ── */
    function selectType(dictType, dictName) {
        curType = dictType || '';
        curTypeName = dictName || '';
        if (curType) {
            $('#curTypeTip').html('当前：<b>' + ems.escapeHtml(curTypeName) + '</b> <code>' + ems.escapeHtml(curType) + '</code>');
            if (canAdd) $('#btnDataAdd').removeClass('layui-btn-disabled').prop('disabled', false);
        } else {
            $('#curTypeTip').text('请先在左侧选择一个字典类型');
            if (canAdd) $('#btnDataAdd').addClass('layui-btn-disabled').prop('disabled', true);
        }
        loadData();
    }

    ems.initTable({
        elem: '#dictDataTable',
        id:   'dictDataTable',
        page: true,
        pagesize: 10,
        extend: { data: [] },
        cols: [[
            { field: 'DictLabel', title: '字典标签' },
            { field: 'DictValue', title: '字典键值', templet: function (d) { return '<code>' + ems.escapeHtml(d.DictValue) + '</code>'; } },
            { field: 'Sort',      title: '排序', width: 70, align: 'center' },
            { field: 'IsDefault', title: '默认', width: 70, align: 'center',
              templet: function (d) { return d.IsDefault === 1 ? '<span class="layui-badge layui-bg-blue">默认</span>' : '<span class="layui-font-gray">-</span>'; } },
            { field: 'Status',    title: '状态', width: 80, align: 'center',
              templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['停用', 'red'] }) },
            { title: '操作', width: 100, align: 'center', toolbar: '#dictDataBar' }
        ]],

        tool: {
            edit: function (d) {
                ems.openEdit({ title: '编辑业务类型 - ' + d.DictLabel, url: '/system/dict/data/form?id=' + d.Id, end: function () { loadData(); } });
            },
            del: function (d) {
                ems.del({ url: '/system/dict/data/delete/' + d.Id, name: d.DictLabel, done: function () { loadData(); } });
            }
        }
    });

    /* ── 左：字典类型 ───────────────────────────────────── */
    var colsConfig = [
        { field: 'DictName', title: '类型名称' },
        { field: 'DictType', title: '类型编码', templet: function (d) { return '<code>' + d.DictType + '</code>'; } },
        { field: 'Status',   title: '状态', width: 80, align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['停用', 'red'] }) },
        { title: '操作', width: 130, align: 'center', toolbar: '#dictBar' }
    ];

    ems.initTable({
        elem: '#dictTable',
        id:   'dictTable',
        url:  '/system/dict/list',
        pagesize: 10,
        cols: [colsConfig],

        done: function (res, curr, count) {
            // 首次加载或当前选中项已不存在时，自动选中第一行
            var rows = (res && res.data) || [];
            if (!rows.length) { selectType('', ''); return; }
            var hit = null;
            for (var i = 0; i < rows.length; i++) {
                if (rows[i].DictType === curType) { hit = rows[i]; break; }
            }
            var target = hit || rows[0];
            selectType(target.DictType, target.DictName);
            highlightRow(target.DictType);
        },

        tool: {
            view: function (d) { selectType(d.DictType, d.DictName); highlightRow(d.DictType); },
            edit: function (d) {
                ems.openEdit({ title: '编辑字典类型 - ' + d.DictName, url: '/system/dict/form?id=' + d.Id });
            },
            del: function (d) {
                ems.del({ url: '/system/dict/type/delete/' + d.Id, name: d.DictName, table: 'dictTable' });
            }
        }
    });

    // 单击整行也可切换
    layui.table.on('row(dictTable)', function (obj) {
        selectType(obj.data.DictType, obj.data.DictName);
        highlightRow(obj.data.DictType);
    });

    function highlightRow(dictType) {
        var $view = $('.layui-table-view').filter(function () {
            return $(this).find('table[lay-id="dictTable"]').length > 0;
        });
        $view.find('.layui-table-body tbody tr').removeClass('ems-row-active');
        $view.find('.layui-table-body tbody tr').each(function () {
            if ($(this).find('td[data-field="DictType"]').text().trim() === dictType) {
                $(this).addClass('ems-row-active');
            }
        });
    }

    /* ── 业务类型区操作 ─────────────────────────────────── */
    $('#btnDataAdd').on('click', function () {
        if (!curType) { ems.warn('请先在左侧选择一个字典类型'); return; }
        ems.openAdd({
            title: '新增业务类型 - ' + curTypeName,
            url: '/system/dict/data/form?dictType=' + encodeURIComponent(curType),
            end: function () { loadData(); }
        });
    });

    $('#btnDataSearch').on('click', function () {
        loadData();
    });
    $('#dataKeyword').on('keydown', function (e) {
        if (e.keyCode === 13) { e.preventDefault(); $('#btnDataSearch').click(); }
    });

    /* ── 字典类型区操作 ─────────────────────────────────── */
    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新增字典类型', url: '/system/dict/form' });
    });

    $('#btnTypeSearch').on('click', function () {
        ems.reloadTable('dictTable', { keyword: $('#typeKeyword').val() || '' }, true);
    });
    $('#typeKeyword').on('keydown', function (e) {
        if (e.keyCode === 13) { e.preventDefault(); $('#btnTypeSearch').click(); }
    });
});
</script>
}
