@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "系统参数设置";
    var userId = User.GetUserId();
    bool canEdit = await PermSvc.HasPermAsync(userId, "sys:config:edit");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-set"></i> 系统参数设置
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>系统参数</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="configSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="参数键 / 值 / 分组"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="configSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canEdit)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnEdit">
                        <i class="layui-icon layui-icon-edit"></i> 编辑参数
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>参数列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="configTable" lay-filter="configTable"></table>
    </div>
</div>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'GroupName',   title: '分组' },
        { field: 'ConfigKey',   title: '参数键', templet: function (d) { return '<code>' + d.ConfigKey + '</code>'; } },
        { field: 'ConfigValue', title: '参数值' },
        { field: 'ConfigType',  title: '类型', width: 90, align: 'center' },
        { field: 'Sort',        title: '排序', width: 80, align: 'center' }
    ];

    ems.initTable({
        elem: '#configTable',
        id:   'configTable',
        url:  '/system/config/list',
        cols: [colsConfig]
    });

    $('#btnEdit').on('click', function () {
        ems.open({ title: '编辑系统参数', url: '/system/config/form' });
    });

    $('#btnFilter').on('click', function () {
        ems.colFilter('configTable', colsConfig);
    });

    $('#btnExport').on('click', function () {
        ems.exportMenu('configTable', '系统参数');
    });

    ems.bindSearch('configSearch', 'configTable');
});
</script>
}
