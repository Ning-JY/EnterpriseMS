@using EnterpriseMS.Common.Extensions
@{
    ViewData["Title"] = "个人产值统计";
    var stats = Model as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    decimal totC = (decimal)(ViewBag.TotalContractValue ?? 0m);
    bool hasEmployee = Model != null;
    string[] progressText = {
        "前期商务","预计启动","标书制作中","投标/磋商中","已中标签合同中",
        "已签回合同","执行中","成果提交","已完成","已终止"
    };
    // 与上方 progressText 顺序对应的 ems-tag 语义色（替代原 Bootstrap badge-*）
    string[] progressTag = { "gray","gray","orange","orange","blue","blue","teal","teal","green","gray" };
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-chart"></i> 个人产值统计
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a><cite>个人产值统计</cite></a>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="ems-alert warn">
        <i class="layui-icon layui-icon-tips"></i>
        @ViewBag.Error
        <div style="margin-top:8px">
            <a class="layui-btn layui-btn-sm layui-btn-normal" href="javascript:ems.openTab('/system/user','用户管理')">去用户管理绑定员工</a>
        </div>
    </div>
}

@if (!hasEmployee)
{
    <div class="ems-alert warn">
        <i class="layui-icon layui-icon-tips"></i>
        您的账号暂未绑定员工档案，无法统计个人产值。请联系管理员在
        <a class="layui-font-teal" href="javascript:ems.openTab('/system/user','用户管理')">用户管理</a>中绑定员工档案。
    </div>
}
else
{
    var statsList = stats.ToList();
    <div class="ems-stat-cards">
        <div class="ems-stat-card">
            <div class="label"><i class="layui-icon layui-icon-template-1"></i> 参与项目</div>
            <div class="value layui-font-teal layui-font-30">@ViewBag.ProjectCount 个</div>
        </div>
        <div class="ems-stat-card">
            <div class="label"><i class="layui-icon layui-icon-rmb"></i> 合同产值合计</div>
            <div class="value layui-font-green layui-font-30">¥@totC.ToString("N2") 万</div>
        </div>
        <div class="ems-stat-card">
            <div class="label"><i class="layui-icon layui-icon-user"></i> 本人产值合计</div>
            <div class="value layui-font-purple layui-font-30">¥@statsList.Sum(s => (decimal)s.MyContractValue).ToString("N2") 万</div>
        </div>
        <div class="ems-stat-card">
            <div class="label"><i class="layui-icon layui-icon-user"></i> 统计人员</div>
            <div class="value layui-font-blue layui-font-30">@ViewBag.EmployeeName</div>
        </div>
        <div class="ems-stat-card">
            <div class="label"><i class="layui-icon layui-icon-chart"></i> 执行中项目</div>
            <div class="value layui-font-orange layui-font-30">@statsList.Count(s => (int)s.ProgressStatus == 6) 个</div>
        </div>
    </div>

    <div class="layui-card ems-card">
        <div class="layui-card-header">产值明细（本人产值 = 项目实际合同额 × 占比）</div>
        <div class="layui-card-body">
            <table class="layui-table" lay-size="sm" lay-skin="line">
                <thead>
                    <tr>
                        <th>项目编号</th><th>项目名称</th><th>部门</th>
                        <th>职责</th><th>占比</th>
                        <th>合同额（万）</th><th>本人产值（万）</th><th>状态</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in statsList)
                    {
                        decimal sMyContractValue = Convert.ToDecimal(s.MyContractValue);
                        decimal sContractAmount = Convert.ToDecimal(s.ContractAmount);
                        int ps = (int)s.ProgressStatus;
                        <tr>
                            <td><a class="layui-font-teal" href="/project/@s.ProjId"><code>@s.ProjNo</code></a></td>
                            <td><a class="layui-font-teal" href="/project/@s.ProjId"><strong>@s.ProjName</strong></a></td>
                            <td class="layui-font-gray">@(s.DeptName ?? "-")</td>
                            <td><span class="layui-badge layui-bg-gray">@s.Role</span></td>
                            <td>
                                <strong class="layui-font-teal">@s.Ratio.ToString("N2")%</strong>
                                <div class="ems-progress" style="margin-top:4px"><span style="width:@(s.Ratio)%"></span></div>
                            </td>
                            <td class="text-right">¥@sContractAmount.ToString("N2")</td>
                            <td class="text-right layui-font-green"><strong>¥@sMyContractValue.ToString("N2")</strong></td>
                            <td><span class="ems-tag ems-tag-@progressTag[ps]">@progressText[ps]</span></td>
                        </tr>
                    }
                    @if (!statsList.Any())
                    {
                        <tr><td colspan="8" class="ems-empty">暂无参与项目记录</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="layui-row layui-col-space14">
        <div class="layui-col-md6">
            <div class="layui-card ems-card">
                <div class="layui-card-header">按状态统计</div>
                <div class="layui-card-body" style="padding:0">
                    <table class="layui-table" lay-size="sm" lay-skin="line" style="margin:0">
                        <thead><tr><th>状态</th><th>项目数</th><th>产值（万）</th></tr></thead>
                        <tbody>
                            @foreach (var grp in statsList.GroupBy(s => (int)s.ProgressStatus).OrderBy(g => g.Key))
                            {
                                <tr>
                                    <td><span class="ems-tag ems-tag-@progressTag[grp.Key]">@progressText[grp.Key]</span></td>
                                    <td>@grp.Count()</td>
                                    <td><strong>¥@grp.Sum(s => (decimal)s.MyContractValue).ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="layui-col-md6">
            <div class="layui-card ems-card">
                <div class="layui-card-header">按职责统计</div>
                <div class="layui-card-body" style="padding:0">
                    <table class="layui-table" lay-size="sm" lay-skin="line" style="margin:0">
                        <thead><tr><th>职责</th><th>项目数</th><th>产值（万）</th></tr></thead>
                        <tbody>
                            @foreach (var grp in statsList.GroupBy(s => (string)s.Role).OrderByDescending(g => g.Sum(s => (decimal)s.MyContractValue)))
                            {
                                <tr>
                                    <td><span class="layui-badge layui-bg-blue">@grp.Key</span></td>
                                    <td>@grp.Count()</td>
                                    <td class="layui-font-green"><strong>¥@grp.Sum(s => (decimal)s.MyContractValue).ToString("N2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
