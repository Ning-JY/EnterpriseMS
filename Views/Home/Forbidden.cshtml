@{
    ViewData["Title"] = "访问被拒绝";
    Layout = "_Layout";
}
<!-- 居中提示卡片：max-width / margin / text-align 为布局居中所需（已最小化内联） -->
<div class="layui-card" style="max-width:480px;margin:10vh auto 0;text-align:center">
    <div class="layui-card-body" style="padding:44px 24px">
        <i class="layui-icon layui-icon-404 layui-font-orange" style="font-size:56px"></i>
        <h1 class="layui-font-orange" style="margin:14px 0 6px">403</h1>
        <h3 style="margin:0 0 6px">您没有权限访问此页面</h3>
        <p class="layui-font-gray">您的账号没有执行此操作的权限，请联系管理员。</p>
        <div style="margin-top:22px">
            <a class="layui-btn layui-btn-normal" href="javascript:ems.openTab('/','首页')">
                <i class="layui-icon layui-icon-home"></i> 返回首页
            </a>
        </div>
    </div>
</div>
