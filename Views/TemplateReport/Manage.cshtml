@{
    ViewData["Title"] = "成果报告模板管理";
    Layout = "_Layout";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">成果报告模板管理</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item">造价小工具</li>
                    <li class="breadcrumb-item active">成果报告模板</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        <div class="card card-primary card-outline">
            <div class="card-header bg-brand d-flex justify-content-between align-items-center">
                <h3 class="card-title"><i class="fas fa-layer-group mr-1"></i>模板列表</h3>
                <a href="/templatereport/templateconfig" class="btn btn-sm btn-light">
                    <i class="fas fa-plus mr-1"></i>新增模板
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>模板名称</th>
                                <th>描述</th>
                                <th>字段数</th>
                                <th>创建日期</th>
                                <th style="width:230px;">操作</th>
                            </tr>
                        </thead>
                        <tbody id="tplBody">
                            <tr><td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-spinner fa-spin mr-1"></i>加载中…
                            </td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>

@* 字段占位符查看弹窗 *@
<div class="modal fade" id="fieldsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-tags mr-1"></i>模板占位符字段</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-info small">
                    <i class="fas fa-info-circle mr-1"></i>
                    以下为模板内识别到的占位符（<code>{{字段名}}</code>）。在项目详情页生成报告时，系统会以同名项目字段自动填充。
                </div>
                <div id="fieldsContent" class="border rounded p-2" style="max-height:50vh;overflow:auto;">
                    <div class="text-muted text-center py-3">加载中…</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadTemplateList() {
            fetch('/templatereport/templates')
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    var $body = $('#tplBody');
                    if (res.code === 200 && res.data && res.data.length) {
                        var html = '';
                        res.data.forEach(function (t) {
                            var fieldCnt = t.fields ? t.fields.length : 0;
                            html += '<tr>' +
                                '<td><i class="fas fa-file-word text-primary mr-1"></i><strong>' + escapeHtml(t.name) + '</strong></td>' +
                                '<td class="small text-muted">' + escapeHtml(t.description || '-') + '</td>' +
                                '<td><span class="badge badge-info">' + fieldCnt + '</span></td>' +
                                '<td class="small text-muted">' + escapeHtml(t.createdAt || '-') + '</td>' +
                                '<td>' +
                                    '<button class="btn btn-xs btn-outline-info mr-1" onclick="showFields(\'' + t.id + '\',\'' + escapeHtml(t.name) + '\')">' +
                                        '<i class="fas fa-tags"></i> 字段' +
                                    '</button>' +
                                    '<a class="btn btn-xs btn-outline-success mr-1" href="/templatereport/download/' + encodeURIComponent(t.id) + '">' +
                                        '<i class="fas fa-download"></i> 下载' +
                                    '</a>' +
                                    '<button class="btn btn-xs btn-outline-danger" onclick="deleteTemplate(\'' + t.id + '\',\'' + escapeHtml(t.name) + '\')">' +
                                        '<i class="fas fa-trash"></i> 删除' +
                                    '</button>' +
                                '</td>' +
                            '</tr>';
                        });
                        $body.html(html);
                    } else {
                        $body.html('<tr><td colspan="5" class="text-center text-muted py-4">暂无模板，请点击右上角「新增模板」</td></tr>');
                    }
                })
                .catch(function () {
                    $('#tplBody').html('<tr><td colspan="5" class="text-center text-danger py-4">模板加载失败，请刷新重试</td></tr>');
                });
        }

        function showFields(id, name) {
            $('#fieldsContent').html('<div class="text-muted text-center py-3">加载中…</div>');
            $('#fieldsModal .modal-title').html('<i class="fas fa-tags mr-1"></i>' + escapeHtml(name) + ' · 占位符');
            $('#fieldsModal').modal('show');
            fetch('/templatereport/scan-placeholders', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ TemplateId: id })
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {
                    if (res.code === 200 && res.data && res.data.length) {
                        var html = '<div class="row">';
                        res.data.forEach(function (p) {
                            html += '<div class="col-md-6 mb-2">' +
                                '<code class="small">{{' + escapeHtml(p.name) + '}}</code>' +
                                '<div class="text-muted" style="font-size:11px;">' + escapeHtml(p.context || '') + '</div>' +
                            '</div>';
                        });
                        html += '</div>';
                        $('#fieldsContent').html(html);
                    } else {
                        $('#fieldsContent').html('<div class="text-muted text-center py-3">未识别到占位符</div>');
                    }
                })
                .catch(function () {
                    $('#fieldsContent').html('<div class="text-danger text-center py-3">加载失败</div>');
                });
        }

        function deleteTemplate(id, name) {
            layer.confirm('确认删除模板 <b>' + name + '</b>？删除后不可恢复。',
                { icon: 3, title: '删除确认', btn: ['确认删除', '取消'] }, function (i) {
                layer.close(i);
                $.ajax({
                    url: '/templatereport/delete',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ TemplateId: id }),
                    success: function (r) {
                        layer.msg(r.message || '已删除', { icon: r.success ? 1 : 2, time: 1500 }, function () {
                            if (r.success) loadTemplateList();
                        });
                    },
                    error: function () { layer.msg('请求失败', { icon: 2 }); }
                });
            });
        }

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, function (m) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
            });
        }

        loadTemplateList();
    </script>
}
