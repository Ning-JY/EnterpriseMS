@{
    ViewData["Title"] = "成果报告模板管理";
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-template-1"></i> 成果报告模板
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">造价小工具</a>
        <a><cite>成果报告模板</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="tplSearch">
            <div class="layui-inline">
                <input type="text" name="keyword" placeholder="模板名称 / 描述"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <select name="category" id="categoryFilter" lay-filter="categoryFilter" style="width:150px">
                    <option value="">全部分类</option>
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="tplSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                    <i class="layui-icon layui-icon-add-1"></i> 新增模板
                </button>
                <button type="button" class="layui-btn" id="btnGenerate">
                    <i class="layui-icon layui-icon-file-b"></i> 生成报告
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>模板列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="tplTable" lay-filter="tplTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="tplBar">
    <a class="ems-icon-btn primary" title="占位符字段" lay-event="fields"><i class="layui-icon layui-icon-list"></i></a>
    <a class="ems-icon-btn success" title="下载模板" lay-event="download"><i class="layui-icon layui-icon-download-circle"></i></a>
    <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
</script>

<!-- 占位符字段弹窗 -->
<div class="ems-modal-box" id="fieldsModal">
    <div class="ems-alert teal">
        以下为模板内识别到的占位符（<code>{{字段名}}</code>）。在项目详情页生成报告时，系统会以同名项目字段自动填充。
    </div>
    <div id="fieldsContent" style="max-height:50vh;overflow:auto;margin-top:12px">
        <div class="ems-empty">加载中…</div>
    </div>
</div>

@section Scripts {
<script>
ems.ready(function () {
    var $ = layui.jquery;

    var colsConfig = [
        { field: 'Name', title: '模板名称', minWidth: 200,
          templet: function (d) {
              return '<i class="layui-icon layui-icon-file-b layui-font-teal"></i> <strong>' +
                     ems.escapeHtml(d.Name) + '</strong>';
          } },
        { field: 'Description', title: '描述', minWidth: 200, templet: ems.tpl.text('Description') },
        { field: 'FieldCount', title: '字段数', width: 100, align: 'center',
          templet: function (d) {
              return '<span class="layui-badge layui-bg-blue">' + (d.FieldCount || 0) + '</span>';
          } },
        { field: 'FileName', title: '模板文件', minWidth: 160, hide: true, templet: ems.tpl.text('FileName') },
        { field: 'CreatedAt', title: '创建日期', width: 160, templet: ems.tpl.text('CreatedAt') },
        { field: 'Category', title: '分类', width: 110, templet: function (d) {
              return d.Category
                  ? '<span class="layui-badge layui-bg-gray">' + ems.escapeHtml(d.Category) + '</span>'
                  : '<span class="layui-font-gray">—</span>';
          } },
        { title: '操作', width: 140, align: 'center', toolbar: '#tplBar' }
    ];

    ems.initTable({
        elem: '#tplTable',
        id:   'tplTable',
        url:  '/templatereport/list',
        cols: [colsConfig],

        tool: {
            fields:   function (d) { showFields(d.Id, d.Name); },
            download: function (d) {
                window.location.href = '/templatereport/download/' + encodeURIComponent(d.Id);
            },
            del: function (d) {
                ems.confirm('确认删除模板 <b>' + ems.escapeHtml(d.Name) + '</b>？删除后不可恢复。',
                    { icon: 3, title: '删除确认', btn: ['确认删除', '取消'] }, function () {
                        ems.post({
                            url:  '/templatereport/delete',
                            data: { TemplateId: d.Id },
                            done: function () { ems.reloadTable('tplTable', null, false); }
                        });
                    });
            }
        }
    });

    // 占位符字段：弹窗展示扫描结果
    function showFields(id, name) {
        $('#fieldsContent').html('<div class="ems-empty">加载中…</div>');
        layer.open({
            type: 1,
            title: ems.escapeHtml(name) + ' · 占位符',
            skin: 'ems-layer',
            area: ['720px'],
            content: $('#fieldsModal'),
            shadeClose: false
        });

        // 纯查询接口，不弹「操作成功」提示，故直接用 $.ajax（token 由 ems.js 全局注入）
        $.ajax({
            url: '/templatereport/scan-placeholders',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ TemplateId: id }),
            success: function (res) {
                var list = (res && res.code === 200 && res.data) ? res.data : [];
                if (!list.length) {
                    $('#fieldsContent').html('<div class="ems-empty">未识别到占位符</div>');
                    return;
                }
                var html = '<div class="ems-info-grid">';
                list.forEach(function (p) {
                    html += '<div class="ems-info-item"><span class="val">' +
                            '<code>{{' + ems.escapeHtml(p.name) + '}}</code>' +
                            '<div class="layui-font-12 layui-font-gray">' + ems.escapeHtml(p.context || '') + '</div>' +
                            '</span></div>';
                });
                html += '</div>';
                $('#fieldsContent').html(html);
            },
            error: function () {
                $('#fieldsContent').html('<div class="ems-empty layui-font-red">加载失败</div>');
            }
        });
    }

    // 新增模板 / 生成报告：整页跳转（均为完整独立页面）
    $('#btnAdd').on('click', function () {
        ems.openTab('/templatereport/templateconfig', '模板配置');
    });
    $('#btnGenerate').on('click', function () {
        ems.openTab('/templatereport/index', '模板化报告生成');
    });

    $('#btnFilter').on('click', function () { ems.colFilter('tplTable', colsConfig); });
    $('#btnExport').on('click', function () { ems.exportMenu('tplTable', '成果报告模板'); });

    // 分类筛选
    $.get('/templatereport/categories', function (res) {
        if (res && res.code === 200 && res.data && res.data.length) {
            var html = '<option value="">全部分类</option>';
            res.data.forEach(function (c) {
                html += '<option value="' + ems.escapeHtml(c) + '">' + ems.escapeHtml(c) + '</option>';
            });
            $('#categoryFilter').html(html);
            layui.form.render('select');
        }
    });
    layui.form.on('select(categoryFilter)', function (obj) {
        ems.reloadTable('tplTable', obj.value ? { Category: obj.value } : null, false);
    });

    ems.bindSearch('tplSearch', 'tplTable');
});
</script>
}
