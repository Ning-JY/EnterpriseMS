@{
    ViewData["Title"] = "模板配置";
    Layout = "_Layout";
}

@section Styles {
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">妯℃澘閰嶇疆</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">棣栭〉</a></li>
                    <li class="breadcrumb-item">閫犱环灏忓伐鍏?/li>
                    <li class="breadcrumb-item active">妯℃澘閰嶇疆</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @** 姝ラ鎸囩ず鍣?*@
        <div class="card card-outline card-primary mb-3">
            <div class="card-body py-3">
                <div class="step-indicator">
                    <div class="step-dot active" id="step1Dot">1</div>
                    <div class="step-dot" id="step2Dot">2</div>
                    <div class="step-dot" id="step3Dot">3</div>
                </div>
                <div class="text-center text-muted small">
                    <span id="step1Label" class="font-weight-bold">涓婁紶妯℃澘</span>
                    <span class="mx-2">鈫?/span>
                    <span id="step2Label">鏍囪鏇挎崲</span>
                    <span class="mx-2">鈫?/span>
                    <span id="step3Label">淇濆瓨妯℃澘</span>
                </div>
            </div>
        </div>

        @** 姝ラ1: 涓婁紶妯℃澘 *@
        <div id="step1" class="card">
            <div class="card-header bg-info text-white">
                <i class="fas fa-upload mr-1"></i>姝ラ1: 涓婁紶Word妯℃澘
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label>妯℃澘鍚嶇О <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="templateName" placeholder="璇疯緭鍏ユā鏉垮悕绉?>
                </div>
                <div class="form-group">
                    <label>妯℃澘鎻忚堪</label>
                    <textarea class="form-control" id="templateDescription" rows="2" placeholder="璇疯緭鍏ユā鏉挎弿杩?></textarea>
                </div>
                <div class="form-group">
                    <label>閫夋嫨Word妯℃澘鏂囦欢 <span class="text-danger">*</span></label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="templateFile" accept=".docx">
                        <label class="custom-file-label" for="templateFile">閫夋嫨鏂囦欢...</label>
                    </div>
                    <small class="form-text text-muted">鏀寔.docx鏍煎紡鐨刉ord鏂囨。</small>
                </div>
                <button class="btn btn-primary" onclick="uploadAndParse()">
                    <i class="fas fa-cloud-upload-alt mr-1"></i>涓婁紶骞惰В鏋?
                </button>
            </div>
        </div>

        @** 姝ラ2: 鏍囪鏇挎崲 *@
        <div id="step2" class="card" style="display:none;">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span><i class="fas fa-edit mr-1"></i>姝ラ2: 鏍囪闇€瑕佹浛鎹㈢殑鍐呭</span>
                <button class="btn btn-sm btn-light" onclick="goToStep(1)">
                    <i class="fas fa-arrow-left mr-1"></i>杩斿洖
                </button>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-7">
                        <h6 class="text-muted mb-2">
                            <i class="fas fa-info-circle mr-1"></i>鐐瑰嚮娈佃惤/琛ㄦ牸鍐呭杩涜閫夋嫨锛屽凡閫変腑鐨勫唴瀹瑰皢琚浛鎹负鍗犱綅绗?
                        </h6>
                        <div id="templateContentList" class="border rounded p-2" style="max-height:500px;overflow-y:auto;">
                            <div class="text-muted text-center py-3">鍔犺浇涓?..</div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h6 class="text-muted mb-2">
                            <i class="fas fa-exchange-alt mr-1"></i>鏇挎崲瑙勫垯鍒楄〃
                        </h6>
                        <div id="replacementList" class="border rounded replacement-list p-2">
                            <div class="text-muted text-center py-3">璇峰湪宸︿晶閫夋嫨闇€瑕佹浛鎹㈢殑鍐呭</div>
                        </div>
                        <button class="btn btn-success mt-3 w-100" onclick="goToStep(3)" id="btnNextStep3" disabled>
                            <i class="fas fa-arrow-right mr-1"></i>涓嬩竴姝ワ細淇濆瓨妯℃澘
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @** 姝ラ3: 淇濆瓨妯℃澘 *@
        <div id="step3" class="card" style="display:none;">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span><i class="fas fa-save mr-1"></i>姝ラ3: 纭骞朵繚瀛樻ā鏉?/span>
                <button class="btn btn-sm btn-light" onclick="goToStep(2)">
                    <i class="fas fa-arrow-left mr-1"></i>杩斿洖
                </button>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-1"></i>
                    绯荤粺灏嗘妸鎮ㄦ爣璁扮殑鍐呭鏇挎崲涓?<code>{{瀛楁鍚峿}</code> 鏍煎紡鐨勫崰浣嶇锛屽苟淇濆瓨涓烘柊妯℃澘銆?
                </div>
                <h6>鏇挎崲棰勮:</h6>
                <div id="replacementPreview" class="border rounded p-3 mb-3" style="max-height:300px;overflow-y:auto;">
                </div>
                <button class="btn btn-success btn-lg" onclick="saveTemplate()">
                    <i class="fas fa-save mr-1"></i>淇濆瓨妯℃澘
                </button>
            </div>
        </div>

    </div>
</section>

@** 瀛楁鍚嶈緭鍏ュ脊绐?*@
<div class="modal fade" id="fieldNameModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">璁剧疆瀛楁鍚?/h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>閫変腑鐨勬枃鏈?</label>
                    <div id="selectedTextDisplay" class="form-control-plaintext text-danger" style="text-decoration:line-through;"></div>
                </div>
                <div class="form-group">
                    <label>瀛楁鍚?<span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="fieldNameInput" placeholder="渚嬪锛氶」鐩悕绉般€佽瘎瀹℃棩鏈?>
                    <small class="form-text text-muted">鐢ㄤ簬鐢熸垚鍗犱綅绗?{{瀛楁鍚峿}锛屽缓璁娇鐢ㄤ腑鏂?/small>
                </div>
                <div class="form-group">
                    <label>瀛楁鏍囩锛堟樉绀哄悕绉帮級</label>
                    <input type="text" class="form-control" id="fieldLabelInput" placeholder="涓庡瓧娈靛悕鐩稿悓鍒欑暀绌?>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">鍙栨秷</button>
                <button type="button" class="btn btn-primary" onclick="confirmFieldName()">纭</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStep = 1;
        let parsedContent = [];
        let selectedItems = new Map();
        let replacements = [];

        function goToStep(step) {
            currentStep = step;
            for (let i = 1; i <= 3; i++) {
                document.getElementById('step' + i).style.display = i === step ? '' : 'none';
                let dot = document.getElementById('step' + i + 'Dot');
                let label = document.getElementById('step' + i + 'Label');
                dot.className = 'step-dot';
                label.className = '';
                if (i < step) {
                    dot.className = 'step-dot completed';
                    dot.innerHTML = '<i class="fas fa-check"></i>';
                } else if (i === step) {
                    dot.className = 'step-dot active';
                    label.className = 'font-weight-bold';
                } else {
                    dot.innerHTML = i;
                }
            }
        }

        async function uploadAndParse() {
            let name = document.getElementById('templateName').value.trim();
            let fileInput = document.getElementById('templateFile');
            let file = fileInput.files[0];

            if (!name) {
                layer.msg('璇疯緭鍏ユā鏉垮悕绉?, { icon: 2 });
                return;
            }
            if (!file) {
                layer.msg('璇烽€夋嫨Word妯℃澘鏂囦欢', { icon: 2 });
                return;
            }

            let formData = new FormData();
            formData.append('templateFile', file);
            formData.append('TemplateName', name);
            formData.append('TemplateDescription', document.getElementById('templateDescription').value);

            try {
                layer.load(1);
                let resp = await fetch('/templatereport/scan-placeholders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TemplateId: 'upload-temp' })
                });

                let reader = new FileReader();
                reader.onload = async function(e) {
                    let content = e.target.result;
                    parsedContent = parseDocxContent(content);
                    renderTemplateContent();
                    goToStep(2);
                    layer.closeAll();
                };
                reader.readAsArrayBuffer(file);
            } catch (err) {
                layer.closeAll();
                layer.msg('瑙ｆ瀽澶辫触: ' + err.message, { icon: 2 });
            }
        }

        function parseDocxContent(arrayBuffer) {
            let items = [];
            try {
                let zip = new JSZip();
                let docXml = '';
                let tables = [];

                zip.loadAsync(arrayBuffer).then(function(zip) {
                    zip.file('word/document.xml').async('string').then(function(content) {
                        let parser = new DOMParser();
                        let xmlDoc = parser.parseFromString(content, 'text/xml');
                        let body = xmlDoc.getElementsByTagName('w:body')[0];
                        if (!body) return;

                        let children = body.childNodes;
                        let itemIndex = 0;

                        for (let i = 0; i < children.length; i++) {
                            let node = children[i];
                            if (node.nodeName === 'w:p') {
                                let text = getParagraphText(node);
                                if (text.trim()) {
                                    items.push({
                                        index: itemIndex++,
                                        type: 'paragraph',
                                        text: text.trim(),
                                        node: node
                                    });
                                }
                            } else if (node.nodeName === 'w:tbl') {
                                let rows = node.getElementsByTagName('w:tr');
                                for (let r = 0; r < rows.length; r++) {
                                    let cells = rows[r].getElementsByTagName('w:tc');
                                    let rowTexts = [];
                                    for (let c = 0; c < cells.length; c++) {
                                        let cellText = getCellText(cells[c]);
                                        if (cellText.trim()) rowTexts.push(cellText.trim());
                                    }
                                    if (rowTexts.length > 0) {
                                        items.push({
                                            index: itemIndex++,
                                            type: 'table-row',
                                            text: rowTexts.join(' | '),
                                            cells: rowTexts
                                        });
                                    }
                                }
                            }
                        }

                        parsedContent = items;
                        renderTemplateContent();
                    });
                });
            } catch (err) {
                console.error('瑙ｆ瀽閿欒:', err);
                parsedContent = [{ index: 0, type: 'error', text: '瑙ｆ瀽澶辫触: ' + err.message }];
                renderTemplateContent();
            }
            return items;
        }

        function getParagraphText(paraNode) {
            let text = '';
            let runs = paraNode.getElementsByTagName('w:r');
            for (let r = 0; r < runs.length; r++) {
                let tNodes = runs[r].getElementsByTagName('w:t');
                for (let t = 0; t < tNodes.length; t++) {
                    text += tNodes[t].textContent;
                }
            }
            return text;
        }

        function getCellText(cellNode) {
            let paras = cellNode.getElementsByTagName('w:p');
            let text = '';
            for (let p = 0; p < paras.length; p++) {
                text += getParagraphText(paras[p]);
                if (p < paras.length - 1) text += ' ';
            }
            return text;
        }

        function renderTemplateContent() {
            let html = '';
            for (let item of parsedContent) {
                let isSelected = selectedItems.has(item.index);
                let typeLabel = item.type === 'paragraph' ? '娈佃惤' : '琛ㄦ牸琛?;
                let typeIcon = item.type === 'paragraph' ? 'fa-align-left' : 'fa-table';
                html += `<div class="template-content-item ${isSelected ? 'selected' : ''}" 
                              onclick="toggleItem(${item.index})" data-index="${item.index}">
                    <span class="item-type"><i class="fas ${typeIcon} mr-1"></i>${typeLabel}</span>
                    <span class="item-text">${escapeHtml(item.text.substring(0, 100))}${item.text.length > 100 ? '...' : ''}</span>
                </div>`;
            }
            if (!html) html = '<div class="text-muted text-center py-3">鏈В鏋愬埌鍐呭</div>';
            document.getElementById('templateContentList').innerHTML = html;
        }

        function toggleItem(index) {
            let item = parsedContent.find(i => i.index === index);
            if (!item) return;

            if (selectedItems.has(index)) {
                selectedItems.delete(index);
                replacements = replacements.filter(r => r.index !== index);
            } else {
                document.getElementById('selectedTextDisplay').textContent = item.text;
                document.getElementById('fieldNameInput').value = '';
                document.getElementById('fieldLabelInput').value = '';
                $('#fieldNameModal').modal('show');
                window._pendingItemIndex = index;
                return;
            }

            updateSelectionUI();
            renderReplacementList();
        }

        function confirmFieldName() {
            let fieldName = document.getElementById('fieldNameInput').value.trim();
            let fieldLabel = document.getElementById('fieldLabelInput').value.trim() || fieldName;
            let index = window._pendingItemIndex;

            if (!fieldName) {
                layer.msg('璇疯緭鍏ュ瓧娈靛悕', { icon: 2 });
                return;
            }

            if (replacements.some(r => r.fieldName === fieldName)) {
                layer.msg('瀛楁鍚嶅凡瀛樺湪锛岃浣跨敤鍏朵粬鍚嶇О', { icon: 2 });
                return;
            }

            let item = parsedContent.find(i => i.index === index);
            if (!item) return;

            selectedItems.set(index, item);
            replacements.push({
                index: index,
                oldText: item.text,
                fieldName: fieldName,
                fieldLabel: fieldLabel
            });

            $('#fieldNameModal').modal('hide');
            updateSelectionUI();
            renderReplacementList();
        }

        function updateSelectionUI() {
            document.querySelectorAll('.template-content-item').forEach(el => {
                let idx = parseInt(el.dataset.index);
                el.classList.toggle('selected', selectedItems.has(idx));
            });
        }

        function renderReplacementList() {
            let html = '';
            for (let r of replacements) {
                html += `<div class="replacement-item">
                    <span class="old-text">${escapeHtml(r.oldText.substring(0, 30))}${r.oldText.length > 30 ? '...' : ''}</span>
                    <span class="arrow">鈫?/span>
                    <span class="new-text">{{${escapeHtml(r.fieldName)}}}</span>
                    <button class="btn btn-sm btn-outline-danger ml-2" onclick="removeReplacement(${r.index})">
                        <i class="fas fa-times"></i>
                    </button>
                </div>`;
            }
            if (!html) html = '<div class="text-muted text-center py-3">璇峰湪宸︿晶閫夋嫨闇€瑕佹浛鎹㈢殑鍐呭</div>';
            document.getElementById('replacementList').innerHTML = html;

            document.getElementById('btnNextStep3').disabled = replacements.length === 0;
        }

        function removeReplacement(index) {
            selectedItems.delete(index);
            replacements = replacements.filter(r => r.index !== index);
            updateSelectionUI();
            renderReplacementList();
        }

        function goToStep3() {
            if (replacements.length === 0) {
                layer.msg('璇疯嚦灏戞爣璁颁竴涓浛鎹㈤」', { icon: 2 });
                return;
            }

            let html = '';
            for (let r of replacements) {
                html += `<div class="d-flex align-items-center mb-2">
                    <span class="text-danger text-decoration-line-through mr-2" style="flex:1;">${escapeHtml(r.oldText.substring(0, 50))}</span>
                    <i class="fas fa-arrow-right text-success mx-2"></i>
                    <span class="text-success font-weight-bold" style="flex:1;">{{${escapeHtml(r.fieldName)}}}</span>
                </div>`;
            }
            document.getElementById('replacementPreview').innerHTML = html;
            goToStep(3);
        }

        async function saveTemplate() {
            let name = document.getElementById('templateName').value.trim();
            let fileInput = document.getElementById('templateFile');
            let file = fileInput.files[0];

            if (!name || !file) {
                layer.msg('璇峰畬鎴愭ā鏉夸俊鎭?, { icon: 2 });
                return;
            }

            let formData = new FormData();
            formData.append('templateFile', file);
            formData.append('TemplateName', name);
            formData.append('TemplateDescription', document.getElementById('templateDescription').value);

            for (let i = 0; i < replacements.length; i++) {
                formData.append(`Replacements[${i}].OldText`, replacements[i].oldText);
                formData.append(`Replacements[${i}].FieldName`, replacements[i].fieldName);
                formData.append(`Replacements[${i}].FieldLabel`, replacements[i].fieldLabel);
            }

            try {
                layer.load(1);
                let resp = await fetch('/templatereport/configure-template', {
                    method: 'POST',
                    body: formData
                });
                let result = await resp.json();
                layer.closeAll();

                if (result.code === 200) {
                    layer.msg('妯℃澘淇濆瓨鎴愬姛锛?, { icon: 1 });
                    setTimeout(() => {
                        window.location.href = '/templatereport/index';
                    }, 1500);
                } else {
                    layer.msg(result.message || '淇濆瓨澶辫触', { icon: 2 });
                }
            } catch (err) {
                layer.closeAll();
                layer.msg('淇濆瓨澶辫触: ' + err.message, { icon: 2 });
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[m]);
        }

        document.getElementById('templateFile').addEventListener('change', function(e) {
            let fileName = e.target.files[0] ? e.target.files[0].name : '閫夋嫨鏂囦欢...';
            $(this).next('.custom-file-label').html(fileName);
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
}
