@{
    ViewData["Title"] = "模板配置";
    Layout = "_Layout";
}

@section Styles {
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">模板配置</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item">造价小工具</li>
                    <li class="breadcrumb-item active">模板配置</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @* 步骤指示器 *@
        <div class="card card-outline card-primary mb-3">
            <div class="card-body py-3">
                <div class="step-indicator">
                    <div class="step-dot active" id="step1Dot">1</div>
                    <div class="step-dot" id="step2Dot">2</div>
                    <div class="step-dot" id="step3Dot">3</div>
                </div>
                <div class="text-center text-muted small">
                    <span id="step1Label" class="font-weight-bold">上传模板</span>
                    <span class="mx-2">→</span>
                    <span id="step2Label">标记替换</span>
                    <span class="mx-2">→</span>
                    <span id="step3Label">保存模板</span>
                </div>
            </div>
        </div>

        @* 步骤1: 上传模板 *@
        <div id="step1" class="card">
            <div class="card-header bg-info text-white">
                <i class="fas fa-upload mr-1"></i>步骤1: 上传Word模板
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label>模板名称 <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="templateName" placeholder="请输入模板名称">
                </div>
                <div class="form-group">
                    <label>模板描述</label>
                    <textarea class="form-control" id="templateDescription" rows="2" placeholder="请输入模板描述"></textarea>
                </div>
                <div class="form-group">
                    <label>选择Word模板文件 <span class="text-danger">*</span></label>
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="templateFile" accept=".docx">
                        <label class="custom-file-label" for="templateFile">选择文件...</label>
                    </div>
                    <small class="form-text text-muted">支持.docx格式的Word文档。</small>
                </div>
                <button class="btn btn-primary" onclick="uploadAndParse()">
                    <i class="fas fa-cloud-upload-alt mr-1"></i>上传并解析
                </button>
            </div>
        </div>

        @* 步骤2: 标记替换 *@
        <div id="step2" class="card" style="display:none;">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span><i class="fas fa-edit mr-1"></i>步骤2: 标记需要替换的内容</span>
                <button class="btn btn-sm btn-light" onclick="goToStep(1)">
                    <i class="fas fa-arrow-left mr-1"></i>返回
                </button>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-7">
                        <h6 class="text-muted mb-2">
                            <i class="fas fa-info-circle mr-1"></i>
                            点击整段替换，或选中段内部分文字后再点击「设为占位符」进行精准替换
                        </h6>
                        <div id="templateContentList" class="border rounded p-2" style="max-height:500px;overflow-y:auto;">
                            <div class="text-muted text-center py-3">加载中...</div>
                        </div>
                        <div class="mt-2 text-right">
                            <button class="btn btn-outline-primary btn-sm" id="btnSetPlaceholder" onclick="setSelectedAsPlaceholder()" disabled>
                                <i class="fas fa-marker mr-1"></i>设为占位符
                            </button>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <h6 class="text-muted mb-2">
                            <i class="fas fa-exchange-alt mr-1"></i>替换规则列表
                        </h6>
                        <div id="replacementList" class="border rounded replacement-list p-2" style="max-height:380px;overflow-y:auto;">
                            <div class="text-muted text-center py-3">请在左侧选择需要替换的内容</div>
                        </div>
                        <button class="btn btn-success mt-3 w-100" onclick="goToStep(3)" id="btnNextStep3" disabled>
                            <i class="fas fa-arrow-right mr-1"></i>下一步：保存模板
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @* 步骤3: 确认并保存模板 *@
        <div id="step3" class="card" style="display:none;">
            <div class="card-header bg-info text-white d-flex justify-content-between">
                <span><i class="fas fa-save mr-1"></i>步骤3: 确认并保存模板</span>
                <button class="btn btn-sm btn-light" onclick="goToStep(2)">
                    <i class="fas fa-arrow-left mr-1"></i>返回
                </button>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-1"></i>
                    系统将把您标记的内容替换为 <code>{{字段名}}</code> 格式的占位符，并保存为新模板。
                </div>
                <h6>替换预览:</h6>
                <div id="replacementPreview" class="border rounded p-3 mb-3" style="max-height:300px;overflow-y:auto;">
                </div>
                <button class="btn btn-success btn-lg" onclick="saveTemplate()">
                    <i class="fas fa-save mr-1"></i>保存模板
                </button>
            </div>
        </div>

    </div>
</section>

@* 字段名输入弹窗（支持整段/段内字符替换） *@
<div class="modal fade" id="fieldNameModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-marker mr-1"></i>设置字段映射</h5>
                <button type="button" class="close text-white" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                @* 替换模式切换 *@
                <div class="form-group">
                    <label class="font-weight-bold">替换方式</label>
                    <div class="row">
                        <div class="col-6">
                            <div class="custom-control custom-radio" id="modeFullGroup">
                                <input type="radio" class="custom-control-input" id="modeFull" name="replaceMode" value="full" checked>
                                <label class="custom-control-label" for="modeFull">
                                    <i class="fas fa-align-justify mr-1 text-primary"></i>整段替换
                                    <div class="small text-muted">整段文字替换为占位符</div>
                                </label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="custom-control custom-radio" id="modeInlineGroup">
                                <input type="radio" class="custom-control-input" id="modeInline" name="replaceMode" value="inline">
                                <label class="custom-control-label" for="modeInline">
                                    <i class="fas fa-highlighter mr-1 text-success"></i>段内精准替换
                                    <div class="small text-muted">仅替换段内选中的文字</div>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <hr>

                @* 段落预览 *@
                <div class="form-group mb-1">
                    <label class="small text-muted">段落原文</label>
                    <div id="paraPreview" class="border rounded p-2 bg-light" style="font-size:13px;line-height:1.8;max-height:120px;overflow-y:auto;"></div>
                </div>

                @* 段内选中文本（仅 inline 模式显示）*@
                <div class="form-group" id="inlinePreviewGroup" style="display:none;">
                    <label class="small text-muted">将被替换的文字（高亮）</label>
                    <div id="inlineSelectedDisplay" class="border rounded p-2 bg-white" style="font-size:13px;line-height:1.8;"></div>
                </div>

                <div class="form-group mb-0">
                    <label>字段名 <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="fieldNameInput" placeholder="例如：项目名称、评审日期">
                    <small class="form-text text-muted">生成占位符 {{字段名}}，生成报告时系统自动填充</small>
                </div>
                <div class="form-group mb-0">
                    <label>字段标签（前端显示名）</label>
                    <input type="text" class="form-control" id="fieldLabelInput" placeholder="与字段名相同则留空">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="confirmFieldName()">
                    <i class="fas fa-check mr-1"></i>确认映射
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentStep = 1;
        let parsedContent = [];
        let selectedItems = new Map();   // itemIndex -> item
        let replacements = [];
        let _pendingItemIndex = null;
        let _templateFileBytes = null;   // 保留上传的模板文件字节（步骤3复用）

        function goToStep(step) {
            currentStep = step;
            for (let i = 1; i <= 3; i++) {
                document.getElementById('step' + i).style.display = i === step ? '' : 'none';
                let dot = document.getElementById('step' + i + 'Dot');
                let label = document.getElementById('step' + i + 'Label');
                dot.className = 'step-dot';
                label.className = '';
                if (i < step) {
                    dot.className = 'step-dot completed';
                    dot.innerHTML = '<i class="fas fa-check"></i>';
                } else if (i === step) {
                    dot.className = 'step-dot active';
                    label.className = 'font-weight-bold';
                } else {
                    dot.innerHTML = i;
                }
            }
        }

        async function uploadAndParse() {
            let name = document.getElementById('templateName').value.trim();
            let fileInput = document.getElementById('templateFile');
            let file = fileInput.files[0];

            if (!name) {
                ems.msg('请输入模板名称', { icon: 2 });
                return;
            }
            if (!file) {
                ems.msg('请选择Word模板文件', { icon: 2 });
                return;
            }

            let formData = new FormData();
            formData.append('templateFile', file);
            formData.append('TemplateName', name);
            formData.append('TemplateDescription', document.getElementById('templateDescription').value);

            try {
                ems.loading(1);
                let resp = await fetch('/templatereport/scan-placeholders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ TemplateId: 'upload-temp' })
                });

                let reader = new FileReader();
                reader.onload = async function(e) {
                    let content = e.target.result;
                    _templateFileBytes = content;   // 保留，供步骤3使用
                    parsedContent = parseDocxContent(content);
                    renderTemplateContent();
                    goToStep(2);
                    ems.closeAll();
                };
                reader.readAsArrayBuffer(file);
            } catch (err) {
                ems.closeAll();
                ems.msg('解析失败: ' + err.message, { icon: 2 });
            }
        }

        function parseDocxContent(arrayBuffer) {
            let items = [];
            try {
                let zip = new JSZip();
                let docXml = '';
                let tables = [];

                zip.loadAsync(arrayBuffer).then(function(zip) {
                    zip.file('word/document.xml').async('string').then(function(content) {
                        let parser = new DOMParser();
                        let xmlDoc = parser.parseFromString(content, 'text/xml');
                        let body = xmlDoc.getElementsByTagName('w:body')[0];
                        if (!body) return;

                        let children = body.childNodes;
                        let itemIndex = 0;

                        for (let i = 0; i < children.length; i++) {
                            let node = children[i];
                            if (node.nodeName === 'w:p') {
                                let text = getParagraphText(node);
                                if (text.trim()) {
                                    items.push({
                                        index: itemIndex++,
                                        type: 'paragraph',
                                        text: text.trim(),
                                        node: node
                                    });
                                }
                            } else if (node.nodeName === 'w:tbl') {
                                let rows = node.getElementsByTagName('w:tr');
                                for (let r = 0; r < rows.length; r++) {
                                    let cells = rows[r].getElementsByTagName('w:tc');
                                    let rowTexts = [];
                                    for (let c = 0; c < cells.length; c++) {
                                        let cellText = getCellText(cells[c]);
                                        if (cellText.trim()) rowTexts.push(cellText.trim());
                                    }
                                    if (rowTexts.length > 0) {
                                        items.push({
                                            index: itemIndex++,
                                            type: 'table-row',
                                            text: rowTexts.join(' | '),
                                            cells: rowTexts
                                        });
                                    }
                                }
                            }
                        }

                        parsedContent = items;
                        renderTemplateContent();
                    });
                });
            } catch (err) {
                console.error('解析错误:', err);
                parsedContent = [{ index: 0, type: 'error', text: '解析失败: ' + err.message }];
                renderTemplateContent();
            }
            return items;
        }

        function getParagraphText(paraNode) {
            let text = '';
            let runs = paraNode.getElementsByTagName('w:r');
            for (let r = 0; r < runs.length; r++) {
                let tNodes = runs[r].getElementsByTagName('w:t');
                for (let t = 0; t < tNodes.length; t++) {
                    text += tNodes[t].textContent;
                }
            }
            return text;
        }

        function getCellText(cellNode) {
            let paras = cellNode.getElementsByTagName('w:p');
            let text = '';
            for (let p = 0; p < paras.length; p++) {
                text += getParagraphText(paras[p]);
                if (p < paras.length - 1) text += ' ';
            }
            return text;
        }

        // ── 渲染模板内容列表（每段可点击） ────────────────────────
        function renderTemplateContent() {
            let html = '';
            for (let item of parsedContent) {
                let isSelected = selectedItems.has(item.index);
                let typeLabel = item.type === 'paragraph' ? '段落' : '表格行';
                let typeIcon = item.type === 'paragraph' ? 'fa-align-left' : 'fa-table';
                // 如果已有占位符映射，渲染时高亮显示被替换文字
                let repl = replacements.find(r => r.index === item.index);
                let displayText = item.text;
                if (repl && repl.source === 'inline') {
                    displayText = escapeHtml(
                        item.text.substring(0, repl.startIndex)
                        + '<mark class="bg-yellow">' + escapeHtml(item.text.substring(repl.startIndex, repl.endIndex)) + '</mark>'
                        + item.text.substring(repl.endIndex)
                    );
                } else if (repl && repl.source === 'full') {
                    displayText = '<span class="text-danger text-decoration-line-through">' + escapeHtml(item.text) + '</span> → <code>{{' + escapeHtml(repl.fieldName) + '}}</code>';
                } else {
                    displayText = escapeHtml(item.text.length > 150 ? item.text.substring(0, 150) + '…' : item.text);
                }
                html += `<div class="template-content-item ${isSelected ? 'selected' : ''}"
                              data-index="${item.index}">
                    <div class="d-flex align-items-start justify-content-between">
                        <div class="flex-grow-1">
                            <span class="item-type"><i class="fas ${typeIcon} mr-1"></i>${typeLabel}</span>
                            <div class="item-text mt-1" style="font-size:13px;line-height:1.6;">${displayText}</div>
                        </div>
                        <div class="ml-2">
                            <button class="btn btn-xs btn-outline-primary" onclick="toggleItem(${item.index})">
                                ${isSelected ? '<i class="fas fa-times"></i> 取消' : '<i class="fas fa-plus"></i> 选择'}
                            </button>
                        </div>
                    </div>
                </div>`;
            }
            if (!html) html = '<div class="text-muted text-center py-3">未解析到内容</div>';
            document.getElementById('templateContentList').innerHTML = html;
        }

        // ── 点击段落：选择（弹出映射弹窗） ──────────────────────────
        function toggleItem(index) {
            let item = parsedContent.find(i => i.index === index);
            if (!item) return;

            // 取消选择
            if (selectedItems.has(index)) {
                selectedItems.delete(index);
                replacements = replacements.filter(r => r.index !== index);
                renderTemplateContent();
                renderReplacementList();
                updatePlaceholderBtn();
                return;
            }

            // 打开弹窗准备映射
            _pendingItemIndex = index;
            openFieldModal(item, null);
        }

        // ── 「设为占位符」按钮：基于浏览器选中文字再弹窗 ─────────────
        function setSelectedAsPlaceholder() {
            let sel = window.getSelection();
            if (!sel || sel.isCollapsed || !sel.rangeCount) {
                ems.msg('请先用鼠标在左侧选中一段文字', { icon: 0 }); return;
            }
            let anchorItem = findItemByRange(sel.getRangeAt(0));
            if (!anchorItem) {
                ems.msg('请先在左侧列表中选择一个段落', { icon: 0 }); return;
            }
            _pendingItemIndex = anchorItem.index;
            openFieldModal(anchorItem, sel);
        }

        // ── 找到选中范围对应的段落 item ─────────────────────────────
        function findItemByRange(range) {
            let container = document.getElementById('templateContentList');
            let nodes = container.querySelectorAll('.template-content-item');
            for (let div of nodes) {
                let idx = parseInt(div.dataset.index);
                let itemDiv = div.querySelector('.item-text');
                if (itemDiv && itemDiv.contains(range.commonAncestorContainer)) {
                    return parsedContent.find(i => i.index === idx);
                }
            }
            return null;
        }

        // ── 打开字段映射弹窗 ───────────────────────────────────────
        function openFieldModal(item, sel) {
            let mode = sel ? 'inline' : 'full';
            document.getElementById('modeFull').checked = (mode === 'full');
            document.getElementById('modeInline').checked = (mode === 'inline');

            // 显示段落原文（inline 模式下高亮选中文字）
            let selText = '';
            if (sel && !sel.isCollapsed) {
                selText = sel.toString();
                let combinedText = item.text;
                let startIdx = combinedText.indexOf(selText);
                if (startIdx < 0) selText = sel.toString().trim();
            }

            // 渲染段落预览
            let paraHtml = escapeHtml(item.text);
            if (mode === 'inline' && selText) {
                let idx = item.text.indexOf(selText);
                if (idx >= 0) {
                    paraHtml = escapeHtml(item.text.substring(0, idx))
                        + '<mark class="bg-yellow" style="padding:0 2px;border-radius:3px;">' + escapeHtml(selText) + '</mark>'
                        + escapeHtml(item.text.substring(idx + selText.length));
                }
            }
            document.getElementById('paraPreview').innerHTML = paraHtml;

            // 段内选中文本
            let inlineGroup = document.getElementById('inlinePreviewGroup');
            if (mode === 'inline' && selText) {
                inlineGroup.style.display = '';
                document.getElementById('inlineSelectedDisplay').innerHTML = '<mark class="bg-yellow px-1 rounded">' + escapeHtml(selText) + '</mark>';
            } else {
                inlineGroup.style.display = 'none';
            }

            document.getElementById('fieldNameInput').value = '';
            document.getElementById('fieldLabelInput').value = '';
            $('#fieldNameModal').modal('show');
        }

        // ── 更新「设为占位符」按钮状态 ─────────────────────────────
        function updatePlaceholderBtn() {
            let sel = window.getSelection();
            let enabled = sel && !sel.isCollapsed && sel.rangeCount > 0
                && document.getElementById('templateContentList').contains(sel.getRangeAt(0)?.commonAncestorContainer);
            document.getElementById('btnSetPlaceholder').disabled = !enabled;
        }

        function confirmFieldName() {
            let fieldName = document.getElementById('fieldNameInput').value.trim();
            let fieldLabel = document.getElementById('fieldLabelInput').value.trim() || fieldName;
            let index = _pendingItemIndex;
            let item = parsedContent.find(i => i.index === index);
            if (!item) return;

            if (!fieldName) { ems.msg('请输入字段名', { icon: 2 }); return; }
            if (replacements.some(r => r.fieldName === fieldName && r.index !== index)) {
                ems.msg('字段名已存在，请使用其他名称', { icon: 2 }); return;
            }

            let mode = document.querySelector('input[name="replaceMode"]:checked').value;
            let oldText = item.text;
            let startIndex = 0, endIndex = oldText.length;

            // inline 模式：从浏览器选中获取起止位置
            if (mode === 'inline') {
                let sel = window.getSelection();
                if (sel && !sel.isCollapsed) {
                    let selText = sel.toString().trim();
                    startIndex = oldText.indexOf(selText);
                    if (startIndex < 0) { ems.msg('选中的文字与段落原文不匹配，请重新选择', { icon: 2 }); return; }
                    endIndex = startIndex + selText.length;
                } else {
                    ems.msg('段内精准替换需先用鼠标选中要替换的文字', { icon: 2 }); return;
                }
            }

            // 移除旧的同名或同名替换
            replacements = replacements.filter(r => r.index !== index);
            selectedItems.set(index, item);
            replacements.push({
                index: index,
                oldText: oldText,
                fieldName: fieldName,
                fieldLabel: fieldLabel,
                source: mode,   // 'full' | 'inline'
                startIndex: startIndex,
                endIndex: endIndex
            });

            // 清空浏览器选中
            window.getSelection().removeAllRanges();
            $('#fieldNameModal').modal('hide');
            renderTemplateContent();
            renderReplacementList();
            updatePlaceholderBtn();
        }

        function renderReplacementList() {
            let html = '';
            for (let r of replacements) {
                let modeLabel = r.source === 'inline' ? '<span class="badge badge-success ml-1" style="font-size:10px;">段内</span>' : '<span class="badge badge-primary ml-1" style="font-size:10px;">整段</span>';
                let oldDisplay = r.source === 'inline'
                    ? escapeHtml(r.oldText.substring(r.startIndex, r.endIndex))
                    : escapeHtml(r.oldText.substring(0, Math.min(r.oldText.length, 30)) + (r.oldText.length > 30 ? '…' : ''));
                html += `<div class="replacement-item">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="flex-grow-1" style="min-width:0;">
                            <div class="small text-muted" style="text-decoration:line-through;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="${escapeHtml(r.oldText)}">
                                ${oldDisplay}
                            </div>
                            <div class="font-weight-bold text-primary" style="font-size:12px;">
                                {{${escapeHtml(r.fieldName)}}}
                                ${modeLabel}
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger ml-2" onclick="removeReplacement(${r.index})" style="flex-shrink:0;">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>`;
            }
            if (!html) html = '<div class="text-muted text-center py-3">请在左侧选择需要替换的内容</div>';
            document.getElementById('replacementList').innerHTML = html;
            document.getElementById('btnNextStep3').disabled = replacements.length === 0;
        }

        function removeReplacement(index) {
            selectedItems.delete(index);
            replacements = replacements.filter(r => r.index !== index);
            renderTemplateContent();
            renderReplacementList();
            updatePlaceholderBtn();
        }

        function goToStep3() {
            if (replacements.length === 0) {
                ems.msg('请至少标记一个替换项', { icon: 2 });
                return;
            }

            let html = '';
            for (let r of replacements) {
                html += `<div class="d-flex align-items-center mb-2">
                    <span class="text-danger text-decoration-line-through mr-2" style="flex:1;">${escapeHtml(r.oldText.substring(0, 50))}</span>
                    <i class="fas fa-arrow-right text-success mx-2"></i>
                    <span class="text-success font-weight-bold" style="flex:1;">{{${escapeHtml(r.fieldName)}}}</span>
                </div>`;
            }
            document.getElementById('replacementPreview').innerHTML = html;
            goToStep(3);
        }

        async function saveTemplate() {
            let name = document.getElementById('templateName').value.trim();
            let fileInput = document.getElementById('templateFile');
            let file = fileInput.files[0];

            if (!name || !file) {
                ems.msg('请完善模板信息', { icon: 2 });
                return;
            }

            let formData = new FormData();
            formData.append('templateFile', file);
            formData.append('TemplateName', name);
            formData.append('TemplateDescription', document.getElementById('templateDescription').value);

            for (let i = 0; i < replacements.length; i++) {
                formData.append(`Replacements[${i}].OldText`, replacements[i].oldText);
                formData.append(`Replacements[${i}].FieldName`, replacements[i].fieldName);
                formData.append(`Replacements[${i}].FieldLabel`, replacements[i].fieldLabel);
                formData.append(`Replacements[${i}].Source`, replacements[i].source || 'full');
                formData.append(`Replacements[${i}].StartIndex`, replacements[i].startIndex || 0);
                formData.append(`Replacements[${i}].EndIndex`, replacements[i].endIndex || replacements[i].oldText.length);
            }

            try {
                ems.loading(1);
                let resp = await fetch('/templatereport/configure-template', {
                    method: 'POST',
                    body: formData
                });
                let result = await resp.json();
                ems.closeAll();

                if (result.code === 200) {
                    ems.msg('模板保存成功，', { icon: 1 });
                    setTimeout(() => {
                        window.location.href = '/templatereport/index';
                    }, 1500);
                } else {
                    ems.msg(result.message || '保存失败', { icon: 2 });
                }
            } catch (err) {
                ems.closeAll();
                ems.msg('保存失败: ' + err.message, { icon: 2 });
            }
        }

        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[m]);
        }

        document.getElementById('templateFile').addEventListener('change', function(e) {
            let fileName = e.target.files[0] ? e.target.files[0].name : '选择文件...';
            $(this).next('.custom-file-label').html(fileName);
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>
}
