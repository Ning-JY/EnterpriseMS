@{
    Layout = "_Layout";
}
@section Styles {
    <style>
        .cfg-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; padding: 14px 16px; background: #fff; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.06); margin-bottom: 14px; }
        .cfg-toolbar .layui-form-item { margin-bottom: 0; }
        .cfg-toolbar .cfg-name { width: 220px; }
        .cfg-toolbar .cfg-cat { width: 160px; }
        .cfg-toolbar .cfg-desc { flex: 1; min-width: 200px; }
        .cfg-grid { display: grid; grid-template-columns: 260px 1fr 300px; gap: 14px; align-items: start; }
        @@media (max-width: 1100px) { .cfg-grid { grid-template-columns: 1fr; } }
        .cfg-panel { background: #fff; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.06); padding: 12px; }
        .cfg-panel > h3 { margin: 0 0 10px; font-size: 15px; color: #0f172a; display: flex; align-items: center; gap: 6px; }
        .cfg-panel > h3 small { font-weight: normal; color: #94a3b8; font-size: 12px; }
        .palette-group { margin-bottom: 12px; }
        .pg-title { font-size: 12px; color: #64748b; font-weight: 600; margin-bottom: 6px; padding-left: 2px; }
        .chip { background: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 6px; padding: 7px 9px; margin-bottom: 6px; cursor: grab; font-size: 13px; color: #334155; transition: .15s; user-select: none; }
        .chip:hover { background: #e0f2fe; border-color: #0d6b64; color: #0d6b64; }
        .chip small { display: block; color: #94a3b8; font-size: 11px; }
        .chip:active { cursor: grabbing; }
        .canvas-block { border: 1px solid #e2e8f0; border-left: 3px solid #cbd5e1; border-radius: 6px; padding: 9px 11px; margin-bottom: 8px; font-size: 13px; color: #334155; line-height: 1.6; cursor: default; transition: .15s; background: #fff; }
        .canvas-block:hover { border-left-color: #0d6b64; }
        .canvas-block.drop-hover { background: #ecfeff; border-color: #0d6b64; }
        .canvas-block.bound { border-left-color: #0d6b64; background: #f0fdfa; }
        .canvas-block .bound-badge { display: inline-block; margin-top: 6px; background: #0d6b64; color: #fff; font-size: 11px; padding: 2px 8px; border-radius: 10px; }
        .canvas-block.table-row { border-left-color: #f59e0b; color: #92400e; background: #fffbeb; font-style: italic; }
        .canvas-empty, .ems-empty { color: #94a3b8; text-align: center; padding: 24px 8px; font-size: 13px; }
        .bind-item { border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 10px; margin-bottom: 8px; font-size: 13px; }
        .bind-item .bi-name { font-weight: 600; color: #0f172a; }
        .bind-item .bi-meta { color: #64748b; font-size: 12px; margin-top: 2px; }
        .bind-item .bi-actions { margin-top: 6px; }
        .bind-item .layui-badge { margin-right: 4px; }
        .preview-row { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; padding: 4px 0; border-bottom: 1px dashed #eef2f7; }
        .preview-row .pv-key { color: #0d6b64; font-family: Consolas, monospace; }
        .preview-row .pv-val { color: #475569; text-align: right; max-width: 60%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        #fieldBindModal { display: none; padding: 16px; }
        .drag-hint { font-size: 12px; color: #0d6b64; background: #ecfeff; border-radius: 6px; padding: 6px 10px; margin-bottom: 10px; }
        .fb-substr-tip { font-size: 12px; color: #64748b; margin-top: 4px; line-height: 1.5; }
        .fb-substr-tip strong { color: #0d6b64; }
        #fbOriginalPreview { border: 1px dashed #cbd5e1; border-radius: 6px; padding: 8px 10px; font-size: 13px; color: #475569; line-height: 1.7; max-height: 150px; overflow: auto; white-space: pre-wrap; user-select: text; background: #f8fafc; }
    </style>
}

<div class="cfg-toolbar">
    <div class="layui-form-item cfg-name">
        <label class="layui-form-label" style="width:auto;padding-left:0">模板名称</label>
        <div class="layui-input-block" style="margin-left:0">
            <input type="text" id="tplName" class="layui-input" placeholder="如：项目建议书" />
        </div>
    </div>
    <div class="layui-form-item cfg-cat">
        <label class="layui-form-label" style="width:auto;padding-left:0">分类</label>
        <div class="layui-input-block" style="margin-left:0">
            <input type="text" id="tplCategory" class="layui-input" list="categoryList" placeholder="报告/合同…" />
            <datalist id="categoryList">
                <option value="报告"></option><option value="合同"></option><option value="证书"></option>
                <option value="通知"></option><option value="函"></option><option value="其他"></option>
            </datalist>
        </div>
    </div>
    <div class="layui-form-item cfg-desc">
        <label class="layui-form-label" style="width:auto;padding-left:0">说明</label>
        <div class="layui-input-block" style="margin-left:0">
            <input type="text" id="tplDesc" class="layui-input" placeholder="模板用途简介" />
        </div>
    </div>
    <button class="layui-btn layui-btn-normal" onclick="saveTemplate()"><i class="layui-icon">&#xe605;</i> 保存模板</button>
    <button class="layui-btn layui-btn-primary" onclick="ems.openTab('/templatereport/manage','模板管理')">返回</button>
</div>

<div class="cfg-grid">
    <!-- 左：字段调色板 -->
    <div class="cfg-panel">
        <h3>字段调色板 <small>拖拽到画布</small></h3>
        <div class="drag-hint">把左侧字段拖到中间文档块上即可完成绑定</div>
        <div id="palette"><div class="ems-empty">加载中…</div></div>
    </div>

    <!-- 中：文档画布 -->
    <div class="cfg-panel">
        <h3>模板画布 <small id="canvasSub">上传 Word 模板开始</small></h3>
        <div id="fileRow" class="layui-form-item" style="margin-bottom:12px">
            <input type="file" id="templateFile" accept=".docx" class="layui-input" onchange="uploadAndParse()" />
        </div>
        <div id="canvasWrap"><div class="canvas-empty">请先上传含真实正文的 Word 模板（如“建设单位：XXX 公司”），再把左侧字段拖到对应段落。</div></div>
    </div>

    <!-- 右：绑定列表 + 实时预览 -->
    <div class="cfg-panel">
        <h3>已绑定字段 <small id="bindCount">(0)</small></h3>
        <div id="bindingList"><div class="ems-empty">尚未绑定字段</div></div>
        <h3 style="margin-top:14px">实时预览 <small>占位符映射</small></h3>
        <div id="livePreview"><div class="ems-empty">绑定后显示</div></div>
    </div>
</div>

<!-- 绑定弹窗 -->
<div id="fieldBindModal">
    <div class="layui-form" lay-filter="bindForm">
        <div class="layui-form-item">
            <label class="layui-form-label">数据来源</label>
            <div class="layui-input-block"><span id="fbSource" class="layui-form-mid"></span></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">绑定键</label>
            <div class="layui-input-block"><span id="fbKey" class="layui-form-mid"></span></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">字段标题</label>
            <div class="layui-input-block"><input type="text" id="fbLabel" class="layui-input" placeholder="显示给填写人的名称" /></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">占位符名</label>
            <div class="layui-input-block"><input type="text" id="fbName" class="layui-input" placeholder="英文/数字，用于 {{name}}" /></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">文档原文</label>
            <div class="layui-input-block">
                <textarea id="fbOldText" class="layui-textarea" rows="2" placeholder="将被替换为占位符的 Word 原文"></textarea>
                <div class="fb-substr-tip">默认填入整段原文。<strong>可手动删减为段落里的部分文字</strong>（子串局部替换）。也可在下方“原文预览”中<strong>用鼠标选中一段文字</strong>，再点“用选中文字”。</div>
            </div>
        </div>
        <div class="layui-form-item" id="fbOriginalWrap" style="display:none">
            <label class="layui-form-label">原文预览</label>
            <div class="layui-input-block">
                <div id="fbOriginalPreview"></div>
                <button type="button" class="layui-btn layui-btn-xs layui-btn-normal" id="btnUseSelection" style="margin-top:6px">用选中文字填入“文档原文”</button>
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">类型</label>
            <div class="layui-input-block">
                <select id="fbType">
                    <option value="text">单行文本</option>
                    <option value="textarea">多行文本</option>
                    <option value="date">日期</option>
                    <option value="select">下拉选择</option>
                    <option value="image">图片</option>
                </select>
            </div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">必填</label>
            <div class="layui-input-block"><input type="checkbox" id="fbRequired" lay-skin="switch" checked /></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">默认值</label>
            <div class="layui-input-block"><input type="text" id="fbDefault" class="layui-input" /></div>
        </div>
        <div class="layui-form-item">
            <label class="layui-form-label">填写提示</label>
            <div class="layui-input-block"><input type="text" id="fbHelp" class="layui-input" placeholder="选填" /></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jszip@@3.10.1/dist/jszip.min.js"></script>
@section Scripts {
<script>
layui.use(['jquery', 'layer', 'form'], function () {
    var $ = layui.jquery, layer = layui.layer, form = layui.form;

    var currentId = new URLSearchParams(location.search).get('id') || '';
    var mode = currentId ? 'edit' : 'new';
    var parsedContent = [];      // [{index,type,text}]
    var replacements = [];       // 绑定对象
    var _sources = [];           // /data-sources
    var _file = null;
    var _chip = null;            // 当前拖入的字段
    var _editingIdx = -1;        // 编辑已有绑定时的下标
    var _pendingBlock = null;

    if (mode === 'edit') {
        $('#fileRow').hide();
        $('#canvasWrap').html('<div class="canvas-empty">编辑模式：调整字段后保存（保留原文档，仅更新字段配置）。</div>');
        loadExisting(currentId);
    } else {
        loadSources();
    }

    function loadExisting(id) {
        fetch('/templatereport/template/' + id).then(r => r.json()).then(function (j) {
            if (!j || j.code !== 200 || !j.data) { layer.msg('加载模板失败', { icon: 2 }); return; }
            var t = j.data;
            $('#tplName').val(t.name); $('#tplDesc').val(t.description); $('#tplCategory').val(t.category || '');
            replacements = (t.fields || []).map(function (f, i) {
                return {
                    id: i, blockIndex: -1, oldText: '', fieldName: f.name, fieldLabel: f.label,
                    fieldSource: f.source, binding: f.binding || '', configKey: f.configKey || '',
                    required: !!f.required, type: f.type || 'text',
                    defaultValue: f.defaultValue || '', helpText: f.helpText || ''
                };
            });
            renderBindings(); renderPreview();
        }).catch(function (e) { console.warn(e); });
    }

    function loadSources() {
        fetch('/templatereport/data-sources').then(r => r.json()).then(function (j) {
            if (!j || j.code !== 200 || !j.data) return;
            _sources = j.data; renderPalette();
        }).catch(function (e) { console.warn('加载字段来源失败', e); });
    }

    function sourceName(sid) {
        var s = _sources.find(function (x) { return x.sourceId === sid; });
        return s ? s.displayName : sid;
    }

    function renderPalette() {
        var html = '';
        _sources.forEach(function (s) {
            if (s.sourceId === 'manual') {
                html += '<div class="palette-group"><div class="pg-title">手动填写</div>' +
                    '<div class="chip" draggable="true" data-source="manual" data-key="" data-label="手动字段">＋ 手动字段</div></div>';
                return;
            }
            var chips = (s.fields || []).map(function (f) {
                return '<div class="chip" draggable="true" data-source="' + esc(s.sourceId) + '" data-key="' + esc(f.key) + '" data-label="' + esc(f.label) + '">' +
                    esc(f.label) + '<small>' + esc(f.key) + '</small></div>';
            }).join('');
            html += '<div class="palette-group"><div class="pg-title">' + esc(s.displayName) + '</div>' + chips + '</div>';
        });
        $('#palette').html(html);
    }

    // 拖拽：调色板 → 画布块
    $('#palette').on('dragstart', '.chip', function (e) {
        var el = this;
        e.originalEvent.dataTransfer.setData('text/plain', JSON.stringify({
            source: el.getAttribute('data-source'),
            key: el.getAttribute('data-key'),
            label: el.getAttribute('data-label')
        }));
    });

    $('#canvasWrap').on('dragover', '.canvas-block', function (e) { e.preventDefault(); $(this).addClass('drop-hover'); });
    $('#canvasWrap').on('dragleave', '.canvas-block', function () { $(this).removeClass('drop-hover'); });
    $('#canvasWrap').on('drop', '.canvas-block', function (e) {
        e.preventDefault(); $(this).removeClass('drop-hover');
        var data;
        try { data = JSON.parse(e.originalEvent.dataTransfer.getData('text/plain')); } catch (err) { return; }
        openBindModal(parseInt(this.getAttribute('data-index')), data);
    });

    function uploadAndParse() {
        var file = document.getElementById('templateFile').files[0];
        if (!file) return;
        _file = file;
        var reader = new FileReader();
        reader.onload = function (e) {
            parseDocxContent(e.target.result).then(function (blocks) {
                parsedContent = blocks;
                renderCanvas();
                $('#canvasSub').text('共 ' + blocks.length + ' 个段落');
                layer.msg('已解析 ' + blocks.length + ' 个段落，拖入字段完成绑定', { icon: 1 });
            });
        };
        reader.readAsArrayBuffer(file);
    }

    function parseDocxContent(arrayBuffer) {
        return JSZip.loadAsync(arrayBuffer).then(function (zip) {
            return zip.file('word/document.xml').async('string');
        }).then(function (xml) {
            var doc = new DOMParser().parseFromString(xml, 'application/xml');
            var body = doc.getElementsByTagName('w:body')[0];
            var items = [], idx = 0;
            if (!body) return items;
            for (var i = 0; i < body.children.length; i++) {
                var node = body.children[i];
                var tag = node.tagName || '';
                if (tag === 'w:p') {
                    var txt = collectText(node);
                    if (txt.trim()) items.push({ index: idx++, type: 'paragraph', text: txt.trim() });
                } else if (tag === 'w:tbl') {
                    var rows = node.getElementsByTagName('w:tr');
                    for (var r = 0; r < rows.length; r++) {
                        var rtxt = collectText(rows[r]);
                        if (rtxt.trim()) items.push({ index: idx++, type: 'table-row', text: rtxt.trim() });
                    }
                }
            }
            return items;
        });
    }
    function collectText(node) {
        var out = '';
        var ts = node.getElementsByTagName('w:t');
        for (var i = 0; i < ts.length; i++) out += ts[i].textContent;
        return out;
    }

    function renderCanvas() {
        if (!parsedContent.length) { $('#canvasWrap').html('<div class="canvas-empty">未解析到段落</div>'); return; }
        var boundIdx = {};
        replacements.forEach(function (r) { if (r.blockIndex >= 0) boundIdx[r.blockIndex] = r; });
        var html = '';
        parsedContent.forEach(function (b) {
            var cls = 'canvas-block' + (b.type === 'table-row' ? ' table-row' : '');
            var badge = '';
            if (boundIdx[b.index]) {
                cls += ' bound';
                badge = '<span class="bound-badge">{{' + esc(boundIdx[b.index].fieldName) + '}}</span>';
            }
            var note = b.type === 'table-row' ? ' <small style="color:#b45309">（表格行·仅展示）</small>' : '';
            html += '<div class="' + cls + '" data-index="' + b.index + '">' + esc(b.text) + note + badge + '</div>';
        });
        $('#canvasWrap').html(html);
    }

    function openBindModal(blockIndex, chip) {
        _chip = chip; _pendingBlock = blockIndex; _editingIdx = -1;
        var block = parsedContent[blockIndex];
        $('#fbSource').text(sourceName(chip.source));
        $('#fbKey').text(chip.source === 'manual' ? '（手动填写）' : chip.key);
        $('#fbLabel').val(chip.source === 'manual' ? '手动字段' : chip.label);
        $('#fbName').val(chip.source === 'manual' ? '' : chip.key);
        $('#fbOldText').val(block ? block.text : '');
        $('#fbOriginalPreview').text(block ? block.text : '');
        $('#fbOriginalWrap').toggle(!!block);
        $('#fbType').val('text');
        $('#fbRequired').prop('checked', true);
        $('#fbDefault').val(''); $('#fbHelp').val('');
        form.render();
        layer.open({ type: 1, title: '绑定字段', area: ['520px', 'auto'], content: $('#fieldBindModal'),
            btn: ['确定', '取消'], yes: function (idx) { confirmBind(idx); }, btn2: function (idx) { layer.close(idx); } });
    }

    function editBinding(idx) {
        var r = replacements[idx]; _chip = { source: r.fieldSource, key: r.binding || r.configKey, label: r.fieldLabel };
        _pendingBlock = r.blockIndex; _editingIdx = idx;
        $('#fbSource').text(sourceName(r.fieldSource));
        $('#fbKey').text(r.fieldSource === 'manual' ? '（手动填写）' : (r.binding || r.configKey || ''));
        $('#fbLabel').val(r.fieldLabel); $('#fbName').val(r.fieldName);
        $('#fbOldText').val(r.oldText); $('#fbType').val(r.type || 'text');
        $('#fbOriginalPreview').text(r.oldText || '');
        $('#fbOriginalWrap').show();
        $('#fbRequired').prop('checked', r.required); $('#fbDefault').val(r.defaultValue || ''); $('#fbHelp').val(r.helpText || '');
        form.render();
        layer.open({ type: 1, title: '编辑字段', area: ['520px', 'auto'], content: $('#fieldBindModal'),
            btn: ['确定', '取消'], yes: function (i2) { confirmBind(i2); }, btn2: function (i2) { layer.close(i2); } });
    }

    function confirmBind(idx) {
        var name = $('#fbName').val().trim();
        var label = $('#fbLabel').val().trim() || name;
        if (!name) { layer.msg('请填写占位符名', { icon: 2 }); return; }
        name = sanitizeName(name);
        if (replacements.some(function (r, i) { return r.fieldName === name && i !== _editingIdx; })) { layer.msg('占位符名重复', { icon: 2 }); return; }
        var isConfig = _chip.source === 'config';
        var rep = {
            id: _editingIdx >= 0 ? replacements[_editingIdx].id : Date.now(),
            blockIndex: _editingIdx >= 0 ? replacements[_editingIdx].blockIndex : (_pendingBlock != null ? _pendingBlock : -1),
            oldText: $('#fbOldText').val(),
            fieldName: name, fieldLabel: label,
            fieldSource: _chip.source,
            binding: isConfig ? '' : (_chip.key || ''),
            configKey: isConfig ? (_chip.key || '') : '',
            required: $('#fbRequired').is(':checked'),
            type: $('#fbType').val(),
            defaultValue: $('#fbDefault').val(),
            helpText: $('#fbHelp').val()
        };
        if (_editingIdx >= 0) replacements[_editingIdx] = rep; else replacements.push(rep);
        layer.close(idx);
        renderCanvas(); renderBindings(); renderPreview();
    }

    function removeBinding(idx) {
        replacements.splice(idx, 1);
        renderCanvas(); renderBindings(); renderPreview();
    }

    function renderBindings() {
        $('#bindCount').text('(' + replacements.length + ')');
        if (!replacements.length) { $('#bindingList').html('<div class="ems-empty">尚未绑定字段</div>'); return; }
        var html = replacements.map(function (r, i) {
            var src = r.fieldSource === 'manual' ? '手动' : (r.fieldSource === 'config' ? '配置' : sourceName(r.fieldSource));
            return '<div class="bind-item">' +
                '<div class="bi-name">{{' + esc(r.fieldName) + '}}</div>' +
                '<div class="bi-meta">' + esc(r.fieldLabel) + ' · <span class="layui-badge layui-bg-blue">' + esc(src) + '</span>' +
                (r.required ? '<span class="layui-badge">必填</span>' : '') + '</div>' +
                '<div class="bi-actions">' +
                '<a class="layui-btn layui-btn-xs" onclick="editBinding(' + i + ')">编辑</a>' +
                '<a class="layui-btn layui-btn-xs layui-btn-danger" onclick="removeBinding(' + i + ')">删除</a></div></div>';
        }).join('');
        $('#bindingList').html(html);
    }

    function renderPreview() {
        if (!replacements.length) { $('#livePreview').html('<div class="ems-empty">绑定后显示</div>'); return; }
        var html = replacements.map(function (r) {
            return '<div class="preview-row"><span class="pv-key">{{' + esc(r.fieldName) + '}}</span>' +
                '<span class="pv-val">' + esc(r.oldText || '—') + '</span></div>';
        }).join('');
        $('#livePreview').html(html);
    }

    function saveTemplate() {
        var name = $('#tplName').val().trim();
        if (!name) { layer.msg('请填写模板名称', { icon: 2 }); return; }
        if (!replacements.length) { layer.msg('请至少绑定一个字段', { icon: 2 }); return; }
        if (mode === 'new' && !_file) { layer.msg('请上传 Word 模板', { icon: 2 }); return; }

        var fd = new FormData();
        if (mode === 'edit') fd.append('TemplateId', currentId);
        fd.append('TemplateName', name);
        fd.append('TemplateDescription', $('#tplDesc').val());
        fd.append('Category', $('#tplCategory').val());
        if (_file) fd.append('templateFile', _file);
        for (var i = 0; i < replacements.length; i++) {
            var r = replacements[i];
            fd.append('Replacements[' + i + '].OldText', r.oldText);
            fd.append('Replacements[' + i + '].FieldName', r.fieldName);
            fd.append('Replacements[' + i + '].FieldLabel', r.fieldLabel);
            fd.append('Replacements[' + i + '].Source', 'full');
            fd.append('Replacements[' + i + '].FieldSource', r.fieldSource);
            fd.append('Replacements[' + i + '].Binding', r.binding || '');
            fd.append('Replacements[' + i + '].ConfigKey', r.configKey || '');
            fd.append('Replacements[' + i + '].Required', r.required ? 'true' : 'false');
            fd.append('Replacements[' + i + '].Type', r.type || 'text');
            fd.append('Replacements[' + i + '].DefaultValue', r.defaultValue || '');
            fd.append('Replacements[' + i + '].HelpText', r.helpText || '');
            fd.append('Replacements[' + i + '].StartIndex', 0);
            fd.append('Replacements[' + i + '].EndIndex', (r.oldText || '').length);
        }
        var load = layer.load(2);
        fetch('/templatereport/configure-template', {
            method: 'POST', headers: { 'RequestVerificationToken': getAntiForgeryToken() }, body: fd
        }).then(function (r) { return r.json(); }).then(function (j) {
            layer.close(load);
            if (j && (j.code === 200 || j.success)) { layer.msg('模板已保存', { icon: 1 }); setTimeout(function () { ems.openTab('/templatereport/manage', '模板管理'); }, 1200); }
            else layer.msg((j && j.message) || '保存失败', { icon: 2 });
        }).catch(function (e) { layer.close(load); layer.msg('保存失败：' + e, { icon: 2 }); });
    }

    function getAntiForgeryToken() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (!t && window.parent !== window) { try { t = window.parent.document.querySelector('input[name="__RequestVerificationToken"]'); } catch (e) { } }
        return (t && t.value) || '';
    }
    function sanitizeName(s) { return s.replace(/\s+/g, '_').replace(/[^\w一-龥]/g, ''); }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }

    // —— 子串替换辅助：在“原文预览”中框选文字，点按钮填入“文档原文” ——
    var _lastSel = '';
    $('#fbOriginalPreview').on('mouseup', function () {
        var s = (window.getSelection ? window.getSelection().toString() : '') || '';
        if (s && s.trim()) _lastSel = s;
    });
    $('#btnUseSelection').on('click', function () {
        var s = _lastSel || (window.getSelection ? window.getSelection().toString() : '') || '';
        s = (s || '').trim();
        if (!s) { layer.msg('请先在上方“原文预览”中用鼠标选中一段文字', { icon: 2 }); return; }
        $('#fbOldText').val(s);
        layer.msg('已填入选中文字（子串替换）', { icon: 1 });
    });

    // 暴露给内联 onclick
    window.saveTemplate = saveTemplate;
    window.uploadAndParse = uploadAndParse;
    window.editBinding = editBinding;
    window.removeBinding = removeBinding;
});
</script>
}
