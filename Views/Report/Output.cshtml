@using EnterpriseMS.Domain.Entities.System
@model dynamic
@{
    ViewData["Title"] = "产值报表";
    var depts     = ViewBag.Depts as List<SysDept> ?? new();
    int year      = (int)(ViewBag.Year ?? DateTime.Today.Year);
    decimal totC  = (decimal)(ViewBag.TotalContract ?? 0m);
    decimal totR  = (decimal)(ViewBag.TotalReceived  ?? 0m);
    var byDept    = ViewBag.ByDept as dynamic;
    var empList   = Model as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<style>
    .emp-row { cursor: pointer; }
</style>

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-chart-screen"></i> 个人产值报表
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">报表中心</a>
        <a><cite>产值报表</cite></a>
    </div>
</div>

<!-- 筛选栏 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="outputSearch" method="get" action="/report/output">
            <div class="layui-inline">
                <select name="year">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                    {
                        <option value="@y" selected="@(y == year ? "selected" : null)">@y 年</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                @await Component.InvokeAsync("DeptSelect", new {
                    id = "deptId", name = "deptId",
                    selectedId = (ViewBag.DeptId as long? ?? 0),
                    emptyText = "全部部门",
                    cssClass = ""
                })
            </div>
            <div class="layui-inline">
                <input type="text" name="keyword" class="layui-input"
                       placeholder="员工姓名/项目名称" value="@ViewBag.Keyword" style="width:160px">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="outputSearch">
                    <i class="layui-icon layui-icon-search"></i> 筛选
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                <a class="layui-btn layui-btn-normal"
                   href="/report/output/export?year=@year&deptId=@ViewBag.DeptId&keyword=@ViewBag.Keyword">
                    <i class="layui-icon layui-icon-export"></i> 导出Excel
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 汇总 -->
<div class="ems-stat-cards">
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-user"></i> 参与人员</div>
        <div class="value layui-font-teal">@(empList.Count())<span class="layui-font-12"> 人</span></div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-file"></i> 总合同产值（分配后）</div>
        <div class="value layui-font-orange">¥@totC.ToString("N2")<span class="layui-font-12"> 万</span></div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-dollar"></i> 已实现产值（@year 年）</div>
        <div class="value layui-font-green">¥@totR.ToString("N2")<span class="layui-font-12"> 万</span></div>
    </div>
</div>

<!-- 部门汇总 -->
@if (byDept != null)
{
    <div class="layui-card ems-card">
        <div class="layui-card-header"><span>部门产值汇总</span></div>
        <div class="layui-card-body">
            <table class="layui-table" lay-size="sm">
                <thead>
                    <tr><th>部门</th><th>人员数</th><th>合同产值(万)</th><th>已实现产值(万)</th><th>实现率</th></tr>
                </thead>
                <tbody>
                    @foreach (var g in byDept)
                    {
                        decimal gContractVal = Convert.ToDecimal(g.ContractValue);
                        decimal gReceivedVal = Convert.ToDecimal(g.ReceivedValue);
                        decimal gRate = gContractVal > 0 ? gReceivedVal / gContractVal * 100m : 0m;
                        <tr>
                            <td><strong>@g.DeptName</strong></td>
                            <td>@g.EmpCount 人</td>
                            <td class="layui-font-teal">¥@gContractVal.ToString("N2")</td>
                            <td class="layui-font-green">¥@gReceivedVal.ToString("N2")</td>
                            <td>
                                <div class="ems-progress" style="width:80px;display:inline-block;vertical-align:middle">
                                    <span style="width:@gRate.ToString("N1")%"></span>
                                </div>
                                <span class="layui-font-12 layui-font-gray" style="margin-left:6px">@gRate.ToString("N0")%</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- 个人明细 -->
<div class="layui-card ems-card">
    <div class="layui-card-header"><span>个人产值明细（@year 年）</span></div>
    <div class="layui-card-body">
        <table class="layui-table" lay-size="sm">
            <thead>
                <tr>
                    <th>员工</th><th>部门</th><th>参与项目数</th>
                    <th>合同产值(万)</th><th>已实现产值(万)</th><th>实现率</th><th>展开</th>
                </tr>
            </thead>
            <tbody>
                @{int empIdx = 0;}
                @foreach (var e in empList)
                {
                    empIdx++;
                    decimal eCv   = Convert.ToDecimal(e.ContractValue);
                    decimal eRv   = Convert.ToDecimal(e.ReceivedValue);
                    decimal eRate = eCv > 0 ? eRv / eCv * 100m : 0m;
                    <tr class="emp-row" onclick="toggleDetail('detail-@empIdx')">
                        <td><strong>@e.EmpName</strong></td>
                        <td><span class="layui-font-12 layui-font-gray">@e.DeptName</span></td>
                        <td class="layui-text-center">@e.ProjectCount</td>
                        <td class="layui-font-teal">¥@eCv.ToString("N2")</td>
                        <td class="layui-font-green">¥@eRv.ToString("N2")</td>
                        <td>
                            <div class="ems-progress" style="width:60px;display:inline-block;vertical-align:middle">
                                <span style="width:@eRate.ToString("N1")%"></span>
                            </div>
                            <span class="layui-font-12 layui-font-gray" style="margin-left:6px">@eRate.ToString("N0")%</span>
                        </td>
                        <td><i class="layui-icon layui-icon-down layui-font-gray" id="icon-@empIdx"></i></td>
                    </tr>
                    <!-- 展开项目明细 -->
                    <tr id="detail-@empIdx" class="layui-hide">
                        <td colspan="7" class="layui-bg-gray">
                            <table class="layui-table" lay-size="sm" style="margin:0">
                                <thead>
                                    <tr class="layui-font-12 layui-font-gray">
                                        <th>项目编号</th><th>项目名称</th><th>角色</th>
                                        <th>占比</th><th>合同产值(万)</th><th>已实现(万)</th><th>状态</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pm in e.Projects)
                                    {
                                        // dynamic 对象不能用 ?. 和强制转换，全部用 Convert
                                        decimal pmActual = pm.Project != null
                                            ? Convert.ToDecimal(pm.Project.ActualContractAmount) : 0m;
                                        decimal pmRatio  = Convert.ToDecimal(pm.Ratio);
                                        decimal pmCv     = pmActual * pmRatio / 100m;
                                        string  pmProjNo   = pm.Project != null ? (string)(pm.Project.ProjNo   ?? "") : "";
                                        string  pmProjName = pm.Project != null ? (string)(pm.Project.ProjName ?? "") : "";
                                        string  pmRole     = (string)(pm.Role ?? "");
                                        int     pmStatus   = pm.Project != null ? Convert.ToInt32(pm.Project.ProgressStatus) : 0;
                                        string  pmStatusText = pmStatus switch {
                                            6 => "执行中", 7 => "成果提交",
                                            8 => "已完成", 9 => "已终止", _ => "进行中"
                                        };
                                        <tr class="layui-font-12">
                                            <td><code>@pmProjNo</code></td>
                                            <td>@pmProjName</td>
                                            <td>@pmRole</td>
                                            <td>@pmRatio.ToString("N1")%</td>
                                            <td class="layui-font-teal">¥@pmCv.ToString("N2")</td>
                                            <td class="layui-font-green">-</td>
                                            <td><span class="layui-badge layui-bg-gray">@pmStatusText</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
                @if (!empList.Any())
                {
                    <tr><td colspan="7" class="layui-text-center layui-font-gray" style="padding:24px 0">暂无数据</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function toggleDetail(id) {
    var idx = id.split('-')[1];
    var row = document.getElementById(id);
    var icon = document.getElementById('icon-' + idx);
    if (row.classList.contains('layui-hide')) {
        row.classList.remove('layui-hide');
        icon.classList.replace('layui-icon-down', 'layui-icon-up');
    } else {
        row.classList.add('layui-hide');
        icon.classList.replace('layui-icon-up', 'layui-icon-down');
    }
}
</script>
}
