@using EnterpriseMS.Domain.Entities.Project
@using EnterpriseMS.Domain.Entities.System
@model List<EnterpriseMS.Domain.Entities.Project.ProjectInvoice>
@{
    ViewData["Title"] = "回款报表";
    var depts    = ViewBag.Depts   as List<SysDept>  ?? new();
    var byDept   = ViewBag.ByDept  as dynamic;
    var byMonth  = ViewBag.ByMonth as dynamic;
    int year     = (int)(ViewBag.Year ?? DateTime.Today.Year);
    decimal totalAmt  = (decimal)(ViewBag.TotalAmount  ?? 0m);
    decimal totalRcv  = (decimal)(ViewBag.TotalReceived ?? 0m);
    decimal totalPend = (decimal)(ViewBag.TotalPending  ?? 0m);
    decimal recvRate  = totalAmt > 0 ? totalRcv / totalAmt * 100m : 0m;
    string fmtAmt(decimal v) => $"¥{v:N2}万";
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-chart"></i> 回款报表
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">报表中心</a>
        <a><cite>回款报表</cite></a>
    </div>
</div>

<!-- 筛选栏 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="receiptSearch" method="get" action="/report/receipt">
            <div class="layui-inline">
                <select name="year">
                    @for (int y = DateTime.Today.Year; y >= DateTime.Today.Year - 4; y--)
                    {
                        <option value="@y" selected="@(y == year ? "selected" : null)">@y 年</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                @await Component.InvokeAsync("DeptSelect", new {
                    id = "deptId", name = "deptId",
                    selectedId = (ViewBag.DeptId as long? ?? 0),
                    emptyText = "全部部门",
                    cssClass = ""
                })
            </div>
            <div class="layui-inline">
                <input type="text" name="keyword" class="layui-input"
                       placeholder="项目名称/编号" value="@ViewBag.Keyword" style="width:160px">
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="receiptSearch">
                    <i class="layui-icon layui-icon-search"></i> 筛选
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                <a class="layui-btn layui-btn-normal"
                   href="/report/receipt/export?year=@year&deptId=@ViewBag.DeptId&keyword=@ViewBag.Keyword">
                    <i class="layui-icon layui-icon-export"></i> 导出Excel
                </a>
            </div>
        </form>
    </div>
</div>

<!-- 汇总 -->
<div class="ems-stat-cards">
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-file"></i> 开票总额</div>
        <div class="value layui-font-teal">@fmtAmt(totalAmt)</div>
        <div class="label">共 @Model.Count 条记录</div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-ok-circle"></i> 已收款</div>
        <div class="value layui-font-green">@fmtAmt(totalRcv)</div>
        <div class="label">@Model.Count(i => i.IsReceived) 条</div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-time"></i> 待收款</div>
        <div class="value layui-font-orange">@fmtAmt(totalPend)</div>
        <div class="label">@Model.Count(i => !i.IsReceived) 条</div>
    </div>
    <div class="ems-stat-card">
        <div class="label"><i class="layui-icon layui-icon-percent"></i> 回款率</div>
        <div class="value">@(totalAmt > 0 ? $"{recvRate:N1}%" : "0%")</div>
        <div class="ems-progress" style="margin-top:8px">
            <span style="width:@(totalAmt > 0 ? recvRate.ToString("N1") : "0")%"></span>
        </div>
    </div>
</div>

<div class="ems-card-row">
    <!-- 按部门统计 -->
    <div class="ems-info-card ems-col-side">
        <div class="ems-info-card-title">按部门回款统计</div>
        <table class="layui-table" lay-size="sm" style="margin:0">
            <thead>
                <tr><th>部门</th><th>开票金额</th><th>已收款</th><th>回款率</th></tr>
            </thead>
            <tbody>
                @if (byDept != null)
                {
                    foreach (var g in byDept)
                    {
                        decimal gTotal    = Convert.ToDecimal(g.TotalAmount);
                        decimal gReceived = Convert.ToDecimal(g.ReceivedAmount);
                        decimal rate      = gTotal > 0 ? gReceived / gTotal * 100m : 0m;
                        <tr>
                            <td>@g.DeptName</td>
                            <td class="layui-font-teal">¥@gTotal.ToString("N2")</td>
                            <td class="layui-font-green">¥@gReceived.ToString("N2")</td>
                            <td>
                                <div class="ems-progress" style="width:60px;display:inline-block;vertical-align:middle">
                                    <span style="width:@rate.ToString("N1")%"></span>
                                </div>
                                <span class="layui-font-12 layui-font-gray" style="margin-left:6px">@rate.ToString("N0")%</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- 月度回款分布 -->
    <div class="ems-info-card ems-col-main">
        <div class="ems-info-card-title">@year 年月度回款分布（万元）</div>
        <canvas id="monthChart" height="160"></canvas>
    </div>
</div>

<!-- 明细表 -->
<div class="layui-card ems-card">
    <div class="layui-card-header"><span>回款明细</span></div>
    <div class="layui-card-body">
        <table class="layui-table" lay-size="sm">
            <thead>
                <tr>
                    <th>项目编号</th><th>项目名称</th><th>回款批次</th>
                    <th>发票号</th><th>金额(万)</th><th>税率</th>
                    <th>开票日期</th><th>付款方</th><th>状态</th><th>收款日期</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td><code class="layui-font-12">@(i.Project?.ProjNo ?? "-")</code></td>
                        <td class="layui-font-12">@(i.Project?.ProjName ?? "-")</td>
                        <td><strong>@i.ReceiptName</strong></td>
                        <td class="layui-font-12 layui-font-gray">@(i.InvoiceNo ?? "-")</td>
                        <td class="layui-font-teal">¥@i.Amount.ToString("N2")</td>
                        <td class="layui-font-12">@(i.TaxRate.HasValue ? i.TaxRate.Value.ToString("N1") + "%" : "-")</td>
                        <td class="layui-font-12">@(i.InvoiceDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="layui-font-12">@(i.Payer ?? "-")</td>
                        <td>
                            @if (i.IsReceived)
                            { <span class="layui-badge layui-bg-green">已收款</span> }
                            else
                            { <span class="layui-badge layui-bg-orange">待收款</span> }
                        </td>
                        <td class="layui-font-12">@(i.ReceivedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="10" class="layui-text-center layui-font-gray" style="padding:24px 0">暂无数据</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js"></script>
<script>
var monthData = [@if (byMonth != null) { foreach (var m in byMonth) { @((decimal)m.Amount) @Html.Raw(",") } }];
var ctx = document.getElementById('monthChart').getContext('2d');
new Chart(ctx, {
    type: 'bar',
    data: {
        labels: ['1月','2月','3月','4月','5月','6月','7月','8月','9月','10月','11月','12月'],
        datasets: [{
            label: '已收款（万元）',
            data: monthData,
            backgroundColor: 'rgba(46,158,91,0.7)',
            borderColor: 'rgba(46,158,91,1)',
            borderWidth: 1,
        }]
    },
    options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true } }
    }
});
</script>
}
