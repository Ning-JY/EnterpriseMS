@model EnterpriseMS.Services.DTOs.Bid.BidProjectCreateDto
@{
    ViewData["Title"] = "新建投标";
    Layout = "_Layout";
    bool isDialog = Context.Request.Query["_dialog"] == "1";
}

@if (!isDialog)
{
    <div class="ems-page-head">
        <div class="ems-page-title">
            <i class="layui-icon layui-icon-add-1"></i> 新建投标
        </div>
        <div class="layui-breadcrumb" lay-separator="/">
            <a href="javascript:;">首页</a>
            <a href="javascript:;">投标管理</a>
            <a><cite>新建投标</cite></a>
        </div>
    </div>
}

<form class="layui-form" lay-filter="bidForm" id="bidForm">
    <div class="layui-row layui-col-space12">

        <!-- 基本信息 -->
        <div class="layui-col-md8">
            <div class="layui-card ems-card">
                <div class="layui-card-header">基本信息</div>
                <div class="layui-card-body">

                    <div class="layui-form-item">
                        <label class="layui-form-label">关联项目</label>
                        <div class="layui-input-block">
                            <div class="layui-inline" style="width:calc(100% - 130px)">
                                <div class="layui-input-inline" style="width:100%">
                                    <select name="ProjectId" id="ProjectId" lay-search>
                                        <option value="">— 不关联（可选）—</option>
                                        @{
                                            var projects = (ViewBag.Projects as IEnumerable<dynamic>) ?? Array.Empty<dynamic>();
                                        }
                                        @foreach (var p in projects)
                                        {
                                            var label = (p.ProjNo != null ? p.ProjNo + " · " : "") + p.ProjName;
                                            <option value="@p.Id">@label</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="layui-inline">
                                <button type="button" class="layui-btn layui-btn-primary" id="btnQuickProject"
                                        title="按名称快速建项并关联">
                                    <i class="layui-icon layui-icon-add-circle"></i> 一键转项目
                                </button>
                            </div>
                            <div class="layui-word-aux" style="margin-top:6px">
                                可留空；或按项目名称选择已有项目，亦可直接一键建项并关联。
                            </div>
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">招标人</label>
                        <div class="layui-input-block">
                            <input type="text" name="Tenderer" class="layui-input"
                                   autocomplete="off" placeholder="如：XX市建设局">
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">预算金额</label>
                        <div class="layui-input-block">
                            <input type="number" step="0.01" name="Budget" class="layui-input"
                                   autocomplete="off" placeholder="单位：万元">
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">投标截止</label>
                        <div class="layui-input-block">
                            <input type="date" name="Deadline" class="layui-input" autocomplete="off">
                        </div>
                    </div>

                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">备注</label>
                        <div class="layui-input-block">
                            <textarea name="Remark" rows="3" class="layui-textarea"
                                      placeholder="项目描述、特殊要求等"></textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- 操作说明 -->
        <div class="layui-col-md4">
            <div class="layui-card ems-card">
                <div class="layui-card-header">操作说明</div>
                <div class="layui-card-body">
                    <div class="ems-alert info">创建投标项目后，可以继续以下操作：</div>
                    <div class="ems-info-list" style="margin-top:12px">
                        <div class="ems-info-item"><span class="label">第 1 步</span><span class="val">上传招标文件进行 AI 解析</span></div>
                        <div class="ems-info-item"><span class="label">第 2 步</span><span class="val">一键生成标书各章节</span></div>
                        <div class="ems-info-item"><span class="label">第 3 步</span><span class="val">预览和编辑章节内容</span></div>
                        <div class="ems-info-item"><span class="label">第 4 步</span><span class="val">组卷生成完整投标文件</span></div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="ems-form-foot">
        <button type="button" class="layui-btn layui-btn-normal" id="btnSave">
            <i class="layui-icon layui-icon-ok"></i> 创建
        </button>
        <button type="button" class="layui-btn layui-btn-primary" id="btnCancel">取消</button>
    </div>
</form>

@section Scripts {
<script>
ems.ready(function () {

    var isDialog = ems.query('_dialog') === '1';
    var $sel = $('#ProjectId');

    /* ── 关联项目下拉 ───────────────────────────── */
    function buildOptions(list, selectedId) {
        var html = '<option value="">— 不关联（可选）—</option>';
        (list || []).forEach(function (p) {
            var label = (p.ProjNo ? p.ProjNo + ' · ' : '') + p.ProjName;
            var sel = (selectedId && String(selectedId) === String(p.Id)) ? ' selected' : '';
            html += '<option value="' + p.Id + '"' + sel + '>' + ems.escapeHtml(label) + '</option>';
        });
        $sel.html(html);
        ems.renderForm('bidForm', 'select');
    }

    function loadProjects(selectedId) {
        $.get('/project/simple-list', function (res) {
            if (res && res.success && res.data) buildOptions(res.data, selectedId);
        }).fail(function () { console.warn('项目列表加载失败'); });
    }

    /* ── 一键转项目：输入项目名称 → 建项 → 关联 ── */
    $('#btnQuickProject').on('click', function () {
        ems.prompt({ title: '一键转项目（输入项目名称）', formType: 0 }, function (name) {
            name = (name || '').trim();
            if (!name) { ems.warn('请输入项目名称'); return; }
            doQuickCreate(name);
        });
    });

    function doQuickCreate(name) {
        ems.post({
            url: '/project/quick-create',
            json: true,
            data: { ProjName: name },
            done: function (res) {
                var newId = res.data && (res.data.id || res.data.Id);
                loadProjects(newId);
                ems.success('已创建项目并关联：' + name);
            }
        });
    }

    /* ── 提交 ───────────────────────────────────── */
    $('#btnSave').on('click', function () {
        ems.post({
            url: '/Bid/Create',
            json: false,                       // MVC 动作无 [FromBody]，须用表单编码提交
            data: $('#bidForm').serialize(),
            done: function (res) {
                var id = res.data && (res.data.id || res.data.Id);
                if (!id) { ems.error('创建失败：未返回投标编号'); return; }
                ems.success('创建成功');
                setTimeout(function () {
                    if (isDialog) ems.openTab('/bid/detail/' + id, '投标详情');
                    else          location.href = '/bid/detail/' + id;
                }, 400);
            }
        });
    });

    $('#btnCancel').on('click', function () {
        if (isDialog) ems.closeSelf('bidTable');
        else          ems.openTab('/bid', '投标台账');
    });
});
</script>
}
