@model EnterpriseMS.Services.DTOs.Bid.BidProjectCreateDto
@{
    ViewData["Title"] = "新建投标";
    Layout = "_Layout";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">新建投标</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item"><a href="/Bid">投标管理</a></li>
                    <li class="breadcrumb-item active">新建投标</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-plus-circle mr-1"></i>基本信息</h3>
                </div>
                <form asp-action="Create" method="post">
                    <div class="card-body">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">关联项目</label>
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <select asp-for="ProjectId" class="form-control">
                                        <option value="">— 不关联（可选）—</option>
                                    </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-outline-primary" id="btnQuickProject" title="按名称快速建项并关联">
                                            <i class="fas fa-magic mr-1"></i>一键转项目
                                        </button>
                                    </div>
                                </div>
                                <small class="form-text text-muted">可留空；或按项目名称选择已有项目，亦可直接一键建项并关联。</small>
                                <span asp-validation-for="ProjectId" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">招标人</label>
                            <div class="col-sm-9">
                                <input asp-for="Tenderer" class="form-control" placeholder="如：XX市建设局" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">预算金额（万元）</label>
                            <div class="col-sm-9">
                                <input asp-for="Budget" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">投标截止日期</label>
                            <div class="col-sm-9">
                                <input asp-for="Deadline" class="form-control" type="date" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">备注</label>
                            <div class="col-sm-9">
                                <textarea asp-for="Remark" class="form-control" rows="3" placeholder="项目描述、特殊要求等"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-1"></i>创建
                        </button>
                        <a href="/Bid" class="btn btn-default ml-2">取消</a>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-info card-outline">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-info-circle mr-1"></i>操作说明</h3>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-2">创建投标项目后，可以：</p>
                    <ul class="text-muted small">
                        <li>上传招标文件进行AI解析</li>
                        <li>一键生成标书各章节</li>
                        <li>预览和编辑章节内容</li>
                        <li>组卷生成完整投标文件</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
</section>

@section Scripts {
    <script>
        $(function () {
            var $sel = $('#ProjectId');

            function buildOptions(list) {
                var html = '<option value="">— 不关联（可选）—</option>';
                (list || []).forEach(function (p) {
                    var label = (p.projNo ? p.projNo + ' · ' : '') + p.projName;
                    html += '<option value="' + p.id + '">' + escapeHtml(label) + '</option>';
                });
                $sel.html(html);
            }

            function escapeHtml(str) {
                return String(str).replace(/[&<>"']/g, function (m) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
                });
            }

            // 加载项目列表（按名称选择关联）
            $.get('/project/simple-list', function (res) {
                if (res && res.success && res.data) buildOptions(res.data);
            }).fail(function () { console.warn('项目列表加载失败'); });

            // 一键转项目：弹窗输入项目名称 → 建项 → 关联
            $('#btnQuickProject').on('click', function () {
                if (typeof layer === 'undefined') {
                    var name = prompt('请输入项目名称（一键建项并关联）：');
                    if (name) doQuickCreate(name.trim());
                } else {
                    layer.prompt({
                        title: '一键转项目',
                        formType: 0,
                        btn: ['创建并关联', '取消']
                    }, function (name, index) {
                        name = (name || '').trim();
                        if (!name) { layer.msg('请输入项目名称', { icon: 2 }); return; }
                        layer.close(index);
                        doQuickCreate(name);
                    });
                }
            });

            function doQuickCreate(name) {
                var load = (typeof layer !== 'undefined') ? layer.load() : null;
                $.ajax({
                    url: '/project/quick-create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ ProjName: name }),
                    success: function (r) {
                        if (load) layer.close(load);
                        if (r && r.success && r.data) {
                            $.get('/project/simple-list', function (res2) {
                                if (res2 && res2.success && res2.data) {
                                    buildOptions(res2.data);
                                    $sel.val(r.data.id);
                                }
                            });
                            if (typeof layer !== 'undefined') layer.msg('已创建项目并关联：' + name, { icon: 1 });
                        } else {
                            if (typeof layer !== 'undefined') layer.msg((r && r.message) || '创建失败', { icon: 2 });
                        }
                    },
                    error: function () {
                        if (load) layer.close(load);
                        if (typeof layer !== 'undefined') layer.msg('请求失败', { icon: 2 });
                    }
                });
            }
        });
    </script>
}
