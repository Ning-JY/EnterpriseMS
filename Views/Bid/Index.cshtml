@{
    ViewData["Title"] = "投标台账";
    Layout = "_Layout";
    string[] statusText = { "草稿", "解析中", "生成中", "审查中", "就绪", "已提交", "已中标", "未中标" };
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-read"></i> 投标台账
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">投标管理</a>
        <a><cite>投标台账</cite></a>
    </div>
</div>

<!-- 搜索卡片 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="bidSearch">
            <div class="layui-inline">
                <input type="text" name="keyword" placeholder="项目名称 / 招标人 / 编号"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                <select name="status">
                    <option value="">全部状态</option>
                    @for (int i = 0; i < statusText.Length; i++)
                    {
                        <option value="@i">@statusText[i]</option>
                    }
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="bidSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                    <i class="layui-icon layui-icon-add-1"></i> 新建投标
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>投标项目列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="bidTable" lay-filter="bidTable"></table>
    </div>
</div>

<!-- 行操作列 -->
<script type="text/html" id="bidBar">
    <a class="ems-icon-btn primary" title="投标详情" lay-event="detail"><i class="layui-icon layui-icon-about"></i></a>
    <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
</script>

@section Scripts {
<script>
ems.ready(function () {

    var STATUS_MAP = {
        0: ['草稿',   'gray'],   1: ['解析中', 'blue'],
        2: ['生成中', 'orange'], 3: ['审查中', 'orange'],
        4: ['就绪',   'cyan'],   5: ['已提交', 'blue'],
        6: ['已中标', 'green'],  7: ['未中标', 'gray']
    };

    var colsConfig = [
        { field: 'ProjectCode', title: '项目编号', width: 150,
          templet: function (d) {
              return '<span class="layui-font-12">' + ems.escapeHtml(d.ProjectCode || '-') + '</span>';
          } },
        { field: 'ProjectName', title: '项目名称', minWidth: 240,
          templet: function (d) {
              return '<a class="layui-link" lay-event="detail">' + ems.escapeHtml(d.ProjectName || '(未关联项目)') + '</a>';
          } },
        { field: 'Tenderer', title: '招标人', width: 180, templet: ems.tpl.text('Tenderer') },
        { field: 'Budget', title: '预算金额(万)', width: 140, align: 'right',
          templet: function (d) {
              if (d.Budget === null || d.Budget === undefined) return '<span class="layui-font-gray">-</span>';
              return '<span class="layui-font-teal ">¥' + Number(d.Budget).toFixed(2) + '</span>';
          } },
        { field: 'Deadline', title: '投标截止', width: 150,
          templet: function (d) {
              if (!d.Deadline) return '<span class="layui-font-gray">-</span>';
              var txt  = ems.fmtDate(d.Deadline);
              var end  = new Date(String(d.Deadline).substring(0, 10) + 'T00:00:00');
              var now  = new Date(); now.setHours(0, 0, 0, 0);
              var days = Math.round((end - now) / 86400000);
              var cls, tip;
              if (isNaN(days))    { return txt; }
              if (days < 0)       { cls = 'layui-font-red';    tip = '已截止'; }
              else if (days < 7)  { cls = 'layui-font-red';    tip = '剩 ' + days + ' 天'; }
              else if (days < 30) { cls = 'layui-font-orange'; tip = '剩 ' + days + ' 天'; }
              else                { cls = 'layui-font-gray'; tip = '剩 ' + days + ' 天'; }
              return txt + '<br><span class="layui-font-12 ' + cls + '">' + tip + '</span>';
          } },
        { field: 'Status', title: '状态', width: 100, align: 'center',
          templet: ems.tpl.badge('Status', STATUS_MAP) },
        { field: 'CreatedAt', title: '创建时间', width: 150, templet: ems.tpl.date('CreatedAt') },
        { title: '操作', width: 110, align: 'center', toolbar: '#bidBar' }
    ];

    ems.initTable({
        elem: '#bidTable',
        id:   'bidTable',
        url:  '/bid/list',
        cols: [colsConfig],

        tool: {
            detail: function (d) { ems.openTab('/bid/detail/' + d.Id, '投标详情 - ' + (d.ProjectName || d.Id)); },
            edit:   function (d) { ems.openEdit({ title: '编辑投标 - ' + (d.ProjectName || d.Id), url: '/bid/edit/' + d.Id, area: ['860px', '92%'] }); }
        }
    });

    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新建投标', url: '/bid/create', area: ['900px', '92%'] });
    });

    $('#btnFilter').on('click', function () { ems.colFilter('bidTable', colsConfig); });
    $('#btnExport').on('click', function () { ems.exportMenu('bidTable', '投标台账'); });

    ems.bindSearch('bidSearch', 'bidTable');
});
</script>
}
