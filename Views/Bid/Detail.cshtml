        function resolveRequirement(btn) {
            var requirementId = btn.dataset.reqId;
            var content = btn.dataset.content;   // 浏览器已解码 HTML 实体，安全
            ems.prompt({
                title: '核对以下条目，并填写在原文中的出处定位（如 "p.14" 或 "投标人须知 §3.2"）：\n\n' + content,
                formType: 0,
