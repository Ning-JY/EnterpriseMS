        // 真实文件导出：成功时后端返回二进制文件流，失败时返回JSON错误——用响应的 Content-Type 区分两种情况，
        // 而不是假设请求一定成功。导出警告（如预估页数超限）通过自定义响应头带回，不阻断下载。
        async function exportDocument(format) {
            var part = document.getElementById('exportPart').value;
            var statusEl = document.getElementById('exportStatus');
            statusEl.innerHTML = '<span class="layui-font-gray"><i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i> 正在生成' + (format === 'pdf' ? 'PDF' : 'Word') + '文件...</span>';

            var url = '/Bid/Export' + (format === 'pdf' ? 'Pdf' : 'Word') + '?bidProjectId=' + bidProjectId + '&part=' + part;

            try {
                var response = await fetch(url, { method: 'GET' });
                var contentType = response.headers.get('Content-Type') || '';

                if (contentType.indexOf('application/json') !== -1) {
                    var result = await response.json();
                    statusEl.innerHTML = '<div class="ems-alert warn">' + escapeHtml(result.message || '导出失败') + '</div>';
                    return;
                }

                if (!response.ok) {
                    statusEl.innerHTML = '<div class="ems-alert danger">导出失败（HTTP ' + response.status + '）</div>';
                    return;
                }

                var warningsHeader = response.headers.get('X-Export-Warnings');
                var blob = await response.blob();
                var disposition = response.headers.get('Content-Disposition') || '';
                var match = /filename\*?=(?:UTF-8'')?["']?([^"';]+)/i.exec(disposition);
                var fileName = match ? decodeURIComponent(match[1]) : ('export.' + (format === 'pdf' ? 'pdf' : 'docx'));

                var a = document.createElement('a');
                var objectUrl = URL.createObjectURL(blob);
                a.href = objectUrl;
                a.download = fileName;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(objectUrl);

                if (warningsHeader) {
                    var warnings = decodeURIComponent(warningsHeader).split(' | ');
                    statusEl.innerHTML = '<div class="ems-alert warn">' +
                        warnings.map(function(w) { return '<div>' + escapeHtml(w) + '</div>'; }).join('') + '</div>';
                } else {
                    statusEl.innerHTML = '<span class="layui-font-green"><i class="layui-icon layui-icon-ok-circle"></i> 已下载</span>';
                }
            } catch (e) {
                statusEl.innerHTML = '<div class="ems-alert danger">请求失败：' + escapeHtml(e.message) + '</div>';
            }
        }

        function displayAssembleResult(data) {
            var infoHtml = '<div class="ems-alert info"><strong>' + escapeHtml(data.ProjectName) + '</strong> - 组装时间：' + data.AssembleTime + '</div>';
            document.getElementById('assembleInfo').innerHTML = infoHtml;

            var tabsHtml = '';
            var contentHtml = '';
            var first = true;

            if (data.TechnicalPart && data.TechnicalPart.Chapters.length > 0) {
                tabsHtml += '<li class="' + (first ? 'layui-this' : '') + '" id="tabTechnical">技术部分 (' + data.TechnicalPart.WordCount + '字)</li>';
                contentHtml += '<div class="layui-tab-item' + (first ? ' layui-show' : '') + '">';
                contentHtml += buildPartContent(data.TechnicalPart);
                contentHtml += '</div>';
                first = false;
            }

            if (data.CommercialPart && data.CommercialPart.Chapters.length > 0) {
                tabsHtml += '<li class="' + (first ? 'layui-this' : '') + '" id="tabCommercial">商务部分 (' + data.CommercialPart.WordCount + '字)</li>';
                contentHtml += '<div class="layui-tab-item' + (first ? ' layui-show' : '') + '">';
                contentHtml += buildPartContent(data.CommercialPart);
                contentHtml += '</div>';
                first = false;
            }

            if (data.FullDocument && data.FullDocument.Chapters.length > 0) {
                tabsHtml += '<li class="' + (first ? 'layui-this' : '') + '" id="tabFull">完整文件 (' + data.FullDocument.WordCount + '字)</li>';
                contentHtml += '<div class="layui-tab-item' + (first ? ' layui-show' : '') + '">';
                contentHtml += '<div style="white-space: pre-wrap; line-height: 1.8; padding: 15px; background: #fafbfc; border-radius: 8px; max-height: 60vh; overflow-y: auto;">';
                contentHtml += escapeHtml(data.FullDocument.Content);
                contentHtml += '</div></div>';
            }

            document.getElementById('assembleTabs').innerHTML = tabsHtml;
            document.getElementById('assembleTabContent').innerHTML = contentHtml;

            // layui tab 需要重新渲染才能响应切换（等价于原 Bootstrap 的 data-toggle="tab"）
            layui.element.render('tab', 'assembleTab');
        }

        function buildPartContent(part) {
            var html = '';
            part.Chapters.forEach(function(chapter, index) {
                html += '<div class="layui-card ems-card">';
                html += '<div class="layui-card-header"><strong>' + (index + 1) + '. ' + escapeHtml(chapter.Name) + '</strong>';
                html += ' <span class="layui-badge layui-bg-gray" style="margin-left:8px">' + chapter.WordCount + '字</span></div>';
                html += '<div class="layui-card-body">';
                html += '<div style="white-space: pre-wrap; line-height: 1.8;">' + escapeHtml(chapter.Content) + '</div>';
                html += '</div></div>';
            });
            return html;
        }

        function copyAssembleContent() {
            if (!assembleData) return;

            var content = '';
            if (assembleData.FullDocument) {
                content = assembleData.FullDocument.Content;
            } else if (assembleData.TechnicalPart && assembleData.CommercialPart) {
                content = assembleData.TechnicalPart.Content + '\n\n' + assembleData.CommercialPart.Content;
            } else if (assembleData.TechnicalPart) {
                content = assembleData.TechnicalPart.Content;
            } else if (assembleData.CommercialPart) {
                content = assembleData.CommercialPart.Content;
            }

            navigator.clipboard.writeText(content).then(function() {
                ems.success('内容已复制到剪贴板！');
            }).catch(function() {
                var textarea = document.createElement('textarea');
                textarea.value = content;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                ems.success('内容已复制到剪贴板！');
            });
        }

        // ── 人员匹配 ───────────────────────────────────────────
        async function matchPersonnel() {
            var progressEl = document.getElementById('generatingProgress');
            var outputEl = document.getElementById('generatingOutput');

            progressEl.style.display = 'block';
            outputEl.style.display = 'block';
            document.getElementById('generatingChapter').textContent = '智能匹配人员';
            outputEl.innerHTML = '<div class="ems-empty"><i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i><p>正在从数据库中匹配符合要求的人员...</p></div>';

            try {
                var response = await fetch('/Bid/MatchPersonnel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ BidProjectId: bidProjectId, MaxPersonnel: 10 })
                });

                if (response.redirected) {
                    window.location.href = response.url;
                    return;
                }

                var text = await response.text();
                var result = JSON.parse(text);
                var data = result.data || result;

                var matched = data.matchedPersonnel || data.MatchedPersonnel;
                if (data && matched) {
                    data.matchedPersonnel = matched;
                    data.unmatchedRequirements = data.unmatchedRequirements || data.UnmatchedRequirements || [];
                    data.summary = data.summary || data.Summary || '';
                    displayPersonnelMatchResult(data);
                } else {
                    var msg = (data && (data.message || data.Message)) || result.message || '未找到匹配人员';
                    outputEl.innerHTML = '<div class="ems-alert warn">' + escapeHtml(msg) + '</div>';
                }
            } catch (e) {
                outputEl.innerHTML = '<div class="ems-alert danger">请求失败：' + e.message + '</div>';
            } finally {
                progressEl.style.display = 'none';
            }
        }

        function displayPersonnelMatchResult(data) {
            var outputEl = document.getElementById('generatingOutput');
            var html = '<div class="ems-alert info">' + escapeHtml(data.summary || data.Summary || '') + '</div>';

            var personnel = data.matchedPersonnel || data.MatchedPersonnel || [];
            if (personnel.length > 0) {
                personnel.forEach(function(p) {
                    var name = p.name || p.Name || '';
                    var dept = p.deptName || p.DeptName || '-';
                    var edu = p.education || p.Education || '-';
                    var years = p.workYears || p.WorkYears || 0;
                    var score = p.matchScore || p.MatchScore || 0;
                    var certs = p.certificates || p.Certificates || [];
                    var basis = p.matchBasis || p.MatchBasis || [];
                    var conflicts = p.conflictWarnings || p.ConflictWarnings || [];
                    var hasConflict = conflicts.length > 0;

                    html += '<div class="layui-card ems-card" style="border-left:4px solid ' + (hasConflict ? '#e09000' : '#2e9e5b') + ';margin-top:8px">';
                    html += '<div class="layui-card-body" style="padding:10px 12px">';
                    html += '<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">';
                    html += '<div><strong>' + escapeHtml(name) + '</strong>';
                    html += ' <span class="layui-font-gray" style="font-size:12px;">' + escapeHtml(dept) + ' · ' + escapeHtml(edu) + ' · 工作' + years + '年</span></div>';
                    html += '<span class="layui-badge layui-bg-blue">匹配得分 ' + score + '</span>';
                    html += '</div>';

                    if (hasConflict) {
                        html += '<div class="ems-alert warn" style="margin-top:8px;font-size:11.5px;">';
                        conflicts.forEach(function(c) { html += '<div><i class="layui-icon layui-icon-notice"></i> ' + escapeHtml(c) + '</div>'; });
                        html += '</div>';
                    }

                    html += '<div style="margin-top:8px;font-size:12px;">';
                    certs.forEach(function(c) {
                        var certName = c.certName || c.CertName || '';
                        var validity = c.validityStatus || c.ValidityStatus || 'Valid';
                        var badgeClass = validity === 'Expired' ? 'layui-bg-red' : (validity === 'ExpiringSoon' ? 'layui-bg-orange' : (validity === 'Unknown' ? 'layui-bg-gray' : 'layui-bg-green'));
                        var validityLabel = validity === 'Expired' ? '已过期' : (validity === 'ExpiringSoon' ? '即将到期' : (validity === 'Unknown' ? '未登记有效期' : '有效'));
                        if (certName) html += '<span class="layui-badge ' + badgeClass + '" style="margin:0 6px 6px 0">' + escapeHtml(certName) + ' · ' + validityLabel + '</span>';
                    });
                    html += '</div>';

                    if (basis.length > 0) {
                        html += '<ul style="margin:4px 0 0;font-size:11.5px;color:#495057;padding-left:18px;">';
                        basis.forEach(function(b) { html += '<li>' + escapeHtml(b) + '</li>'; });
                        html += '</ul>';
                    }

                    html += '</div></div>';
                });
            } else {
                html += '<div class="ems-alert warn"><i class="layui-icon layui-icon-notice"></i> 暂无符合条件的人员</div>';
            }

            var unmatched = data.unmatchedRequirements || data.UnmatchedRequirements || [];
            if (unmatched.length > 0) {
                html += '<div class="ems-alert warn" style="margin-top:8px"><strong>未匹配的要求：</strong><ul style="margin:0">';
                unmatched.forEach(function(req) {
                    html += '<li>' + escapeHtml(req) + '</li>';
                });
                html += '</ul></div>';
            }

            var unrecognized = data.unrecognizedRequirements || data.UnrecognizedRequirements || [];
            if (unrecognized.length > 0) {
                html += '<div class="ems-alert info" style="margin-top:8px">';
                html += '<strong><i class="layui-icon layui-icon-search"></i> 系统无法自动识别证书类型，需人工直接核对：</strong><ul style="margin:0">';
                unrecognized.forEach(function(req) {
                    html += '<li>' + escapeHtml(req) + '</li>';
                });
                html += '</ul></div>';
            }

            html += '<div style="margin-top:14px"><button class="layui-btn layui-btn-normal" onclick="generatePersonnelSection()"><i class="layui-icon layui-icon-star"></i> 根据匹配结果生成人员配置文档</button>';
            html += ' <span class="layui-font-gray" style="font-size:12px;margin-left:8px">存在岗位冲突的人员不会被写入正文，需人工确认后再补充</span></div>';

            outputEl.innerHTML = html;
        }

        async function generatePersonnelSection() {
            var outputEl = document.getElementById('generatingOutput');
            outputEl.innerHTML += '<div style="margin-top:14px"><div class="ems-alert info"><i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i> 正在生成人员配置文档...</div></div>';

            try {
                var response = await fetch('/Bid/GeneratePersonnelSection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ BidProjectId: bidProjectId, MaxPersonnel: 10 })
                });
                var result = await response.json();

                if (result.success) {
                    ems.success('人员配置文档已生成！页面将刷新显示结果。');
                    location.reload();
                } else {
                    ems.error('生成失败：' + result.message);
                }
            } catch (e) {
                ems.error('请求失败：' + e.message);
            }
        }

        async function generateChapterStream(chapterName, customRequirements) {
            var progressEl = document.getElementById('generatingProgress');
            var outputEl = document.getElementById('generatingOutput');

            progressEl.style.display = 'block';
            outputEl.style.display = 'block';
            document.getElementById('generatingChapter').textContent = chapterName;
            outputEl.innerHTML = '';

            await generateChapterStreamInternal({
                BidProjectId: bidProjectId,
                ChapterName: chapterName,
                TargetWordCount: 2000,
                CustomRequirements: customRequirements || ''
            }, function(chunk) {
                document.getElementById('generatingOutput').innerHTML += chunk;
            }, function() {
                setTimeout(() => location.reload(), 1000);
            });
        }

        async function reviewBid() {
            document.getElementById('reviewResult').style.display = 'block';
            document.getElementById('reviewContent').innerHTML =
                '<div class="ems-empty"><i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i><p>正在审查...</p></div>';

            try {
                var response = await fetch('/Bid/Review', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ BidProjectId: bidProjectId })
                });
                var result = await response.json();

                if (result.success) {
                    displayReviewResult(result.data);
                } else {
                    document.getElementById('reviewContent').innerHTML =
                        '<div class="ems-alert danger">' + result.message + '</div>';
                }
            } catch (e) {
                document.getElementById('reviewContent').innerHTML =
                    '<div class="ems-alert danger">请求失败：' + e.message + '</div>';
            }
        }

        function displayReviewResult(data) {
            var html = '<div style="margin-bottom:12px"><strong>综合评分：</strong>';
            var scoreClass = data.overallScore >= 80 ? 'green' : data.overallScore >= 60 ? 'orange' : 'red';
            html += '<span class="layui-badge layui-bg-' + scoreClass + '">' + data.overallScore + '分</span></div>';

            if (data.missingItems && data.missingItems.length > 0) {
                html += '<div class=" layui-font-red" style="margin-top:10px">缺失内容：</div><ul>';
                data.missingItems.forEach(function(item) {
                    html += '<li>' + item + '</li>';
                });
                html += '</ul>';
            }

            if (data.issues && data.issues.length > 0) {
                html += '<div class=" layui-font-orange" style="margin-top:10px">问题列表：</div>';
                data.issues.forEach(function(issue) {
                    html += '<div class="ems-alert ' +
                        (issue.severity === 'high' ? 'danger' : issue.severity === 'medium' ? 'warn' : 'info') +
                        '" style="margin-top:6px">';
                    html += '<strong>[' + issue.chapter + ']</strong> ' + issue.description;
                    if (issue.suggestion) html += '<br><span class="layui-font-gray" style="font-size:12px">建议：' + issue.suggestion + '</span>';
                    html += '</div>';
                });
            }

            if (data.suggestions && data.suggestions.length > 0) {
                html += '<div class=" layui-font-teal" style="margin-top:10px">改进建议：</div><ul>';
                data.suggestions.forEach(function(item) {
                    html += '<li>' + item + '</li>';
                });
                html += '</ul>';
            }

            document.getElementById('reviewContent').innerHTML = html;
        }
    </script>
}

@functions {
    // 配色与列表页 STATUS_MAP 保持一致（layui 无 bg-teal，就绪用 cyan）
    string GetStatusColor(int status) => status switch
    {
        0 => "gray",
        1 => "blue",
        2 => "orange",
        3 => "orange",
        4 => "cyan",
        5 => "blue",
        6 => "green",
        7 => "gray",
        _ => "gray"
    };

    string GetStatusName(int status) => status switch
    {
        0 => "草稿",
        1 => "解析中",
        2 => "生成中",
        3 => "审查中",
        4 => "就绪",
        5 => "已提交",
        6 => "已中标",
        7 => "未中标",
        _ => "未知"
    };

    string GetDocStatusColor(int status) => status switch
    {
        0 => "gray",
        1 => "green",
        2 => "orange",
        3 => "cyan",
        4 => "blue",
        _ => "gray"
    };

    string GetDocStatusName(int status) => status switch
    {
        0 => "草稿",
        1 => "AI生成",
        2 => "编辑中",
        3 => "已审查",
        4 => "定稿",
        _ => "未知"
    };
}
