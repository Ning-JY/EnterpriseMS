@model EnterpriseMS.Services.DTOs.Bid.BidProjectDto
@using EnterpriseMS.Domain.Enums
@{
    ViewData["Title"] = $"投标详情 - {Model.ProjectName}";
    Layout = "_Layout";
}

@* 招标文件解析模块专用样式：刻意自包含、不依赖 AdminLTE/Bootstrap 之外的任何库，
   否决性条款用警示色单独提出，不与普通要求混排——这是本模块最重要的视觉原则。 *@
<style>
    .tp-stage-bar{display:flex;align-items:stretch;gap:0;margin-bottom:14px;border:1px solid #dee2e6;border-radius:4px;overflow:hidden;}
    .tp-stage{flex:1;padding:8px 10px;font-size:12px;text-align:center;background:#f8f9fa;color:#868e96;border-right:1px solid #dee2e6;position:relative;}
    .tp-stage:last-child{border-right:none;}
    .tp-stage.tp-done{background:#eaf4ee;color:#2f7a4f;}
    .tp-stage.tp-live{background:#fdf3e3;color:#a9690e;font-weight:600;}
    .tp-stage .tp-stage-num{display:block;font-size:10px;opacity:.7;margin-bottom:2px;}

    .tp-veto-box{background:#fdf3e3;border:1px solid #f0c178;border-left:4px solid #d9822b;border-radius:4px;padding:12px 14px;margin-bottom:14px;}
    .tp-veto-box .tp-veto-title{font-weight:600;color:#a9690e;font-size:13px;margin-bottom:8px;}
    .tp-veto-item{font-size:12.5px;line-height:1.7;padding:5px 0;color:#6b4a1e;border-top:1px solid #f0c178;}
    .tp-veto-item:first-of-type{border-top:none;}

    .tp-review-box{background:#e9f1fb;border:1px solid #b9d3ef;border-left:4px solid #3a6ea5;border-radius:4px;padding:12px 14px;margin-bottom:14px;}
    .tp-review-box .tp-review-title{font-weight:600;color:#2c5a8c;font-size:13px;margin-bottom:8px;}

    .tp-req-row{padding:8px 4px;border-bottom:1px solid #eee;font-size:12.5px;}
    .tp-req-row:last-child{border-bottom:none;}
    .tp-req-row .tp-src{font-family:Consolas,monospace;font-size:10.5px;color:#868e96;margin-left:6px;}
    .tp-badge-veto{display:inline-block;font-size:10px;background:#a9690e;color:#fff;border-radius:3px;padding:1px 6px;margin-right:6px;}
    .tp-badge-review{display:inline-block;font-size:10px;background:#3a6ea5;color:#fff;border-radius:3px;padding:1px 6px;margin-right:6px;}

    .tp-confirm-bar{display:flex;align-items:center;justify-content:space-between;background:#f8f9fa;border:1px dashed #ced4da;border-radius:4px;padding:10px 14px;margin-top:10px;}
</style>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">
                    @Model.ProjectName
                    <small class="ml-2">投标详情</small>
                </h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item"><a href="/Bid">投标管理</a></li>
                    <li class="breadcrumb-item active">投标详情</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-12 text-right">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-edit mr-1"></i>编辑
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-left mr-1"></i>返回列表
            </a>
        </div>
    </div>

    @{
        var parseStage = Model.ParseStage;
    }
    <div class="row mb-3">
        <div class="col-md-12">
            <div class="tp-stage-bar">
                <div class="tp-stage @(parseStage >= 1 ? "tp-done" : "")"><span class="tp-stage-num">01</span>上传文件</div>
                <div class="tp-stage @(parseStage == 1 ? "tp-live" : (parseStage >= 2 ? "tp-done" : ""))"><span class="tp-stage-num">02</span>AI 解析</div>
                <div class="tp-stage @(parseStage == 2 ? "tp-live" : (parseStage >= 3 ? "tp-done" : ""))"><span class="tp-stage-num">03</span>人工确认要素表</div>
                <div class="tp-stage @(parseStage >= 3 ? "tp-done" : "")"><span class="tp-stage-num">04</span>进入内容生成</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">基本信息</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">项目名称</dt>
                        <dd class="col-sm-8">@Model.ProjectName</dd>
                        <dt class="col-sm-4">项目编号</dt>
                        <dd class="col-sm-8">@Model.ProjectCode</dd>
                        <dt class="col-sm-4">招标人</dt>
                        <dd class="col-sm-8">@(Model.Tenderer ?? "-")</dd>
                        <dt class="col-sm-4">预算金额</dt>
                        <dd class="col-sm-8">@(Model.Budget?.ToString("N2") ?? "-") 万元</dd>
                        <dt class="col-sm-4">截止日期</dt>
                        <dd class="col-sm-8">@(Model.Deadline?.ToString("yyyy-MM-dd") ?? "-")</dd>
                        <dt class="col-sm-4">状态</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-@(GetStatusColor(Model.Status))">
                                @GetStatusName(Model.Status)
                            </span>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>招标文件解析</span>
                    <span class="badge bg-@(parseStage == 3 ? "success" : (parseStage == 2 ? "warning" : "secondary"))">
                        @Model.ParseStageName
                    </span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.SourceFileName))
                    {
                        <div class="mb-2 text-muted" style="font-size:12px;">
                            <i class="fas fa-file-alt mr-1"></i>@Model.SourceFileName
                        </div>
                    }
                    <div class="mb-3">
                        <input type="file" id="bidFile" class="form-control" accept=".pdf,.docx,.doc" />
                        <small class="text-muted">支持 PDF / Word；扫描件暂不支持文字识别</small>
                    </div>
                    <button type="button" class="btn btn-primary w-100" onclick="analyzeDocument()">
                        <i class="fas fa-robot mr-1"></i> AI解析招标文件
                    </button>
                    <div id="analyzeProgress" class="mt-3" style="display:none;">
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%">
                                正在解析（按章节分块处理，大文件可能需要数十秒到数分钟）...
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">快捷操作</div>
                <div class="card-body">
                    @if (parseStage != 3)
                    {
                        <div class="alert alert-light border mb-2" style="font-size:11.5px;padding:6px 10px;">
                            <i class="fas fa-info-circle mr-1"></i>建议先完成"人工确认招标要素表"，再生成正文内容
                        </div>
                    }
                    <button type="button" class="btn btn-success w-100 mb-2" onclick="generateFullBid()">
                        <i class="fas fa-magic"></i> 一键生成全部章节
                    </button>
                    <button type="button" class="btn btn-warning w-100 mb-2" onclick="reviewBid()">
                        <i class="fas fa-check-circle"></i> AI审查标书
                    </button>
                    <button type="button" class="btn btn-primary w-100 mb-2" onclick="matchPersonnel()">
                        <i class="fas fa-users"></i> 智能匹配人员
                    </button>
                    <button type="button" class="btn btn-info w-100 mb-2" onclick="assembleDocument('all')">
                        <i class="fas fa-file-alt"></i> 组卷（完整文件）
                    </button>
                    <div class="row">
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-info w-100" onclick="assembleDocument('technical')">
                                技术部分
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="btn btn-outline-info w-100" onclick="assembleDocument('commercial')">
                                商务部分
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            @{
                var vetoItems = Model.Requirements.Where(r => r.IsVeto).ToList();
                var reviewItems = Model.Requirements.Where(r => r.NeedsReview).ToList();
            }

            @if (vetoItems.Any())
            {
                <div class="tp-veto-box">
                    <div class="tp-veto-title"><i class="fas fa-exclamation-triangle mr-1"></i>否决性条款 · @vetoItems.Count 项（不满足将导致废标，请重点核对）</div>
                    @foreach (var v in vetoItems)
                    {
                        <div class="tp-veto-item">
                            @v.Content
                            @if (!string.IsNullOrWhiteSpace(v.SourceRef))
                            {
                                <span class="tp-src">[@v.SourceRef]</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (reviewItems.Any())
            {
                <div class="tp-review-box">
                    <div class="tp-review-title"><i class="fas fa-search mr-1"></i>待人工确认 · @reviewItems.Count 项（AI未能在原文中定位到出处，需人工核实后才能确认要素表）</div>
                    @foreach (var r in reviewItems)
                    {
                        <div class="tp-req-row" style="border-color:#b9d3ef;">
                            <span class="tp-badge-review">待确认</span>@r.Content
                            <button class="btn btn-xs btn-outline-primary float-right" style="font-size:10px;padding:1px 6px;"
                                    onclick="resolveRequirement(@r.Id, '@Html.Raw(System.Text.Json.JsonEncodedText.Encode(r.Content))')">
                                核对
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>招标要求</span>
                    <span class="badge bg-info">@Model.Requirements.Count 项</span>
                </div>
                <div class="card-body" style="max-height: 320px; overflow-y: auto;">
                    @if (Model.Requirements.Any())
                    {
                        @foreach (var req in Model.Requirements.GroupBy(r => r.Category))
                        {
                            <h6 class="text-primary mt-2">@req.Key</h6>
                            @foreach (var item in req)
                            {
                                <div class="tp-req-row">
                                    @if (item.IsVeto)
                                    {
                                        <span class="tp-badge-veto">否决项</span>
                                    }
                                    @if (item.NeedsReview)
                                    {
                                        <span class="tp-badge-review">待确认</span>
                                    }
                                    <small class="text-muted">@(item.ScoreWeight?.ToString() ?? "")分</small>
                                    @item.Content
                                    @if (!string.IsNullOrWhiteSpace(item.SourceRef))
                                    {
                                        <span class="tp-src">[@item.SourceRef]</span>
                                    }
                                </div>
                            }
                        }

                        @if (parseStage == 2)
                        {
                            <div class="tp-confirm-bar">
                                <span style="font-size:12.5px;color:#495057;">
                                    @if (reviewItems.Any())
                                    {
                                        <text>还有 @reviewItems.Count 项待确认，处理完成后才能确认要素表</text>
                                    }
                                    else
                                    {
                                        <text>所有条目已有出处定位，可以确认招标要素表</text>
                                    }
                                </span>
                                <button type="button" class="btn btn-sm @(reviewItems.Any() ? "btn-secondary" : "btn-success")"
                                        onclick="confirmElements()" @(reviewItems.Any() ? "disabled" : "")>
                                    <i class="fas fa-check mr-1"></i>确认招标要素表
                                </button>
                            </div>
                        }
                        else if (parseStage == 3)
                        {
                            <div class="tp-confirm-bar" style="border-style:solid;border-color:#bcd6c5;background:#eaf2ec;">
                                <span style="font-size:12.5px;color:#2f7a4f;">
                                    <i class="fas fa-check-circle mr-1"></i>
                                    已于 @(Model.ElementsConfirmedAt?.ToString("yyyy-MM-dd HH:mm")) 由 @Model.ElementsConfirmedBy 确认
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-3">
                            请先上传招标文件进行AI解析
                        </div>
                    }
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>标书章节</span>
                    <button class="btn btn-sm btn-outline-primary" onclick="showAddChapter()">+ 添加章节</button>
                </div>
                <div class="card-body">
                    <div id="chaptersList">
                        @if (Model.Documents.Any())
                        {
                            @foreach (var doc in Model.Documents.OrderBy(d => d.SortOrder))
                            {
                                <div class="card mb-2" data-doc-id="@doc.Id">
                                    <div class="card-body p-2">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>@doc.ChapterName</strong>
                                                <span class="badge bg-@(GetDocStatusColor(doc.Status)) ms-2">
                                                    @GetDocStatusName(doc.Status)
                                                </span>
                                                <small class="text-muted ms-2">@(doc.WordCount ?? 0) 字</small>
                                            </div>
                                            <div>
                                                <button class="btn btn-sm btn-outline-primary" onclick="previewChapter(@doc.Id, '@doc.ChapterName')">预览</button>
                                                <button class="btn btn-sm btn-outline-success" onclick="regenerateChapter('@doc.ChapterName')">重新生成</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted text-center py-3">
                                暂无章节，请使用"一键生成全部章节"或手动添加
                            </div>
                        }
                    </div>

                    <div id="generatingProgress" class="mt-3" style="display:none;">
                        <div class="alert alert-info">
                            <i class="fas fa-hourglass-half"></i> 正在生成：<span id="generatingChapter"></span>
                        </div>
                    </div>

                    <div id="generatingOutput" class="mt-3 border rounded p-3 bg-light"
                         style="display:none; max-height: 500px; overflow-y: auto; white-space: pre-wrap;"></div>
                </div>
            </div>

            <div class="card" id="reviewResult" style="display:none;">
                <div class="card-header">AI审查结果</div>
                <div class="card-body" id="reviewContent"></div>
            </div>
        </div>
    </div>
</div>

<!-- 章节预览/编辑弹窗 -->
<div class="modal fade" id="chapterModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="chapterModalTitle">章节内容</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div id="chapterPreview" style="white-space: pre-wrap; max-height: 60vh; overflow-y: auto; padding: 15px; background: #f8f9fa; border-radius: 5px;"></div>
                <div id="chapterEditArea" style="display:none;">
                    <textarea id="chapterContentEdit" class="form-control" rows="20" style="font-size: 14px;"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                <button type="button" class="btn btn-primary" id="btnToggleEdit" onclick="toggleEditMode()">编辑</button>
                <button type="button" class="btn btn-success" id="btnSaveContent" style="display:none;" onclick="saveChapterContent()">保存</button>
            </div>
        </div>
    </div>
</div>

<!-- 组卷结果弹窗 -->
<div class="modal fade" id="assembleModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assembleModalTitle">投标文件</h5>
                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
            </div>
            <div class="modal-body">
                <div id="assembleInfo" class="mb-3"></div>
                <ul class="nav nav-tabs" id="assembleTabs" role="tablist"></ul>
                <div class="tab-content" id="assembleTabContent"></div>
                <div id="assembleLoading" class="text-center py-4" style="display:none;">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">正在组装文档...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                <button type="button" class="btn btn-success" onclick="copyAssembleContent()">
                    <i class="fas fa-copy"></i> 复制全部内容
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/bid-ai.js"></script>
    <script>
        var bidProjectId = @Model.Id;

        async function analyzeDocument() {
            var fileInput = document.getElementById('bidFile');
            if (!fileInput.files.length) {
                alert('请选择招标文件');
                return;
            }

            var formData = new FormData();
            formData.append('File', fileInput.files[0]);
            formData.append('BidProjectId', bidProjectId);

            document.getElementById('analyzeProgress').style.display = 'block';

            try {
                var response = await fetch('/Bid/Analyze', {
                    method: 'POST',
                    body: formData
                });
                var result = await response.json();

                if (result.success) {
                    alert('解析完成！页面将刷新显示结果，请重点核对"否决性条款"和"待人工确认"两个区块。');
                    location.reload();
                } else {
                    alert('解析失败：' + result.message);
                }
            } catch (e) {
                alert('请求失败：' + e.message);
            } finally {
                document.getElementById('analyzeProgress').style.display = 'none';
            }
        }

        // "人工确认招标要素表"卡点：后端会再次校验是否还有待确认条目，前端disabled只是减少误触，不是唯一防线。
        async function confirmElements() {
            if (!confirm('确认后将锁定本次招标要素表，作为后续内容生成与人员匹配的依据，确定要继续吗？')) return;

            try {
                var response = await fetch('/Bid/ConfirmElements', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ BidProjectId: bidProjectId })
                });
                var result = await response.json();

                if (result.success) {
                    alert('招标要素表已确认。');
                    location.reload();
                } else {
                    alert('无法确认：' + result.message);
                }
            } catch (e) {
                alert('请求失败：' + e.message);
            }
        }

        // 核对单条"待确认"要求：人工补充原文出处定位，并复核是否属于否决性条款。
        async function resolveRequirement(requirementId, content) {
            var decoded = JSON.parse('"' + content + '"');
            var sourceRef = prompt(
                '核对以下条目，并填写在原文中的出处定位（如 "p.14" 或 "投标人须知 §3.2"）：\n\n' + decoded,
                ''
            );
            if (sourceRef === null) return; // 用户取消
            if (!sourceRef.trim()) {
                alert('出处不能为空，否则该条目会继续保留"待确认"状态');
                return;
            }
            var isVeto = confirm('该条目是否为否决性条款（不满足将直接导致废标）？\n点击"确定"=是否决项，点击"取消"=不是否决项');

            try {
                var response = await fetch('/Bid/ResolveRequirement', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ RequirementId: requirementId, IsVeto: isVeto, SourceRef: sourceRef.trim() })
                });
                var result = await response.json();
                if (result.success) {
                    location.reload();
                } else {
                    alert('保存失败：' + result.message);
                }
            } catch (e) {
                alert('请求失败：' + e.message);
            }
        }

        async function generateFullBid() {
            if (!confirm('确定要一键生成全部章节吗？这将覆盖现有内容。')) return;

            document.getElementById('generatingProgress').style.display = 'block';

            try {
                var response = await fetch('/Bid/GenerateFull', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ BidProjectId: bidProjectId })
                });
                var result = await response.json();

                if (result.success) {
                    alert('生成完成！页面将刷新显示结果。');
                    location.reload();
                } else {
                    alert('生成失败：' + result.message);
                }
            } catch (e) {
                alert('请求失败：' + e.message);
            } finally {
                document.getElementById('generatingProgress').style.display = 'none';
            }
        }

        function showAddChapter() {
            var name = prompt('请输入章节名称：');
            if (name) {
                generateChapterStream(name);
            }
        }

        function regenerateChapter(chapterName) {
            var customReq = prompt('请输入自定义要求（可选，直接点确定跳过）：\n\n例如：\n- 重点突出公司在轨道交通领域的经验\n- 增加BIM技术应用方案\n- 补充质量控制措施');
            generateChapterStream(chapterName, customReq || '');
        }

        var currentDocId = null;
        var isEditMode = false;

        async function previewChapter(docId, chapterName) {
            currentDocId = docId;
            isEditMode = false;
            document.getElementById('chapterModalTitle').textContent = chapterName;
            document.getElementById('chapterPreview').style.display = 'block';
            document.getElementById('chapterEditArea').style.display = 'none';
            document.getElementById('btnToggleEdit').textContent = '编辑';
            document.getElementById('btnSaveContent').style.display = 'none';

            document.getElementById('chapterPreview').innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div><p>加载中...</p></div>';
            $('#chapterModal').modal('show');

            try {
                var docResponse = await fetch('/Bid/GetDocument?docId=' + docId, {
                    credentials: 'same-origin'
                });

                if (docResponse.redirected) {
                    window.location.href = docResponse.url;
                    return;
                }

                var docResult = await docResponse.json();
                var doc = docResult.data || docResult;

                var content = '';
                if (doc.Content) content = doc.Content;
                else if (doc.content) content = doc.content;

                if (content) {
                    document.getElementById('chapterPreview').innerHTML = '<div style="white-space: pre-wrap; line-height: 1.8;">' + escapeHtml(content) + '</div>';
                } else {
                    document.getElementById('chapterPreview').innerHTML = '<div class="text-muted">暂无内容，请先生成标书</div>';
                }
            } catch (e) {
                document.getElementById('chapterPreview').innerHTML = '<div class="text-danger">加载失败：' + e.message + '</div>';
            }
        }

        function toggleEditMode() {
            isEditMode = !isEditMode;
            var preview = document.getElementById('chapterPreview');
            var editArea = document.getElementById('chapterEditArea');
            var btnToggle = document.getElementById('btnToggleEdit');
            var btnSave = document.getElementById('btnSaveContent');

            if (isEditMode) {
                editArea.value = preview.innerText;
                preview.style.display = 'none';
                editArea.style.display = 'block';
                btnToggle.textContent = '预览';
                btnSave.style.display = 'inline-block';
            } else {
                preview.innerHTML = '<div style="white-space: pre-wrap;">' + escapeHtml(editArea.value) + '</div>';
                preview.style.display = 'block';
                editArea.style.display = 'none';
                btnToggle.textContent = '编辑';
                btnSave.style.display = 'none';
            }
        }

        async function saveChapterContent() {
            if (!currentDocId) return;

            var content = document.getElementById('chapterContentEdit').value;
            try {
                var response = await fetch('/Bid/UpdateContent?documentId=' + currentDocId, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Content: content })
                });
                var result = await response.json();

                if (result.success) {
                    alert('保存成功！');
                    location.reload();
                } else {
                    alert('保存失败：' + result.message);
                }
            } catch (e) {
                alert('请求失败：' + e.message);
            }
        }

        var assembleData = null;

        async function assembleDocument(part) {
            document.getElementById('assembleModalTitle').textContent = part === 'all' ? '投标文件（完整）' :
                part === 'technical' ? '技术部分' : '商务部分';
            document.getElementById('assembleInfo').innerHTML = '';
            document.getElementById('assembleTabs').innerHTML = '';
            document.getElementById('assembleTabContent').innerHTML = '';
            document.getElementById('assembleLoading').style.display = 'block';
            $('#assembleModal').modal('show');

            try {
                var response = await fetch('/Bid/Assemble', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ BidProjectId: bidProjectId, Part: part })
                });
                var result = await response.json();

                document.getElementById('assembleLoading').style.display = 'none';

                if (result.success && result.data) {
                    assembleData = result.data;
                    displayAssembleResult(result.data);
                } else {
                    document.getElementById('assembleInfo').innerHTML = '<div class="alert alert-warning">' + (result.message || '组卷失败') + '</div>';
                }
            } catch (e) {
                document.getElementById('assembleLoading').style.display = 'none';
                document.getElementById('assembleInfo').innerHTML = '<div class="alert alert-danger">请求失败：' + e.message + '</div>';
            }
        }

        function displayAssembleResult(data) {
            var infoHtml = '<div class="alert alert-info py-2"><strong>' + escapeHtml(data.ProjectName) + '</strong> - 组装时间：' + data.AssembleTime + '</div>';
            document.getElementById('assembleInfo').innerHTML = infoHtml;

            var tabsHtml = '';
            var contentHtml = '';
            var first = true;

            if (data.TechnicalPart && data.TechnicalPart.Chapters.length > 0) {
                tabsHtml += '<li class="nav-item"><a class="nav-link' + (first ? ' active' : '') + '" data-toggle="tab" href="#tabTechnical">技术部分 (' + data.TechnicalPart.WordCount + '字)</a></li>';
                contentHtml += '<div class="tab-pane fade' + (first ? ' show active' : '') + '" id="tabTechnical">';
                contentHtml += buildPartContent(data.TechnicalPart);
                contentHtml += '</div>';
                first = false;
            }

            if (data.CommercialPart && data.CommercialPart.Chapters.length > 0) {
                tabsHtml += '<li class="nav-item"><a class="nav-link' + (first ? ' active' : '') + '" data-toggle="tab" href="#tabCommercial">商务部分 (' + data.CommercialPart.WordCount + '字)</a></li>';
                contentHtml += '<div class="tab-pane fade' + (first ? ' show active' : '') + '" id="tabCommercial">';
                contentHtml += buildPartContent(data.CommercialPart);
                contentHtml += '</div>';
                first = false;
            }

            if (data.FullDocument && data.FullDocument.Chapters.length > 0) {
                tabsHtml += '<li class="nav-item"><a class="nav-link' + (first ? ' active' : '') + '" data-toggle="tab" href="#tabFull">完整文件 (' + data.FullDocument.WordCount + '字)</a></li>';
                contentHtml += '<div class="tab-pane fade' + (first ? ' show active' : '') + '" id="tabFull">';
                contentHtml += '<div style="white-space: pre-wrap; line-height: 1.8; padding: 15px; background: #f8f9fa; border-radius: 5px; max-height: 60vh; overflow-y: auto;">';
                contentHtml += escapeHtml(data.FullDocument.Content);
                contentHtml += '</div></div>';
            }

            document.getElementById('assembleTabs').innerHTML = tabsHtml;
            document.getElementById('assembleTabContent').innerHTML = contentHtml;
        }

        function buildPartContent(part) {
            var html = '';
            part.Chapters.forEach(function(chapter, index) {
                html += '<div class="card mb-3">';
                html += '<div class="card-header"><strong>' + (index + 1) + '. ' + escapeHtml(chapter.Name) + '</strong>';
                html += ' <span class="badge badge-secondary ml-2">' + chapter.WordCount + '字</span></div>';
                html += '<div class="card-body">';
                html += '<div style="white-space: pre-wrap; line-height: 1.8;">' + escapeHtml(chapter.Content) + '</div>';
                html += '</div></div>';
            });
            return html;
        }

        function copyAssembleContent() {
            if (!assembleData) return;

            var content = '';
            if (assembleData.FullDocument) {
                content = assembleData.FullDocument.Content;
            } else if (assembleData.TechnicalPart && assembleData.CommercialPart) {
                content = assembleData.TechnicalPart.Content + '\n\n' + assembleData.CommercialPart.Content;
            } else if (assembleData.TechnicalPart) {
                content = assembleData.TechnicalPart.Content;
            } else if (assembleData.CommercialPart) {
                content = assembleData.CommercialPart.Content;
            }

            navigator.clipboard.writeText(content).then(function() {
                alert('内容已复制到剪贴板！');
            }).catch(function() {
                var textarea = document.createElement('textarea');
                textarea.value = content;
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                document.body.removeChild(textarea);
                alert('内容已复制到剪贴板！');
            });
        }

        // ── 人员匹配 ───────────────────────────────────────────
        async function matchPersonnel() {
            var progressEl = document.getElementById('generatingProgress');
            var outputEl = document.getElementById('generatingOutput');

            progressEl.style.display = 'block';
            outputEl.style.display = 'block';
            document.getElementById('generatingChapter').textContent = '智能匹配人员';
            outputEl.innerHTML = '<div class="text-center"><div class="spinner-border text-primary"></div><p>正在从数据库中匹配符合要求的人员...</p></div>';

            try {
                var response = await fetch('/Bid/MatchPersonnel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ BidProjectId: bidProjectId, MaxPersonnel: 10 })
                });

                if (response.redirected) {
                    window.location.href = response.url;
                    return;
                }

                var text = await response.text();
                var result = JSON.parse(text);
                var data = result.data || result;

                var matched = data.matchedPersonnel || data.MatchedPersonnel;
                if (data && matched) {
                    data.matchedPersonnel = matched;
                    data.unmatchedRequirements = data.unmatchedRequirements || data.UnmatchedRequirements || [];
                    data.summary = data.summary || data.Summary || '';
                    displayPersonnelMatchResult(data);
                } else {
                    var msg = (data && (data.message || data.Message)) || result.message || '未找到匹配人员';
                    outputEl.innerHTML = '<div class="alert alert-warning">' + escapeHtml(msg) + '</div>';
                }
            } catch (e) {
                outputEl.innerHTML = '<div class="alert alert-danger">请求失败：' + e.message + '</div>';
            } finally {
                progressEl.style.display = 'none';
            }
        }

        function displayPersonnelMatchResult(data) {
            var outputEl = document.getElementById('generatingOutput');
            var html = '<div class="alert alert-info py-2">' + escapeHtml(data.summary || data.Summary || '') + '</div>';

            var personnel = data.matchedPersonnel || data.MatchedPersonnel || [];
            if (personnel.length > 0) {
                personnel.forEach(function(p) {
                    var name = p.name || p.Name || '';
                    var dept = p.deptName || p.DeptName || '-';
                    var edu = p.education || p.Education || '-';
                    var years = p.workYears || p.WorkYears || 0;
                    var score = p.matchScore || p.MatchScore || 0;
                    var certs = p.certificates || p.Certificates || [];
                    var basis = p.matchBasis || p.MatchBasis || [];
                    var conflicts = p.conflictWarnings || p.ConflictWarnings || [];
                    var hasConflict = conflicts.length > 0;

                    html += '<div class="card mb-2" style="border-left:4px solid ' + (hasConflict ? '#d9822b' : '#28a745') + ';">';
                    html += '<div class="card-body p-2">';
                    html += '<div class="d-flex justify-content-between align-items-start">';
                    html += '<div><strong>' + escapeHtml(name) + '</strong>';
                    html += ' <span class="text-muted" style="font-size:12px;">' + escapeHtml(dept) + ' · ' + escapeHtml(edu) + ' · 工作' + years + '年</span></div>';
                    html += '<span class="badge badge-primary">匹配得分 ' + score + '</span>';
                    html += '</div>';

                    if (hasConflict) {
                        html += '<div class="alert alert-warning py-1 px-2 mt-2 mb-1" style="font-size:11.5px;">';
                        conflicts.forEach(function(c) { html += '<div><i class="fas fa-exclamation-triangle mr-1"></i>' + escapeHtml(c) + '</div>'; });
                        html += '</div>';
                    }

                    html += '<div class="mt-2" style="font-size:12px;">';
                    certs.forEach(function(c) {
                        var certName = c.certName || c.CertName || '';
                        var validity = c.validityStatus || c.ValidityStatus || 'Valid';
                        var badgeClass = validity === 'Expired' ? 'badge-danger' : (validity === 'ExpiringSoon' ? 'badge-warning' : (validity === 'Unknown' ? 'badge-secondary' : 'badge-success'));
                        var validityLabel = validity === 'Expired' ? '已过期' : (validity === 'ExpiringSoon' ? '即将到期' : (validity === 'Unknown' ? '未登记有效期' : '有效'));
                        if (certName) html += '<span class="badge ' + badgeClass + ' mr-1 mb-1">' + escapeHtml(certName) + ' · ' + validityLabel + '</span>';
                    });
                    html += '</div>';

                    if (basis.length > 0) {
                        html += '<ul class="mb-0 mt-1" style="font-size:11.5px;color:#495057;padding-left:18px;">';
                        basis.forEach(function(b) { html += '<li>' + escapeHtml(b) + '</li>'; });
                        html += '</ul>';
                    }

                    html += '</div></div>';
                });
            } else {
                html += '<div class="alert alert-warning py-2"><i class="fas fa-exclamation-triangle"></i> 暂无符合条件的人员</div>';
            }

            var unmatched = data.unmatchedRequirements || data.UnmatchedRequirements || [];
            if (unmatched.length > 0) {
                html += '<div class="alert alert-warning py-2 mt-2"><strong>未匹配的要求：</strong><ul class="mb-0">';
                unmatched.forEach(function(req) {
                    html += '<li>' + escapeHtml(req) + '</li>';
                });
                html += '</ul></div>';
            }

            var unrecognized = data.unrecognizedRequirements || data.UnrecognizedRequirements || [];
            if (unrecognized.length > 0) {
                html += '<div class="alert alert-info py-2 mt-2" style="background:#e9f1fb;border-color:#b9d3ef;">';
                html += '<strong><i class="fas fa-search mr-1"></i>系统无法自动识别证书类型，需人工直接核对：</strong><ul class="mb-0">';
                unrecognized.forEach(function(req) {
                    html += '<li>' + escapeHtml(req) + '</li>';
                });
                html += '</ul></div>';
            }

            html += '<div class="mt-3"><button class="btn btn-primary" onclick="generatePersonnelSection()"><i class="fas fa-magic mr-1"></i>根据匹配结果生成人员配置文档</button>';
            html += ' <small class="text-muted ml-2">存在岗位冲突的人员不会被写入正文，需人工确认后再补充</small></div>';

            outputEl.innerHTML = html;
        }

        async function generatePersonnelSection() {
            var outputEl = document.getElementById('generatingOutput');
            outputEl.innerHTML += '<div class="mt-3"><div class="alert alert-info"><i class="fas fa-spinner fa-spin"></i> 正在生成人员配置文档...</div></div>';

            try {
                var response = await fetch('/Bid/GeneratePersonnelSection', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ BidProjectId: bidProjectId, MaxPersonnel: 10 })
                });
                var result = await response.json();

                if (result.success) {
                    alert('人员配置文档已生成！页面将刷新显示结果。');
                    location.reload();
                } else {
                    alert('生成失败：' + result.message);
                }
            } catch (e) {
                alert('请求失败：' + e.message);
            }
        }

        async function generateChapterStream(chapterName, customRequirements) {
            var progressEl = document.getElementById('generatingProgress');
            var outputEl = document.getElementById('generatingOutput');

            progressEl.style.display = 'block';
            outputEl.style.display = 'block';
            document.getElementById('generatingChapter').textContent = chapterName;
            outputEl.innerHTML = '';

            await generateChapterStreamInternal({
                BidProjectId: bidProjectId,
                ChapterName: chapterName,
                TargetWordCount: 2000,
                CustomRequirements: customRequirements || ''
            }, function(chunk) {
                document.getElementById('generatingOutput').innerHTML += chunk;
            }, function() {
                setTimeout(() => location.reload(), 1000);
            });
        }

        async function reviewBid() {
            document.getElementById('reviewResult').style.display = 'block';
            document.getElementById('reviewContent').innerHTML =
                '<div class="text-center"><div class="spinner-border text-primary"></div><p>正在审查...</p></div>';

            try {
                var response = await fetch('/Bid/Review', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ BidProjectId: bidProjectId })
                });
                var result = await response.json();

                if (result.success) {
                    displayReviewResult(result.data);
                } else {
                    document.getElementById('reviewContent').innerHTML =
                        '<div class="alert alert-danger">' + result.message + '</div>';
                }
            } catch (e) {
                document.getElementById('reviewContent').innerHTML =
                    '<div class="alert alert-danger">请求失败：' + e.message + '</div>';
            }
        }

        function displayReviewResult(data) {
            var html = '<div class="mb-3"><strong>综合评分：</strong>';
            var scoreClass = data.overallScore >= 80 ? 'success' : data.overallScore >= 60 ? 'warning' : 'danger';
            html += '<span class="badge bg-' + scoreClass + ' fs-6">' + data.overallScore + '分</span></div>';

            if (data.missingItems && data.missingItems.length > 0) {
                html += '<h6 class="text-danger">缺失内容：</h6><ul>';
                data.missingItems.forEach(function(item) {
                    html += '<li>' + item + '</li>';
                });
                html += '</ul>';
            }

            if (data.issues && data.issues.length > 0) {
                html += '<h6 class="text-warning">问题列表：</h6>';
                data.issues.forEach(function(issue) {
                    html += '<div class="alert alert-' +
                        (issue.severity === 'high' ? 'danger' : issue.severity === 'medium' ? 'warning' : 'info') +
                        ' py-2">';
                    html += '<strong>[' + issue.chapter + ']</strong> ' + issue.description;
                    if (issue.suggestion) html += '<br><small class="text-muted">建议：' + issue.suggestion + '</small>';
                    html += '</div>';
                });
            }

            if (data.suggestions && data.suggestions.length > 0) {
                html += '<h6 class="text-primary">改进建议：</h6><ul>';
                data.suggestions.forEach(function(item) {
                    html += '<li>' + item + '</li>';
                });
                html += '</ul>';
            }

            document.getElementById('reviewContent').innerHTML = html;
        }
    </script>
}

@functions {
    string GetStatusColor(int status) => status switch
    {
        0 => "secondary",
        1 => "info",
        2 => "primary",
        3 => "warning",
        4 => "success",
        5 => "info",
        6 => "success",
        7 => "danger",
        _ => "secondary"
    };

    string GetStatusName(int status) => status switch
    {
        0 => "草稿",
        1 => "解析中",
        2 => "生成中",
        3 => "审查中",
        4 => "就绪",
        5 => "已提交",
        6 => "已中标",
        7 => "未中标",
        _ => "未知"
    };

    string GetDocStatusColor(int status) => status switch
    {
        0 => "secondary",
        1 => "success",
        2 => "warning",
        3 => "info",
        4 => "primary",
        _ => "secondary"
    };

    string GetDocStatusName(int status) => status switch
    {
        0 => "草稿",
        1 => "AI生成",
        2 => "编辑中",
        3 => "已审查",
        4 => "定稿",
        _ => "未知"
    };
}
