@model EnterpriseMS.Services.DTOs.Bid.BidProjectDto
@{
    ViewData["Title"] = $"投标详情 - {Model.ProjectName}";
    Layout = "_Layout";

    var parseStage  = Model.ParseStage;
    var vetoItems   = Model.Requirements.Where(r => r.IsVeto).ToList();
    var reviewItems = Model.Requirements.Where(r => r.NeedsReview).ToList();
}

@* 招标文件解析模块专用样式：原 tp-* 类在全站无任何 CSS 定义（迁移前即为裸样式），
   此处按 ems 设计语言最小化重建为 bid-*，只覆盖本模块独有的视觉（阶段条 / 否决条款块 /
   要求行 / 流式输出区）。通用外观一律复用 ems.css + layui 原生 class。 *@
@section Styles {
<style>
    .bid-stage-wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .bid-stage-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .bid-stage { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 16px;
                 background: #f5f6f8; color: #8a94a6; font-size: 13px; }
    .bid-stage .num { display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px;
                      border-radius: 50%; background: #d9dde5; color: #fff; font-size: 11px; }
    .bid-stage.live { background: #fff3e0; color: #e09000; }
    .bid-stage.live .num { background: #e09000; }
    .bid-stage.done { background: #e8f3f1; color: #0d6b64; }
    .bid-stage.done .num { background: #0d6b64; }

    .bid-veto-box { background: #fdecec; border: 1px solid #f4c7c7; border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; }
    .bid-veto-title { font-size: 13px; font-weight: 600; color: #c0392b; margin-bottom: 8px; }
    .bid-veto-item { font-size: 13px; line-height: 1.7; color: #7a2f2f; padding: 4px 0; border-top: 1px dashed #f0cccc; }
    .bid-veto-item:first-of-type { border-top: none; }

    .bid-review-box { background: #eaf3ff; border: 1px solid #b9d3ef; border-radius: 10px; padding: 12px 14px; margin-bottom: 14px; }
    .bid-review-title { font-size: 13px; font-weight: 600; color: #2b6cb0; margin-bottom: 8px; }

    .bid-req-row { position: relative; font-size: 13px; line-height: 1.8; color: #1f2d3d;
                   padding: 6px 8px; border: 1px solid #eef1f5; border-radius: 6px; margin-bottom: 6px; background: #fff; }
    .bid-req-row .layui-btn { float: right; margin-left: 8px; }
    .bid-src { color: #8a94a6; font-size: 12px; margin-left: 4px; }
    .bid-cat { font-size: 13px; font-weight: 600; color: #0d6b64; margin: 10px 0 6px; }

    .bid-badge { display: inline-block; padding: 1px 7px; border-radius: 10px; font-size: 11px; margin-right: 6px; }
    .bid-badge-veto { background: #fdecec; color: #c0392b; }
    .bid-badge-review { background: #eaf3ff; color: #2b6cb0; }

    .bid-confirm-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
                       margin-top: 12px; padding: 10px 12px; border: 1px dashed #d9dde5; border-radius: 8px; background: #fafbfc; }
    .bid-confirm-bar.done { border-style: solid; border-color: #bcd6c5; background: #eaf2ec; }

    .bid-output { margin-top: 14px; padding: 14px; border: 1px solid #eef1f5; border-radius: 8px; background: #fafbfc;
                  max-height: 500px; overflow-y: auto; white-space: pre-wrap; font-size: 13px; line-height: 1.8; }
    .bid-preview { white-space: pre-wrap; max-height: 60vh; overflow-y: auto; padding: 15px; background: #fafbfc; border-radius: 8px; }
    .bid-chapter-row { border: 1px solid #eef1f5; border-radius: 8px; padding: 8px 12px; margin-bottom: 8px;
                       display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }

    .ems-alert.danger { background: #fdecec; color: #c0392b; }
    .bid-file-input { height: auto !important; line-height: normal !important; padding: 7px 10px; }

    /* ~/js/bid-ai.js 不可改动，其兜底分支仍会输出 text-danger / text-muted，
       此处按 ems 配色补一条兼容规则，避免出现无样式文本 */
    .text-danger { color: #e05050; }
    .text-muted { color: #8a94a6; }
</style>
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-read"></i> @Model.ProjectName
        <span class="layui-font-12">投标详情</span>
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">投标管理</a>
        <a><cite>投标详情</cite></a>
    </div>
</div>

<!-- 解析阶段进度 + 页面操作 -->
<div class="layui-card ems-card">
    <div class="layui-card-body bid-stage-wrap">
        <div class="bid-stage-bar">
            <span class="bid-stage @(parseStage >= 1 ? "done" : "")"><span class="num">1</span>上传文件</span>
            <span class="bid-stage @(parseStage == 1 ? "live" : (parseStage >= 2 ? "done" : ""))"><span class="num">2</span>AI 解析</span>
            <span class="bid-stage @(parseStage == 2 ? "live" : (parseStage >= 3 ? "done" : ""))"><span class="num">3</span>人工确认要素表</span>
            <span class="bid-stage @(parseStage >= 3 ? "done" : "")"><span class="num">4</span>进入内容生成</span>
        </div>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnEditBid">
                <i class="layui-icon layui-icon-edit"></i> 编辑
            </button>
            <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="btnBackList">
                <i class="layui-icon layui-icon-return"></i> 返回列表
            </button>
        </div>
    </div>
</div>

<div class="layui-row layui-col-space12">

    <!-- ── 左栏 ─────────────────────────────────────────── -->
    <div class="layui-col-md4">

        <div class="layui-card ems-card">
            <div class="layui-card-header">基本信息</div>
            <div class="layui-card-body">
                <div class="ems-info-list">
                    <div class="ems-info-item"><span class="label">项目名称</span><span class="val"><strong>@Model.ProjectName</strong></span></div>
                    <div class="ems-info-item"><span class="label">项目编号</span><span class="val">@Model.ProjectCode</span></div>
                    <div class="ems-info-item"><span class="label">招标人</span><span class="val">@(Model.Tenderer ?? "-")</span></div>
                    <div class="ems-info-item"><span class="label">预算金额</span><span class="val layui-font-teal">@(Model.Budget?.ToString("N2") ?? "-") <span class="layui-font-12"><strong>万元</strong></span></span></div>
                    <div class="ems-info-item"><span class="label">截止日期</span><span class="val">@(Model.Deadline?.ToString("yyyy-MM-dd") ?? "-")</span></div>
                    <div class="ems-info-item">
                        <span class="label">状态</span>
                        <span class="val">
                            <span class="layui-badge layui-bg-@GetStatusColor(Model.Status)">@GetStatusName(Model.Status)</span>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span>招标文件解析</span>
                <div class="ems-card-tools">
                    <span class="layui-badge layui-bg-@(parseStage == 3 ? "green" : (parseStage == 2 ? "orange" : "gray"))">
                        @Model.ParseStageName
                    </span>
                </div>
            </div>
            <div class="layui-card-body">
                @if (!string.IsNullOrWhiteSpace(Model.SourceFileName))
                {
                    <div class="layui-font-gray" style="font-size:12px;margin-bottom:8px">
                        <i class="layui-icon layui-icon-file"></i> @Model.SourceFileName
                    </div>
                }
                <div style="margin-bottom:12px">
                    <input type="file" id="bidFile" class="layui-input bid-file-input" accept=".pdf,.docx,.doc">
                    <div class="layui-word-aux" style="margin-top:6px">支持 PDF / Word；扫描件暂不支持文字识别</div>
                </div>
                <button type="button" class="layui-btn layui-btn-normal layui-btn-fluid" onclick="analyzeDocument()">
                    <i class="layui-icon layui-icon-engine"></i> AI 解析招标文件
                </button>
                <div id="analyzeProgress" style="display:none;margin-top:14px">
                    <div class="ems-alert info">
                        <i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i>
                        正在解析（按章节分块处理，大文件可能需要数十秒到数分钟）...
                    </div>
                </div>
            </div>
        </div>

        <div class="layui-card ems-card">
            <div class="layui-card-header">快捷操作</div>
            <div class="layui-card-body">
                @if (parseStage != 3)
                {
                    <div class="ems-alert warn" style="margin-bottom:10px;font-size:12px">
                        <i class="layui-icon layui-icon-tips"></i> 建议先完成“人工确认招标要素表”，再生成正文内容
                    </div>
                }
                <button type="button" class="layui-btn layui-btn-fluid" style="background:#2e9e5b;margin-bottom:8px" onclick="generateFullBid()">
                    <i class="layui-icon layui-icon-star"></i> 一键生成全部章节
                </button>
                <button type="button" class="layui-btn layui-btn-warm layui-btn-fluid" style="margin-bottom:8px" onclick="reviewBid()">
                    <i class="layui-icon layui-icon-ok-circle"></i> AI 审查标书
                </button>
                <button type="button" class="layui-btn layui-btn-normal layui-btn-fluid" style="margin-bottom:8px" onclick="matchPersonnel()">
                    <i class="layui-icon layui-icon-friends"></i> 智能匹配人员
                </button>
                <button type="button" class="layui-btn layui-btn-fluid" style="background:#1890ff;margin-bottom:8px" onclick="assembleDocument('all')">
                    <i class="layui-icon layui-icon-file-b"></i> 组卷（完整文件）
                </button>
                <div class="layui-row layui-col-space8">
                    <div class="layui-col-xs6">
                        <button type="button" class="layui-btn layui-btn-primary layui-btn-fluid" onclick="assembleDocument('technical')">技术部分</button>
                    </div>
                    <div class="layui-col-xs6">
                        <button type="button" class="layui-btn layui-btn-primary layui-btn-fluid" onclick="assembleDocument('commercial')">商务部分</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="layui-card ems-card">
            <div class="layui-card-header">导出文件</div>
            <div class="layui-card-body">
                <div style="margin-bottom:10px">
                    <select id="exportPart" class="layui-input">
                        <option value="all">完整投标文件</option>
                        <option value="technical">仅技术部分</option>
                        <option value="commercial">仅商务部分</option>
                    </select>
                </div>
                <div class="layui-row layui-col-space8">
                    <div class="layui-col-xs6">
                        <button type="button" class="layui-btn layui-btn-fluid" style="background:#2e9e5b" onclick="exportDocument('word')">
                            <i class="layui-icon layui-icon-export"></i> 导出 Word
                        </button>
                    </div>
                    <div class="layui-col-xs6">
                        <button type="button" class="layui-btn layui-btn-danger layui-btn-fluid" onclick="exportDocument('pdf')">
                            <i class="layui-icon layui-icon-export"></i> 导出 PDF
                        </button>
                    </div>
                </div>
                <div id="exportStatus" style="margin-top:10px;font-size:12px"></div>
                <div class="layui-word-aux" style="margin-top:6px">PDF 导出依赖服务器 LibreOffice 环境；若不可用请改用 Word 格式</div>
            </div>
        </div>

    </div>

    <!-- ── 右栏 ─────────────────────────────────────────── -->
    <div class="layui-col-md8">

        @if (vetoItems.Any())
        {
            <div class="bid-veto-box">
                <div class="bid-veto-title">
                    <i class="layui-icon layui-icon-notice"></i>
                    否决性条款 · @vetoItems.Count 项（不满足将导致废标，请重点核对）
                </div>
                @foreach (var v in vetoItems)
                {
                    <div class="bid-veto-item">
                        @v.Content
                        @if (!string.IsNullOrWhiteSpace(v.SourceRef))
                        {
                            <span class="bid-src">[@v.SourceRef]</span>
                        }
                    </div>
                }
            </div>
        }

        @if (reviewItems.Any())
        {
            <div class="bid-review-box">
                <div class="bid-review-title">
                    <i class="layui-icon layui-icon-search"></i>
                    待人工确认 · @reviewItems.Count 项（AI 未能在原文中定位到出处，需人工核实后才能确认要素表）
                </div>
                @foreach (var r in reviewItems)
                {
                    <div class="bid-req-row" style="border-color:#b9d3ef;">
                        <button class="layui-btn layui-btn-xs layui-btn-primary"
                                data-req-id="@r.Id" data-content="@r.Content"
                                onclick="resolveRequirement(this)">核对</button>
                        <span class="bid-badge bid-badge-review">待确认</span>@r.Content
                    </div>
                }
            </div>
        }

        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span>招标要求</span>
                <div class="ems-card-tools">
                    <span class="layui-badge layui-bg-cyan">@Model.Requirements.Count 项</span>
                </div>
            </div>
            <div class="layui-card-body" style="max-height:320px;overflow-y:auto">
                @if (Model.Requirements.Any())
                {
                    @foreach (var req in Model.Requirements.GroupBy(r => r.Category))
                    {
                        <div class="bid-cat">@req.Key</div>
                        @foreach (var item in req)
                        {
                            <div class="bid-req-row">
                                @if (item.IsVeto)
                                {
                                    <span class="bid-badge bid-badge-veto">否决项</span>
                                }
                                @if (item.NeedsReview)
                                {
                                    <span class="bid-badge bid-badge-review">待确认</span>
                                }
                                <span class="layui-font-gray" style="font-size:12px">@(item.ScoreWeight?.ToString() ?? "")分</span>
                                @item.Content
                                @if (!string.IsNullOrWhiteSpace(item.SourceRef))
                                {
                                    <span class="bid-src">[@item.SourceRef]</span>
                                }
                            </div>
                        }
                    }

                    @if (parseStage == 2)
                    {
                        <div class="bid-confirm-bar">
                            <span style="font-size:12.5px;color:#495057;">
                                @if (reviewItems.Any())
                                {
                                    <text>还有 @reviewItems.Count 项待确认，处理完成后才能确认要素表</text>
                                }
                                else
                                {
                                    <text>所有条目已有出处定位，可以确认招标要素表</text>
                                }
                            </span>
                            <button type="button"
                                    class="layui-btn layui-btn-sm @(reviewItems.Any() ? "layui-btn-disabled" : "")"
                                    style="@(reviewItems.Any() ? "" : "background:#2e9e5b")"
                                    onclick="confirmElements()" @(reviewItems.Any() ? "disabled" : "")>
                                <i class="layui-icon layui-icon-ok"></i> 确认招标要素表
                            </button>
                        </div>
                    }
                    else if (parseStage == 3)
                    {
                        <div class="bid-confirm-bar done">
                            <span style="font-size:12.5px;color:#2f7a4f;">
                                <i class="layui-icon layui-icon-ok-circle"></i>
                                已于 @(Model.ElementsConfirmedAt?.ToString("yyyy-MM-dd HH:mm")) 由 @Model.ElementsConfirmedBy 确认
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div class="ems-empty">请先上传招标文件进行 AI 解析</div>
                }
            </div>
        </div>

        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span>标书章节</span>
                <div class="ems-card-tools">
                    <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" onclick="showAddChapter()">
                        <i class="layui-icon layui-icon-add-1"></i> 添加章节
                    </button>
                </div>
            </div>
            <div class="layui-card-body">
                <div id="chaptersList">
                    @if (Model.Documents.Any())
                    {
                        @foreach (var doc in Model.Documents.OrderBy(d => d.SortOrder))
                        {
                            <div class="bid-chapter-row" data-doc-id="@doc.Id">
                                <div>
                                    <strong>@doc.ChapterName</strong>
                                    <span class="layui-badge layui-bg-@GetDocStatusColor(doc.Status)" style="margin-left:6px">
                                        @GetDocStatusName(doc.Status)
                                    </span>
                                    <span class="layui-font-gray" style="font-size:12px;margin-left:6px">@(doc.WordCount ?? 0) 字</span>
                                </div>
                                <div>
                                    <button class="layui-btn layui-btn-xs layui-btn-primary" onclick="previewChapter(@doc.Id, '@EncodeHelper.SafeEncode(doc.ChapterName)')">预览</button>
                                    <button class="layui-btn layui-btn-xs" style="background:#2e9e5b" onclick="regenerateChapter('@EncodeHelper.SafeEncode(doc.ChapterName)')">重新生成</button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="ems-empty">暂无章节，请使用“一键生成全部章节”或手动添加</div>
                    }
                </div>

                <div id="generatingProgress" style="display:none;margin-top:14px">
                    <div class="ems-alert info">
                        <i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i>
                        正在生成：<span id="generatingChapter"></span>
                    </div>
                </div>

                <div id="generatingOutput" class="bid-output" style="display:none;"></div>
            </div>
        </div>

        <div class="layui-card ems-card" id="reviewResult" style="display:none;">
            <div class="layui-card-header">AI 审查结果</div>
            <div class="layui-card-body" id="reviewContent"></div>
        </div>

    </div>
</div>

<!-- 章节预览/编辑弹窗（layer type:1 承载） -->
<div class="ems-modal-box" id="chapterModal">
    <span id="chapterModalTitle" style="display:none">章节内容</span>
    <div id="chapterPreview" class="bid-preview"></div>
    <div id="chapterEditArea" style="display:none;">
        <textarea id="chapterContentEdit" class="layui-textarea" rows="20" style="font-size:14px;min-height:52vh"></textarea>
    </div>
    <div class="ems-modal-foot">
        <button type="button" class="layui-btn layui-btn-primary" onclick="closeChapterModal()">关闭</button>
        <button type="button" class="layui-btn layui-btn-normal" id="btnToggleEdit" onclick="toggleEditMode()">编辑</button>
        <button type="button" class="layui-btn" id="btnSaveContent" style="display:none;background:#2e9e5b" onclick="saveChapterContent()">保存</button>
    </div>
</div>

<!-- 组卷结果弹窗（layer type:1 承载） -->
<div class="ems-modal-box" id="assembleModal">
    <span id="assembleModalTitle" style="display:none">投标文件</span>
    <div id="assembleInfo" style="margin-bottom:12px"></div>
    <div class="layui-tab layui-tab-brief" lay-filter="assembleTab" style="margin:0">
        <ul class="layui-tab-title" id="assembleTabs"></ul>
        <div class="layui-tab-content" id="assembleTabContent"></div>
    </div>
    <div id="assembleLoading" class="ems-empty" style="display:none;">
        <i class="layui-icon layui-icon-loading layui-anim layui-anim-rotate layui-anim-loop"></i>
        <div style="margin-top:8px">正在组装文档...</div>
    </div>
    <div class="ems-modal-foot">
        <button type="button" class="layui-btn layui-btn-primary" onclick="closeAssembleModal()">关闭</button>
        <button type="button" class="layui-btn" style="background:#2e9e5b" onclick="copyAssembleContent()">
            <i class="layui-icon layui-icon-file-b"></i> 复制全部内容
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/bid-ai.js"></script>
    <script>
        var bidProjectId = @Model.Id;

        /* ──────────────────────────────────────────────────────────────
           同源 fetch 自动携带 CSRF 令牌
           后端全局启用 AutoValidateAntiforgeryToken（Program.cs），令牌头名为
           RequestVerificationToken。旧版由 site.js 的 fetch 包装统一附带，新版
           _Layout 只引 ems.js（仅包装 jQuery.ajax），故在此补齐。
           说明：只在请求发出前补一个请求头，不改动任何调用点的 URL / 方法 /
           请求体 / 响应处理，也不改动 ~/js/bid-ai.js（其流式生成同样受益）。
           ────────────────────────────────────────────────────────────── */
        (function () {
            if (window.__bidFetchCsrfPatched) return;
            window.__bidFetchCsrfPatched = true;
            var rawFetch = window.fetch;
            if (typeof rawFetch !== 'function') return;

            window.fetch = function (input, init) {
                init = init || {};
                var url = (typeof input === 'string') ? input : ((input && input.url) || '');
                var method = (init.method || (input && input.method) || 'GET').toUpperCase();
                var sameOrigin = url.indexOf('http') !== 0 || url.indexOf(location.origin) === 0;

                if (sameOrigin && method !== 'GET' && method !== 'HEAD' && method !== 'OPTIONS') {
                    var el = document.querySelector('input[name="__RequestVerificationToken"]');
                    var token = el ? el.value : '';
                    if (token) {
                        var headers = new Headers(init.headers || (input && input.headers) || {});
                        if (!headers.has('RequestVerificationToken')) {
                            headers.set('RequestVerificationToken', token);
                        }
                        init = Object.assign({}, init, { headers: headers });
                    }
                }
                return rawFetch.call(window, input, init);
            };
        })();

        /* ──────────────────────────────────────────────────────────────
           弹窗：原 Bootstrap modal → layui layer(type:1)
           容器 id / 内部元素 id 全部保持不变，业务 JS 逻辑零改动
           ────────────────────────────────────────────────────────────── */
        var _chapterLayer = null;
        var _assembleLayer = null;

        function openChapterModal() {
            var title = document.getElementById('chapterModalTitle').textContent || '章节内容';
            if (_chapterLayer !== null) { layer.title(title, _chapterLayer); return; }
            $('#chapterModal').show();
            _chapterLayer = layer.open({
