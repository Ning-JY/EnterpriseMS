                if (!sourceRef) {
                    ems.warn('出处不能为空，否则该条目会继续保留"待确认"状态');
                    return;
                }
                // ems.confirm 只透传「确定」回调，"否，非否决项" 分支通过 layer 原生 btn2 保留
                ems.confirm('该条目是否为否决性条款（不满足将直接导致废标）？',
                    {
                        icon: 3,
                        btn: ['是，否决项', '否，非否决项'],
