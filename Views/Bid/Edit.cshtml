@model EnterpriseMS.Services.DTOs.Bid.BidProjectDto
@{
    ViewData["Title"] = $"编辑投标 - {Model.ProjectName}";
    Layout = "_Layout";
    bool isDialog = Context.Request.Query["_dialog"] == "1";
    string[] statusText = { "草稿", "解析中", "生成中", "审查中", "就绪", "已提交", "已中标", "未中标" };
}

@if (!isDialog)
{
    <div class="ems-page-head">
        <div class="ems-page-title">
            <i class="layui-icon layui-icon-edit"></i> 编辑投标 - @Model.ProjectName
        </div>
        <div class="layui-breadcrumb" lay-separator="/">
            <a href="javascript:;">首页</a>
            <a href="javascript:;">投标管理</a>
            <a><cite>编辑投标</cite></a>
        </div>
    </div>
}

<form class="layui-form" lay-filter="bidEditForm" id="bidEditForm">
    <div class="layui-row layui-col-space12">

        <!-- 编辑信息 -->
        <div class="layui-col-md8">
            <div class="layui-card ems-card">
                <div class="layui-card-header">编辑信息</div>
                <div class="layui-card-body">

                    <div class="layui-form-item">
                        <label class="layui-form-label">项目名称</label>
                        <div class="layui-input-block">
                            <input type="text" class="layui-input" value="@Model.ProjectName" disabled>
                            <div class="layui-word-aux" style="margin-top:6px">项目名称由 AI 解析自动填充，不可直接修改。</div>
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">项目编号</label>
                        <div class="layui-input-block">
                            <input type="text" class="layui-input" value="@Model.ProjectCode" disabled>
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">招标人</label>
                        <div class="layui-input-block">
                            <input type="text" name="Tenderer" value="@Model.Tenderer" class="layui-input"
                                   autocomplete="off" placeholder="如：XX市建设局">
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">预算金额</label>
                        <div class="layui-input-block">
                            <input type="number" step="0.01" name="Budget" value="@Model.Budget"
                                   class="layui-input" autocomplete="off" placeholder="单位：万元">
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">投标截止</label>
                        <div class="layui-input-block">
                            <input type="date" name="Deadline" value="@(Model.Deadline?.ToString("yyyy-MM-dd"))"
                                   class="layui-input" autocomplete="off">
                        </div>
                    </div>

                    <div class="layui-form-item">
                        <label class="layui-form-label">状态</label>
                        <div class="layui-input-block">
                            <select name="Status">
                                @for (int i = 0; i < statusText.Length; i++)
                                {
                                    <option value="@i" selected="@(Model.Status == i)">@statusText[i]</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="layui-form-item layui-form-text">
                        <label class="layui-form-label">备注</label>
                        <div class="layui-input-block">
                            <textarea name="Remark" rows="3" class="layui-textarea"
                                      placeholder="项目描述、特殊要求等">@Model.Remark</textarea>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- 项目信息 -->
        <div class="layui-col-md4">
            <div class="layui-card ems-card">
                <div class="layui-card-header">项目信息</div>
                <div class="layui-card-body">
                    <div class="ems-info-list">
                        <div class="ems-info-item">
                            <span class="label">创建时间</span>
                            <span class="val">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <div class="ems-info-item">
                            <span class="label">当前状态</span>
                            <span class="val">@Model.StatusName</span>
                        </div>
                        <div class="ems-info-item">
                            <span class="label">文档数量</span>
                            <span class="val"><strong>@Model.Documents.Count 个章节</strong></span>
                        </div>
                        <div class="ems-info-item">
                            <span class="label">要求数量</span>
                            <span class="val"><strong>@Model.Requirements.Count 项</strong></span>
                        </div>
                    </div>
                    <div style="margin-top:14px">
                        <button type="button" class="layui-btn layui-btn-normal layui-btn-fluid" id="btnGoDetail">
                            <i class="layui-icon layui-icon-about"></i> 查看投标详情
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="ems-form-foot">
        <button type="button" class="layui-btn layui-btn-normal" id="btnSave">
            <i class="layui-icon layui-icon-ok"></i> 保存修改
        </button>
        <button type="button" class="layui-btn layui-btn-primary" id="btnCancel">取消</button>
    </div>
</form>

@section Scripts {
<script>
ems.ready(function () {

    var bidId    = @Model.Id;
    var isDialog = ems.query('_dialog') === '1';

    $('#btnSave').on('click', function () {
        ems.post({
            url: '/Bid/Edit/' + bidId,
            json: false,                            // MVC 动作无 [FromBody]，须用表单编码提交
            data: $('#bidEditForm').serialize(),
            done: function () {
                ems.success('保存成功');
                setTimeout(function () {
                    if (isDialog) ems.closeSelf('bidTable');
                    else          ems.openTab('/bid/detail/' + bidId, '投标详情');
                }, 400);
            }
        });
    });

    $('#btnGoDetail').on('click', function () {
        ems.openTab('/bid/detail/' + bidId, '投标详情');
    });

    $('#btnCancel').on('click', function () {
        if (isDialog) ems.closeSelf();
        else          ems.openTab('/bid', '投标台账');
    });
});
</script>
}
