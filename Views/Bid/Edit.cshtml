@model EnterpriseMS.Services.DTOs.Bid.BidProjectDto
@using EnterpriseMS.Domain.Enums
@{
    ViewData["Title"] = $"编辑投标 - {Model.ProjectName}";
    Layout = "_Layout";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">编辑投标</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">首页</a></li>
                    <li class="breadcrumb-item"><a href="/Bid">投标管理</a></li>
                    <li class="breadcrumb-item active">编辑投标</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-edit mr-1"></i>编辑信息</h3>
                </div>
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <div class="card-body">
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">项目名称</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" value="@Model.ProjectName" disabled />
                                <small class="text-muted">项目名称由AI解析自动填充</small>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">项目编号</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" value="@Model.ProjectCode" disabled />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">招标人</label>
                            <div class="col-sm-9">
                                <input name="Tenderer" value="@Model.Tenderer" class="form-control" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">预算金额（万元）</label>
                            <div class="col-sm-9">
                                <input name="Budget" value="@Model.Budget" class="form-control" type="number" step="0.01" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">投标截止日期</label>
                            <div class="col-sm-9">
                                <input name="Deadline" value="@(Model.Deadline?.ToString("yyyy-MM-dd"))" class="form-control" type="date" />
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">状态</label>
                            <div class="col-sm-9">
                                <select name="Status" class="form-control">
                                    @foreach (BidProjectStatus status in Enum.GetValues<BidProjectStatus>())
                                    {
                                        <option value="@((int)status)" selected="@(Model.Status == (int)status)">@status</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group row">
                            <label class="col-sm-3 col-form-label">备注</label>
                            <div class="col-sm-9">
                                <textarea name="Remark" class="form-control" rows="3">@Model.Remark</textarea>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save mr-1"></i>保存修改
                        </button>
                        <a href="/Bid/Detail/@Model.Id" class="btn btn-default ml-2">取消</a>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-info card-outline">
                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-info-circle mr-1"></i>项目信息</h3>
                </div>
                <div class="card-body">
                    <dl class="row small mb-0">
                        <dt class="col-sm-5">创建时间</dt>
                        <dd class="col-sm-7">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-sm-5">文档数量</dt>
                        <dd class="col-sm-7">@Model.Documents.Count 个章节</dd>
                        <dt class="col-sm-5">要求数量</dt>
                        <dd class="col-sm-7">@Model.Requirements.Count 项</dd>
                    </dl>
                    <hr>
                    <a href="/Bid/Detail/@Model.Id" class="btn btn-info btn-sm btn-block">
                        <i class="fas fa-eye mr-1"></i>查看投标详情
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
