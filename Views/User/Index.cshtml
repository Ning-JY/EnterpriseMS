@using EnterpriseMS.Common.Extensions
@inject EnterpriseMS.Services.Interfaces.IPermissionService PermSvc
@{
    ViewData["Title"] = "用户管理";
    var userId  = User.GetUserId();
    bool canAdd    = await PermSvc.HasPermAsync(userId, "sys:user:add");
    bool canEdit   = await PermSvc.HasPermAsync(userId, "sys:user:edit");
    bool canDel    = await PermSvc.HasPermAsync(userId, "sys:user:delete");
    bool canReset  = await PermSvc.HasPermAsync(userId, "sys:user:reset");
}

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-user"></i> 用户管理
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">系统管理</a>
        <a><cite>用户管理</cite></a>
    </div>
</div>

<!-- 搜索卡片：无头部、无字段名，仅控件；新增/批量导入在右侧 -->
<div class="layui-card ems-card ems-search">
    <div class="layui-card-body">
        <form class="layui-form" lay-filter="userSearch">
            <div class="layui-inline">
                <input type="text" name="Keyword" placeholder="用户名 / 姓名 / 手机"
                       autocomplete="off" class="layui-input">
            </div>
            <div class="layui-inline">
                @await Component.InvokeAsync("DeptSelect", new {
                    id = "DeptId", name = "DeptId", selectedId = 0L,
                    emptyText = "全部部门", cssClass = ""
                })
            </div>
            <div class="layui-inline">
                <select name="Status">
                    <option value="">全部状态</option>
                    <option value="1">正常</option>
                    <option value="0">禁用</option>
                </select>
            </div>
            <div class="layui-inline">
                <button class="layui-btn" lay-submit lay-filter="userSearch">
                    <i class="layui-icon layui-icon-search"></i> 搜索
                </button>
            </div>
            <div class="layui-inline ems-search-actions">
                @if (canAdd)
                {
                    <button type="button" class="layui-btn layui-btn-normal" id="btnAdd">
                        <i class="layui-icon layui-icon-add-1"></i> 新增
                    </button>
                    <button type="button" class="layui-btn" id="btnImport">
                        <i class="layui-icon layui-icon-upload-circle"></i> 批量导入
                    </button>
                }
            </div>
        </form>
    </div>
</div>

<!-- 列表卡片：筛选/导出在卡片头部，无批量删除 -->
<div class="layui-card ems-card">
    <div class="layui-card-header">
        <span>用户列表</span>
        <div class="ems-card-tools">
            <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnFilter">
                <i class="layui-icon layui-icon-cols"></i> 筛选列
            </button>
            <button type="button" class="layui-btn layui-btn-sm" id="btnExport">
                <i class="layui-icon layui-icon-export"></i> 导出
            </button>
        </div>
    </div>
    <div class="layui-card-body">
        <table id="userTable" lay-filter="userTable"></table>
    </div>
</div>

<!-- 行操作列：图标按钮（带底色，尺寸适配行高） -->
<script type="text/html" id="userBar">
    @if (canEdit)
    {
        <text>
        <a class="ems-icon-btn edit" title="编辑" lay-event="edit"><i class="layui-icon layui-icon-edit"></i></a>
        {{# if(d.Status === 1){ }}
        <a class="ems-icon-btn warn" title="禁用" lay-event="disable"><i class="layui-icon layui-icon-close-fill"></i></a>
        {{# } else { }}
        <a class="ems-icon-btn success" title="启用" lay-event="enable"><i class="layui-icon layui-icon-ok-circle"></i></a>
        {{# } }}
        </text>
    }
    @if (canReset)
    {
        <a class="ems-icon-btn gray" title="重置密码" lay-event="resetPwd"><i class="layui-icon layui-icon-key"></i></a>
    }
    @if (canDel)
    {
        <a class="ems-icon-btn danger" title="删除" lay-event="del"><i class="layui-icon layui-icon-delete"></i></a>
    }
</script>

@section Scripts {
<script>
ems.ready(function () {

    var colsConfig = [
        { field: 'Username',     title: '用户名' },
        { field: 'RealName',     title: '姓名' },
        { field: 'DeptName',     title: '部门', templet: ems.tpl.text('DeptName') },
        { field: 'Phone',        title: '手机', templet: ems.tpl.text('Phone') },
        { field: 'Status',       title: '状态', align: 'center',
          templet: ems.tpl.badge('Status', { 1: ['正常', 'green'], 0: ['禁用', 'red'] }) },
        { field: 'RoleNames',    title: '角色', templet: function (d) {
            return '<div class="ems-role-tags">' + ems.tpl.tags('RoleNames')(d) + '</div>';
        } },
        { field: 'EmployeeName', title: '绑定员工', templet: ems.tpl.tag('EmployeeName') },
        { field: 'LastLoginTime', title: '最后登录', hide: true,
          templet: function (d) { return d.LastLoginTime ? ems.fmtDateTime(d.LastLoginTime) : '从未登录'; } },
        { title: '操作', width: 150, align: 'center', toolbar: '#userBar' }
    ];

    ems.initTable({
        elem: '#userTable',
        id:   'userTable',
        url:  '/system/user/list',
        cols: [colsConfig],

        tool: {
            edit: function (d) {
                ems.openEdit({ title: '编辑用户 - ' + d.RealName, url: '/system/user/form?id=' + d.Id });
            },
            enable:  function (d) { toggleStatus(d, 1); },
            disable: function (d) { toggleStatus(d, 0); },
            resetPwd: function (d) {
                ems.promptDialog({
                    title: '重置密码',
                    icon: 'layui-icon-key',
                    msg: '为 <b>' + ems.escapeHtml(d.RealName) + '</b> 设置新密码',
                    formType: 1,
                    minLength: 6,
                    btn: ['确认重置', '取消']
                }, function (val) {
                    ems.post({
                        url: '/system/user/resetpwd', json: false,
                        data: { id: d.Id, newPwd: val }
                    });
                });
            },
            del: function (d) {
                ems.del({
                    url: '/system/user/delete/' + d.Id,
                    name: d.RealName,
                    table: 'userTable'
                });
            }
        }
    });

    // 搜索卡片内的「新增 / 批量导入」
    $('#btnAdd').on('click', function () {
        ems.openAdd({ title: '新增用户', url: '/system/user/form' });
    });

    $('#btnImport').on('click', function () {
        layer.open({
            type: 1,
            title: '批量导入用户',
            skin: 'ems-layer',
            content:
                '<div class="ems-import-body">' +
                '  <input type="file" id="importUserFile" class="layui-input">' +
                '  <div class="ems-import-tip">' +
                '    支持 Excel / CSV 文件，请先下载导入模板填写后上传。<br>导入将覆盖同名用户的关键信息。' +
                '  </div>' +
                '</div>',
            btn: ['开始导入', '下载模板'],
            yes: function (index) {
                var f = document.getElementById('importUserFile');
                if (!f.files.length) { ems.error('请先选择文件'); return; }
                var formData = new FormData();
                formData.append('file', f.files[0]);
                var load = layer.load(2);
                $.ajax({
                    url: '/system/user/import',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (res) {
                        layer.close(load);
                        if (res && res.success) {
                            var d = res.data || {};
                            var tip = '导入完成：新增 ' + (d.created || 0) + '，更新 ' + (d.updated || 0) + (d.failed ? '，失败 ' + d.failed : '');
                            ems.success(tip);
                            if (d.errors && d.errors.length) {
                                console.warn('导入未成功的行：', d.errors);
                                ems.msg('部分行未导入，详见控制台');
                            }
                            setTimeout(function () { location.reload(); }, 600);
                            layer.close(index);
                        } else {
                            ems.error((res && res.message) || '导入失败');
                        }
                    },
                    error: function () { layer.close(load); ems.error('导入请求失败，请重试'); }
                });
            },
            btn2: function () {
                ems.download('/system/user/template');
                return false;
            }
        });
    });

    // 列表卡片头部的「筛选列 / 导出」
    $('#btnFilter').on('click', function () {
        ems.colFilter('userTable', colsConfig);
    });

    $('#btnExport').on('click', function () {
        ems.exportMenu('userTable', '用户列表');
    });

    function toggleStatus(d, status) {
        ems.setStatus({
            url: '/system/user/status',
            data: { id: d.Id, status: status },
            status: status,
            table: 'userTable',
            confirm: '确定' + (status === 1 ? '启用' : '禁用') + '用户 ' + d.RealName + '？'
        });
    }

    // 搜索（搜索按钮写 lay-submit lay-filter="userSearch" 即可）
    ems.bindSearch('userSearch', 'userTable');
});
</script>
}
