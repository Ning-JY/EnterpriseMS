@{
    ViewData["Title"] = "报告生成";
}

<style>
    .cursor-pointer   { cursor: pointer; }
    .highlight-col     { background: #fff7e6 !important; }
    .mapping-scroll     { overflow: auto; max-height: 420px; border: 1px solid #f0f0f0; }
    .auto-reason       { color: #999; }
    .num-          { font-weight: ; }
</style>

<!-- 标题栏 + 面包屑 -->
<div class="ems-page-head">
    <div class="ems-page-title">
        <i class="layui-icon layui-icon-file"></i> 报告生成
    </div>
    <div class="layui-breadcrumb" lay-separator="/">
        <a href="javascript:;">首页</a>
        <a href="javascript:;">造价小工具</a>
        <a><cite>报告生成</cite></a>
    </div>
</div>

@** ── 顶部工具栏 ── *@
<div class="layui-card ems-card">
    <div class="layui-card-body layui-btn-container">
        <input type="file" id="upload" accept=".xlsx,.xls" class="layui-hide">
        <button type="button" class="layui-btn layui-btn-sm" id="btnImportExcel">
            <i class="layui-icon layui-icon-upload"></i> 导入 Excel
        </button>
        <button type="button" class="layui-btn layui-btn-sm layui-btn-warm" id="btnPreview">
            <i class="layui-icon layui-icon-file"></i> 生成报告
        </button>
        <label class="layui-form-label" style="width:auto;padding:0 6px 0 12px;line-height:30px">模板</label>
        <select id="tplSelect" class="layui-input-inline" style="width:200px;height:30px"></select>
        <span class="layui-font-12 layui-font-gray" style="margin-left:12px">
            <i class="layui-icon layui-icon-tips"></i> 导入后请在下方字段映射卡片中完成映射，再点击"确认映射"
        </span>
    </div>
</div>

@** ── 操作说明（默认折叠） ── *@
<div class="layui-card ems-card" style="border-left:4px solid #17a2b8">
    <div class="layui-card-header cursor-pointer" id="helpHeader">
        <span><i class="layui-icon layui-icon-read text-info"></i> <strong>操作说明（点击展开）</strong></span>
        <i class="layui-icon layui-icon-right layui-font-gray" id="helpIcon" style="float:right"></i>
    </div>
    <div id="helpContent" class="layui-card-body layui-hide">
        <ol class="layui-font-12" style="padding-left:18px;margin:0">
            <li>点击 <strong>"导入 Excel"</strong> 上传工作簿（支持多 Sheet）。</li>
            <li>点击左侧树形结构中的<strong>子节点</strong>，右侧将自动显示该 Sheet 的字段映射预览表。</li>
            <li>在映射预览表中为每列选择正确的字段类型（项目编码、项目名称、送审金额等），<strong>同一字段只能映射到一列</strong>，已映射列高亮显示。</li>
            <li>点击映射卡片底部的 <strong>"确认映射"</strong>，系统将解析所有 Sheet 数据并自动折叠映射卡片。</li>
            <li>勾选左侧项目（父节点可批量全选/全不选子节点），用于后续生成报告。</li>
            <li>使用筛选栏（审增/减、差额条件）过滤审核明细，表格支持分页（默认每页 10 条）。</li>
            <li>点击 <strong>"生成报告"</strong> 预览选中项目的审核结果，可导出 Word 文档。</li>
            <li>审核原因可下拉选择或手动输入，修改后实时保存。</li>
        </ol>
        <div class="layui-font-12 layui-font-gray" style="margin-top:6px">
            <i class="layui-icon layui-icon-light layui-font-orange"></i>
            提示：A2 单元格支持"父\子"格式，将自动生成两级树结构。
        </div>
    </div>
</div>

@** ── 主体：左树 + 右内容 ── *@
<div class="layui-row layui-col-space14">

    @** 左：项目结构树 ── *@
    <div class="layui-col-md3 layui-col-lg2">
        <div class="layui-card ems-card">
            <div class="layui-card-header"><i class="layui-icon layui-icon-folder"></i> 项目结构</div>
            <div class="layui-card-body" id="treeContainer" style="max-height:420px;overflow:auto">
                <div class="ems-empty">请先导入 Excel</div>
            </div>
            <div class="layui-card-body layui-font-12 layui-font-gray" style="padding-top:0">
                <i class="layui-icon layui-icon-ok"></i> 勾选后生成报告包含数据
            </div>
        </div>
    </div>

    @** 右：筛选 + 映射 + 明细 ── *@
    <div class="layui-col-md9 layui-col-lg10">

        @** 筛选栏 ── *@
        <div class="layui-card ems-card">
            <div class="layui-card-body">
                <form class="layui-form" lay-filter="reportFilter">
                    <div class="layui-inline">
                        <label class="layui-form-label" style="width:auto;padding-right:6px">审增/减</label>
                        <div style="display:inline-block">
                            <select id="type" style="width:85px">
                                <option value="">全部</option>
                                <option value="inc">审增</option>
                                <option value="dec">审减</option>
                            </select>
                        </div>
                    </div>
                    <div class="layui-inline">
                        <label class="layui-form-label" style="width:auto;padding-right:6px">条件</label>
                        <div style="display:inline-block">
                            <select id="mode" style="width:110px">
                                <option value="all">无限制</option>
                                <option value="gt">差额 &gt;</option>
                                <option value="lt">差额 &lt;</option>
                                <option value="between">介于</option>
                                <option value="abs">|差额| &gt;</option>
                            </select>
                        </div>
                    </div>
                    <div class="layui-inline">
                        <input id="min" placeholder="数值1" class="layui-input" style="width:90px" type="number">
                    </div>
                    <div class="layui-inline">
                        <input id="max" placeholder="数值2" class="layui-input" style="width:90px" type="number">
                    </div>
                    <div class="layui-inline">
                        <button type="button" class="layui-btn layui-btn-sm" id="btnFilter">
                            <i class="layui-icon layui-icon-search"></i> 筛选
                        </button>
                        <button type="button" class="layui-btn layui-btn-sm layui-btn-primary" id="btnReset">
                            <i class="layui-icon layui-icon-refresh"></i> 重置
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @** 字段映射卡片（可折叠） ── *@
        <div class="layui-card ems-card" id="mappingCard">
            <div class="layui-card-header cursor-pointer" id="mappingHeader">
                <span><i class="layui-icon layui-icon-transfer"></i> 字段映射（点击展开）</span>
                <i class="layui-icon layui-icon-down layui-font-gray" id="mappingCollapseIcon" style="float:right"></i>
            </div>
            <div id="mappingBody">
                <div class="layui-card-body">
                    <div class="ems-alert info">
                        <i class="layui-icon layui-icon-tips"></i> 请先导入 Excel，然后点击左侧子节点切换预览
                    </div>
                </div>
            </div>
            <div class="layui-card-body layui-text-right" id="mappingFooter">
                <button type="button" class="layui-btn layui-btn-sm layui-btn-normal" id="btnConfirmMapping">
                    <i class="layui-icon layui-icon-ok"></i> 确认映射
                </button>
            </div>
        </div>

        @** 审核明细表格 + 分页 ── *@
        <div class="layui-card ems-card">
            <div class="layui-card-header">
                <span>
                    <i class="layui-icon layui-icon-table"></i> 审核明细
                    <span class="layui-font-gray" style="margin-left:6px">（当前：<span id="currentProjectLabel">未选择</span>）</span>
                </span>
                <span class="layui-badge" id="rowCountBadge" style="float:right">0</span>
            </div>
            <div class="layui-card-body">
                <table class="layui-table" lay-size="sm">
                    <thead>
                        <tr>
                            <th style="width:15%">项目名称</th>
                            <th style="width:10%">送审工程量</th>
                            <th style="width:10%">送审单价(元)</th>
                            <th style="width:10%">审定工程量</th>
                            <th style="width:10%">审定单价(元)</th>
                            <th style="width:10%">送审金额(元)</th>
                            <th style="width:10%">审定金额(元)</th>
                            <th style="width:10%">差额(元)</th>
                            <th>审核原因</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                </table>
            </div>
            @** 分页栏 ── *@
            <div class="layui-card-body layui-hide" id="paginationBar">
                <div class="layui-btn-container" style="display:flex;align-items:center;gap:10px">
                    <span id="pageInfo" class="layui-font-12 layui-font-gray"></span>
                    <select id="pageSizeSelect" class="layui-input" style="width:70px;display:inline-block">
                        <option value="10" selected>10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                    </select>
                    <span class="layui-font-12 layui-font-gray">条/页</span>
                    <span style="flex:1"></span>
                    <button type="button" class="layui-btn layui-btn-sm" id="prevPageBtn">
                        <i class="layui-icon layui-icon-left"></i>
                    </button>
                    <button type="button" class="layui-btn layui-btn-sm" id="nextPageBtn">
                        <i class="layui-icon layui-icon-right"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>@** /col-right ── *@
</div>@** /row ── *@

@** ── 报告预览（layer 弹层） ── *@
<div class="ems-modal-box" id="previewBox" style="display:none">
    <div id="previewContent" style="max-height:65vh;overflow-y:auto;padding:4px 8px"></div>
</div>

@section Scripts {
    @** 第三方库 ── *@
    <script src="https://cdn.jsdelivr.net/npm/xlsx/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/file-saver@2.0.5/dist/FileSaver.min.js"></script>

    <script>
    ems.ready(function () {
        var $ = layui.jquery;

        // ═══════════════════════════════════════════════════════
        //  全局状态
        // ═══════════════════════════════════════════════════════
        let workbookSheets = [];
        let sheetsStore = [];
        let currentMapping = {项目编码: -1, 项目名称: -1, 计量单位: -1, 送审金额: -1, 审定金额: -1, 审核差额: -1, 审核原因: -1,
            送审工程量: -1, 审定工程量: -1, 工程量差额: -1,
            送审单价: -1, 审定单价: -1, 单价差额: -1};
        let isMapped = false;
        let currentChildNode = null;
        let currentDisplayData = [];
        let currentPage = 1;
        let pageSize = 10;

        let parentNodes = [];
        let childNodes = [];
        let nodeChecked = new Map();
        let currentFilter = { type: "", mode: "all", min: 0, max: 0 };

        const REASON_OPTIONS = [
            "工程量调整", "综合单价调整", "工程量及综合单价调整",
            "送审清单漏项", "图纸无该项内容",
            "设计变更", "材料调整", "其他"];

        // ═══════════════════════════════════════════════════════
        //  工具函数
        // ═══════════════════════════════════════════════════════
        function parseMoney(v) {
            let n = parseFloat(String(v).replace(/,/g, "").replace(/￥/g, ""));
            return isNaN(n) ? 0 : n;
        }
        function escapeHtml(str) {
            return String(str).replace(/[&<>"']/g, m => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            })[m]);
        }

        // ═══════════════════════════════════════════════════════
        //  操作说明折叠
        // ═══════════════════════════════════════════════════════
        function toggleHelp() {
            let content = document.getElementById('helpContent');
            let icon = document.getElementById('helpIcon');
            let show = content.classList.contains('layui-hide');
            content.classList.toggle('layui-hide');
            icon.className = show
                ? 'layui-icon layui-icon-down layui-font-gray'
                : 'layui-icon layui-icon-right layui-font-gray';
        }

        // ═══════════════════════════════════════════════════════
        //  A2 父\子格式解析
        // ═══════════════════════════════════════════════════════
        function parseParentChild(a2) {
            if (!a2) return null;
            let s = String(a2).trim();
            if (s.indexOf('\\') > -1) {
                let parts = s.split('\\');
                return { parent: parts[0].trim(), child: parts.slice(1).join('\\').trim() || parts[parts.length - 1].trim() };
            }
            return { parent: null, child: s };
        }

        // ═══════════════════════════════════════════════════════
        //  构建树（layui.tree）
        // ═══════════════════════════════════════════════════════
        function buildTree() {
            if (!workbookSheets.length) {
                document.getElementById("treeContainer").innerHTML = '<div class="ems-empty">请先导入 Excel</div>';
                return;
            }
            let parentMap = new Map();
            childNodes = [];
            let childId = 0;
            for (let sIdx = 0; sIdx < workbookSheets.length; sIdx++) {
                let sheet = workbookSheets[sIdx];
                let a2Val = (sheet.data[1] && sheet.data[1][0]) || "";
                let parsed = parseParentChild(a2Val);
                if (!parsed) continue;
                let { parent, child } = parsed;
                let cid = `child_${sIdx}_${childId++}`;
                childNodes.push({ id: cid, label: child || "未命名", sheetIdx: sIdx, parentName: parent });
                let pKey = parent || "未分组";
                if (!parentMap.has(pKey)) parentMap.set(pKey, { id: `parent_${pKey}`, name: pKey, childrenIds: [] });
                parentMap.get(pKey).childrenIds.push(cid);
            }
            parentNodes = Array.from(parentMap.values());

            let treeData = parentNodes.map(function (p) {
                return {
                    id: p.id, title: p.name, spread: true,
                    children: p.childrenIds.map(function (cid) {
                        let ch = null;
                        for (let i = 0; i < childNodes.length; i++) {
                            if (childNodes[i].id === cid) { ch = childNodes[i]; break; }
                        }
                        return { id: cid, title: ch ? ch.label : cid };
                    })
                };
            });

            layui.tree.render({
                elem: '#treeContainer',
                id: 'excelTreeIns',
                data: treeData,
                showCheckbox: true,
                onlyIconControl: true,
                click: function (obj) {
                    if (obj.data.children && obj.data.children.length) return; // 父节点仅展开
                    onChildClick(obj.data.id);
                },
                oncheck: function () {
                    nodeChecked = new Map();
                    let checked = layui.tree.getChecked('excelTreeIns') || [];
                    checked.forEach(function (p) {
                        (p.children || []).forEach(function (c) { nodeChecked.set(c.id, true); });
                        if (!p.children || !p.children.length) nodeChecked.set(p.id, true);
                    });
                }
            });
        }

        // ═══════════════════════════════════════════════════════
        //  点击子节点：切换映射预览 + 加载明细
        // ═══════════════════════════════════════════════════════
        function onChildClick(cid) {
            let child = childNodes.find(c => c.id === cid);
            if (!child) return;
            currentChildNode = cid;
            let sheet = workbookSheets[child.sheetIdx];
            if (sheet) {
                let headerRow = sheet.data[2] || [];
                renderMappingPreview(headerRow, sheet.data.slice(3, 13));
            }
            document.getElementById("currentProjectLabel").innerHTML = escapeHtml(child.label);
            if (isMapped && sheetsStore[child.sheetIdx]) {
                applyFiltersToDataset(sheetsStore[child.sheetIdx].parsedRows);
            } else {
                currentDisplayData = [];
                renderTableWithPagination();
            }
        }

        // ═══════════════════════════════════════════════════════
        //  渲染字段映射预览
        // ═══════════════════════════════════════════════════════
        function renderMappingPreview(headers, sampleRows) {
            let fieldList = [ "项目编码", "项目名称", "计量单位","送审金额", "审定金额", "审核差额", "审核原因",
                "送审工程量", "审定工程量", "工程量差额",
                "送审单价", "审定单价", "单价差额"];
            let defaultMap = { 1: "项目编码",
            2: "项目名称",
            4: "计量单位",
            5: "送审工程量",
            6: "送审单价",
            8: "送审金额",
            9: "审定工程量",
            10: "审定单价",
            11: "审定金额",
            12: "工程量差额",
            13: "审核差额",
            14: "审核原因" };
            let html = `<div class="mapping-scroll"><table class="layui-table" lay-size="sm"><thead><tr>`;
            for (let i = 0; i < headers.length; i++) {
                let df = defaultMap[i] || null;
                html += `<th data-colidx="${i}"><select class="layui-input mapping-select" data-colidx="${i}">
                    <option value="">未识别</option>`;
                for (let f of fieldList) {
                    html += `<option value="${f}" ${df === f ? 'selected' : ''}>${f}</option>`;
                }
                html += `</select></th>`;
            }
            html += `</tr></thead><tbody>`;
            sampleRows.forEach(row => {
                html += `<tr>`;
                for (let i = 0; i < headers.length; i++) {
                    let val = row[i] !== undefined ? String(row[i]) : "";
                    html += `<td title="${escapeHtml(val)}">${escapeHtml(val)}</td>`;
                }
                html += `</tr>`;
            });
            html += `</tbody></table></div>`;
            document.getElementById("mappingBody").innerHTML = html;

            expandMappingCard();

            let selects = document.querySelectorAll(".mapping-select");
            function updateHighlights() {
                document.querySelectorAll(".mapping-scroll th, .mapping-scroll td").forEach(el => el.classList.remove("highlight-col"));
                let fieldToCol = new Map();
                selects.forEach(sel => {
                    let field = sel.value;
                    let col = parseInt(sel.dataset.colidx);
                    if (field) {
                        if (fieldToCol.has(field) && fieldToCol.get(field) !== col) { sel.value = ""; }
                        else { fieldToCol.set(field, col); }
                    }
                });
                fieldToCol.forEach((col) => {
                    let th = document.querySelector(`.mapping-scroll th[data-colidx="${col}"]`);
                    if (th) th.classList.add("highlight-col");
                    document.querySelectorAll(".mapping-scroll tbody tr").forEach(row => {
                        if (row.children[col]) row.children[col].classList.add("highlight-col");
                    });
                });
            }
            selects.forEach(sel => sel.addEventListener("change", updateHighlights));
            updateHighlights();
        }

        // ═══════════════════════════════════════════════════════
        //  映射卡片折叠/展开
        // ═══════════════════════════════════════════════════════
        function toggleMappingCard() {
            let body = document.getElementById("mappingBody");
            let footer = document.getElementById("mappingFooter");
            let icon = document.getElementById("mappingCollapseIcon");
            let collapsed = !body.classList.contains('layui-hide');
            body.classList.toggle('layui-hide');
            footer.classList.toggle('layui-hide');
            icon.className = collapsed
                ? 'layui-icon layui-icon-down layui-font-gray'
                : 'layui-icon layui-icon-right layui-font-gray';
        }
        function collapseMappingCard() {
            let body = document.getElementById("mappingBody");
            let footer = document.getElementById("mappingFooter");
            let icon = document.getElementById("mappingCollapseIcon");
            body.classList.add('layui-hide');
            footer.classList.add('layui-hide');
            icon.className = 'layui-icon layui-icon-right layui-font-gray';
        }
        function expandMappingCard() {
            let body = document.getElementById("mappingBody");
            let footer = document.getElementById("mappingFooter");
            let icon = document.getElementById("mappingCollapseIcon");
            body.classList.remove('layui-hide');
            footer.classList.remove('layui-hide');
            icon.className = 'layui-icon layui-icon-down layui-font-gray';
        }

        // ═══════════════════════════════════════════════════════
        //  确认映射
        // ═══════════════════════════════════════════════════════
        function confirmMapping() {
            let selects = document.querySelectorAll(".mapping-select");
            if (!selects.length) {
                ems.msg('请先导入 Excel 并点击左侧子节点', { icon: 2 });
                return;
            }
            let mapping = {
                项目编码: -1, 项目名称: -1, 计量单位: -1, 送审金额: -1, 审定金额: -1, 审核差额: -1, 审核原因: -1,
                送审工程量: -1, 审定工程量: -1, 工程量差额: -1,
                送审单价: -1, 审定单价: -1, 单价差额: -1
            };
            selects.forEach(sel => {
                let col = parseInt(sel.dataset.colidx);
                let field = sel.value;
                if (field && mapping[field] !== undefined) mapping[field] = col;
            });
            if (mapping.项目名称 === -1 || mapping.送审金额 === -1) {
                ems.msg('至少需要映射「项目名称」和「送审金额」', { icon: 2 });
                return;
            }
            currentMapping = mapping;
            sheetsStore = [];
            for (let sIdx = 0; sIdx < workbookSheets.length; sIdx++) {
                let sheet = workbookSheets[sIdx];
                let dataRows = sheet.data.slice(5);
                let parsed = [];
                for (let row of dataRows) {
                    if (!row.length || (row.length === 1 && !row[0])) continue;
                    let code = row[mapping.项目编码];
                    if (code === undefined || code === null || code === "") continue;
                    let name = (mapping.项目名称 !== -1 && row[mapping.项目名称]) ? String(row[mapping.项目名称]) : "";
                    let unit = (mapping.计量单位 !== -1 && row[mapping.计量单位]) ? String(row[mapping.计量单位]) : "";
                    let submitQty = (mapping.送审工程量 !== -1) ? parseMoney(row[mapping.送审工程量]) : 0;
                    let approveQty = (mapping.审定工程量 !== -1) ? parseMoney(row[mapping.审定工程量]) : 0;
                    let volDiff = (mapping.工程量差额 !== -1) ? parseMoney(row[mapping.工程量差额]) : (approveQty - submitQty);
                    let submitPrice = (mapping.送审单价 !== -1) ? parseMoney(row[mapping.送审单价]) : 0;
                    let approvePrice = (mapping.审定单价 !== -1) ? parseMoney(row[mapping.审定单价]) : 0;
                    let priceDiff = (mapping.单价差额 !== -1) ? parseMoney(row[mapping.单价差额]) : (approvePrice - submitPrice);

                    let submit = parseMoney(row[mapping.送审金额]);
                    let approve = (mapping.审定金额 !== -1) ? parseMoney(row[mapping.审定金额]) : 0;
                    let diff = (mapping.审核差额 !== -1) ? parseMoney(row[mapping.审核差额]) : (approve - submit);

                    let reasonRaw = (mapping.审核原因 !== -1 && row[mapping.审核原因]) ? String(row[mapping.审核原因]) : "";
                    let auto = false;
                    if (!reasonRaw.trim()) {
                        auto = true;
                        if (submitQty === 0 && submitQty !== undefined) {
                            reasonRaw = "送审清单漏项";
                        } else if (approveQty === 0 && approveQty !== undefined) {
                            reasonRaw = "图纸无该项内容";
                        } else if (priceDiff !== 0 && volDiff !== 0) {
                            reasonRaw = "工程量及综合单价调整";
                        } else if (priceDiff !== 0 && volDiff === 0) {
                            reasonRaw = "综合单价调整";
                        } else if (priceDiff === 0 && volDiff !== 0) {
                            reasonRaw = "工程量调整";
                        } else {
                            reasonRaw = "无调整";
                        }
                    }
                    parsed.push({
                        code: String(code).trim(),
                        name: name.trim(),
                        submit, approve, diff, unit,
                        submitQty, approveQty, volDiff,
                        submitPrice, approvePrice, priceDiff,
                        reason: reasonRaw,
                        auto
                    });
                }
                sheetsStore.push({ sheetIdx: sIdx, sheetName: sheet.name, parsedRows: parsed });
            }
            isMapped = true;
            collapseMappingCard();
            let totalRows = sheetsStore.reduce((s, sh) => s + sh.parsedRows.length, 0);
            ems.msg(`映射完成！共加载 ${sheetsStore.length} 个 Sheet，共 ${totalRows} 条明细`, { icon: 1 });
            if (currentChildNode) {
                let child = childNodes.find(c => c.id === currentChildNode);
                if (child && sheetsStore[child.sheetIdx]) {
                    applyFiltersToDataset(sheetsStore[child.sheetIdx].parsedRows);
                }
            }
        }

        // ═══════════════════════════════════════════════════════
        //  筛选
        // ═══════════════════════════════════════════════════════
        function applyFilters() {
            if (!isMapped || !currentChildNode) {
                ems.msg('请先确认映射并选择左侧子节点', { icon: 2 });
                return;
            }
            let type = document.getElementById("type").value;
            let mode = document.getElementById("mode").value;
            let min  = parseFloat(document.getElementById("min").value) || 0;
            let max  = parseFloat(document.getElementById("max").value) || 0;
            currentFilter = { type, mode, min, max };
            let child = childNodes.find(c => c.id === currentChildNode);
            if (child && sheetsStore[child.sheetIdx]) {
                applyFiltersToDataset(sheetsStore[child.sheetIdx].parsedRows);
            }
        }
        function resetFilters() {
            document.getElementById("type").value = "";
            document.getElementById("mode").value = "all";
            document.getElementById("min").value = "";
            document.getElementById("max").value = "";
            currentFilter = { type: "", mode: "all", min: 0, max: 0 };
            if (currentChildNode) {
                let child = childNodes.find(c => c.id === currentChildNode);
                if (child && sheetsStore[child.sheetIdx]) applyFiltersToDataset(sheetsStore[child.sheetIdx].parsedRows);
            }
        }
        function applyFiltersToDataset(sourceRows) {
            if (!sourceRows) { currentDisplayData = []; renderTableWithPagination(); return; }
            currentDisplayData = sourceRows.filter(d => {
                let { type, mode, min, max } = currentFilter;
                if (type === "inc" && d.diff <= 0) return false;
                if (type === "dec" && d.diff >= 0) return false;
                if (mode === "gt")      return d.diff > min;
                if (mode === "lt")      return d.diff < min;
                if (mode === "between") return d.diff >= min && d.diff <= max;
                if (mode === "abs")     return Math.abs(d.diff) > min;
                return true;
            });
            currentPage = 1;
            renderTableWithPagination();
        }

        // ═══════════════════════════════════════════════════════
        //  渲染表格 + 分页
        // ═══════════════════════════════════════════════════════
        function renderTableWithPagination() {
            let total = currentDisplayData.length;
            let totalPages = Math.ceil(total / pageSize) || 1;
            if (currentPage > totalPages) currentPage = totalPages;
            let start = (currentPage - 1) * pageSize;
            let end   = start + pageSize;
            let pageData = currentDisplayData.slice(start, end);
            let tbody = document.getElementById("tableBody");

            document.getElementById("rowCountBadge").innerText = total;

            if (!total) {
                tbody.innerHTML = `<tr><td colspan="9" class="layui-text-center layui-font-gray" style="padding:18px 0">暂无数据</td></tr>`;
                document.getElementById("paginationBar").classList.add("layui-hide");
                return;
            }

            tbody.innerHTML = "";
            pageData.forEach((d, idx) => {
                let globalIdx = start + idx;
                let diffCls = d.diff > 0 ? 'layui-font-red' : (d.diff < 0 ? 'layui-font-green' : 'layui-font-gray');
                tbody.insertAdjacentHTML('beforeend', `<tr>
                    <td>${escapeHtml(d.name)}</td>
                    <td>${d.submitQty.toFixed(2)}</td>
                    <td>${d.submitPrice.toFixed(2)}</td>
                    <td>${d.approveQty.toFixed(2)}</td>
                    <td>${d.approvePrice.toFixed(2)}</td>
                    <td>${d.submit.toFixed(2)}</td>
                    <td>${d.approve.toFixed(2)}</td>
                    <td class="${diffCls} num-">${d.diff.toFixed(2)}</td>
                    <td class="${d.auto ? 'auto-reason' : ''}">
                        <div style="display:flex;gap:6px;align-items:center">
                            <select class="layui-input layui-input-inline reason-select" data-idx="${globalIdx}" style="width:100px">
                                ${REASON_OPTIONS.map(opt => `<option ${d.reason === opt ? 'selected' : ''}>${opt}</option>`).join('')}
                            </select>
                            <input class="layui-input reason-input" data-idx="${globalIdx}"
                                value="${escapeHtml(d.reason)}" style="width:120px">
                        </div>
                    </td>
                </tr>`);
            });

            document.querySelectorAll('.reason-select').forEach(sel => {
                sel.addEventListener('change', () => {
                    let idx = parseInt(sel.dataset.idx);
                    if (!isNaN(idx) && currentDisplayData[idx]) {
                        currentDisplayData[idx].reason = sel.value;
                        currentDisplayData[idx].auto = false;
                        let inp = sel.closest('.reason-box')?.querySelector('.reason-input');
                        if (inp) inp.value = sel.value;
                    }
                });
            });
            document.querySelectorAll('.reason-input').forEach(inp => {
                inp.addEventListener('input', () => {
                    let idx = parseInt(inp.dataset.idx);
                    if (!isNaN(idx) && currentDisplayData[idx]) {
                        currentDisplayData[idx].reason = inp.value;
                        currentDisplayData[idx].auto = false;
                    }
                });
            });

            document.getElementById("paginationBar").classList.remove("layui-hide");
            document.getElementById("pageInfo").innerHTML =
                `第 ${currentPage} / ${totalPages} 页，共 ${total} 条`;

            let prevBtn = document.getElementById("prevPageBtn");
            let nextBtn = document.getElementById("nextPageBtn");
            prevBtn.classList.toggle("layui-btn-disabled", currentPage <= 1);
            nextBtn.classList.toggle("layui-btn-disabled", currentPage >= totalPages);
            prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; renderTableWithPagination(); } };
            nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; renderTableWithPagination(); } };

            let ps = document.getElementById("pageSizeSelect");
            ps.value = pageSize;
            ps.onchange = e => { pageSize = parseInt(e.target.value); currentPage = 1; renderTableWithPagination(); };
        }

        // ═══════════════════════════════════════════════════════
        //  导入 Excel
        // ═══════════════════════════════════════════════════════
        $('#upload').on('change', async function (e) {
            let file = e.target.files[0];
            if (!file) return;
            let buffer = await file.arrayBuffer();
            let workbook = XLSX.read(buffer, { type: 'array' });
            workbookSheets = [];
            for (let name of workbook.SheetNames) {
                let ws = workbook.Sheets[name];
                let data = XLSX.utils.sheet_to_json(ws, { header: 1, defval: "" });
                if (data.length >= 3) workbookSheets.push({ name, data });
            }
            if (!workbookSheets.length) {
                ems.msg('无有效工作表（每个 Sheet 至少需要 3 行数据）', { icon: 2 });
                return;
            }
            isMapped = false;
            sheetsStore = [];
            nodeChecked.clear();
            buildTree();
            if (childNodes.length) onChildClick(childNodes[0].id);
            else document.getElementById("currentProjectLabel").innerHTML = "无子节点";
            document.getElementById("mappingBody").innerHTML =
                `<div class="layui-card-body"><div class="ems-alert info">
                    <i class="layui-icon layui-icon-tips"></i> 请点击左侧子节点加载映射预览
                </div></div>`;
            e.target.value = "";
        });

        // ═══════════════════════════════════════════════════════
        //  报告预览（layer 弹层）
        // ═══════════════════════════════════════════════════════
        function previewReport() {
            if (!isMapped) {
                ems.msg('请先确认映射', { icon: 2 });
                return;
            }
            let selected = childNodes.filter(c => nodeChecked.get(c.id) === true);
            if (!selected.length) {
                ems.msg('请勾选至少一个子节点', { icon: 2 });
                return;
            }
            let html = '';
            for (let child of selected) {
                let sheet = sheetsStore[child.sheetIdx];
                if (!sheet || !sheet.parsedRows.length) continue;
                let filteredRows = filterRows(sheet.parsedRows);
                if (!filteredRows.length) continue;
                html += `<h5 style="border-bottom:1px solid #eee;padding-bottom:4px;margin-bottom:8px">
                    <i class="layui-icon layui-icon-file text-info"></i> ${escapeHtml(child.label)}
                </h5><ul style="margin-bottom:12px;padding-left:18px">`;
                filteredRows.forEach((item, idx) => {
                    let diffAbs = Math.abs(item.diff);
                    let typeText = item.diff > 0 ? "审增" : (item.diff < 0 ? "审减" : "无调整");
                    let diffCls = item.diff > 0 ? 'layui-font-red' : (item.diff < 0 ? 'layui-font-green' : 'layui-font-gray');
                    html += `<li style="margin-bottom:4px">
                        ${idx + 1}. ${escapeHtml(item.name)}：
                        送审工程量 ${item.submitQty.toFixed(2)}${escapeHtml(item.unit)}，审定工程量 ${item.approveQty.toFixed(2)}${escapeHtml(item.unit)}，
                        送审单价 ${item.submitPrice.toFixed(2)} 元/${escapeHtml(item.unit)}，审定单价 ${item.approvePrice.toFixed(2)} 元/${escapeHtml(item.unit)}，
                        送审金额 ${item.submit.toFixed(2)} 元，审定金额 ${item.approve.toFixed(2)} 元，
                        <span class="${diffCls}">${typeText}金额 ${diffAbs.toFixed(2)} 元</span>，
                        ${typeText}原因：${escapeHtml(item.reason)}
                    </li>`;
                });
                html += `</ul>`;
            }
            if (!html) {
                ems.msg('所选节点在当前筛选条件下无数据', { icon: 3 });
                return;
            }
            document.getElementById("previewContent").innerHTML = html;
            layer.open({
                type: 1,
                title: '<i class="layui-icon layui-icon-file"></i> 工程审核报告预览',
                area: ['92%', '90%'],
                content: $('#previewBox'),
                btn: ['导出 Word', '关闭'],
                yes: function () { exportWordReport(); },
                btn2: function () { layer.closeAll(); }
            });
        }

        // ═══════════════════════════════════════════════════════
        //  导出 Word（服务端模板渲染）
        // ═══════════════════════════════════════════════════════
        async function exportWordReport() {
            let selected = childNodes.filter(c => nodeChecked.get(c.id) === true);
            if (!selected.length) { ems.msg('请勾选至少一个子节点', { icon: 2 }); return; }
            let tplId = document.getElementById('tplSelect').value;
            if (!tplId) { ems.msg('请先在右上角选择模板', { icon: 2 }); return; }

            // 汇总所有勾选项目的筛选后明细，并计算合计
            let allRows = [];
            let submitTotal = 0, approveTotal = 0, diffTotal = 0, projCount = 0;
            selected.forEach(child => {
                let sheet = sheetsStore[child.sheetIdx];
                if (!sheet) return;
                let filtered = filterRows(sheet.parsedRows);
                if (!filtered.length) return;
                projCount++;
                filtered.forEach(item => {
                    allRows.push({
                        name: item.name, unit: item.unit,
                        submitQty: item.submitQty.toFixed(2), submitPrice: item.submitPrice.toFixed(2), submit: item.submit.toFixed(2),
                        approveQty: item.approveQty.toFixed(2), approvePrice: item.approvePrice.toFixed(2), approve: item.approve.toFixed(2),
                        diff: item.diff.toFixed(2), reason: item.reason
                    });
                    submitTotal += item.submit; approveTotal += item.approve; diffTotal += item.diff;
                });
            });
            if (!allRows.length) { ems.msg('所选节点在当前筛选条件下无数据', { icon: 3 }); return; }
            allRows.forEach((r, i) => r.序号 = i + 1);

            // 客户端字段名 -> 模板占位符名（与 cost-audit-report.docx 表格行一致）
            let excelColumns = [
                { ColumnName: '序号', FieldName: '序号' },
                { ColumnName: 'name', FieldName: '项目名称' },
                { ColumnName: 'unit', FieldName: '计量单位' },
                { ColumnName: 'submitQty', FieldName: '送审工程量' },
                { ColumnName: 'submitPrice', FieldName: '送审单价' },
                { ColumnName: 'submit', FieldName: '送审金额' },
                { ColumnName: 'approveQty', FieldName: '审定工程量' },
                { ColumnName: 'approvePrice', FieldName: '审定单价' },
                { ColumnName: 'approve', FieldName: '审定金额' },
                { ColumnName: 'diff', FieldName: '差额' },
                { ColumnName: 'reason', FieldName: '审核原因' }
            ];
            let excelRows = allRows.map(r => ({
                '序号': r.序号, 'name': r.name, 'unit': r.unit,
                'submitQty': r.submitQty, 'submitPrice': r.submitPrice, 'submit': r.submit,
                'approveQty': r.approveQty, 'approvePrice': r.approvePrice, 'approve': r.approve,
                'diff': r.diff, 'reason': r.reason
            }));

            let today = new Date().toISOString().slice(0, 10);
            let sup = {
                '工程名称': selected.length === 1 ? selected[0].label : ('共 ' + selected.length + ' 个项目'),
                '报告日期': today,
                '送审合计': submitTotal.toFixed(2),
                '审定合计': approveTotal.toFixed(2),
                '审减合计': diffTotal.toFixed(2),
                '项目数': String(projCount)
            };

            let payload = {
                TemplateId: tplId, ContextSource: '', InstanceId: '',
                SupplementaryFields: sup,
                ExcelColumns: excelColumns, ExcelRows: excelRows,
                ListFields: {}, ImageFields: {}
            };

            let loadIndex;
            try {
                loadIndex = layer.load(1, { shade: [0.3, '#fff'] });
                // 全局 AutoValidateAntiforgeryToken 要求 POST 必须带 CSRF 令牌头，否则返回 400
                let antiForgery = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];
                let resp = await fetch('/templatereport/generate-adhoc', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': antiForgery },
                    body: JSON.stringify(payload)
                });
                if (!resp.ok) { ems.msg('生成失败：HTTP ' + resp.status, { icon: 2 }); return; }
                let blob = await resp.blob();
                saveAs(blob, '造价审核报告_' + today + '.docx');
                ems.msg('已生成报告', { icon: 1 });
            } catch (e) {
                ems.msg('生成异常：' + e.message, { icon: 2 });
            } finally {
                if (loadIndex) layer.close(loadIndex);
            }
        }

        // ── 共用筛选逻辑
        function filterRows(rows) {
            let { type, mode, min, max } = currentFilter;
            return rows.filter(d => {
                if (type === "inc" && d.diff <= 0) return false;
                if (type === "dec" && d.diff >= 0) return false;
                if (mode === "gt")      return d.diff > min;
                if (mode === "lt")      return d.diff < min;
                if (mode === "between") return d.diff >= min && d.diff <= max;
                if (mode === "abs")     return Math.abs(d.diff) > min;
                return true;
            });
        }

        // ═══════════════════════════════════════════════════════
        //  加载造价类模板（供导出时选择）
        // ═══════════════════════════════════════════════════════
        function loadCostTemplates() {
            fetch('/templatereport/templates')
                .then(r => r.json())
                .then(d => {
                    let list = d && d.data ? d.data : (Array.isArray(d) ? d : []);
                    if (!Array.isArray(list)) list = [];
                    list = list.filter(t => (t.category || '') === '造价');
                    let sel = document.getElementById('tplSelect');
                    sel.innerHTML = '';
                    if (!list.length) {
                        sel.innerHTML = '<option value="">（无可用模板）</option>';
                        return;
                    }
                    list.forEach(t => {
                        let o = document.createElement('option');
                        o.value = t.id; o.textContent = t.name;
                        sel.appendChild(o);
                    });
                })
                .catch(() => {
                    document.getElementById('tplSelect').innerHTML = '<option value="">（模板加载失败）</option>';
                });
        }

        // ═══════════════════════════════════════════════════════
        //  事件绑定
        // ═══════════════════════════════════════════════════════
        $('#btnImportExcel').on('click', function () { $('#upload').click(); });
        $('#btnPreview').on('click', previewReport);
        $('#helpHeader').on('click', toggleHelp);
        $('#mappingHeader').on('click', toggleMappingCard);
        $('#btnConfirmMapping').on('click', confirmMapping);
        $('#btnFilter').on('click', applyFilters);
        $('#btnReset').on('click', resetFilters);
        loadCostTemplates();
    });
    </script>
}
